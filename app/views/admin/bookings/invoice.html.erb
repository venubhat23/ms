<%
  has_gst = @booking.booking_items&.any? { |item| item.product&.gst_enabled }

  gst_summary     = gst_booking_summary(@booking_items || @booking.booking_items)
  taxable_amount  = gst_summary[:base]
  total_cgst      = gst_summary[:cgst]
  total_sgst      = gst_summary[:sgst]
  total_igst      = gst_summary[:igst]
  total_tax       = gst_summary[:tax]
  subtotal_amount = gst_summary[:base] + gst_summary[:tax]
  final_total     = subtotal_amount

  business_settings = SystemSetting.business_settings
  template_name = begin
    SystemSetting.column_names.include?('invoice_template') ? (business_settings.invoice_template.presence || 'classic') : 'classic'
  rescue => _e
    'classic'
  end
  allowed_templates = %w[classic tally modern corporate saffron minimal]
  template_name = 'classic' unless allowed_templates.include?(template_name)
%>

<%= render "admin/bookings/invoice_templates/#{template_name}",
    booking: @booking,
    business_settings: business_settings,
    booking_items: (@booking_items || @booking.booking_items),
    has_gst: has_gst,
    subtotal_amount: subtotal_amount,
    taxable_amount: taxable_amount,
    total_cgst: total_cgst,
    total_sgst: total_sgst,
    total_igst: total_igst,
    total_tax: total_tax,
    final_total: final_total,
    gst_summary: gst_summary %>
