<style>
  .inv-minimal { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 12px; background: #fff; color: #1a1a1a; padding: 36px; }
  .inv-minimal .top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 32px; }
  .inv-minimal .co-name { font-size: 26px; font-weight: 700; letter-spacing: -1px; }
  .inv-minimal .co-sub { font-size: 11px; color: #666; line-height: 1.6; margin-top: 4px; max-width: 260px; }
  .inv-minimal .inv-block { text-align: right; }
  .inv-minimal .inv-type { font-size: 10px; font-weight: 700; color: #666; text-transform: uppercase; letter-spacing: 2px; }
  .inv-minimal .inv-num { font-size: 22px; font-weight: 700; color: #1a1a1a; }
  .inv-minimal .inv-date { font-size: 11px; color: #666; margin-top: 3px; }
  .inv-minimal .divider { border: none; border-top: 2px solid #1a1a1a; margin: 0 0 24px; }
  .inv-minimal .thin-divider { border: none; border-top: 1px solid #e5e5e5; margin: 12px 0; }
  .inv-minimal .addr-row { display: flex; gap: 40px; margin-bottom: 28px; }
  .inv-minimal .addr-col { flex: 1; }
  .inv-minimal .addr-label { font-size: 9px; font-weight: 700; color: #999; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 6px; }
  .inv-minimal .addr-name { font-size: 14px; font-weight: 700; }
  .inv-minimal .addr-detail { font-size: 11px; color: #555; line-height: 1.6; }
  .inv-minimal .items-table { width: 100%; border-collapse: collapse; }
  .inv-minimal .items-table th { font-size: 9px; font-weight: 700; color: #999; text-transform: uppercase; letter-spacing: 1px; padding: 0 8px 10px; border-bottom: 2px solid #1a1a1a; }
  .inv-minimal .items-table th:first-child { padding-left: 0; }
  .inv-minimal .items-table th:last-child { text-align: right; padding-right: 0; }
  .inv-minimal .items-table td { padding: 12px 8px; border-bottom: 1px solid #e5e5e5; font-size: 12px; }
  .inv-minimal .items-table td:first-child { padding-left: 0; font-weight: 600; }
  .inv-minimal .items-table td:last-child { text-align: right; padding-right: 0; font-weight: 700; }
  .inv-minimal .totals-section { display: flex; justify-content: flex-end; margin: 20px 0; }
  .inv-minimal .totals-box { width: 240px; }
  .inv-minimal .t-row { display: flex; justify-content: space-between; padding: 6px 0; font-size: 12px; color: #555; border-bottom: 1px solid #e5e5e5; }
  .inv-minimal .t-row.grand { color: #1a1a1a; font-weight: 700; font-size: 16px; border-top: 2px solid #1a1a1a; border-bottom: none; padding-top: 10px; }
  .inv-minimal .bottom-section { display: flex; gap: 30px; margin-top: 28px; padding-top: 24px; border-top: 1px solid #e5e5e5; }
  .inv-minimal .bank-section { flex: 2; }
  .inv-minimal .bank-label { font-size: 9px; font-weight: 700; color: #999; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 10px; }
  .inv-minimal .b-row { display: flex; justify-content: space-between; padding: 4px 0; font-size: 11px; color: #555; border-bottom: 1px solid #f0f0f0; }
  .inv-minimal .qr-section { flex: 1; text-align: center; }
  .inv-minimal .sig-section { flex: 1; text-align: center; border-left: 1px solid #e5e5e5; padding-left: 20px; }
  .inv-minimal .words { font-size: 10px; color: #888; font-style: italic; margin-top: 8px; }
</style>

<div class="inv-minimal">
  <%
    upi_id_mn = business_settings.upi_id || '9972808044@ybl'
    upi_str_mn = "upi://pay?pa=#{upi_id_mn}&pn=#{CGI.escape(business_settings.business_name || 'Marali Santhe')}&am=#{final_total.round(2)}&cu=INR&tn=#{CGI.escape("Invoice #{booking.invoice_number || booking.booking_number}")}"
  %>

  <div class="top">
    <div>
      <img src="/logo.jpeg" style="width:50px;height:50px;border-radius:50%;margin-bottom:8px;float:left;margin-right:12px;border:1px solid #e5e5e5;" alt="Logo"/>
      <div class="co-name"><%= business_settings.business_name || 'Marali Santhe' %></div>
      <div class="co-sub"><%= business_settings.address %><br/><%= business_settings.mobile %> &nbsp;|&nbsp; <%= business_settings.email %><br/>GSTIN: <%= business_settings.gstin %> &nbsp;|&nbsp; PAN: <%= business_settings.pan_number %></div>
    </div>
    <div class="inv-block">
      <div class="inv-type"><%= has_gst ? 'Tax Invoice' : 'Bill of Supply' %></div>
      <div class="inv-num">#<%= booking.invoice_number || booking.booking_number %></div>
      <div class="inv-date"><%= Date.current.strftime('%d %B %Y') %></div>
      <div style="margin-top:6px;font-size:11px;font-weight:700;color:<%= booking.payment_status_paid? ? '#155724' : '#721c24' %>;">
        <%= booking.payment_status_paid? ? '● PAID' : '○ PENDING' %>
      </div>
    </div>
  </div>

  <hr class="divider"/>

  <div class="addr-row">
    <div class="addr-col">
      <div class="addr-label">Billed To</div>
      <div class="addr-name"><%= booking.customer_name || booking.customer&.display_name %></div>
      <div class="addr-detail"><%= booking.delivery_address || booking.customer&.address %></div>
      <% if (booking.customer_phone || booking.customer&.mobile).present? %>
        <div class="addr-detail"><%= booking.customer_phone || booking.customer&.mobile %></div>
      <% end %>
    </div>
    <div class="addr-col">
      <div class="addr-label">Shipped To</div>
      <div class="addr-name"><%= booking.customer_name || booking.customer&.display_name %></div>
      <div class="addr-detail"><%= booking.delivery_address || booking.customer&.address %></div>
    </div>
    <div class="addr-col">
      <div class="addr-label">Payment Details</div>
      <div style="font-size:11px;color:#555;line-height:1.8;">
        <strong>Due:</strong> <%= (Date.current + 30.days).strftime('%d %b %Y') %><br/>
        <strong>Amount:</strong> ₹ <%= number_with_delimiter(sprintf('%.2f', final_total), delimiter: ',') %><br/>
        <strong>Received:</strong> ₹ <%= booking.payment_status_paid? ? number_with_delimiter(final_total.round(2), delimiter: ',') : '0.00' %>
      </div>
    </div>
  </div>

  <!-- Items -->
  <table class="items-table">
    <thead>
      <tr>
        <th>Item</th>
        <th style="text-align:center;">HSN</th>
        <th style="text-align:center;">Qty</th>
        <th style="text-align:right;">Rate</th>
        <th style="text-align:right;">Tax</th>
        <th>Amount</th>
      </tr>
    </thead>
    <tbody>
      <% booking_items.each do |item| %>
        <% it = gst_item_totals(item) %>
        <tr>
          <td><%= item.product&.name || 'Product' %></td>
          <td style="text-align:center;font-size:10px;color:#888;"><%= item.product&.hsn_code || '-' %></td>
          <td style="text-align:center;"><%= item.quantity %> <%= item.product&.unit_type || 'PCS' %></td>
          <td style="text-align:right;font-weight:400;">₹<%= number_with_delimiter(sprintf('%.2f', item.price || 0), delimiter: ',') %></td>
          <td style="text-align:right;font-weight:400;font-size:11px;color:#666;">₹<%= number_with_delimiter(it[:tax].round(2), delimiter: ',') %> (<%= it[:gst_rate].to_i == it[:gst_rate] ? it[:gst_rate].to_i : it[:gst_rate] %>%)</td>
          <td>₹<%= number_with_delimiter((it[:base]+it[:tax]).round(2), delimiter: ',') %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <!-- Totals -->
  <div class="totals-section">
    <div class="totals-box">
      <div class="t-row"><span>Taxable Amount</span><span>₹ <%= number_with_delimiter(taxable_amount.round(2), delimiter: ',') %></span></div>
      <% rate_groups = gst_rate_groups(booking_items)
         all_rates = (rate_groups[:cgst].keys + rate_groups[:sgst].keys).uniq.sort
         all_rates.each do |rate| %>
        <% if rate_groups[:cgst][rate].to_f > 0 %>
          <div class="t-row"><span>CGST @<%= rate.to_i == rate ? rate.to_i : rate %>%</span><span>₹ <%= number_with_delimiter(rate_groups[:cgst][rate].round(2), delimiter: ',') %></span></div>
        <% end %>
        <% if rate_groups[:sgst][rate].to_f > 0 %>
          <div class="t-row"><span>SGST @<%= rate.to_i == rate ? rate.to_i : rate %>%</span><span>₹ <%= number_with_delimiter(rate_groups[:sgst][rate].round(2), delimiter: ',') %></span></div>
        <% end %>
      <% end %>
      <div class="t-row grand"><span>Total</span><span>₹ <%= number_with_delimiter(sprintf('%.2f', final_total), delimiter: ',') %></span></div>
      <div class="words"><%= amount_in_words(final_total) %> Rupees Only</div>
    </div>
  </div>

  <!-- Bottom -->
  <div class="bottom-section">
    <div class="bank-section">
      <div class="bank-label">Bank Details</div>
      <div class="b-row"><span>Account Holder</span><strong><%= business_settings.account_holder_name %></strong></div>
      <div class="b-row"><span>Bank</span><strong><%= business_settings.bank_name %></strong></div>
      <div class="b-row"><span>Account No.</span><strong><%= business_settings.account_number %></strong></div>
      <div class="b-row"><span>IFSC Code</span><strong><%= business_settings.ifsc_code %></strong></div>
    </div>
    <div class="qr-section">
      <div class="bank-label">UPI Payment</div>
      <img src="https://api.qrserver.com/v1/create-qr-code/?size=90x90&data=<%= CGI.escape(upi_str_mn) %>" alt="QR" style="width:75px;height:75px;border:1px solid #e5e5e5;border-radius:4px;"/>
      <div style="font-size:9px;color:#888;margin-top:4px;"><%= upi_id_mn %></div>
    </div>
    <div class="sig-section">
      <div class="bank-label">Signature</div>
      <div style="height:50px;border:1px solid #e5e5e5;border-radius:3px;margin-bottom:8px;"></div>
      <div style="font-size:11px;font-weight:700;"><%= business_settings.business_name %></div>
      <div style="font-size:9px;color:#888;margin-top:2px;">Authorised Signatory</div>
    </div>
  </div>

  <% if business_settings.terms_and_conditions.present? %>
    <div style="margin-top:20px;padding-top:16px;border-top:1px solid #e5e5e5;">
      <div style="font-size:9px;font-weight:700;color:#999;text-transform:uppercase;letter-spacing:2px;margin-bottom:6px;">Terms &amp; Conditions</div>
      <ol style="padding-left:16px;font-size:10px;color:#555;line-height:1.7;margin:0;">
        <% business_settings.formatted_terms_and_conditions.each do |t| %><li><%= t %></li><% end %>
      </ol>
    </div>
  <% end %>

  <div style="margin-top:20px;text-align:center;font-size:9px;color:#bbb;letter-spacing:1px;text-transform:uppercase;">This is a Computer Generated Invoice</div>
</div>
