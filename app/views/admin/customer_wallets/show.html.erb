<% content_for :title, "Customer Wallet" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1"><%= "#{@customer_wallet.customer.first_name} #{@customer_wallet.customer.last_name}".strip %></h2>
    <p class="text-muted mb-0">
      <%= @customer_wallet.customer.email %>
      <% if @customer_wallet.customer.mobile.present? %>
        &middot; <%= @customer_wallet.customer.mobile %>
      <% end %>
    </p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to admin_customer_wallets_path, class: "btn btn-secondary" do %>
      <i class="bi bi-arrow-left me-1"></i>Back
    <% end %>
    <%= link_to edit_admin_customer_wallet_path(@customer_wallet), class: "btn btn-outline-warning" do %>
      <i class="bi bi-pencil me-1"></i>Edit
    <% end %>
    <%= link_to admin_customer_wallet_path(@customer_wallet), method: :delete,
        class: "btn btn-outline-danger",
        confirm: "Are you sure? This will delete all transaction history." do %>
      <i class="bi bi-trash me-1"></i>Delete
    <% end %>
  </div>
</div>

<div class="row mb-4">
  <div class="col-md-4">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body text-center">
        <h6 class="text-muted mb-2">Current Balance</h6>
        <h1 class="mb-2 text-<%= @customer_wallet.balance > 0 ? 'success' : 'muted' %>">
          <%= @customer_wallet.formatted_balance %>
        </h1>
        <span class="badge bg-<%= @customer_wallet.status? ? 'success' : 'danger' %>">
          <%= @customer_wallet.status? ? 'Active' : 'Inactive' %>
        </span>
        <% if @customer_wallet.notes.present? %>
          <p class="text-muted mt-3 mb-0 small"><%= @customer_wallet.notes %></p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-white">
        <h6 class="mb-0 text-success"><i class="bi bi-plus-circle me-1"></i>Add Money</h6>
      </div>
      <div class="card-body">
        <%= form_with url: add_money_admin_customer_wallet_path(@customer_wallet), method: :post, local: true do %>
          <div class="mb-2">
            <label class="form-label small">Amount</label>
            <div class="input-group">
              <span class="input-group-text">₹</span>
              <input type="number" name="amount" step="0.01" min="0.01" class="form-control" required>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label small">Description (optional)</label>
            <input type="text" name="description" class="form-control" placeholder="e.g. Refund, promotional credit">
          </div>
          <button type="submit" class="btn btn-success w-100">Add Money</button>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-white">
        <h6 class="mb-0 text-danger"><i class="bi bi-dash-circle me-1"></i>Deduct Money</h6>
      </div>
      <div class="card-body">
        <%= form_with url: deduct_money_admin_customer_wallet_path(@customer_wallet), method: :post, local: true do %>
          <div class="mb-2">
            <label class="form-label small">Amount</label>
            <div class="input-group">
              <span class="input-group-text">₹</span>
              <input type="number" name="amount" step="0.01" min="0.01" max="<%= @customer_wallet.balance %>" class="form-control" required>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label small">Description (optional)</label>
            <input type="text" name="description" class="form-control" placeholder="e.g. Correction, manual reversal">
          </div>
          <button type="submit" class="btn btn-danger w-100" <%= 'disabled' if @customer_wallet.balance <= 0 %>>Deduct Money</button>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-header bg-white d-flex justify-content-between align-items-center">
    <h6 class="mb-0">Recent Transactions</h6>
    <%= link_to "View Full History", transaction_history_admin_customer_wallet_path(@customer_wallet), class: "btn btn-sm btn-outline-primary" %>
  </div>
  <div class="card-body p-0">
    <% if @transactions.any? %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Type</th>
              <th>Amount</th>
              <th>Balance After</th>
              <th>Description</th>
              <th>Reference</th>
              <th>Booking</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            <% @transactions.each do |txn| %>
              <tr>
                <td>
                  <span class="badge bg-<%= txn.transaction_color %>">
                    <i class="bi bi-<%= txn.transaction_icon %> me-1"></i><%= txn.transaction_type.humanize %>
                  </span>
                </td>
                <td class="fw-medium text-<%= txn.credit? ? 'success' : 'danger' %>">
                  <%= txn.credit? ? '+' : '-' %><%= txn.formatted_amount %>
                </td>
                <td>₹<%= number_with_delimiter(txn.balance_after.to_f.round(2)) %></td>
                <td><%= txn.description %></td>
                <td><small class="text-muted"><%= txn.reference_number %></small></td>
                <td>
                  <% if txn.booking.present? %>
                    <%= link_to "##{txn.booking.booking_number}", admin_booking_path(txn.booking), class: "small" %>
                  <% else %>
                    <span class="text-muted small">&mdash;</span>
                  <% end %>
                </td>
                <td><small class="text-muted"><%= txn.created_at.strftime('%d %b %Y, %I:%M %p') %></small></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-5">
        <i class="bi bi-clock-history display-1 text-muted"></i>
        <h6 class="mt-3 text-muted">No Transactions Yet</h6>
      </div>
    <% end %>
  </div>
</div>
