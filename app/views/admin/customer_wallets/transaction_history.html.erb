<% content_for :title, "Wallet Transaction History" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1"><%= "#{@customer_wallet.customer.first_name} #{@customer_wallet.customer.last_name}".strip %></h2>
    <p class="text-muted mb-0">Full transaction history &middot; Current balance: <strong><%= @customer_wallet.formatted_balance %></strong></p>
  </div>
  <div>
    <%= link_to admin_customer_wallet_path(@customer_wallet), class: "btn btn-secondary" do %>
      <i class="bi bi-arrow-left me-1"></i>Back to Wallet
    <% end %>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-header bg-white">
    <h6 class="mb-0">All Transactions</h6>
  </div>
  <div class="card-body p-0">
    <% if @transactions.any? %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Type</th>
              <th>Amount</th>
              <th>Balance After</th>
              <th>Description</th>
              <th>Reference</th>
              <th>Booking</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            <% @transactions.each do |txn| %>
              <tr>
                <td>
                  <span class="badge bg-<%= txn.transaction_color %>">
                    <i class="bi bi-<%= txn.transaction_icon %> me-1"></i><%= txn.transaction_type.humanize %>
                  </span>
                </td>
                <td class="fw-medium text-<%= txn.credit? ? 'success' : 'danger' %>">
                  <%= txn.credit? ? '+' : '-' %><%= txn.formatted_amount %>
                </td>
                <td>₹<%= number_with_delimiter(txn.balance_after.to_f.round(2)) %></td>
                <td><%= txn.description %></td>
                <td><small class="text-muted"><%= txn.reference_number %></small></td>
                <td>
                  <% if txn.booking.present? %>
                    <%= link_to "##{txn.booking.booking_number}", admin_booking_path(txn.booking), class: "small" %>
                  <% else %>
                    <span class="text-muted small">&mdash;</span>
                  <% end %>
                </td>
                <td><small class="text-muted"><%= txn.created_at.strftime('%d %b %Y, %I:%M %p') %></small></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @transactions.respond_to?(:total_pages) && @transactions.total_pages > 1 %>
        <div class="card-footer bg-white">
          <div class="d-flex justify-content-center">
            <%= paginate @transactions %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-5">
        <i class="bi bi-clock-history display-1 text-muted"></i>
        <h6 class="mt-3 text-muted">No Transactions Yet</h6>
      </div>
    <% end %>
  </div>
</div>
