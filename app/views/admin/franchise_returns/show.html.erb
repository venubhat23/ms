<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1">Franchise Return #<%= @franchise_return.id %></h2>
    <p class="text-muted mb-0">
      <%= link_to @franchise_return.franchise.display_name, admin_franchise_path(@franchise_return.franchise) %>
      &middot; submitted <%= @franchise_return.created_at.strftime("%b %d, %Y %I:%M %p") %>
    </p>
  </div>
  <% status_color = { 'pending' => 'warning', 'approved' => 'success', 'rejected' => 'danger' }[@franchise_return.status] %>
  <span class="badge bg-<%= status_color %> fs-6"><%= @franchise_return.status.capitalize %></span>
</div>

<% if @franchise_return.errors.any? %>
  <div class="alert alert-danger">
    <%= @franchise_return.errors.full_messages.to_sentence %>
  </div>
<% end %>

<div class="row">
  <div class="col-lg-7">
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-transparent border-0">
        <h5 class="mb-0">Returned Items</h5>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table mb-0">
            <thead class="bg-light">
              <tr>
                <th class="border-0">Product</th>
                <th class="border-0 text-end">Quantity</th>
                <th class="border-0 text-end">Unit Price (B2B)</th>
                <th class="border-0 text-end">Subtotal</th>
              </tr>
            </thead>
            <tbody>
              <% @franchise_return.items.each do |item| %>
                <tr>
                  <td><%= item.product&.name || 'Deleted product' %></td>
                  <td class="text-end fw-semibold"><%= item.quantity.to_f.round(2) %></td>
                  <td class="text-end small text-muted">₹<%= number_with_delimiter(item.unit_price.to_f.round(2)) %></td>
                  <td class="text-end fw-semibold">₹<%= number_with_delimiter(item.subtotal.round(2)) %></td>
                </tr>
              <% end %>
            </tbody>
            <tfoot>
              <tr class="table-light">
                <th colspan="3" class="text-end">Total</th>
                <th class="text-end">₹<%= number_with_delimiter(@franchise_return.total_amount.to_f.round(2)) %></th>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </div>

    <% if @franchise_return.notes.present? %>
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-0">
          <h5 class="mb-0">Note</h5>
        </div>
        <div class="card-body">
          <%= simple_format(@franchise_return.notes) %>
        </div>
      </div>
    <% end %>

    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-transparent border-0">
        <h5 class="mb-0">Franchise Details</h5>
      </div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-sm-4">Mobile</dt>
          <dd class="col-sm-8"><%= @franchise_return.franchise.mobile.presence || '—' %></dd>

          <dt class="col-sm-4">Email</dt>
          <dd class="col-sm-8"><%= @franchise_return.franchise.email.presence || '—' %></dd>

          <dt class="col-sm-4">Address</dt>
          <dd class="col-sm-8"><%= @franchise_return.franchise.address.presence || '—' %></dd>

          <% if @franchise_return.franchise.franchise_wallet.present? %>
            <dt class="col-sm-4">Wallet Balance</dt>
            <dd class="col-sm-8"><%= @franchise_return.franchise.franchise_wallet.formatted_balance %></dd>
          <% end %>
        </dl>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-transparent border-0">
        <h5 class="mb-0">Actions</h5>
      </div>
      <div class="card-body">
        <% if @franchise_return.pending? %>
          <div class="alert alert-info small">
            <i class="bi bi-info-circle me-1"></i>
            Approving will add <%= pluralize(@franchise_return.total_quantity.to_f.round(2), 'unit') %> back to the
            main store's stock and credit
            <strong>₹<%= number_with_delimiter(@franchise_return.total_amount.to_f.round(2)) %></strong>
            to the franchise's wallet.
          </div>

          <%= form_with url: approve_admin_franchise_return_path(@franchise_return), method: :patch, local: true do |f| %>
            <%= f.submit "Approve Return", class: "btn btn-success w-100 mb-3",
                data: { confirm: "Approve this return? Stock will be credited back to the main store and the franchise wallet will be paid — this can't be undone." } %>
          <% end %>

          <%= form_with url: reject_admin_franchise_return_path(@franchise_return), method: :patch, local: true do |f| %>
            <div class="mb-2">
              <%= f.text_field :reason, class: "form-control", placeholder: "Reason for rejection (optional)" %>
            </div>
            <%= f.submit "Reject", class: "btn btn-outline-danger w-100",
                data: { confirm: "Reject this return?" } %>
          <% end %>
        <% elsif @franchise_return.approved? %>
          <p class="text-success mb-2">
            <i class="bi bi-check-circle-fill me-1"></i>Approved on <%= @franchise_return.reviewed_at&.strftime("%b %d, %Y") %>
            by <%= @franchise_return.reviewed_by&.email %>
          </p>
          <p class="text-muted small mb-0">
            Stock credited back to the main store and ₹<%= number_with_delimiter(@franchise_return.total_amount.to_f.round(2)) %>
            paid to the franchise wallet.
          </p>
        <% else %>
          <p class="text-danger mb-2"><i class="bi bi-x-circle-fill me-1"></i>Rejected on <%= @franchise_return.reviewed_at&.strftime("%b %d, %Y") %></p>
          <% if @franchise_return.rejection_reason.present? %>
            <p class="text-muted small mb-0">Reason: <%= @franchise_return.rejection_reason %></p>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
