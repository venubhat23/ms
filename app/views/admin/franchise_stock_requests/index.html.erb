<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1">Franchise Stock Requests</h2>
    <p class="text-muted mb-0">Review product requests from franchises and approve them into Franchise Bookings</p>
  </div>
</div>

<div class="row mb-4">
  <div class="col-md-3">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <h6 class="text-muted mb-1">Total</h6>
        <h4 class="mb-0"><%= @stats[:total] %></h4>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <h6 class="text-muted mb-1">Pending</h6>
        <h4 class="mb-0 text-warning"><%= @stats[:pending] %></h4>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <h6 class="text-muted mb-1">Approved</h6>
        <h4 class="mb-0 text-success"><%= @stats[:approved] %></h4>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <h6 class="text-muted mb-1">Rejected</h6>
        <h4 class="mb-0 text-danger"><%= @stats[:rejected] %></h4>
      </div>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm mb-4">
  <div class="card-body">
    <div class="row g-3">
      <div class="col-md-3">
        <select class="form-select" onchange="window.location.href='<%= admin_franchise_stock_requests_path %>?status=' + this.value">
          <option value="">All Status</option>
          <option value="pending" <%= 'selected' if params[:status] == 'pending' %>>Pending</option>
          <option value="approved" <%= 'selected' if params[:status] == 'approved' %>>Approved</option>
          <option value="rejected" <%= 'selected' if params[:status] == 'rejected' %>>Rejected</option>
        </select>
      </div>
      <div class="col-md-3">
        <%= link_to "Clear Filters", admin_franchise_stock_requests_path, class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <% if @stock_requests.any? %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th class="border-0">Franchise</th>
              <th class="border-0">Items</th>
              <th class="border-0">Requested</th>
              <th class="border-0">Status</th>
              <th class="border-0">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @stock_requests.each do |sr| %>
              <tr>
                <td class="align-middle">
                  <%= link_to sr.franchise.display_name, admin_franchise_path(sr.franchise) %>
                  <div class="small text-muted"><%= sr.franchise.mobile %></div>
                </td>
                <td class="align-middle"><%= pluralize(sr.items_count, 'item') %></td>
                <td class="align-middle small"><%= sr.created_at.strftime("%b %d, %Y") %></td>
                <td class="align-middle">
                  <% status_color = { 'pending' => 'warning', 'approved' => 'success', 'rejected' => 'danger' }[sr.status] %>
                  <span class="badge bg-<%= status_color %>"><%= sr.status.capitalize %></span>
                </td>
                <td class="align-middle">
                  <%= link_to "Manage", admin_franchise_stock_request_path(sr), class: "btn btn-sm btn-outline-primary" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @stock_requests.respond_to?(:total_pages) %>
        <div class="card-footer bg-transparent border-0">
          <%= paginate @stock_requests %>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-5">
        <i class="bi bi-box-seam fs-1 text-muted d-block mb-3"></i>
        <h5 class="text-muted">No stock requests</h5>
      </div>
    <% end %>
  </div>
</div>
