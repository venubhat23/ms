<% content_for :page_title, "Import Products with Variants" %>
<% content_for :page_subtitle, "Bulk Variant Product Import (Wide Format)" %>

<div class="container-fluid">
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="mb-1">
        <i class="fas fa-layer-group me-2"></i>
        Import Products with Variants
      </h2>
      <p class="text-muted mb-0">One row per product — up to 5 size/weight variants per row</p>
    </div>
    <div>
      <%= link_to admin_imports_path, class: "btn btn-outline-secondary" do %>
        <i class="fas fa-arrow-left me-1"></i>
        Back to Imports
      <% end %>
    </div>
  </div>

  <div class="row">
    <!-- Upload Form -->
    <div class="col-lg-8">
      <div class="card shadow-sm border-0">
        <div class="card-header bg-teal text-white">
          <h5 class="mb-0">
            <i class="fas fa-cloud-upload-alt me-2"></i>
            Upload Variant Product Data
          </h5>
        </div>
        <div class="card-body p-4">
          <%= form_with url: admin_import_products_variants_path, multipart: true, local: true, class: "needs-validation", novalidate: true do |f| %>
            <div class="mb-4">
              <label for="file" class="form-label fw-bold">
                <i class="fas fa-file-csv me-2"></i>
                Select CSV File
                <span class="text-danger">*</span>
              </label>
              <%= f.file_field :file,
                  class: "form-control form-control-lg",
                  accept: ".csv",
                  required: true,
                  id: "file" %>
              <div class="form-text">
                <i class="fas fa-info-circle me-1"></i>
                CSV format only. Each row = one product with up to 5 variants (weight1…weight5 columns). Maximum size: 10 MB.
              </div>
              <div class="invalid-feedback">
                Please select a CSV file to upload.
              </div>
            </div>

            <!-- File Preview Section -->
            <div id="file-preview" class="mb-4" style="display: none;">
              <div class="alert alert-info">
                <div class="d-flex align-items-center">
                  <i class="fas fa-file-check me-2"></i>
                  <div>
                    <strong>File Selected:</strong> <span id="file-name"></span><br>
                    <small>Size: <span id="file-size"></span></small>
                  </div>
                </div>
              </div>
            </div>

            <!-- Submit Button -->
            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
              <button type="submit" class="btn btn-teal btn-lg" id="submit-btn">
                <i class="fas fa-upload me-2"></i>
                Import Variant Products
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
      <!-- Download Template Card -->
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-success text-white">
          <h5 class="mb-0">
            <i class="fas fa-download me-2"></i>
            Download Template
          </h5>
        </div>
        <div class="card-body">
          <p class="card-text mb-3">
            Download the wide-format CSV template. Each row defines one product; up to 5 variants are specified inline as <code>weight1…weight5</code> columns.
          </p>
          <div class="d-grid">
            <%= link_to download_template_admin_imports_path(template_type: 'products_variants'),
                class: "btn btn-success",
                target: "_blank" do %>
              <i class="fas fa-file-csv me-2"></i>
              Download CSV Template
            <% end %>
          </div>
        </div>
      </div>

      <!-- Column Reference -->
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-info text-white">
          <h5 class="mb-0">
            <i class="fas fa-table me-2"></i>
            Column Reference
          </h5>
        </div>
        <div class="card-body p-3">
          <h6 class="text-danger mb-2">Required columns</h6>
          <ul class="list-unstyled small mb-3">
            <li><i class="fas fa-asterisk text-danger me-1" style="font-size:0.6rem;"></i> <code>name</code> — product name</li>
            <li><i class="fas fa-asterisk text-danger me-1" style="font-size:0.6rem;"></i> <code>category</code> — category name (auto-created if missing)</li>
            <li><i class="fas fa-asterisk text-danger me-1" style="font-size:0.6rem;"></i> <code>product_type</code> — Milk / Grocery / Fruit &amp; Vegetable</li>
            <li><i class="fas fa-asterisk text-danger me-1" style="font-size:0.6rem;"></i> <code>weight1</code>, <code>unit1</code>, <code>selling_price1</code>, <code>buying_price1</code>, <code>stock1</code></li>
          </ul>

          <h6 class="text-secondary mb-2">Optional product fields</h6>
          <ul class="list-unstyled small mb-3">
            <li><i class="fas fa-circle text-muted me-1" style="font-size:0.4rem;"></i> <code>status</code> — active (default) / inactive</li>
            <li><i class="fas fa-circle text-muted me-1" style="font-size:0.4rem;"></i> <code>description</code></li>
            <li><i class="fas fa-circle text-muted me-1" style="font-size:0.4rem;"></i> <code>is_subscription_enabled</code> — true / false</li>
            <li><i class="fas fa-circle text-muted me-1" style="font-size:0.4rem;"></i> <code>gst_enabled</code>, <code>gst_percentage</code>, <code>hsn_code</code></li>
            <li><i class="fas fa-circle text-muted me-1" style="font-size:0.4rem;"></i> <code>is_discounted</code>, <code>discount_type</code>, <code>discount_value</code></li>
            <li><i class="fas fa-circle text-muted me-1" style="font-size:0.4rem;"></i> <code>is_occasional_product</code></li>
          </ul>

          <h6 class="text-secondary mb-2">Variant columns (repeat for 2–5)</h6>
          <ul class="list-unstyled small mb-0">
            <li><i class="fas fa-circle text-muted me-1" style="font-size:0.4rem;"></i> <code>weight2</code>, <code>unit2</code>, <code>selling_price2</code>, <code>buying_price2</code>, <code>stock2</code></li>
            <li><i class="fas fa-circle text-muted me-1" style="font-size:0.4rem;"></i> <code>weight3</code> … <code>stock3</code></li>
            <li><i class="fas fa-circle text-muted me-1" style="font-size:0.4rem;"></i> <code>weight4</code> … <code>stock4</code></li>
            <li><i class="fas fa-circle text-muted me-1" style="font-size:0.4rem;"></i> <code>weight5</code> … <code>stock5</code></li>
            <li class="mt-2 text-muted" style="font-size:0.75rem;">Leave blank to skip a variant slot.</li>
          </ul>
        </div>
      </div>

      <!-- Example Preview -->
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-secondary text-white">
          <h5 class="mb-0">
            <i class="fas fa-eye me-2"></i>
            Sample Row
          </h5>
        </div>
        <div class="card-body p-3">
          <div class="table-responsive" style="font-size:0.7rem;">
            <table class="table table-bordered table-sm mb-1">
              <thead class="table-dark">
                <tr>
                  <th>name</th><th>category</th><th>product_type</th><th>status</th>
                  <th class="table-warning">weight1</th><th class="table-warning">unit1</th>
                  <th class="table-warning">selling_price1</th><th class="table-warning">buying_price1</th><th class="table-warning">stock1</th>
                  <th class="table-success">weight2</th><th class="table-success">unit2</th>
                  <th class="table-success">selling_price2</th><th class="table-success">buying_price2</th><th class="table-success">stock2</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Cow Milk</td><td>Dairy</td><td>Milk</td><td>active</td>
                  <td>0.5</td><td>Liter</td><td>32</td><td>22</td><td>200</td>
                  <td>1</td><td>Liter</td><td>60</td><td>42</td><td>150</td>
                </tr>
                <tr>
                  <td>Organic Honey</td><td>Grocery</td><td>Grocery</td><td>active</td>
                  <td>250</td><td>Gram</td><td>149</td><td>100</td><td>50</td>
                  <td>500</td><td>Gram</td><td>280</td><td>190</td><td>30</td>
                </tr>
              </tbody>
            </table>
          </div>
          <small class="text-muted">
            <i class="fas fa-lightbulb text-warning me-1"></i>
            The first variant is automatically set as the default. Units accepted: Kg, Gram, Liter, Bottle, Box, Piece.
          </small>
        </div>
      </div>

      <!-- Validation notes -->
      <div class="card shadow-sm border-0">
        <div class="card-header bg-warning text-dark">
          <h5 class="mb-0">
            <i class="fas fa-shield-alt me-2"></i>
            What gets validated
          </h5>
        </div>
        <div class="card-body">
          <ul class="list-unstyled small mb-0">
            <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i> name &amp; product_type are required per row</li>
            <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i> weight1 &amp; selling_price1 are required</li>
            <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i> Category auto-created if not found</li>
            <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i> SKU auto-generated from name</li>
            <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i> Duplicate variants (same weight+unit) skipped on existing products</li>
            <li class="mb-0"><i class="fas fa-check-circle text-success me-2"></i> Invalid unit values default to Kg</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.form-control[type="file"] {
  border: 2px dashed #dee2e6;
  background-color: #f8f9fa;
  padding: 1rem;
  transition: all 0.3s ease;
}
.form-control[type="file"]:hover {
  border-color: #17a2b8;
  background-color: #e3f2fd;
}
.bg-teal { background-color: #17a2b8 !important; }
.btn-teal { background-color: #17a2b8; border-color: #17a2b8; color: white; }
.btn-teal:hover { background-color: #138496; border-color: #138496; color: white; }
.card { transition: all 0.3s ease; }
.card:hover { transform: translateY(-2px); box-shadow: 0 4px 8px rgba(0,0,0,0.1) !important; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const fileInput = document.getElementById('file');
  const filePreview = document.getElementById('file-preview');
  const fileName = document.getElementById('file-name');
  const fileSize = document.getElementById('file-size');
  const form = document.querySelector('form');
  const submitBtn = document.getElementById('submit-btn');

  fileInput.addEventListener('change', function(e) {
    const file = e.target.files[0];
    if (file) {
      filePreview.style.display = 'block';
      fileName.textContent = file.name;
      fileSize.textContent = formatFileSize(file.size);
      fileInput.classList.add('is-valid');
    } else {
      filePreview.style.display = 'none';
      fileInput.classList.remove('is-valid');
    }
  });

  form.addEventListener('submit', function(e) {
    if (!form.checkValidity()) { e.preventDefault(); e.stopPropagation(); }
    form.classList.add('was-validated');
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Importing…';
  });

  function formatFileSize(bytes) {
    if (bytes === 0) return '0 Bytes';
    const k = 1024, sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
  }
});
</script>
