<% content_for :title, 'POS - Current Cash Stock' %>
<%= render 'admin/pos/styles' %>
<% inr = ->(v) { "₹#{number_with_precision(v.to_d, precision: 2, delimiter: ",", strip_insignificant_zeros: true)}" } %>

<div class="container-fluid">
  <!-- Page Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
      <h2 class="mb-1"><i class="bi bi-safe2 me-2 text-primary"></i>Current Cash Stock</h2>
      <p class="text-muted mb-0">Cash each shop is holding now: cash collected minus what was deposited to the bank</p>
    </div>
    <%= link_to admin_pos_path, class: 'btn btn-outline-secondary' do %>
      <i class="bi bi-arrow-left me-1"></i>Cash Collected
    <% end %>
  </div>

  <!-- Statistics Cards -->
  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-3 d-flex align-items-center">
          <div class="flex-grow-1">
            <h6 class="text-muted mb-1">Cash Collected (all time)</h6>
            <h4 class="mb-0"><%= inr.(@totals[:collected]) %></h4>
          </div>
          <span class="pos-stat-icon pos-soft-primary"><i class="bi bi-cash-stack"></i></span>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-3 d-flex align-items-center">
          <div class="flex-grow-1">
            <h6 class="text-muted mb-1">Deposited to Bank</h6>
            <h4 class="mb-0 text-info"><%= inr.(@totals[:deposited]) %></h4>
          </div>
          <span class="pos-stat-icon pos-soft-info"><i class="bi bi-bank"></i></span>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-3 d-flex align-items-center">
          <div class="flex-grow-1">
            <h6 class="text-muted mb-1">Cash in Hand Now</h6>
            <h4 class="mb-0 text-success"><%= inr.(@totals[:in_hand]) %></h4>
          </div>
          <span class="pos-stat-icon pos-soft-success"><i class="bi bi-wallet2"></i></span>
        </div>
      </div>
    </div>
  </div>

  <!-- By shop -->
  <h5 class="mb-2">By Shop</h5>
  <div class="row g-3 mb-4">
    <% @rows.each do |row| %>
      <% banked = row[:collected].positive? ? (row[:deposited] / row[:collected] * 100).round.clamp(0, 100) : 0 %>
      <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body p-3 d-flex flex-column">
            <div class="d-flex align-items-center gap-2 mb-3">
              <span class="pos-stat-icon pos-soft-primary" style="width:36px;height:36px;font-size:1rem;"><i class="bi <%= row[:id] ? 'bi-shop' : 'bi-building' %>"></i></span>
              <span class="fw-semibold text-truncate"><%= row[:name] %></span>
            </div>
            <h6 class="text-muted mb-1">Cash in Hand</h6>
            <div class="pos-shop-amount text-success mb-2"><%= inr.(row[:in_hand]) %></div>
            <div class="d-flex justify-content-between small text-muted">
              <span>Collected</span><span class="fw-semibold text-dark"><%= inr.(row[:collected]) %></span>
            </div>
            <div class="d-flex justify-content-between small text-muted mb-2">
              <span>Deposited</span><span class="fw-semibold text-info"><%= inr.(row[:deposited]) %></span>
            </div>
            <div class="pos-share mb-1"><div style="width: <%= banked %>%;"></div></div>
            <small class="text-muted"><%= banked %>% banked</small>
            <div class="mt-auto pt-3">
              <button type="button"
                      class="btn btn-success btn-sm w-100"
                      data-bs-toggle="modal"
                      data-bs-target="#posDepositModal"
                      data-store-key="<%= row[:key] %>"
                      data-store-name="<%= row[:name] %>"
                      data-in-hand="<%= row[:in_hand].round(2).to_s('F') %>"
                      <%= 'disabled' unless row[:in_hand] > 0 %>>
                <i class="bi bi-bank me-1"></i>Deposit to Bank
              </button>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Deposit history -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent border-0 pt-3">
      <h5 class="mb-3"><i class="bi bi-clock-history me-1"></i>Bank Deposit History</h5>
      <div class="d-flex flex-wrap gap-2">
        <%= link_to 'All shops', admin_pos_cash_stock_path, class: "btn btn-sm #{@history_store ? 'btn-outline-primary' : 'btn-primary'}" %>
        <% @rows.each do |row| %>
          <%= link_to row[:name], admin_pos_cash_stock_path(store: row[:key]), class: "btn btn-sm #{@history_store == row[:key] ? 'btn-primary' : 'btn-outline-primary'}" %>
        <% end %>
      </div>
    </div>
    <div class="card-body p-0 mt-2">
      <% if @deposits.any? %>
        <div class="table-responsive">
          <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
              <tr>
                <th class="border-0 fw-semibold">Date</th>
                <th class="border-0 fw-semibold">Shop</th>
                <th class="border-0 fw-semibold text-end">Amount</th>
                <th class="border-0 fw-semibold">Bank</th>
                <th class="border-0 fw-semibold">Reference</th>
                <th class="border-0 fw-semibold">Notes</th>
                <th class="border-0 fw-semibold">By</th>
                <th class="border-0 fw-semibold text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @deposits.each do |d| %>
                <tr>
                  <td class="text-nowrap"><%= d.deposited_on.strftime('%d %b %Y') %></td>
                  <td><span class="badge bg-light text-dark border"><%= d.store_label %></span></td>
                  <td class="text-end fw-semibold text-info"><%= inr.(d.amount) %></td>
                  <td><%= d.bank_name.presence || '—' %></td>
                  <td><%= d.reference_number.presence || '—' %></td>
                  <td class="small"><%= d.notes.presence || '—' %></td>
                  <td class="small text-muted"><%= d.created_by&.email || '—' %></td>
                  <td class="text-end">
                    <%= button_to admin_pos_deposit_path(d), method: :delete, class: 'btn btn-sm btn-outline-danger',
                          title: 'Remove this deposit (the cash goes back to the shop)',
                          form: { data: { turbo: false }, onsubmit: "return confirm('Remove this deposit of #{inr.(d.amount)} from #{j d.store_label}? The amount goes back into that shop\\'s cash in hand.');" } do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="pos-empty"><i class="bi bi-bank fs-1 d-block mb-2 opacity-50"></i>No bank deposits yet.</div>
      <% end %>
    </div>
  </div>
</div>

<%# One modal for every shop; the Deposit button that opens it fills in the shop. %>
<div class="modal fade" id="posDepositModal" tabindex="-1" aria-labelledby="posDepositModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius:16px;">
      <%= form_with model: @deposit, url: admin_pos_deposits_path, method: :post, local: true, data: { turbo: false }, id: 'posDepositForm' do |f| %>
        <div class="modal-header">
          <h5 class="modal-title" id="posDepositModalLabel"><i class="bi bi-bank me-2"></i>Deposit cash to bank</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" name="cash_deposit[store_key]" id="posDepositStoreKey">
          <div class="pos-modal-balance mb-3">
            <div class="fw-semibold mb-2"><i class="bi bi-shop me-1"></i><span id="posDepositStoreName"></span></div>
            <div class="row text-center g-2">
              <div class="col-6">
                <small>Cash in hand</small>
                <div class="fw-bold" id="posDepositInHand">₹0</div>
              </div>
              <div class="col-6">
                <small>Remaining after deposit</small>
                <div class="fw-bold text-success" id="posDepositRemaining">₹0</div>
              </div>
            </div>
          </div>

          <div class="mb-3">
            <%= f.label :amount, 'Amount to deposit (₹)', class: 'form-label fw-semibold' %>
            <div class="input-group">
              <span class="input-group-text">₹</span>
              <%= f.number_field :amount, class: 'form-control', step: '0.01', min: '0.01', required: true, id: 'posDepositAmount', placeholder: '0.00' %>
              <button type="button" class="btn btn-outline-secondary" id="posDepositAll">All</button>
            </div>
            <div class="text-danger small mt-1 d-none" id="posDepositError"></div>
          </div>
          <div class="row g-2">
            <div class="col-sm-6 mb-3">
              <%= f.label :deposited_on, 'Deposit date', class: 'form-label fw-semibold' %>
              <%= f.date_field :deposited_on, class: 'form-control', required: true, max: Date.current %>
            </div>
            <div class="col-sm-6 mb-3">
              <%= f.label :bank_name, 'Bank', class: 'form-label fw-semibold' %>
              <%= f.text_field :bank_name, class: 'form-control', placeholder: 'e.g. SBI' %>
            </div>
          </div>
          <div class="mb-3">
            <%= f.label :reference_number, 'Reference / slip no.', class: 'form-label fw-semibold' %>
            <%= f.text_field :reference_number, class: 'form-control', placeholder: 'Optional' %>
          </div>
          <div class="mb-1">
            <%= f.label :notes, class: 'form-label fw-semibold' %>
            <%= f.text_area :notes, class: 'form-control', rows: 2, placeholder: 'Optional' %>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success" id="posDepositSubmit"><i class="bi bi-check2-circle me-1"></i>Confirm deposit</button>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
(function () {
  const modal = document.getElementById('posDepositModal');
  if (!modal) return;
  // Bootstrap modals must sit directly under <body> to stack above the admin layout.
  if (modal.parentElement !== document.body) document.body.appendChild(modal);

  const amountInput = document.getElementById('posDepositAmount');
  const errorBox = document.getElementById('posDepositError');
  const submitBtn = document.getElementById('posDepositSubmit');
  let inHand = 0;

  const inr = (v) => '₹' + Number(v).toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 2 });

  function refresh() {
    const amount = parseFloat(amountInput.value) || 0;
    const remaining = Math.round((inHand - amount) * 100) / 100;
    document.getElementById('posDepositRemaining').textContent = inr(Math.max(remaining, 0));
    let msg = '';
    if (amount > inHand) msg = 'Amount is more than the cash in hand (' + inr(inHand) + ').';
    errorBox.textContent = msg;
    errorBox.classList.toggle('d-none', !msg);
    amountInput.classList.toggle('is-invalid', !!msg);
    submitBtn.disabled = !!msg || amount <= 0;
  }

  modal.addEventListener('show.bs.modal', function (event) {
    const btn = event.relatedTarget;
    if (!btn) return;
    inHand = parseFloat(btn.dataset.inHand) || 0;
    document.getElementById('posDepositStoreKey').value = btn.dataset.storeKey;
    document.getElementById('posDepositStoreName').textContent = btn.dataset.storeName;
    document.getElementById('posDepositInHand').textContent = inr(inHand);
    amountInput.max = inHand;
    amountInput.value = '';
    refresh();
  });
  modal.addEventListener('shown.bs.modal', () => amountInput.focus());
  amountInput.addEventListener('input', refresh);
  document.getElementById('posDepositAll').addEventListener('click', function () {
    amountInput.value = inHand;
    refresh();
  });
  document.getElementById('posDepositForm').addEventListener('submit', function () {
    submitBtn.disabled = true;
  });
})();
</script>
