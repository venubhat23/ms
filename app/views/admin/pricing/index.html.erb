<style>
  .pricing-page {
    background: linear-gradient(135deg, #f0f4ff 0%, #faf5ff 50%, #f0fdf4 100%);
    min-height: 100vh;
    padding: 24px;
  }

  .pricing-header {
    background: linear-gradient(135deg, #1e293b 0%, #312e81 50%, #1e3a5f 100%);
    border-radius: 20px;
    padding: 28px 32px;
    margin-bottom: 28px;
    color: white;
    box-shadow: 0 20px 40px rgba(30, 41, 59, 0.3);
    position: relative;
    overflow: hidden;
  }

  .pricing-header::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -10%;
    width: 300px;
    height: 300px;
    background: rgba(139, 92, 246, 0.15);
    border-radius: 50%;
  }

  .pricing-header::after {
    content: '';
    position: absolute;
    bottom: -30%;
    right: 10%;
    width: 200px;
    height: 200px;
    background: rgba(59, 130, 246, 0.1);
    border-radius: 50%;
  }

  .pricing-header h1 {
    font-size: 1.8rem;
    font-weight: 700;
    margin: 0 0 6px;
    position: relative;
    z-index: 1;
  }

  .pricing-header p {
    color: rgba(255,255,255,0.7);
    margin: 0;
    font-size: 0.9rem;
    position: relative;
    z-index: 1;
  }

  .summary-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
    margin-bottom: 28px;
  }

  .summary-card {
    background: white;
    border-radius: 16px;
    padding: 20px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    border: 1px solid rgba(226, 232, 240, 0.8);
    display: flex;
    align-items: center;
    gap: 14px;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .summary-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(0,0,0,0.1);
  }

  .summary-card .icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    flex-shrink: 0;
  }

  .summary-card .card-value {
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 3px;
  }

  .summary-card .card-label {
    font-size: 0.75rem;
    color: #64748b;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .category-section {
    margin-bottom: 28px;
  }

  .category-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
    padding: 14px 20px;
    background: white;
    border-radius: 14px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    border-left: 4px solid;
  }

  .category-header .cat-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
  }

  .category-header h3 {
    font-size: 1rem;
    font-weight: 700;
    margin: 0;
    color: #1e293b;
  }

  .category-header .cat-meta {
    margin-left: auto;
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .cat-badge {
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .pricing-table-wrap {
    background: white;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    border: 1px solid rgba(226, 232, 240, 0.8);
  }

  .pricing-table {
    width: 100%;
    border-collapse: collapse;
  }

  .pricing-table thead {
    background: linear-gradient(135deg, #f8fafc, #f1f5f9);
    border-bottom: 2px solid #e2e8f0;
  }

  .pricing-table thead th {
    padding: 12px 16px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.7px;
    color: #64748b;
    text-align: left;
    white-space: nowrap;
  }

  .pricing-table thead th:last-child,
  .pricing-table thead th:nth-child(3),
  .pricing-table thead th:nth-child(4),
  .pricing-table thead th:nth-child(5) {
    text-align: right;
  }

  .pricing-table tbody tr {
    border-bottom: 1px solid #f1f5f9;
    transition: background 0.15s;
  }

  .pricing-table tbody tr:last-child {
    border-bottom: none;
  }

  .pricing-table tbody tr:hover {
    background: linear-gradient(135deg, rgba(59,130,246,0.03), rgba(139,92,246,0.03));
  }

  .pricing-table tbody tr.in-stock-row {
    background: rgba(240, 253, 244, 0.5);
  }

  .pricing-table tbody tr.out-of-stock-row {
    background: rgba(255, 241, 242, 0.3);
    opacity: 0.75;
  }

  .pricing-table tbody td {
    padding: 13px 16px;
    font-size: 0.85rem;
    color: #374151;
    vertical-align: middle;
  }

  .pricing-table tbody td:nth-child(3),
  .pricing-table tbody td:nth-child(4),
  .pricing-table tbody td:nth-child(5) {
    text-align: right;
    font-family: 'Courier New', monospace;
    font-weight: 600;
  }

  .product-name-cell {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .product-avatar {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 700;
    color: white;
    flex-shrink: 0;
  }

  .product-name {
    font-weight: 600;
    color: #1e293b;
    font-size: 0.85rem;
  }

  .stock-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .stock-badge.in-stock {
    background: linear-gradient(135deg, #dcfce7, #bbf7d0);
    color: #166534;
    border: 1px solid #86efac;
  }

  .stock-badge.low-stock {
    background: linear-gradient(135deg, #fef9c3, #fef08a);
    color: #854d0e;
    border: 1px solid #fde047;
  }

  .stock-badge.out-of-stock {
    background: linear-gradient(135deg, #fee2e2, #fecaca);
    color: #991b1b;
    border: 1px solid #fca5a5;
  }

  .selling-price {
    color: #1e40af;
    font-size: 0.9rem;
  }

  .cost-price {
    color: #7c3aed;
  }

  .profit-positive {
    color: #15803d;
  }

  .profit-negative {
    color: #dc2626;
  }

  .profit-neutral {
    color: #6b7280;
  }

  .in-stock-divider {
    background: linear-gradient(90deg, #22c55e, #16a34a);
    height: 2px;
    margin: 0;
    opacity: 0.4;
  }

  .no-cost-price {
    color: #9ca3af;
    font-style: italic;
    font-size: 0.78rem;
    font-family: inherit;
    font-weight: 400;
  }

  .color-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
  }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
    color: #94a3b8;
  }

  .empty-state i {
    font-size: 3rem;
    margin-bottom: 12px;
    display: block;
  }

  @media (max-width: 768px) {
    .pricing-page { padding: 12px; }
    .summary-cards { grid-template-columns: 1fr 1fr; }
    .pricing-table thead th:nth-child(4) { display: none; }
    .pricing-table tbody td:nth-child(4) { display: none; }
  }
</style>

<% content_for :title, "Pricing Overview" %>

<div class="pricing-page">
  <%# Header %>
  <div class="pricing-header">
    <h1><i class="bi bi-tags-fill me-2"></i>Pricing Overview</h1>
    <p>Category-wise selling price, cost price &amp; stock availability</p>
  </div>

  <%# Summary Cards %>
  <%
    all_products = @categories_with_products.flat_map { |_, prods| prods }
    total_products   = all_products.size
    in_stock_count   = all_products.count { |p| p.stock.to_f > 0 }
    out_stock_count  = total_products - in_stock_count
    total_categories = @categories_with_products.size
  %>
  <div class="summary-cards">
    <div class="summary-card">
      <div class="icon-wrap" style="background: linear-gradient(135deg,#dbeafe,#bfdbfe);">
        <i class="bi bi-grid-3x3-gap-fill" style="color:#1d4ed8;"></i>
      </div>
      <div>
        <div class="card-value" style="color:#1d4ed8;"><%= total_categories %></div>
        <div class="card-label">Categories</div>
      </div>
    </div>
    <div class="summary-card">
      <div class="icon-wrap" style="background: linear-gradient(135deg,#f3e8ff,#e9d5ff);">
        <i class="bi bi-box-seam-fill" style="color:#7c3aed;"></i>
      </div>
      <div>
        <div class="card-value" style="color:#7c3aed;"><%= total_products %></div>
        <div class="card-label">Total Products</div>
      </div>
    </div>
    <div class="summary-card">
      <div class="icon-wrap" style="background: linear-gradient(135deg,#dcfce7,#bbf7d0);">
        <i class="bi bi-check-circle-fill" style="color:#16a34a;"></i>
      </div>
      <div>
        <div class="card-value" style="color:#16a34a;"><%= in_stock_count %></div>
        <div class="card-label">In Stock</div>
      </div>
    </div>
    <div class="summary-card">
      <div class="icon-wrap" style="background: linear-gradient(135deg,#fee2e2,#fecaca);">
        <i class="bi bi-exclamation-circle-fill" style="color:#dc2626;"></i>
      </div>
      <div>
        <div class="card-value" style="color:#dc2626;"><%= out_stock_count %></div>
        <div class="card-label">Out of Stock</div>
      </div>
    </div>
  </div>

  <%# Category wise tables %>
  <% if @categories_with_products.empty? %>
    <div class="pricing-table-wrap">
      <div class="empty-state">
        <i class="bi bi-tags"></i>
        <p>No active products found.</p>
      </div>
    </div>
  <% end %>

  <%
    category_colors = [
      { bg: '#dbeafe', border: '#3b82f6', icon_bg: 'linear-gradient(135deg,#3b82f6,#1d4ed8)', text_color: '#1d4ed8', avatar_bg: '#3b82f6' },
      { bg: '#f3e8ff', border: '#8b5cf6', icon_bg: 'linear-gradient(135deg,#8b5cf6,#6d28d9)', text_color: '#6d28d9', avatar_bg: '#8b5cf6' },
      { bg: '#dcfce7', border: '#22c55e', icon_bg: 'linear-gradient(135deg,#22c55e,#15803d)', text_color: '#15803d', avatar_bg: '#22c55e' },
      { bg: '#fff7ed', border: '#f97316', icon_bg: 'linear-gradient(135deg,#f97316,#c2410c)', text_color: '#c2410c', avatar_bg: '#f97316' },
      { bg: '#fef9c3', border: '#eab308', icon_bg: 'linear-gradient(135deg,#eab308,#a16207)', text_color: '#a16207', avatar_bg: '#eab308' },
      { bg: '#fce7f3', border: '#ec4899', icon_bg: 'linear-gradient(135deg,#ec4899,#be185d)', text_color: '#be185d', avatar_bg: '#ec4899' },
    ]
    color_idx = 0
  %>

  <% @categories_with_products.each do |category_name, products| %>
    <% color = category_colors[color_idx % category_colors.size] %>
    <% color_idx += 1 %>
    <% cat_in_stock = products.count { |p| p.stock.to_f > 0 } %>
    <% cat_out = products.size - cat_in_stock %>

    <div class="category-section">
      <div class="category-header" style="border-color:<%= color[:border] %>; background: linear-gradient(135deg, white, <%= color[:bg] %>10);">
        <div class="cat-icon" style="background:<%= color[:icon_bg] %>;">
          <i class="bi bi-folder-fill" style="color:white;"></i>
        </div>
        <h3 style="color:<%= color[:text_color] %>;"><%= category_name %></h3>
        <div class="cat-meta">
          <% if cat_in_stock > 0 %>
            <span class="cat-badge" style="background:#dcfce7; color:#15803d; border:1px solid #86efac;">
              <i class="bi bi-check-circle-fill me-1"></i><%= cat_in_stock %> In Stock
            </span>
          <% end %>
          <% if cat_out > 0 %>
            <span class="cat-badge" style="background:#fee2e2; color:#991b1b; border:1px solid #fca5a5;">
              <i class="bi bi-x-circle-fill me-1"></i><%= cat_out %> Out
            </span>
          <% end %>
          <span class="cat-badge" style="background:<%= color[:bg] %>; color:<%= color[:text_color] %>; border:1px solid <%= color[:border] %>25;">
            <%= products.size %> products
          </span>
        </div>
      </div>

      <div class="pricing-table-wrap">
        <table class="pricing-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Product Name</th>
              <th>Selling Price</th>
              <th>Cost Price</th>
              <th>Profit</th>
              <th>Stock Qty</th>
              <th>Availability</th>
            </tr>
          </thead>
          <tbody>
            <%
              in_stock_prods  = products.select { |p| p.stock.to_f > 0 }
              out_stock_prods = products.select { |p| p.stock.to_f <= 0 }
              row_idx = 0
            %>

            <% in_stock_prods.each do |product| %>
              <% row_idx += 1 %>
              <% stock_qty = product.stock.to_f %>
              <% selling = product.price.to_f %>
              <% cost    = product.buying_price.to_f %>
              <% profit  = cost > 0 ? (selling - cost) : nil %>
              <tr class="in-stock-row">
                <td style="color:#94a3b8; font-size:0.78rem;"><%= row_idx %></td>
                <td>
                  <div class="product-name-cell">
                    <div class="product-avatar" style="background:<%= color[:avatar_bg] %>;">
                      <%= product.name.first(2).upcase %>
                    </div>
                    <span class="product-name"><%= product.name %></span>
                  </div>
                </td>
                <td class="selling-price">₹<%= number_with_precision(selling, precision: 2) %></td>
                <td class="cost-price">
                  <% if cost > 0 %>
                    ₹<%= number_with_precision(cost, precision: 2) %>
                  <% else %>
                    <span class="no-cost-price">Not set</span>
                  <% end %>
                </td>
                <td>
                  <% if profit %>
                    <% if profit > 0 %>
                      <span class="profit-positive">+₹<%= number_with_precision(profit, precision: 2) %></span>
                    <% elsif profit < 0 %>
                      <span class="profit-negative">₹<%= number_with_precision(profit, precision: 2) %></span>
                    <% else %>
                      <span class="profit-neutral">₹0.00</span>
                    <% end %>
                  <% else %>
                    <span class="no-cost-price">—</span>
                  <% end %>
                </td>
                <td style="text-align:right; color:#1e293b;">
                  <strong><%= number_with_precision(stock_qty, precision: stock_qty == stock_qty.to_i ? 0 : 2) %></strong>
                </td>
                <td>
                  <% if stock_qty > 10 %>
                    <span class="stock-badge in-stock"><i class="bi bi-circle-fill" style="font-size:6px;"></i> In Stock</span>
                  <% elsif stock_qty > 0 %>
                    <span class="stock-badge low-stock"><i class="bi bi-exclamation-triangle-fill" style="font-size:9px;"></i> Low Stock</span>
                  <% end %>
                </td>
              </tr>
            <% end %>

            <% if in_stock_prods.any? && out_stock_prods.any? %>
              <tr><td colspan="7" style="padding:0;"><div class="in-stock-divider"></div></td></tr>
            <% end %>

            <% out_stock_prods.each do |product| %>
              <% row_idx += 1 %>
              <% selling = product.price.to_f %>
              <% cost    = product.buying_price.to_f %>
              <% profit  = cost > 0 ? (selling - cost) : nil %>
              <tr class="out-of-stock-row">
                <td style="color:#94a3b8; font-size:0.78rem;"><%= row_idx %></td>
                <td>
                  <div class="product-name-cell">
                    <div class="product-avatar" style="background:#94a3b8;">
                      <%= product.name.first(2).upcase %>
                    </div>
                    <span class="product-name" style="color:#94a3b8;"><%= product.name %></span>
                  </div>
                </td>
                <td class="selling-price" style="color:#94a3b8;">₹<%= number_with_precision(selling, precision: 2) %></td>
                <td style="color:#94a3b8; text-align:right; font-family:'Courier New',monospace; font-weight:600;">
                  <% if cost > 0 %>
                    ₹<%= number_with_precision(cost, precision: 2) %>
                  <% else %>
                    <span class="no-cost-price">Not set</span>
                  <% end %>
                </td>
                <td>
                  <% if profit %>
                    <span style="color:#94a3b8; font-family:'Courier New',monospace; font-weight:600;">₹<%= number_with_precision(profit, precision: 2) %></span>
                  <% else %>
                    <span class="no-cost-price">—</span>
                  <% end %>
                </td>
                <td style="text-align:right; color:#94a3b8;"><strong>0</strong></td>
                <td>
                  <span class="stock-badge out-of-stock"><i class="bi bi-x-circle-fill" style="font-size:9px;"></i> Out of Stock</span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>
