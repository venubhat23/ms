<style>
  .split-product-row { transition: background-color .15s ease; }
  .split-product-row:hover { background-color: #fafbfc; }

  .split-variant-table tbody tr { transition: background-color .15s ease; }
  .split-variant-table tbody tr:hover { background-color: #f8f9fa; }

  .btn-transfer-gradient {
    background: linear-gradient(135deg, #0ea5e9, #22c55e);
    border: none;
    color: #fff;
    box-shadow: 0 2px 10px rgba(14, 165, 233, .25);
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .btn-transfer-gradient:hover {
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(14, 165, 233, .35);
  }

  .transfer-modal-header {
    background: linear-gradient(135deg, #0ea5e9, #22c55e);
    color: #fff;
    border-bottom: none;
  }
  .transfer-modal-header .btn-close { filter: brightness(0) invert(1); opacity: .85; }
  .transfer-modal-header .modal-title small { color: rgba(255,255,255,.85); }

  .transfer-section-label {
    display: flex;
    align-items: center;
    gap: .5rem;
    font-weight: 600;
    letter-spacing: .03em;
  }
  .transfer-icon-circle {
    width: 26px; height: 26px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: .8rem; flex-shrink: 0;
  }
  .transfer-icon-circle.from { background: linear-gradient(135deg, #fb7185, #ef4444); }
  .transfer-icon-circle.to { background: linear-gradient(135deg, #34d399, #059669); }

  .transfer-row {
    border: 1px solid #e9ecef;
    border-radius: .6rem;
    padding: .6rem;
    background: #fff;
    transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease;
    animation: rowIn .25s ease;
  }
  .transfer-row:hover { border-color: #7dd3fc; box-shadow: 0 2px 10px rgba(14, 165, 233, .08); }
  @keyframes rowIn { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }

  .add-row-btn {
    border: 1.5px dashed #cbd5e1;
    border-radius: .5rem;
    color: #0ea5e9;
    font-weight: 500;
    transition: all .15s ease;
  }
  .add-row-btn:hover { border-color: #0ea5e9; background: #f0f9ff; color: #0284c7; }

  .balance-scale {
    border-radius: .75rem;
    padding: 1rem 1.25rem;
    background: #f8f9fa;
    border: 1px solid #e9ecef;
    transition: background .3s ease, border-color .3s ease;
  }
  .balance-scale.is-balanced { background: linear-gradient(135deg, #ecfdf5, #f0fdf4); border-color: #86efac; }
  .balance-scale.is-mismatched { background: linear-gradient(135deg, #fef2f2, #fff1f2); border-color: #fca5a5; }

  .balance-bar-track {
    height: 10px;
    border-radius: 6px;
    background: #e9ecef;
    overflow: hidden;
  }
  .balance-bar-fill {
    height: 100%;
    border-radius: 6px;
    width: 0%;
    transition: width .35s cubic-bezier(.4,0,.2,1), background-color .3s ease;
  }
  .balance-bar-fill.from-bar { background: linear-gradient(90deg, #fb7185, #ef4444); }
  .balance-bar-fill.to-bar { background: linear-gradient(90deg, #34d399, #059669); }

  .balance-icon-wrap {
    width: 48px; height: 48px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem;
  }
  .balance-icon-wrap.pop { animation: balancePop .4s cubic-bezier(.34,1.56,.64,1); }
  @keyframes balancePop { 0% { transform: scale(.4); opacity: 0; } 60% { transform: scale(1.2); } 100% { transform: scale(1); opacity: 1; } }

  /* Loading overlay shown while the transfer form submits */
  .transfer-loading-overlay {
    position: absolute;
    inset: 0;
    background: rgba(255,255,255,.92);
    backdrop-filter: blur(1px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity .2s ease;
    z-index: 20;
    border-radius: .5rem;
  }
  .transfer-loading-overlay.active { opacity: 1; pointer-events: all; }
  .dual-ring-loader {
    width: 56px; height: 56px;
    border-radius: 50%;
    border: 4px solid #e9ecef;
    border-top-color: #0ea5e9;
    border-bottom-color: #22c55e;
    animation: spin .8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .transfer-loading-overlay p {
    margin-top: 1rem;
    margin-bottom: 0;
    font-weight: 600;
    color: #334155;
    animation: pulseText 1.4s ease-in-out infinite;
  }
  @keyframes pulseText { 0%, 100% { opacity: .6; } 50% { opacity: 1; } }
</style>

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1">Product Split</h2>
    <p class="text-muted mb-0">Products, their variant packs, and available stock in store</p>
  </div>
</div>

<!-- Search -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body">
    <%= form_with url: admin_product_splits_path, method: :get, local: true do %>
      <div class="input-group">
        <span class="input-group-text bg-white border-end-0">
          <i class="bi bi-search"></i>
        </span>
        <input type="text" name="search" class="form-control border-start-0" placeholder="Search products..." value="<%= params[:search] %>">
        <%= submit_tag "Search", class: "btn btn-primary" %>
        <% if params[:search].present? %>
          <%= link_to "Clear", admin_product_splits_path, class: "btn btn-outline-secondary" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<!-- Products & Variant Stock -->
<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <% if @products.any? %>
      <% @products.each do |product| %>
        <% total_stock = product.available_quantity %>
        <% variants = product.product_variants.sort_by { |v| v.weight.to_f } %>
        <% variant_total = variants.sum { |v| v.available_stock.to_f } %>
        <% mismatch = product.has_multiple_quantities? && variants.any? && variant_total.round(3) != total_stock.round(3) %>

        <div class="border-bottom p-3 split-product-row">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-box-seam-fill text-primary fs-5"></i>
              <div>
                <h6 class="mb-0"><%= product.name %></h6>
                <small class="text-muted">SKU: <%= product.sku %></small>
              </div>
            </div>
            <div class="text-end">
              <span class="badge bg-primary-subtle text-primary fs-6 px-3 py-2">
                Total Stock: <%= number_with_precision(total_stock, precision: 2, strip_insignificant_zeros: true) %> <%= product.unit_type %>
              </span>
              <% if mismatch %>
                <span class="badge bg-danger-subtle text-danger ms-2" title="Variant stock does not add up to total stock">
                  <i class="bi bi-exclamation-triangle-fill"></i> Mismatch
                </span>
              <% end %>
            </div>
          </div>

          <% if variants.any? %>
            <div class="table-responsive mt-3">
              <table class="table table-sm table-borderless align-middle mb-0 split-variant-table">
                <thead>
                  <tr class="text-muted small text-uppercase">
                    <th style="width: 40%">Variant</th>
                    <th>Unit</th>
                    <th>Available Stock</th>
                    <th>Selling Price</th>
                  </tr>
                </thead>
                <tbody>
                  <% variants.each do |variant| %>
                    <tr>
                      <td class="ps-4">
                        <i class="bi bi-arrow-return-right text-muted me-1"></i>
                        <%= variant.weight %> <%= variant.unit %>
                        <% if variant.is_default? %>
                          <span class="badge bg-secondary-subtle text-secondary ms-1">Default</span>
                        <% end %>
                      </td>
                      <td><%= variant.unit %></td>
                      <td>
                        <span class="badge <%= variant.available_stock.to_f > 0 ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger' %>">
                          <%= number_with_precision(variant.available_stock, precision: 2, strip_insignificant_zeros: true) %>
                        </span>
                      </td>
                      <td>&#8377;<%= number_with_precision(variant.selling_price, precision: 2, strip_insignificant_zeros: true) %></td>
                    </tr>
                  <% end %>
                  <tr class="border-top">
                    <td class="ps-4 fw-semibold" colspan="2">Sum of variants</td>
                    <td colspan="2" class="fw-semibold">
                      <%= number_with_precision(variant_total, precision: 2, strip_insignificant_zeros: true) %>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-muted small mt-2 ps-4">No variants — sold as a single unit.</div>
          <% end %>

          <% if variants.size >= 2 %>
            <button type="button" class="btn btn-sm btn-transfer-gradient mt-3" data-bs-toggle="modal" data-bs-target="#transferModal-<%= product.id %>">
              <i class="bi bi-arrow-left-right me-1"></i> Transfer / Split Stock
            </button>

            <div class="modal fade" id="transferModal-<%= product.id %>" tabindex="-1" aria-hidden="true">
              <div class="modal-dialog modal-lg">
                <div class="modal-content position-relative">
                  <%= form_with url: admin_product_split_transfer_path(product_id: product.id), method: :post, local: true, html: { class: "transfer-form" } do %>
                    <div class="modal-header transfer-modal-header">
                      <h5 class="modal-title">
                        <i class="bi bi-arrow-left-right me-2"></i>Transfer / Split Stock
                        <br><small><%= product.name %></small>
                      </h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                      <p class="text-muted small">
                        Move stock between variants of this product — split one variant into several smaller ones
                        (e.g. 1 &times; 25kg &rarr; 5 &times; 5kg), or merge several back into one
                        (e.g. 1 &times; 5kg + 2 &times; 10kg &rarr; 1 &times; 25kg). The total weight on both sides must match.
                      </p>

                      <div class="transfer-section-label text-danger small text-uppercase mt-3 mb-2">
                        <span class="transfer-icon-circle from"><i class="bi bi-dash"></i></span> From (consume)
                      </div>
                      <div class="transfer-rows from-rows d-flex flex-column gap-2">
                        <div class="row g-2 transfer-row mx-0">
                          <div class="col-7">
                            <select name="from_variant_ids[]" class="form-select form-select-sm variant-select">
                              <option value="">Select variant...</option>
                              <% variants.each do |v| %>
                                <option value="<%= v.id %>" data-weight="<%= v.weight.to_f %>">
                                  <%= v.label %> (available: <%= v.available_stock %>)
                                </option>
                              <% end %>
                            </select>
                          </div>
                          <div class="col-3">
                            <input type="number" name="from_quantities[]" class="form-control form-control-sm qty-input" min="1" placeholder="Qty">
                          </div>
                          <div class="col-2">
                            <button type="button" class="btn btn-sm btn-outline-danger remove-row" title="Remove"><i class="bi bi-x"></i></button>
                          </div>
                        </div>
                      </div>
                      <button type="button" class="btn btn-sm add-row-btn mt-2 w-100" data-target="from">
                        <i class="bi bi-plus-lg me-1"></i>Add source variant
                      </button>

                      <div class="transfer-section-label text-success small text-uppercase mt-4 mb-2">
                        <span class="transfer-icon-circle to"><i class="bi bi-plus"></i></span> To (produce)
                      </div>
                      <div class="transfer-rows to-rows d-flex flex-column gap-2">
                        <div class="row g-2 transfer-row mx-0">
                          <div class="col-7">
                            <select name="to_variant_ids[]" class="form-select form-select-sm variant-select">
                              <option value="">Select variant...</option>
                              <% variants.each do |v| %>
                                <option value="<%= v.id %>" data-weight="<%= v.weight.to_f %>">
                                  <%= v.label %> (available: <%= v.available_stock %>)
                                </option>
                              <% end %>
                            </select>
                          </div>
                          <div class="col-3">
                            <input type="number" name="to_quantities[]" class="form-control form-control-sm qty-input" min="1" placeholder="Qty">
                          </div>
                          <div class="col-2">
                            <button type="button" class="btn btn-sm btn-outline-danger remove-row" title="Remove"><i class="bi bi-x"></i></button>
                          </div>
                        </div>
                      </div>
                      <button type="button" class="btn btn-sm add-row-btn mt-2 w-100" data-target="to">
                        <i class="bi bi-plus-lg me-1"></i>Add destination variant
                      </button>

                      <div class="balance-scale mt-4 d-flex align-items-center gap-3">
                        <div class="flex-grow-1">
                          <div class="d-flex justify-content-between small mb-1">
                            <span class="text-muted">From total</span>
                            <span><span class="from-total fw-semibold">0</span> <%= product.unit_type %></span>
                          </div>
                          <div class="balance-bar-track">
                            <div class="balance-bar-fill from-bar"></div>
                          </div>
                          <div class="d-flex justify-content-between small mt-3 mb-1">
                            <span class="text-muted">To total</span>
                            <span><span class="to-total fw-semibold">0</span> <%= product.unit_type %></span>
                          </div>
                          <div class="balance-bar-track">
                            <div class="balance-bar-fill to-bar"></div>
                          </div>
                        </div>
                        <div class="text-center" style="min-width: 90px;">
                          <div class="balance-icon-wrap balance-icon">
                            <i class="bi bi-dash-circle text-muted"></i>
                          </div>
                          <div class="balance-status small fw-semibold text-muted">Enter quantities</div>
                        </div>
                      </div>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                      <%= submit_tag "Transfer Stock", class: "btn btn-transfer-gradient" %>
                    </div>
                  <% end %>

                  <div class="transfer-loading-overlay">
                    <div class="dual-ring-loader"></div>
                    <p>Transferring stock&hellip;</p>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="text-center text-muted py-5">
        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
        No products found.
      </div>
    <% end %>
  </div>
</div>

<% if respond_to?(:paginate) && @products.respond_to?(:total_pages) %>
  <div class="d-flex justify-content-center mt-4">
    <%= paginate @products %>
  </div>
<% end %>

<script>
(function() {
  function sideTotal(modalContent, side) {
    var total = 0;
    modalContent.querySelectorAll('.' + side + '-rows .transfer-row').forEach(function(row) {
      var select = row.querySelector('.variant-select');
      var qtyInput = row.querySelector('.qty-input');
      var qty = parseFloat(qtyInput.value) || 0;
      var opt = select.options[select.selectedIndex];
      var weight = opt ? (parseFloat(opt.getAttribute('data-weight')) || 0) : 0;
      total += qty * weight;
    });
    return total;
  }

  function recalcBalance(modalContent) {
    if (!modalContent) return;
    var fromTotal = sideTotal(modalContent, 'from');
    var toTotal = sideTotal(modalContent, 'to');
    var maxTotal = Math.max(fromTotal, toTotal, 1);

    modalContent.querySelector('.from-total').textContent = fromTotal.toFixed(2);
    modalContent.querySelector('.to-total').textContent = toTotal.toFixed(2);
    modalContent.querySelector('.from-bar').style.width = Math.min(100, (fromTotal / maxTotal) * 100) + '%';
    modalContent.querySelector('.to-bar').style.width = Math.min(100, (toTotal / maxTotal) * 100) + '%';

    var scale = modalContent.querySelector('.balance-scale');
    var statusEl = modalContent.querySelector('.balance-status');
    var iconWrap = modalContent.querySelector('.balance-icon-wrap');

    scale.classList.remove('is-balanced', 'is-mismatched');
    iconWrap.classList.remove('pop');
    // Force reflow so the pop animation can replay on repeated matches
    void iconWrap.offsetWidth;

    if (fromTotal === 0 && toTotal === 0) {
      statusEl.textContent = 'Enter quantities';
      statusEl.className = 'balance-status small fw-semibold text-muted';
      iconWrap.innerHTML = '<i class="bi bi-dash-circle text-muted"></i>';
    } else if (Math.abs(fromTotal - toTotal) < 0.01) {
      scale.classList.add('is-balanced');
      statusEl.textContent = 'Balanced';
      statusEl.className = 'balance-status small fw-semibold text-success';
      iconWrap.innerHTML = '<i class="bi bi-check-circle-fill text-success"></i>';
      iconWrap.classList.add('pop');
    } else {
      scale.classList.add('is-mismatched');
      statusEl.textContent = 'Mismatched';
      statusEl.className = 'balance-status small fw-semibold text-danger';
      iconWrap.innerHTML = '<i class="bi bi-x-circle-fill text-danger"></i>';
      iconWrap.classList.add('pop');
    }
  }

  document.addEventListener('click', function(e) {
    var addBtn = e.target.closest('.add-row-btn');
    if (addBtn) {
      var modalContent = addBtn.closest('.modal-content');
      var container = modalContent.querySelector('.' + addBtn.getAttribute('data-target') + '-rows');
      var firstRow = container.querySelector('.transfer-row');
      var clone = firstRow.cloneNode(true);
      clone.querySelectorAll('select, input').forEach(function(el) {
        if (el.tagName === 'SELECT') { el.selectedIndex = 0; } else { el.value = ''; }
      });
      container.appendChild(clone);
      recalcBalance(modalContent);
      return;
    }

    var removeBtn = e.target.closest('.remove-row');
    if (removeBtn) {
      var modalContent = removeBtn.closest('.modal-content');
      var row = removeBtn.closest('.transfer-row');
      var container = row.parentElement;
      if (container.querySelectorAll('.transfer-row').length > 1) {
        row.remove();
      } else {
        row.querySelectorAll('select, input').forEach(function(el) {
          if (el.tagName === 'SELECT') { el.selectedIndex = 0; } else { el.value = ''; }
        });
      }
      recalcBalance(modalContent);
    }
  });

  document.addEventListener('input', function(e) {
    if (e.target.classList.contains('qty-input')) {
      recalcBalance(e.target.closest('.modal-content'));
    }
  });

  document.addEventListener('change', function(e) {
    if (e.target.classList.contains('variant-select')) {
      recalcBalance(e.target.closest('.modal-content'));
    }
  });

  document.addEventListener('submit', function(e) {
    if (!e.target.classList.contains('transfer-form')) return;
    var modalContent = e.target.closest('.modal-content');
    var overlay = modalContent.querySelector('.transfer-loading-overlay');
    if (overlay) overlay.classList.add('active');
    modalContent.querySelectorAll('button').forEach(function(btn) { btn.disabled = true; });
  });
})();
</script>
