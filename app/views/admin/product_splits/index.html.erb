<style>
  .split-product-row { transition: background-color .15s ease; }
  .split-product-row:hover { background-color: #fafbfc; }

  .split-variant-table tbody tr { transition: background-color .15s ease; }
  .split-variant-table tbody tr:hover { background-color: #f8f9fa; }

  .btn-transfer-gradient {
    background: linear-gradient(135deg, #0ea5e9, #22c55e);
    border: none;
    color: #fff;
    box-shadow: 0 2px 10px rgba(14, 165, 233, .25);
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .btn-transfer-gradient:hover {
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(14, 165, 233, .35);
  }

  .transfer-modal-header {
    background: linear-gradient(135deg, #0ea5e9, #22c55e);
    color: #fff;
    border-bottom: none;
  }
  .transfer-modal-header .btn-close { filter: brightness(0) invert(1); opacity: .85; }
  .transfer-modal-header .modal-title small { color: rgba(255,255,255,.85); }

  .transfer-section-label {
    display: flex;
    align-items: center;
    gap: .5rem;
    font-weight: 600;
    letter-spacing: .03em;
  }
  .transfer-icon-circle {
    width: 26px; height: 26px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: .8rem; flex-shrink: 0;
  }
  .transfer-icon-circle.from { background: linear-gradient(135deg, #fb7185, #ef4444); }
  .transfer-icon-circle.to { background: linear-gradient(135deg, #34d399, #059669); }

  .balance-scale {
    border-radius: .75rem;
    padding: 1rem 1.25rem;
    background: #f8f9fa;
    border: 1px solid #e9ecef;
    transition: background .3s ease, border-color .3s ease;
  }
  .balance-scale.is-balanced { background: linear-gradient(135deg, #ecfdf5, #f0fdf4); border-color: #86efac; }
  .balance-scale.is-mismatched { background: linear-gradient(135deg, #fef2f2, #fff1f2); border-color: #fca5a5; }

  /* Loading overlay shown while the transfer form submits */
  .transfer-loading-overlay {
    position: absolute;
    inset: 0;
    background: rgba(255,255,255,.92);
    backdrop-filter: blur(1px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity .2s ease;
    z-index: 20;
    border-radius: .5rem;
  }
  .transfer-loading-overlay.active { opacity: 1; pointer-events: all; }
  .dual-ring-loader {
    width: 56px; height: 56px;
    border-radius: 50%;
    border: 4px solid #e9ecef;
    border-top-color: #0ea5e9;
    border-bottom-color: #22c55e;
    animation: spin .8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .transfer-loading-overlay p {
    margin-top: 1rem;
    margin-bottom: 0;
    font-weight: 600;
    color: #334155;
    animation: pulseText 1.4s ease-in-out infinite;
  }
  @keyframes pulseText { 0%, 100% { opacity: .6; } 50% { opacity: 1; } }
</style>

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1">Product Split</h2>
    <p class="text-muted mb-0">Products, their variant packs, and available stock in store</p>
  </div>
</div>

<!-- Search -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body">
    <%= form_with url: admin_product_splits_path, method: :get, local: true do %>
      <div class="input-group">
        <span class="input-group-text bg-white border-end-0">
          <i class="bi bi-search"></i>
        </span>
        <input type="text" name="search" class="form-control border-start-0" placeholder="Search products..." value="<%= params[:search] %>">
        <%= submit_tag "Search", class: "btn btn-primary" %>
        <% if params[:search].present? %>
          <%= link_to "Clear", admin_product_splits_path, class: "btn btn-outline-secondary" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<!-- Products & Variant Stock -->
<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <% if @products.any? %>
      <% @products.each do |product| %>
        <% total_stock = product.available_quantity %>
        <% variants = product.product_variants.sort_by { |v| -v.weight.to_f } %>
        <% variant_total = variants.sum { |v| v.available_stock.to_f } %>
        <% mismatch = product.has_multiple_quantities? && variants.any? && variant_total.round(3) != total_stock.round(3) %>

        <div class="border-bottom p-3 split-product-row">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-box-seam-fill text-primary fs-5"></i>
              <div>
                <h6 class="mb-0"><%= product.name %></h6>
                <small class="text-muted">SKU: <%= product.sku %></small>
              </div>
            </div>
            <div class="text-end">
              <span class="badge bg-primary-subtle text-primary fs-6 px-3 py-2">
                Total Stock: <%= number_with_precision(total_stock, precision: 2, strip_insignificant_zeros: true) %> <%= product.unit_type %>
              </span>
              <% if mismatch %>
                <span class="badge bg-danger-subtle text-danger ms-2" title="Variant stock does not add up to total stock">
                  <i class="bi bi-exclamation-triangle-fill"></i> Mismatch
                </span>
              <% end %>
            </div>
          </div>

          <% if variants.any? %>
            <div class="table-responsive mt-3">
              <table class="table table-sm table-borderless align-middle mb-0 split-variant-table">
                <thead>
                  <tr class="text-muted small text-uppercase">
                    <th style="width: 40%">Variant</th>
                    <th>Unit</th>
                    <th>Available Stock</th>
                    <th>Selling Price</th>
                  </tr>
                </thead>
                <tbody>
                  <% variants.each do |variant| %>
                    <tr>
                      <td class="ps-4">
                        <i class="bi bi-arrow-return-right text-muted me-1"></i>
                        <%= variant.weight %> <%= variant.unit %>
                        <% if variant.is_default? %>
                          <span class="badge bg-secondary-subtle text-secondary ms-1">Default</span>
                        <% end %>
                      </td>
                      <td><%= variant.unit %></td>
                      <td>
                        <span class="badge <%= variant.available_stock.to_f > 0 ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger' %>">
                          <%= number_with_precision(variant.available_stock, precision: 2, strip_insignificant_zeros: true) %>
                        </span>
                      </td>
                      <td>&#8377;<%= number_with_precision(variant.selling_price, precision: 2, strip_insignificant_zeros: true) %></td>
                    </tr>
                  <% end %>
                  <tr class="border-top">
                    <td class="ps-4 fw-semibold" colspan="2">Sum of variants</td>
                    <td colspan="2" class="fw-semibold">
                      <%= number_with_precision(variant_total, precision: 2, strip_insignificant_zeros: true) %>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-muted small mt-2 ps-4">No variants — sold as a single unit.</div>
          <% end %>

          <% if variants.any? %>
            <button type="button" class="btn btn-sm btn-transfer-gradient mt-3" data-bs-toggle="modal" data-bs-target="#transferModal-<%= product.id %>">
              <i class="bi bi-arrow-left-right me-1"></i> Transfer / Split Stock
            </button>

            <div class="modal fade" id="transferModal-<%= product.id %>" tabindex="-1" aria-hidden="true">
              <div class="modal-dialog modal-lg">
                <div class="modal-content position-relative">
                  <%= form_with url: admin_product_split_transfer_path(product_id: product.id), method: :post, local: true, html: { class: "transfer-form" } do %>
                    <div class="modal-header transfer-modal-header">
                      <h5 class="modal-title">
                        <i class="bi bi-arrow-left-right me-2"></i>Transfer / Split Stock
                        <br><small><%= product.name %></small>
                      </h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                      <p class="text-muted small mb-3">
                        Move stock from one variant to another. The quantity is taken out of
                        <strong>From</strong> and added to <strong>To</strong>, so total stock stays the same.
                      </p>

                      <div class="row g-3 align-items-end">
                        <div class="col-md-5">
                          <div class="transfer-section-label text-danger small text-uppercase mb-2">
                            <span class="transfer-icon-circle from"><i class="bi bi-dash"></i></span> From
                          </div>
                          <select name="from_variant_id" class="form-select from-select" required>
                            <option value="">Select variant...</option>
                            <% variants.each do |v| %>
                              <option value="<%= v.id %>" data-stock="<%= v.available_stock %>" data-label="<%= v.label %>">
                                <%= v.label %> (available: <%= v.available_stock %>)
                              </option>
                            <% end %>
                          </select>
                        </div>
                        <div class="col-md-2 text-center d-none d-md-block pb-2">
                          <i class="bi bi-arrow-right fs-4 text-muted"></i>
                        </div>
                        <div class="col-md-5">
                          <div class="transfer-section-label text-success small text-uppercase mb-2">
                            <span class="transfer-icon-circle to"><i class="bi bi-plus"></i></span> To
                          </div>
                          <select name="to_variant_id" class="form-select to-select" required>
                            <option value="">Select variant...</option>
                            <% variants.each do |v| %>
                              <option value="<%= v.id %>" data-stock="<%= v.available_stock %>" data-label="<%= v.label %>">
                                <%= v.label %> (available: <%= v.available_stock %>)
                              </option>
                            <% end %>
                            <option value="new" data-stock="0">+ Create new variant&hellip;</option>
                          </select>
                          <div class="new-variant-fields mt-2 d-none">
                            <div class="row g-1">
                              <div class="col-6">
                                <input type="number" step="0.001" min="0.001" name="to_new_weight" class="form-control form-control-sm new-weight-input" placeholder="Weight (<%= product.unit_type %>)">
                              </div>
                              <div class="col-6">
                                <input type="number" step="0.01" min="0.01" name="to_new_price" class="form-control form-control-sm" placeholder="Selling price ₹">
                              </div>
                            </div>
                          </div>
                        </div>
                        <div class="col-12">
                          <label class="form-label small fw-semibold text-uppercase text-muted mb-1">Quantity to move</label>
                          <input type="number" name="quantity" class="form-control qty-input" min="1" step="1" placeholder="e.g. 4" required>
                          <div class="form-text from-available-hint"></div>
                        </div>
                      </div>

                      <div class="balance-scale mt-4">
                        <div class="small text-muted text-uppercase fw-semibold mb-2">After transfer</div>
                        <div class="transfer-preview small text-muted">Select variants and enter a quantity.</div>
                      </div>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                      <%= submit_tag "Transfer Stock", class: "btn btn-transfer-gradient" %>
                    </div>
                  <% end %>

                  <div class="transfer-loading-overlay">
                    <div class="dual-ring-loader"></div>
                    <p>Transferring stock&hellip;</p>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="text-center text-muted py-5">
        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
        No products found.
      </div>
    <% end %>
  </div>
</div>

<% if respond_to?(:paginate) && @products.respond_to?(:total_pages) %>
  <div class="d-flex justify-content-center mt-4">
    <%= paginate @products %>
  </div>
<% end %>

<script>
(function() {
  function selectedOpt(select) {
    return select.options[select.selectedIndex];
  }

  function refresh(modalContent) {
    if (!modalContent) return;
    var fromSel = modalContent.querySelector('.from-select');
    var toSel = modalContent.querySelector('.to-select');
    var qtyInput = modalContent.querySelector('.qty-input');
    var preview = modalContent.querySelector('.transfer-preview');
    var hint = modalContent.querySelector('.from-available-hint');
    var scale = modalContent.querySelector('.balance-scale');
    var submitBtn = modalContent.querySelector('input[type=submit]');

    // Don't let the same variant be picked on both sides
    Array.prototype.forEach.call(toSel.options, function(opt) {
      opt.disabled = opt.value !== '' && opt.value === fromSel.value;
    });
    if (toSel.value && toSel.value === fromSel.value) toSel.selectedIndex = 0;

    var fields = modalContent.querySelector('.new-variant-fields');
    if (toSel.value === 'new') {
      fields.classList.remove('d-none');
    } else {
      fields.classList.add('d-none');
      fields.querySelectorAll('input').forEach(function(el) { el.value = ''; });
    }

    var fromStock = fromSel.value ? parseInt(selectedOpt(fromSel).getAttribute('data-stock'), 10) || 0 : null;
    qtyInput.max = fromStock !== null ? fromStock : '';
    hint.textContent = fromStock !== null ? 'Available in ' + selectedOpt(fromSel).getAttribute('data-label') + ': ' + fromStock : '';

    var qty = parseInt(qtyInput.value, 10) || 0;
    scale.classList.remove('is-balanced', 'is-mismatched');

    if (!fromSel.value || !toSel.value || qty <= 0) {
      preview.innerHTML = 'Select variants and enter a quantity.';
      preview.className = 'transfer-preview small text-muted';
      submitBtn.disabled = false;
      return;
    }

    var toStock = parseInt(selectedOpt(toSel).getAttribute('data-stock'), 10) || 0;
    var toLabel = toSel.value === 'new'
      ? 'New ' + (modalContent.querySelector('.new-weight-input').value || '?') + ' variant'
      : selectedOpt(toSel).getAttribute('data-label');
    var fromLabel = selectedOpt(fromSel).getAttribute('data-label');

    if (qty > fromStock) {
      scale.classList.add('is-mismatched');
      preview.className = 'transfer-preview small text-danger fw-semibold';
      preview.textContent = 'Only ' + fromStock + ' available in ' + fromLabel + '.';
      submitBtn.disabled = true;
      return;
    }

    scale.classList.add('is-balanced');
    preview.className = 'transfer-preview';
    preview.innerHTML =
      '<div class="d-flex justify-content-between"><span>' + fromLabel + '</span><span>' + fromStock + ' &rarr; <strong class="text-danger">' + (fromStock - qty) + '</strong></span></div>' +
      '<div class="d-flex justify-content-between mt-1"><span>' + toLabel + '</span><span>' + toStock + ' &rarr; <strong class="text-success">' + (toStock + qty) + '</strong></span></div>';
    submitBtn.disabled = false;
  }

  document.addEventListener('input', function(e) {
    if (e.target.closest('.transfer-form')) refresh(e.target.closest('.modal-content'));
  });
  document.addEventListener('change', function(e) {
    if (e.target.closest('.transfer-form')) refresh(e.target.closest('.modal-content'));
  });

  document.addEventListener('submit', function(e) {
    if (!e.target.classList.contains('transfer-form')) return;
    var modalContent = e.target.closest('.modal-content');
    var overlay = modalContent.querySelector('.transfer-loading-overlay');
    if (overlay) overlay.classList.add('active');
    modalContent.querySelectorAll('button').forEach(function(btn) { btn.disabled = true; });
  });
})();
</script>
