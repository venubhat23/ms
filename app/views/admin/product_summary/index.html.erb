<% content_for :title, "Product Summary" %>

<style>
  .psum { font-family: inherit; }

  .psum-hero {
    background: linear-gradient(135deg, #1C7C54 0%, #10b981 100%);
    border-radius: 18px;
    padding: 1.75rem 2rem 0;
    color: #fff;
    margin-bottom: 1.75rem;
    position: relative;
    overflow: hidden;
  }
  .psum-hero::after {
    content: ''; position: absolute; top: -50px; right: -30px;
    width: 190px; height: 190px; background: rgba(255,255,255,.08); border-radius: 50%;
  }
  .psum-hero h2 { font-weight: 700; margin: 0; font-size: 1.6rem; }
  .psum-hero p  { margin: .25rem 0 1.25rem; opacity: .85; font-size: .9rem; }

  .psum-tabs { display: flex; gap: .4rem; flex-wrap: wrap; position: relative; z-index: 1; }
  .psum-tab {
    display: inline-flex; align-items: center; gap: .5rem;
    padding: .7rem 1.15rem; border-radius: 12px 12px 0 0;
    background: rgba(255,255,255,.14); color: #fff; text-decoration: none;
    font-weight: 600; font-size: .9rem; transition: background .15s, transform .15s;
  }
  .psum-tab:hover { background: rgba(255,255,255,.24); color: #fff; }
  .psum-tab.is-active { background: #f6f9f8; color: #1C7C54; }
  .psum-tab .psum-tab-count {
    background: rgba(0,0,0,.12); border-radius: 999px; padding: .05rem .5rem;
    font-size: .78rem; font-weight: 700;
  }
  .psum-tab.is-active .psum-tab-count { background: rgba(28,124,84,.14); }

  .psum-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
  .psum-stat {
    background: #fff; border-radius: 14px; padding: 1.1rem 1.25rem;
    box-shadow: 0 2px 12px rgba(0,0,0,.06); display: flex; align-items: center; gap: .9rem;
  }
  .psum-stat-ic {
    width: 44px; height: 44px; border-radius: 12px; flex: none;
    display: flex; align-items: center; justify-content: center; font-size: 1.25rem;
  }
  .psum-stat-val { font-size: 1.4rem; font-weight: 700; line-height: 1; }
  .psum-stat-lbl { font-size: .78rem; color: #6c757d; margin-top: .2rem; }

  .psum-ic-blue   { background: #e7f1ff; color: #0d6efd; }
  .psum-ic-teal   { background: #d9f2ec; color: #1C7C54; }
  .psum-ic-amber  { background: #fff3cd; color: #b8860b; }
  .psum-ic-red    { background: #fde2e1; color: #dc3545; }
  .psum-ic-grey   { background: #eef1f4; color: #55606b; }

  .psum-card { background: #fff; border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,.06); overflow: hidden; margin-bottom: 1.25rem; }
  .psum-card-head {
    padding: .9rem 1.25rem; border-bottom: 1px solid #eef0f2;
    display: flex; align-items: center; gap: .6rem; font-weight: 700;
  }
  .psum-card-head .sub { font-weight: 500; color: #8a929b; font-size: .82rem; }

  table.psum-table { width: 100%; border-collapse: collapse; font-size: .86rem; }
  .psum-table th, .psum-table td { padding: .6rem .85rem; text-align: left; white-space: nowrap; }
  .psum-table thead th {
    background: #f6f8f9; color: #55606b; font-weight: 600; font-size: .78rem;
    text-transform: uppercase; letter-spacing: .03em; position: sticky; top: 0; z-index: 1;
  }
  .psum-table tbody tr { border-top: 1px solid #eef0f2; }
  .psum-table tbody tr:hover { background: #f9fbfa; }
  .psum-table td.num, .psum-table th.num { text-align: right; font-variant-numeric: tabular-nums; }
  .psum-table tr.psum-sub td:first-child { padding-left: 2.1rem; color: #6c757d; }
  .psum-table tr.psum-header td { background: #f3f6f5; font-weight: 700; }
  .psum-table tfoot td { border-top: 2px solid #e3e7ea; font-weight: 700; background: #fafbfc; }

  .psum-scroll { overflow-x: auto; max-height: 74vh; }

  .psum-badge {
    display: inline-flex; align-items: center; gap: .3rem;
    padding: .15rem .5rem; border-radius: 999px; font-size: .78rem; font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .psum-badge.ok   { background: #e6f5ee; color: #1C7C54; }
  .psum-badge.low  { background: #fff3cd; color: #9a7400; }
  .psum-badge.out  { background: #fde2e1; color: #c62828; }
  .psum-badge.none { background: transparent; color: #c3cad1; font-weight: 500; }

  .psum-name { font-weight: 600; }
  .psum-meta { font-size: .76rem; color: #8a929b; }

  .psum-pill { font-size: .7rem; font-weight: 700; padding: .1rem .45rem; border-radius: 6px; background: #eef1f4; color: #55606b; }
  .psum-pill.off { background: #fde2e1; color: #c62828; }

  .psum-cards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.25rem; }

  .psum-empty { text-align: center; padding: 3rem 1rem; color: #8a929b; }
  .psum-empty i { font-size: 2.5rem; display: block; margin-bottom: .5rem; opacity: .5; }

  .psum-search { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
  .psum-search .select2-container { min-width: 320px; }
  .psum-search-hint { font-size: .8rem; color: #b8860b; font-weight: 600; }
</style>

<div class="psum">
  <div class="psum-hero">
    <h2><i class="bi bi-boxes me-2"></i>Product Summary</h2>
    <p>Live inventory across the HQ warehouse, franchises and stores</p>
    <div class="psum-tabs">
      <%
        tab_defs = [
          ["main",       "Main Admin Store", "bi-building"],
          ["franchises", "Franchises",       "bi-shop-window"],
          ["stores",     "Stores",           "bi-shop"]
        ]
      %>
      <% tab_defs.each do |key, label, icon| %>
        <%= link_to admin_product_summary_path(tab: key), class: "psum-tab #{'is-active' if @tab == key}" do %>
          <i class="bi <%= icon %>"></i><%= label %>
          <span class="psum-tab-count"><%= @tab_counts[key] %></span>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="psum-search">
    <select id="psum-search" data-placeholder="Search a product…">
      <option value=""></option>
      <% @search_products.each do |id, name, sku| %>
        <option value="<%= id %>"><%= name %><%= " — #{sku}" if sku.present? %></option>
      <% end %>
    </select>
    <button type="button" class="btn btn-outline-secondary btn-sm" id="psum-search-clear">
      <i class="bi bi-x-circle me-1"></i>Show all
    </button>
    <span class="psum-search-hint" id="psum-search-hint"></span>
  </div>

  <%= render "tab_#{@tab}" %>
</div>

<script>
  (function () {
    if (typeof window.jQuery === 'undefined' || !jQuery.fn.select2) return;
    var $search = jQuery('#psum-search');
    if (!$search.length) return;

    $search.select2({
      theme: 'bootstrap-5',
      width: '320px',
      allowClear: true,
      placeholder: $search.data('placeholder')
    });

    var hint = document.getElementById('psum-search-hint');

    function rows() {
      return Array.prototype.slice.call(document.querySelectorAll('tr[data-psum-product]'));
    }

    function apply(pid) {
      var all = rows();
      if (!pid) {
        all.forEach(function (tr) { tr.hidden = false; });
        document.querySelectorAll('.psum-cards-grid > .psum-card').forEach(function (c) { c.hidden = false; });
        if (hint) hint.textContent = '';
        return;
      }
      var shown = 0, first = null;
      all.forEach(function (tr) {
        var match = tr.getAttribute('data-psum-product') === String(pid);
        tr.hidden = !match;
        if (match) { shown++; if (!first) first = tr; }
      });
      // In the per-entity "cards" layout, hide cards with nothing to show.
      document.querySelectorAll('.psum-cards-grid > .psum-card').forEach(function (card) {
        var any = card.querySelector('tr[data-psum-product]:not([hidden])');
        card.hidden = !any;
      });
      if (hint) hint.textContent = shown ? '' : 'Not stocked in this view';
      if (first) first.scrollIntoView({ block: 'center' });
    }

    $search.on('change', function () { apply($search.val()); });

    var clearBtn = document.getElementById('psum-search-clear');
    if (clearBtn) {
      clearBtn.addEventListener('click', function () { $search.val('').trigger('change'); });
    }
  })();
</script>
