<!-- Delete Loading Overlay (shared by products index/show delete buttons) -->
<div id="delete-loading-overlay" class="delete-loading-overlay" style="display: none;">
  <div class="delete-loading-container">
    <div class="delete-loading-spinner">
      <div class="spinner-ring"></div>
      <div class="spinner-ring"></div>
      <div class="spinner-ring"></div>
      <i class="bi bi-trash delete-loading-icon"></i>
    </div>
    <h4 class="delete-loading-title">Deleting Product...</h4>
    <p class="delete-loading-message">Removing the product and any related records. This won't take long.</p>
    <div class="progress delete-loading-progress">
      <div class="progress-bar progress-bar-striped progress-bar-animated bg-danger" role="progressbar" style="width: 0%"></div>
    </div>
  </div>
</div>

<style>
.delete-loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(8px);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease-in-out;
}

.delete-loading-overlay.show {
  opacity: 1;
}

.delete-loading-container {
  text-align: center;
  padding: 3rem 2rem;
  background: white;
  border-radius: 20px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
  border: 1px solid #e9ecef;
  max-width: 400px;
  width: 90%;
  animation: deleteSlideUp 0.5s ease-out;
}

@keyframes deleteSlideUp {
  from { transform: translateY(50px); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.delete-loading-spinner {
  position: relative;
  width: 100px;
  height: 100px;
  margin: 0 auto 1.5rem;
}

.delete-loading-spinner .spinner-ring {
  position: absolute;
  border: 3px solid transparent;
  border-radius: 50%;
  animation: deleteSpin 2s linear infinite;
}

.delete-loading-spinner .spinner-ring:nth-child(1) {
  border-top-color: #dc3545;
  width: 100px;
  height: 100px;
}

.delete-loading-spinner .spinner-ring:nth-child(2) {
  border-top-color: #fd7e14;
  width: 80px;
  height: 80px;
  top: 10px;
  left: 10px;
  animation-delay: -0.4s;
}

.delete-loading-spinner .spinner-ring:nth-child(3) {
  border-top-color: #ffc107;
  width: 60px;
  height: 60px;
  top: 20px;
  left: 20px;
  animation-delay: -0.8s;
}

@keyframes deleteSpin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.delete-loading-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 2rem;
  color: #dc3545;
  animation: deletePulse 2s ease-in-out infinite;
}

@keyframes deletePulse {
  0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
  50% { transform: translate(-50%, -50%) scale(1.1); opacity: 0.8; }
}

.delete-loading-title {
  color: #212529;
  font-weight: 600;
  margin-bottom: 0.5rem;
  font-size: 1.4rem;
}

.delete-loading-message {
  color: #6c757d;
  margin-bottom: 1.25rem;
  font-size: 0.95rem;
}

.delete-loading-progress {
  height: 8px;
  border-radius: 10px;
  background: #e9ecef;
  overflow: hidden;
}

.delete-loading-progress .progress-bar {
  border-radius: 10px;
  transition: width 0.3s ease;
}

@media (prefers-color-scheme: dark) {
  .delete-loading-overlay { background: rgba(33, 37, 41, 0.95); }
  .delete-loading-container { background: #212529; border-color: #495057; }
  .delete-loading-title { color: #f8f9fa; }
  .delete-loading-message { color: #adb5bd; }
}
</style>

<script>
// Delegated on document (bound once): a DOMContentLoaded listener never fires
// after a Turbo visit, which left Delete as a plain link back to the show page.
if (!window.productDeleteHandlerBound) {
  window.productDeleteHandlerBound = true;
  document.addEventListener('click', function(e) {
      const button = e.target.closest('.delete-product-btn');
      if (!button) return;
      e.preventDefault();

      const overlay = document.getElementById('delete-loading-overlay');
      const progressBar = overlay?.querySelector('.progress-bar');
      const productName = button.dataset.productName;
      const url = button.href;
      if (button.dataset.busy) return;
      button.dataset.busy = '1';

      // Ask the server what is connected to this product so the operator sees
      // exactly what will be removed before confirming.
      fetch(url + '/dependencies', { headers: { 'Accept': 'application/json' } })
        .then(r => r.ok ? r.json() : Promise.reject())
        .then(data => confirmMessageFor(productName, data))
        .catch(() => `Delete '${productName}'?\n\nThis will permanently delete the product and all its related data. This cannot be undone.`)
        .then(message => {
          delete button.dataset.busy;
          if (confirm(message)) submitDelete(url, overlay, progressBar);
        });
  });

  function confirmMessageFor(productName, data) {
    const deleted = (data && data.deleted) || [];
    const kept = (data && data.kept) || [];
    let msg = `Delete '${productName}'?\n\n`;
    if (deleted.length) {
      msg += 'These connected records will ALSO be permanently deleted:\n';
      deleted.forEach(g => { msg += `  • ${g.label}: ${g.count}\n`; });
      msg += '\n';
    } else {
      msg += 'No stock, variants or other records depend on this product.\n\n';
    }
    if (kept.length) {
      msg += 'Kept as history (only unlinked from this product):\n';
      kept.forEach(g => { msg += `  • ${g.label}: ${g.count}\n`; });
      msg += '\n';
    }
    return msg + 'This cannot be undone. Click OK to delete the product and all dependent records.';
  }

  function submitDelete(url, overlay, progressBar) {
      if (overlay) {
        overlay.style.display = 'flex';
        setTimeout(() => overlay.classList.add('show'), 10);

        let progress = 0;
        const progressInterval = setInterval(() => {
          progress += Math.random() * 15;
          if (progress > 90) {
            progress = 90;
            clearInterval(progressInterval);
          }
          if (progressBar) progressBar.style.width = progress + '%';
        }, 200);
      }

      const form = document.createElement('form');
      form.method = 'POST';
      form.action = url;
      form.style.display = 'none';

      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
      if (csrfToken) {
        const csrfInput = document.createElement('input');
        csrfInput.type = 'hidden';
        csrfInput.name = 'authenticity_token';
        csrfInput.value = csrfToken;
        form.appendChild(csrfInput);
      }

      const methodInput = document.createElement('input');
      methodInput.type = 'hidden';
      methodInput.name = '_method';
      methodInput.value = 'delete';
      form.appendChild(methodInput);

      document.body.appendChild(form);
      form.submit();
  }
}
</script>
