<div class="card border-0 shadow-sm mt-4">
  <div class="card-header bg-transparent border-0 d-flex align-items-center justify-content-between">
    <h5 class="mb-0">
      <i class="bi bi-layers me-2 text-primary"></i>
      Quantity Variants (<%= product.product_variants.size %>)
    </h5>
    <%= link_to edit_variants_admin_product_path(product), class: "btn btn-sm btn-outline-primary" do %>
      <i class="bi bi-pencil me-1"></i> Edit Variants
    <% end %>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="border-0 fw-semibold ps-3">Variant</th>
            <th class="border-0 fw-semibold">Buying Price</th>
            <th class="border-0 fw-semibold">Selling Price</th>
            <th class="border-0 fw-semibold">B2B Price</th>
            <th class="border-0 fw-semibold">Discount</th>
            <th class="border-0 fw-semibold">After Discount</th>
            <th class="border-0 fw-semibold">GST %</th>
            <th class="border-0 fw-semibold">GST ₹</th>
            <th class="border-0 fw-semibold">Stock</th>
            <th class="border-0 fw-semibold">Status</th>
          </tr>
        </thead>
        <tbody>
          <% product.product_variants.ordered.each do |v| %>
            <tr>
              <td class="ps-3">
                <div class="d-flex align-items-center gap-2">
                  <span class="fw-semibold"><%= v.label %></span>
                  <% if v.is_default? %>
                    <span class="badge bg-primary-subtle text-primary">Default</span>
                  <% end %>
                </div>
              </td>
              <td>
                <% if v.buying_price.present? %>
                  ₹<%= '%.2f' % v.buying_price %>
                <% else %>
                  <span class="text-muted">—</span>
                <% end %>
              </td>
              <td class="fw-medium">₹<%= '%.2f' % v.selling_price %></td>
              <td>
                ₹<%= '%.2f' % v.effective_b2b_price %>
                <% unless v.b2b_selling_price.present? %>
                  <small class="text-muted d-block">Same as selling</small>
                <% end %>
              </td>
              <td>
                <% if v.discount_enabled? && v.discount_amount.to_f > 0 %>
                  <span class="text-success fw-medium">
                    <% if v.discount_type == 'percentage' %>
                      <%= v.discount_value %>%
                    <% else %>
                      ₹<%= '%.2f' % v.discount_value %>
                    <% end %>
                    <small class="text-muted">(−₹<%= '%.2f' % v.discount_amount %>)</small>
                  </span>
                <% else %>
                  <span class="text-muted">—</span>
                <% end %>
              </td>
              <td class="fw-semibold text-primary">₹<%= '%.2f' % v.effective_price %></td>
              <td>
                <% gst_pct = v.effective_gst_percentage %>
                <% if gst_pct.to_f > 0 %>
                  <span class="badge bg-info-subtle text-info"><%= gst_pct %>%</span>
                <% else %>
                  <span class="text-muted">—</span>
                <% end %>
              </td>
              <td>
                <% gst_amt = v.computed_gst_amount %>
                <% if gst_amt > 0 %>
                  ₹<%= '%.2f' % gst_amt %>
                <% else %>
                  <span class="text-muted">—</span>
                <% end %>
              </td>
              <td>
                <span class="<%= v.available_stock.to_i > 0 ? 'text-success' : 'text-danger' %> fw-medium">
                  <%= v.available_stock.to_i %>
                </span>
              </td>
              <td>
                <% if v.in_stock? %>
                  <span class="badge bg-success-subtle text-success">In Stock</span>
                <% else %>
                  <span class="badge bg-danger-subtle text-danger">Out of Stock</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
