<style>
  .pm-hero {
    background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 55%, #db2777 100%);
    border-radius: 1rem; color: #fff; padding: 1.75rem 2rem; position: relative; overflow: hidden;
    box-shadow: 0 10px 30px -10px rgba(79, 70, 229, .55);
  }
  .pm-hero::after {
    content: ""; position: absolute; right: -60px; top: -60px; width: 220px; height: 220px;
    border-radius: 50%; background: rgba(255,255,255,.08);
  }
  .pm-hero::before {
    content: ""; position: absolute; right: 120px; bottom: -80px; width: 160px; height: 160px;
    border-radius: 50%; background: rgba(255,255,255,.06);
  }
  .pm-hero .btn-light { font-weight: 600; color: #4f46e5; position: relative; z-index: 1; }
  .pm-stat {
    border: 0; border-radius: .9rem; transition: transform .15s ease, box-shadow .15s ease;
    box-shadow: 0 2px 10px rgba(15, 23, 42, .06); height: 100%;
  }
  .pm-stat:hover { transform: translateY(-3px); box-shadow: 0 10px 24px rgba(15, 23, 42, .12); }
  .pm-stat .pm-icon {
    width: 52px; height: 52px; border-radius: .8rem; display: flex; align-items: center; justify-content: center;
    font-size: 1.5rem;
  }
  .pm-stat .pm-value { font-size: 1.75rem; font-weight: 700; line-height: 1.1; }
  .pm-stat .pm-label { font-size: .78rem; text-transform: uppercase; letter-spacing: .05em; color: #64748b; font-weight: 600; }
  .pm-catalog { border-radius: 1rem; overflow: hidden; }
  .pm-catalog .card-header { padding: 1rem 1.25rem; border-bottom: 1px solid #eef0f4 !important; }
  .pm-catalog thead th { font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; color: #64748b; }
  .pm-catalog tbody tr { transition: background-color .12s ease; }
  .pm-catalog tbody tr:hover { background-color: #f8f7ff; }
  .pm-search-wrap { min-width: 340px; max-width: 460px; flex: 1 1 340px; }
  .pm-search-wrap .select2-container .select2-selection--single {
    height: 42px; border-radius: 999px; border: 1px solid #dfe3ea; padding-left: 2.1rem; display: flex; align-items: center;
  }
  .pm-search-wrap .select2-container--focus .select2-selection--single,
  .pm-search-wrap .select2-container--open .select2-selection--single { border-color: #7c3aed; box-shadow: 0 0 0 .2rem rgba(124, 58, 237, .15); }
  .pm-search-wrap .pm-search-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #94a3b8; z-index: 2; pointer-events: none; }
  .pm-s2-dropdown { border-radius: .75rem !important; overflow: hidden; box-shadow: 0 12px 30px rgba(15, 23, 42, .15); border-color: #e2e8f0 !important; }
  .pm-s2-dropdown .select2-results__option { padding: .45rem .75rem; }
  .pm-s2-dropdown .select2-results__option--highlighted { background: #f1edff !important; color: inherit !important; }
  .pm-s2-item { display: flex; align-items: center; gap: .65rem; }
  .pm-s2-item img, .pm-s2-item .pm-s2-ph { width: 38px; height: 38px; border-radius: .5rem; object-fit: cover; flex-shrink: 0; }
  .pm-s2-item .pm-s2-ph { background: #ede9fe; color: #7c3aed; display: flex; align-items: center; justify-content: center; }
  .pm-s2-item .pm-s2-name { font-weight: 600; font-size: .9rem; }
  .pm-s2-item .pm-s2-meta { font-size: .75rem; color: #64748b; }
  .pm-s2-item .pm-s2-price { margin-left: auto; text-align: right; font-weight: 600; font-size: .85rem; white-space: nowrap; }
  .pm-s2-item mark { padding: 0; background: #fde68a; border-radius: 2px; }
</style>

<!-- Page Header -->
<div class="pm-hero mb-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 position-relative" style="z-index: 1;">
    <div>
      <h2 class="mb-1 fw-bold"><i class="bi bi-boxes me-2"></i>Product Management</h2>
      <p class="mb-0 opacity-75">Manage your product inventory and catalog</p>
    </div>
    <div>
      <%= link_to admin_products_path(request.query_parameters.except('page').merge(format: :csv)), class: "btn btn-outline-light btn-lg rounded-pill px-4 me-2", data: { turbo: false } do %>
        <i class="bi bi-download me-1"></i>
        Export Products
      <% end %>
      <%= link_to new_admin_product_path, class: "btn btn-light btn-lg rounded-pill px-4 shadow-sm" do %>
        <i class="bi bi-plus-lg me-1"></i>
        Add New Product
      <% end %>
    </div>
  </div>
</div>

<!-- Stats Cards -->
<% stat_cards = [
  { label: 'Total Products', value: (@products.respond_to?(:total_count) ? @products.total_count : @products.count), icon: 'bi-box-seam', color: '#4f46e5', bg: '#eef2ff' },
  { label: 'Active Products', value: @products.count { |p| p.status == 'active' }, icon: 'bi-check-circle', color: '#059669', bg: '#ecfdf5' },
  { label: 'In Stock', value: @products.count { |p| p.total_stock > 0 }, icon: 'bi-box', color: '#0284c7', bg: '#f0f9ff' },
  { label: 'Low Stock', value: @products.count { |p| p.total_stock > 0 && p.total_stock <= 10 }, icon: 'bi-exclamation-triangle', color: '#d97706', bg: '#fffbeb' }
] %>
<div class="row g-3 mb-4">
  <% stat_cards.each do |card| %>
    <div class="col-6 col-md-3">
      <div class="card pm-stat">
        <div class="card-body d-flex align-items-center gap-3">
          <div class="pm-icon" style="background: <%= card[:bg] %>; color: <%= card[:color] %>;">
            <i class="bi <%= card[:icon] %>"></i>
          </div>
          <div>
            <div class="pm-label"><%= card[:label] %></div>
            <div class="pm-value" style="color: <%= card[:color] %>;"><%= card[:value] %></div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>



<script>
// Runs on full loads and Turbo visits (DOMContentLoaded never fires after a Turbo visit)
(function(init) {
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
})(function() {
  // Select2 product quick-search: type "ric" -> Rice shows up; picking it opens
  // the product. The first option filters the catalog table by the typed text.
  if (window.jQuery && jQuery.fn.select2) {
    const $search = jQuery('#productQuickSearch');
    const escapeHtml = (str) => String(str ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const highlight = (text, term) => {
      const safe = escapeHtml(text);
      if (!term) return safe;
      const re = new RegExp('(' + term.trim().split(/\s+/).map(w => escapeHtml(w).replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|') + ')', 'ig');
      return safe.replace(re, '<mark>$1</mark>');
    };
    let lastTerm = '';

    $search.select2({
      theme: 'bootstrap-5',
      width: '100%',
      placeholder: 'Search products by name or SKU…',
      allowClear: true,
      minimumInputLength: 1,
      dropdownCssClass: 'pm-s2-dropdown',
      ajax: {
        url: '<%= search_admin_products_path(format: :json) %>',
        dataType: 'json',
        delay: 200,
        data: params => ({ q: params.term }),
        processResults: (data, params) => {
          lastTerm = params.term || '';
          const results = data.results || [];
          results.unshift({ id: '__filter__', text: params.term, filter: true, count: results.length });
          return { results };
        },
        cache: true
      },
      language: {
        inputTooShort: () => 'Type to search products…',
        searching: () => 'Searching…',
        noResults: () => 'No products found'
      },
      escapeMarkup: m => m,
      templateResult: item => {
        if (item.loading) return item.text;
        if (item.filter) {
          return '<div class="pm-s2-item text-primary"><div class="pm-s2-ph"><i class="bi bi-funnel"></i></div>' +
                 '<div><div class="pm-s2-name">Show all results for “' + escapeHtml(item.text) + '”</div>' +
                 '<div class="pm-s2-meta">Filter the catalog table</div></div></div>';
        }
        const img = item.image ? '<img src="' + escapeHtml(item.image) + '" alt="">'
                               : '<div class="pm-s2-ph"><i class="bi bi-box-seam"></i></div>';
        const statusBadge = item.status === 'active'
          ? '<span class="badge bg-success-subtle text-success ms-1">Active</span>'
          : '<span class="badge bg-secondary-subtle text-secondary ms-1">' + escapeHtml(item.status || 'inactive') + '</span>';
        const stockCls = item.stock > 0 ? 'text-success' : 'text-danger';
        return '<div class="pm-s2-item">' + img +
               '<div class="text-truncate"><div class="pm-s2-name text-truncate">' + highlight(item.text, lastTerm) + statusBadge + '</div>' +
               '<div class="pm-s2-meta">' + escapeHtml(item.category || 'No Category') + (item.sku ? ' · SKU ' + escapeHtml(item.sku) : '') + '</div></div>' +
               '<div class="pm-s2-price">₹' + Number(item.price || 0).toLocaleString('en-IN') +
               '<div class="pm-s2-meta ' + stockCls + '">' + item.stock + ' ' + escapeHtml(item.unit || '') + '</div></div></div>';
      },
      templateSelection: item => escapeHtml(item.text || 'Search products by name or SKU…')
    });

    $search.on('select2:select', function(e) {
      const item = e.params.data;
      const url = new URL(window.location.href);
      url.searchParams.delete('page');
      if (item.filter) {
        url.searchParams.set('search', item.text);
        window.location.href = url.toString();
      } else if (item.url) {
        window.location.href = item.url;
      }
    });

    $search.on('select2:clear', function() {
      const url = new URL(window.location.href);
      if (!url.searchParams.has('search')) return;
      url.searchParams.delete('search');
      url.searchParams.delete('page');
      window.location.href = url.toString();
    });

    $search.on('select2:open', () => document.querySelector('.select2-container--open .select2-search__field')?.focus());
  }

  // Select All checkbox + bulk action bar
  const selectAll = document.getElementById('selectAllProducts');
  const productCheckboxes = document.querySelectorAll('.product-checkbox');
  const bulkBar = document.getElementById('bulkActionBar');
  const selectedCount = document.getElementById('selectedCount');
  const bulkActionInput = document.getElementById('bulkActionInput');

  function updateBulkBar() {
    const checked = document.querySelectorAll('.product-checkbox:checked').length;
    if (checked > 0) {
      bulkBar?.classList.remove('d-none');
      if (selectedCount) selectedCount.textContent = checked + ' product' + (checked === 1 ? '' : 's') + ' selected';
    } else {
      bulkBar?.classList.add('d-none');
    }
    if (selectAll) {
      selectAll.indeterminate = checked > 0 && checked < productCheckboxes.length;
      selectAll.checked = checked === productCheckboxes.length && productCheckboxes.length > 0;
    }
  }

  selectAll?.addEventListener('change', function() {
    productCheckboxes.forEach(cb => cb.checked = this.checked);
    updateBulkBar();
  });

  productCheckboxes.forEach(cb => cb.addEventListener('change', updateBulkBar));

  // Bulk action buttons (activate / deactivate / delete)
  document.querySelectorAll('[data-bulk-action]').forEach(btn => {
    btn.addEventListener('click', function() {
      const action = this.dataset.bulkAction;
      const checked = document.querySelectorAll('.product-checkbox:checked');
      if (checked.length === 0) return;

      const confirmMessages = {
        delete: 'Delete ' + checked.length + ' selected product(s)?\n\nEach product\'s stock batches, movements, wishlists, subscriptions, etc. are removed with it. This cannot be undone.',
        deactivate: 'Deactivate ' + checked.length + ' selected product(s)?',
        activate: 'Activate ' + checked.length + ' selected product(s)?'
      };

      if (!confirm(confirmMessages[action] || 'Confirm action?')) return;

      bulkActionInput.value = action;
      document.getElementById('bulkActionForm').submit();
    });
  });
});
</script>

<%= render 'admin/products/delete_loading_overlay' %>


<!-- Products Table -->
<div class="card border-0 shadow-sm pm-catalog">
  <div class="card-header bg-white">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
      <div class="d-flex align-items-center gap-2">
        <h5 class="mb-0 fw-bold"><i class="bi bi-grid-3x3-gap text-primary me-2"></i>Product Catalog</h5>
        <% if params[:search].present? %>
          <span class="badge rounded-pill bg-primary-subtle text-primary border">
            “<%= params[:search] %>”
            <%= link_to admin_products_path(request.query_parameters.except('search', 'page')), class: "text-primary ms-1 text-decoration-none", title: "Clear search" do %><i class="bi bi-x-circle-fill"></i><% end %>
          </span>
        <% end %>
      </div>
      <div class="pm-search-wrap position-relative">
        <i class="bi bi-search pm-search-icon"></i>
        <select id="productQuickSearch" class="form-select">
          <% if params[:search].present? %>
            <option value="__filter__" selected><%= params[:search] %></option>
          <% end %>
        </select>
      </div>
    </div>
  </div>

  <!-- Bulk Action Bar (hidden until items selected) -->
  <div id="bulkActionBar" class="d-none px-3 py-2 bg-primary-subtle border-bottom d-flex align-items-center gap-3 flex-wrap">
    <span id="selectedCount" class="fw-medium text-primary small"></span>
    <button type="button" class="btn btn-sm btn-primary" id="bulkEditBtn">
      <i class="bi bi-pencil-square me-1"></i>Bulk Edit
    </button>
    <button type="button" class="btn btn-sm btn-success" data-bulk-action="activate">
      <i class="bi bi-check-circle me-1"></i>Activate
    </button>
    <button type="button" class="btn btn-sm btn-warning" data-bulk-action="deactivate">
      <i class="bi bi-dash-circle me-1"></i>Deactivate
    </button>
    <button type="button" class="btn btn-sm btn-danger" data-bulk-action="delete">
      <i class="bi bi-trash me-1"></i>Delete Selected
    </button>
  </div>

  <div class="card-body p-0">
    <% if @products.any? %>
      <%= form_with url: bulk_action_admin_products_path, method: :post, id: "bulkActionForm", local: true do %>
        <%= hidden_field_tag :bulk_action, '', id: 'bulkActionInput' %>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th class="border-0" style="width: 40px;">
                  <input type="checkbox" id="selectAllProducts" class="form-check-input">
                </th>
                <th class="border-0 fw-semibold"><%= sort_header('Product', 'name', first_direction: 'asc') %></th>
                <th class="border-0 fw-semibold"><%= sort_header('Category', 'category', first_direction: 'asc') %></th>
                <th class="border-0 fw-semibold"><%= sort_header('Price & Profit', 'price') %></th>
                <th class="border-0 fw-semibold"><%= sort_header('Stock', 'stock') %></th>
                <th class="border-0 fw-semibold"><%= sort_header('Status', 'status', first_direction: 'asc') %></th>
                <th class="border-0 fw-semibold">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @products.each do |product| %>
                <%# .to_json never escapes apostrophes, which would otherwise break out of
                    this single-quoted HTML attribute for any name like "Farmer's Choice" —
                    ' is a valid JSON escape for it that stays inert as HTML text. %>
                <tr data-product-id="<%= product.id %>"
                    data-product='<%= {
                      id: product.id, name: product.name, price: product.price.to_f,
                      buying_price: product.buying_price.to_f, stock: product.stock.to_i,
                      unit_type: product.unit_type, status: product.status,
                      category_id: product.category_id,
                      has_variants: product.has_multiple_quantities?,
                      variants: product.product_variants.sort_by { |v| [v.display_order || 0, v.weight.to_f] }.map { |v|
                        { id: v.id, label: v.label, unit: v.unit, weight: v.weight.to_f,
                          selling_price: v.selling_price.to_f, buying_price: v.buying_price.to_f,
                          available_stock: v.available_stock.to_i }
                      }
                    }.to_json.gsub("'", "\\u0027") %>'>
                  <td class="align-middle">
                    <input type="checkbox" name="product_ids[]" value="<%= product.id %>" class="form-check-input product-checkbox">
                  </td>
                  <td class="align-middle">
                    <div class="d-flex align-items-center">
                      <div class="position-relative me-3">
                        <% if product.r2_image_url.present? %>
                          <img src="<%= product.r2_image_url %>"
                               alt="<%= product.name %>"
                               class="rounded-circle object-fit-cover"
                               style="width: 40px; height: 40px;">
                        <% elsif product.main_image_url.present? %>
                          <img src="<%= product.main_image_url(width: 60, height: 60) %>"
                               alt="<%= product.name %>"
                               class="rounded-circle object-fit-cover"
                               style="width: 40px; height: 40px;">
                        <% elsif product.image.attached? %>
                          <%= image_tag product.image,
                              alt: product.name,
                              class: "rounded-circle object-fit-cover",
                              style: "width: 40px; height: 40px;" %>
                        <% else %>
                          <div class="avatar-sm bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="bi bi-box-seam text-primary"></i>
                          </div>
                        <% end %>
                      </div>
                      <div>
                        <h6 class="mb-0">
                          <%= product.name %>
                          <% variant_count = product.product_variants.size %>
                          <% if variant_count > 0 %>
                            <span class="badge bg-info-subtle text-info border ms-1">
                              <i class="bi bi-diagram-3 me-1"></i><%= pluralize(variant_count, 'variant') %>
                            </span>
                          <% end %>
                        </h6>
                        <small class="text-muted">SKU: <%= product.sku || 'N/A' %></small>
                        <% if product.image_url.present? %>
                          <small class="text-success d-block">
                            <i class="bi bi-cloud-check me-1"></i>Cloudinary
                          </small>
                        <% elsif product.image.attached? %>
                          <small class="text-info d-block">
                            <i class="bi bi-server me-1"></i>Local
                          </small>
                        <% end %>
                      </div>
                    </div>
                  </td>
                  <td class="align-middle">
                    <span class="badge bg-secondary-subtle text-secondary"><%= product.category&.name || 'No Category' %></span>
                  </td>
                  <td class="align-middle">
                    <div>
                      <!-- Selling Price -->
                      <div class="d-flex align-items-center gap-2">
                        <span class="fw-medium">
                          <%= product.respond_to?(:formatted_selling_price) ? product.formatted_selling_price : number_to_currency(product.final_price_after_discount) %>
                        </span>
                        <% if product.discounted? %>
                          <small class="badge bg-success-subtle text-success">
                            <%= product.discount_percentage.round(1) %>% OFF
                          </small>
                        <% end %>
                      </div>

                      <!-- Discount Info -->
                      <% if product.discounted? %>
                        <small class="text-muted text-decoration-line-through">
                          MRP: <%= number_to_currency(product.original_price || product.price) %>
                        </small>
                        <br>
                      <% end %>

                      <!-- Profit Info -->
                      <% if product.buying_price.present? %>
                        <div class="small mt-1">
                          <span class="text-muted">Cost: ₹<%= product.buying_price.round(2) %></span>
                          <span class="mx-1">•</span>
                          <span class="<%= product.profit_status_class %> fw-medium">
                            Profit: ₹<%= product.profit_amount.round(2) %>
                          </span>
                          <% if product.profit_percentage != 0 %>
                            <span class="mx-1">•</span>
                            <span class="<%= product.profit_status_class %> fw-medium">
                              <%= product.profit_margin_percentage.round(1) %>%
                            </span>
                          <% end %>
                        </div>
                        <div class="small">
                          <span class="badge bg-<%= product.profitable? ? 'success' : (product.profit_amount == 0 ? 'warning' : 'danger') %>-subtle text-<%= product.profitable? ? 'success' : (product.profit_amount == 0 ? 'warning' : 'danger') %>">
                            <%= product.profit_status %>
                          </span>
                        </div>
                      <% else %>
                        <small class="text-muted">No cost price set</small>
                      <% end %>
                    </div>
                  </td>
                  <td class="align-middle">
                    <% total_stock = product.total_stock %>
                    <% if total_stock > 0 %>
                      <span class="text-success fw-medium"><%= total_stock %> <%= product.unit_type %></span>
                      <div class="small text-muted">In Stock<%= " · #{product.product_variants.size} variants" if product.has_multiple_quantities? && product.product_variants.any? %></div>
                    <% else %>
                      <span class="text-danger fw-medium">0 <%= product.unit_type %></span>
                      <div class="small text-muted">Out of Stock</div>
                    <% end %>
                  </td>
                  <td class="align-middle">
                    <% case product.status %>
                    <% when 'active' %>
                      <span class="badge bg-success-subtle text-success">
                        <i class="bi bi-check-circle me-1"></i>
                        Active
                      </span>
                    <% when 'inactive' %>
                      <span class="badge bg-danger-subtle text-danger">
                        <i class="bi bi-x-circle me-1"></i>
                        Inactive
                      </span>
                    <% when 'draft' %>
                      <span class="badge bg-warning-subtle text-warning">
                        <i class="bi bi-clock me-1"></i>
                        Draft
                      </span>
                    <% else %>
                      <span class="badge bg-secondary-subtle text-secondary"><%= product.status&.humanize || 'Unknown' %></span>
                    <% end %>
                  </td>
                  <td class="align-middle">
                    <div class="dropdown">
                      <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <i class="bi bi-three-dots"></i>
                      </button>
                      <ul class="dropdown-menu">
                        <li>
                          <%= link_to admin_product_path(product), class: "dropdown-item" do %>
                            <i class="bi bi-eye me-2"></i>
                            View Details
                          <% end %>
                        </li>
                        <li>
                          <%= link_to edit_admin_product_path(product), class: "dropdown-item" do %>
                            <i class="bi bi-pencil me-2"></i>
                            Edit Product
                          <% end %>
                        </li>
                        <li>
                          <%= link_to manage_images_admin_product_path(product), class: "dropdown-item" do %>
                            <i class="bi bi-image me-2"></i>
                            Change Image
                          <% end %>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                          <%= link_to admin_product_path(product),
                              class: "dropdown-item text-danger delete-product-btn",
                              data: {
                                product_name: product.name
                              } do %>
                            <i class="bi bi-trash me-2"></i>
                            Delete Product
                          <% end %>
                        </li>
                      </ul>
                    </div>
                  </td>
                </tr>
              <% end %>

            </tbody>
          </table>
        </div>
      <% end %>

      <!-- Pagination -->
      <% if respond_to?(:paginate) && @products.respond_to?(:total_pages) %>
        <div class="card-footer bg-transparent border-0">
          <%= paginate @products %>
        </div>
      <% end %>

      <!-- Bulk Edit Form (hidden, submitted by the modal) -->
      <form id="bulkEditForm" method="post" action="<%= bulk_update_admin_products_path %>">
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <div id="bulkEditFields"></div>
      </form>
    <% else %>
      <div class="text-center py-5">
        <div class="mb-3">
          <i class="bi bi-box-seam fs-1 text-muted"></i>
        </div>
        <% if params[:search].present? %>
          <h5 class="text-muted mb-3">No products found for "<%= params[:search] %>"</h5>
          <p class="text-muted mb-4">We couldn't find any matching products. You can create a new one instead.</p>
          <%= link_to new_admin_product_path(name: params[:search]), class: "btn btn-primary" do %>
            <i class="bi bi-plus-lg me-1"></i>Create "<%= params[:search] %>"
          <% end %>
        <% else %>
          <h5 class="text-muted mb-3">No Products Found</h5>
          <p class="text-muted mb-4">Start by adding your first product to build your catalog and manage inventory.</p>
          <%= link_to "Add Product", new_admin_product_path, class: "btn btn-primary" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<!-- Bulk Edit Modal -->
<div class="modal fade" id="bulkEditModal" tabindex="-1" aria-labelledby="bulkEditModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="bulkEditModalLabel">
          <i class="bi bi-pencil-square me-2"></i>Bulk Edit Products
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-0">
        <div class="alert alert-light border-0 rounded-0 mb-0 py-2 px-3 small text-muted">
          <i class="bi bi-info-circle me-1"></i>
          Products with variants show their variant rows below them — edit price &amp; stock there.
        </div>
        <div class="table-responsive">
          <table class="table table-bordered align-middle mb-0" id="bulkEditTable">
            <thead class="sticky-top" style="background:#f1f3f5;">
              <tr>
                <th style="min-width:160px;">Product / Variant</th>
                <th style="min-width:100px;">Sell Price (₹)</th>
                <th style="min-width:100px;">Cost Price (₹)</th>
                <th style="min-width:80px;">Stock</th>
                <th style="min-width:110px;">Unit</th>
                <th style="min-width:100px;">Status</th>
                <th style="min-width:140px;">Category</th>
              </tr>
            </thead>
            <tbody id="bulkEditBody">
            </tbody>
          </table>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="bulkEditSaveBtn">
          <i class="bi bi-check-lg me-1"></i>Save All Changes
        </button>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  const UNIT_TYPES = <%= Product::UNIT_TYPES.map(&:last).to_json.html_safe %>;
  const CATEGORIES = <%= @categories.map { |c| [c.id, c.name] }.to_json.html_safe %>;
  const STATUSES   = [['active','Active'],['inactive','Inactive'],['draft','Draft']];

  function buildSelect(name, options, selected, extraClass) {
    let html = `<select name="${name}" class="form-select form-select-sm ${extraClass||''}">`;
    options.forEach(([val, label]) => {
      html += `<option value="${val}"${val == selected ? ' selected' : ''}>${label}</option>`;
    });
    html += '</select>';
    return html;
  }

  function escHtml(str) {
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function openBulkEditModal() {
    const checked = document.querySelectorAll('.product-checkbox:checked');
    if (checked.length === 0) return;

    const tbody = document.getElementById('bulkEditBody');
    tbody.innerHTML = '';

    checked.forEach(cb => {
      const row = cb.closest('tr');
      const p   = JSON.parse(row.dataset.product);
      const id  = p.id;

      const unitOptions = UNIT_TYPES.map(u => [u, u]);
      const hasVariants = p.has_variants && p.variants && p.variants.length > 0;
      const dis         = hasVariants ? 'disabled' : '';

      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td>
          <input type="text" name="products[${id}][name]"
                 class="form-control form-control-sm"
                 value="${escHtml(p.name)}" required>
          ${hasVariants ? `<span class="badge bg-info-subtle text-info mt-1"><i class="bi bi-diagram-3 me-1"></i>${p.variants.length} variant${p.variants.length !== 1 ? 's' : ''} — edit below</span>` : ''}
        </td>
        <td>
          <input type="number" name="products[${id}][price]"
                 class="form-control form-control-sm ${dis ? 'bg-light' : ''}"
                 value="${p.price}" min="0" step="0.01" ${dis}
                 ${dis ? 'title="Set on the variant rows below"' : ''}>
        </td>
        <td>
          <input type="number" name="products[${id}][buying_price]"
                 class="form-control form-control-sm"
                 value="${p.buying_price}" min="0" step="0.01">
        </td>
        <td>
          <input type="number" name="products[${id}][stock]"
                 class="form-control form-control-sm ${dis ? 'bg-light' : ''}"
                 value="${p.stock}" min="0" step="1" ${dis}
                 ${dis ? 'title="Set on the variant rows below"' : ''}>
        </td>
        <td>${buildSelect(`products[${id}][unit_type]`, unitOptions, p.unit_type)}</td>
        <td>${buildSelect(`products[${id}][status]`, STATUSES, p.status)}</td>
        <td>${buildSelect(`products[${id}][category_id]`, CATEGORIES, p.category_id)}</td>
      `;
      tbody.appendChild(tr);

      if (hasVariants) {
        p.variants.forEach(v => {
          const vtr = document.createElement('tr');
          vtr.className = 'table-light';
          vtr.innerHTML = `
            <td class="ps-4">
              <i class="bi bi-arrow-return-right text-muted me-1"></i>
              <span class="fw-medium">${escHtml(v.label)}</span>
            </td>
            <td>
              <input type="number" name="variants[${v.id}][selling_price]"
                     class="form-control form-control-sm" value="${v.selling_price}" min="0" step="0.01">
            </td>
            <td>
              <input type="number" name="variants[${v.id}][buying_price]"
                     class="form-control form-control-sm" value="${v.buying_price}" min="0" step="0.01">
            </td>
            <td>
              <input type="number" name="variants[${v.id}][available_stock]"
                     class="form-control form-control-sm" value="${v.available_stock}" min="0" step="1">
            </td>
            <td class="text-muted small align-middle">${escHtml(v.unit)}</td>
            <td colspan="2" class="text-muted small align-middle">Variant stock is edited directly (no batches)</td>
          `;
          tbody.appendChild(vtr);
        });
      }
    });

    new bootstrap.Modal(document.getElementById('bulkEditModal')).show();
  }

  document.getElementById('bulkEditBtn')?.addEventListener('click', openBulkEditModal);

  (function(init) {
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  })(function() {
    document.getElementById('bulkEditSaveBtn')?.addEventListener('click', function() {
      const tbody = document.getElementById('bulkEditBody');
      if (tbody.children.length === 0) return;

      const btn = this;
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Saving…';

      const container = document.getElementById('bulkEditFields');
      container.innerHTML = '';
      tbody.querySelectorAll('input, select').forEach(el => {
        if (el.disabled || !el.name) return; // disabled = variant-driven, skip
        const hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = el.name;
        hidden.value = el.value;
        container.appendChild(hidden);
      });

      document.getElementById('bulkEditForm').submit();
    });
  });
})();
</script>
