// Upload business logo to R2 via AJAX as soon as a file is picked
document.getElementById('logo_file_input')?.addEventListener('change', function() {
  const fileInput = this;
  const file = fileInput.files[0];
  if (!file) return;

  const errorDiv = document.getElementById('logo_upload_error');
  const previewImg = document.getElementById('logo_preview_img');
  const logoUrlField = document.getElementById('logo_url_field');

  errorDiv.style.display = 'none';

  const formData = new FormData();
  formData.append('logo', file);

  fetch('<%= admin_settings_system_upload_logo_path %>', {
    method: 'POST',
    headers: {
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
    },
    body: formData
  })
    .then(response => response.json())
    .then(data => {
      if (data.error) {
        errorDiv.textContent = data.error;
        errorDiv.style.display = 'block';
        return;
      }

      logoUrlField.value = data.public_url;
      previewImg.src = data.public_url;
      previewImg.style.display = '';
    })
    .catch(function() {
      errorDiv.textContent = 'Failed to upload logo. Please try again.';
      errorDiv.style.display = 'block';
    });
});

// Website Images: multi-file upload with immediate save-and-display, plus
// per-thumbnail delete. Each selected file uploads one at a time so the
// server-side max-images cap (enforced in SystemSetting.add_image) rejects
// cleanly file-by-file instead of failing a whole batch.
(function() {
  function setupGallery(config) {
    const input = document.getElementById(config.inputId);
    const grid = document.getElementById(config.gridId);
    const errorDiv = document.getElementById(config.errorId);
    const countSpan = document.getElementById(config.countId);
    if (!input) return;

    const csrfToken = document.querySelector('meta[name="csrf-token"]').content;

    input.addEventListener('change', function() {
      const files = Array.from(input.files || []);
      input.value = '';
      if (!files.length) return;
      errorDiv.style.display = 'none';
      uploadNext(files, 0);
    });

    function uploadNext(files, index) {
      if (index >= files.length) return;

      const formData = new FormData();
      formData.append('image', files[index]);

      fetch(config.uploadUrl, {
        method: 'POST',
        headers: { 'X-CSRF-Token': csrfToken },
        body: formData
      })
        .then(response => response.json())
        .then(data => {
          if (data.error) {
            errorDiv.textContent = data.error;
            errorDiv.style.display = 'block';
            return;
          }
          addThumbnail(data.public_url);
          countSpan.textContent = data.images.length + ' / ' + config.max + ' uploaded';
        })
        .catch(function() {
          errorDiv.textContent = 'Failed to upload image. Please try again.';
          errorDiv.style.display = 'block';
        })
        .finally(function() {
          uploadNext(files, index + 1);
        });
    }

    function addThumbnail(url) {
      const col = document.createElement('div');
      col.className = 'col-auto website-image-thumb';
      col.dataset.url = url;
      col.innerHTML = '<div class="position-relative border rounded" style="width:120px;height:120px;">' +
        '<img src="' + url + '" alt="" class="w-100 h-100 rounded website-image-preview" style="object-fit: cover; cursor: zoom-in;">' +
        '<button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1 p-0 website-image-remove" ' +
        'style="width:24px;height:24px;line-height:1;"><i class="bi bi-x"></i></button></div>';
      grid.appendChild(col);
    }

    grid.addEventListener('click', function(e) {
      const previewImg = e.target.closest('.website-image-preview');
      if (previewImg) {
        openImagePreview(previewImg.src);
        return;
      }

      const btn = e.target.closest('.website-image-remove');
      if (!btn) return;
      const thumb = btn.closest('.website-image-thumb');
      const url = thumb.dataset.url;

      fetch(config.deleteUrl + '?image_url=' + encodeURIComponent(url), {
        method: 'DELETE',
        headers: { 'X-CSRF-Token': csrfToken }
      })
        .then(response => response.json())
        .then(data => {
          if (data.error) {
            errorDiv.textContent = data.error;
            errorDiv.style.display = 'block';
            return;
          }
          thumb.remove();
          countSpan.textContent = data.images.length + ' / ' + config.max + ' uploaded';
        })
        .catch(function() {
          errorDiv.textContent = 'Failed to delete image. Please try again.';
          errorDiv.style.display = 'block';
        });
    });
  }

  setupGallery({
    inputId: 'home_page_images_input',
    gridId: 'home_page_images_grid',
    errorId: 'home_page_images_error',
    countId: 'home_page_images_count',
    uploadUrl: '<%= admin_settings_system_upload_home_page_image_path %>',
    deleteUrl: '<%= admin_settings_system_delete_home_page_image_path %>',
    max: <%= SystemSetting::HOME_PAGE_IMAGES_MAX %>
  });

  setupGallery({
    inputId: 'site_gallery_images_input',
    gridId: 'site_gallery_images_grid',
    errorId: 'site_gallery_images_error',
    countId: 'site_gallery_images_count',
    uploadUrl: '<%= admin_settings_system_upload_gallery_image_path %>',
    deleteUrl: '<%= admin_settings_system_delete_gallery_image_path %>',
    max: <%= SystemSetting::SITE_GALLERY_IMAGES_MAX %>
  });
})();

// Tab Management - Manual implementation to ensure it works
document.addEventListener('DOMContentLoaded', function() {
  const tabs = document.querySelectorAll('#systemTabs button');
  const panes = document.querySelectorAll('.tab-pane');

  function showTab(targetId) {
    // Hide all panes and deactivate all tabs
    panes.forEach(pane => {
      pane.classList.remove('show', 'active');
    });
    tabs.forEach(tab => {
      tab.classList.remove('active');
      tab.setAttribute('aria-selected', 'false');
    });

    // Show the target pane and activate the corresponding tab
    const targetPane = document.querySelector(targetId);
    const targetTab = document.querySelector(`[data-bs-target="${targetId}"]`);

    if (targetPane && targetTab) {
      targetPane.classList.add('show', 'active');
      targetTab.classList.add('active');
      targetTab.setAttribute('aria-selected', 'true');
    }
  }

  // Add click listeners to tabs
  tabs.forEach(tab => {
    tab.addEventListener('click', function(e) {
      e.preventDefault();
      const target = this.getAttribute('data-bs-target');
      if (target) {
        showTab(target);
        localStorage.setItem('systemActiveTab', target);
      }
    });
  });

  // Show default tab (Business Settings) or restore from localStorage
  const savedTab = localStorage.getItem('systemActiveTab');
  if (savedTab && document.querySelector(savedTab)) {
    showTab(savedTab);
  } else {
    showTab('#business-settings');
  }
});

// UPI Functions
function copyUpiId() {
  const upiId = document.getElementById('upi-id')?.textContent;
  if (upiId) {
    navigator.clipboard.writeText(upiId).then(function() {
      alert('UPI ID copied to clipboard!');
    }, function() {
      alert('Failed to copy UPI ID');
    });
  }
}

