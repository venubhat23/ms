  corporate: 'Corporate Navy',
  saffron:   'Saffron Warm',
  minimal:   'Minimal B&W',
  proforma:  'Proforma Invoice'
};

let _previewCurrentTemplate = null;

function openTemplatePreview(templateName) {
  const spinner   = document.getElementById('previewLoadingSpinner');
  const content   = document.getElementById('invoicePreviewContent');
  const errorMsg  = document.getElementById('previewErrorMsg');
  const badge     = document.getElementById('previewTemplateBadge');

  // Reset state
  spinner.style.display  = 'flex';
  content.style.display  = 'none';
  content.innerHTML      = '';
  errorMsg.style.display = 'none';
  badge.textContent      = templateLabels[templateName] || templateName;
  _previewCurrentTemplate = templateName;

  // Move modal to <body> to escape .main-content fixed stacking context
  const modalEl = document.getElementById('invoiceTemplatePreviewModal');
  if (modalEl.parentElement !== document.body) {
    document.body.appendChild(modalEl);
  }
  const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
  modal.show();

  // Fetch rendered template HTML inline (no outer layout, no iframe)
  const url = '<%= admin_settings_preview_invoice_template_path %>?template=' + encodeURIComponent(templateName) + '&inline=1';
  fetch(url, { credentials: 'same-origin', headers: { 'Accept': 'text/html' } })
    .then(function(response) {
      if (!response.ok) throw new Error('HTTP ' + response.status);
      return response.text();
    })
    .then(function(html) {
      if (_previewCurrentTemplate !== templateName) return; // stale response
      content.innerHTML     = html;
      spinner.style.display = 'none';
      content.style.display = 'block';
    })
    .catch(function() {
      spinner.style.display  = 'none';
      errorMsg.style.display = 'block';
    });
}

// Retry link
document.addEventListener('DOMContentLoaded', function() {
  var retryLink = document.getElementById('previewRetryLink');
  if (retryLink) {
    retryLink.addEventListener('click', function(e) {
      e.preventDefault();
      if (_previewCurrentTemplate) openTemplatePreview(_previewCurrentTemplate);
    });
  }
});
</script>