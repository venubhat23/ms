                  <%= link_to new_admin_store_path, class: "btn btn-outline-success" do %>
                    <i class="bi bi-plus-circle me-2"></i>
                    Add New Store
                  <% end %>
                <% else %>
                  <button class="btn btn-outline-secondary" disabled>
                    <i class="bi bi-plus-circle me-2"></i>
                    Add New Store (Limit Reached)
                  </button>
                <% end %>
              <% else %>
                <div class="alert alert-warning">
                  <small>
                    <i class="bi bi-info-circle me-1"></i>
                    Enable the feature to access store management.
                  </small>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Help Card -->
