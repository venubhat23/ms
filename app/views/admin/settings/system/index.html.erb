            <%= form_with url: admin_settings_system_path, method: :patch, local: true, id: "otp-login-form" do |form| %>
              <%= form.hidden_field :otp_login_settings_update, value: "true" %>

              <div class="row">
                <div class="col-md-12">
                  <div class="form-check form-switch mb-3">
                    <%= form.check_box :otp_login_enabled,
                          { checked: @otp_login_enabled,
