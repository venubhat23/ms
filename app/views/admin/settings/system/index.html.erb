                    <%= form.text_area :shop_addresses,
                          rows: 6,
                          class: "form-control",
                          placeholder: "Enter each shop address on a new line:\n\nShop 1: 123 Main Street, City - 12345\nShop 2: 456 Market Road, Town - 67890\nShop 3: 789 Central Avenue, Village - 54321",
