          <div class="card-body">
            <h6 class="text-muted">Collect From Store Feature:</h6>
            <ul class="small text-muted mb-0">
              <li>Enable customers to collect products from physical stores</li>
              <li>Maximum <%= Store::MAX_STORES_LIMIT %> stores allowed</li>
              <li>Stores must have contact details and address</li>
              <li>Only active stores appear in customer checkout</li>
              <li>Store selection is saved with each booking</li>
            </ul>
          </div>
        </div>
      </div>
