<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="mb-1 fw-bold"><i class="bi bi-arrow-left-right me-2"></i>Stock Transfer Requests</h4>
    <small class="text-muted"><%= @pending_count %> pending approval</small>
  </div>
</div>

<!-- Status Tabs -->
<ul class="nav nav-pills mb-4 gap-1">
  <%= link_to admin_stock_transfers_path, class: "nav-link #{'active' if params[:status].blank?}", style: "border-radius:8px;" do %>All<% end %>
  <%= link_to admin_stock_transfers_path(status: 'pending'), class: "nav-link #{'active' if params[:status] == 'pending'}", style: "border-radius:8px;" do %>Pending <span class="badge bg-warning ms-1"><%= @pending_count %></span><% end %>
  <%= link_to admin_stock_transfers_path(status: 'completed'), class: "nav-link #{'active' if params[:status] == 'completed'}", style: "border-radius:8px;" do %>Completed<% end %>
  <%= link_to admin_stock_transfers_path(status: 'rejected'), class: "nav-link #{'active' if params[:status] == 'rejected'}", style: "border-radius:8px;" do %>Rejected<% end %>
</ul>

<% pending_groups = @groups.select { |g| g[:status] == 'pending' } %>

<% if pending_groups.any? %>
  <!-- Bulk Approve/Reject Bar -->
  <form id="bulk_action_form" action="<%= bulk_approve_admin_stock_transfers_path %>" method="post" class="mb-3"
        data-turbo="false" data-bulk-form data-bulk-progress-url="<%= bulk_progress_admin_stock_transfers_path %>">
    <%= hidden_field_tag :_method, 'patch' %>
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
    <div class="d-flex align-items-center gap-2 p-3 bg-warning-subtle rounded flex-wrap" style="border:1px dashed #f0ad4e;">
      <input type="checkbox" id="select_all_groups" class="form-check-input mt-0" style="cursor:pointer;">
      <label for="select_all_groups" class="mb-0 text-warning-emphasis fw-semibold small">Select all pending requests</label>
      <input type="text" name="rejection_reason" placeholder="Rejection reason (optional, used only for Reject Selected)"
             class="form-control form-control-sm ms-2" style="max-width:280px;">
      <div class="d-flex gap-2 ms-auto">
        <button type="submit" formaction="<%= bulk_reject_admin_stock_transfers_path %>" data-verb="Reject"
                class="btn btn-outline-danger btn-sm" style="border-radius:6px;" onclick="return confirmBulk('reject')">
          <i class="bi bi-x-circle me-1"></i>Reject Selected
        </button>
        <button type="submit" formaction="<%= bulk_approve_admin_stock_transfers_path %>" data-verb="Approve"
                class="btn btn-warning btn-sm" style="border-radius:6px;" onclick="return confirmBulk('approve')">
          <i class="bi bi-check2-all me-1"></i>Approve Selected
        </button>
      </div>
    </div>
  </form>
<% end %>

<% if @groups.any? %>
  <div class="d-flex flex-column gap-3">
    <% @groups.each do |group| %>
      <% is_pending = group[:status] == 'pending' %>
      <div class="card border-0 shadow-sm" style="border-radius:14px; <%= is_pending ? 'border-left:4px solid #f0ad4e !important;' : '' %>">
        <!-- Group Header -->
        <div class="card-header d-flex align-items-center gap-3 py-3 px-4" style="background:#f8fafc; border-radius:14px 14px 0 0;">
          <% if is_pending %>
            <input type="checkbox" name="group_ids[]" form="bulk_action_form"
                   value="<%= group[:group_id] %>"
                   class="form-check-input group-checkbox mt-0" style="cursor:pointer;">
          <% end %>
          <div class="flex-grow-1"
               <% if group[:total_count] > 1 %>role="button" style="cursor:pointer;" onclick="openGroupItemsModal('<%= j group[:group_id] %>')"<% end %>>
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <span class="fw-semibold"><%= group[:from_store] %> &rarr; <%= group[:to_store] %></span>
              <% case group[:status]
                 when 'pending' %>
                <span class="badge bg-warning-subtle text-warning">Pending</span>
              <% when 'completed' %>
                <span class="badge bg-success-subtle text-success">Completed</span>
              <% when 'rejected' %>
                <span class="badge bg-danger-subtle text-danger">Rejected</span>
              <% else %>
                <span class="badge bg-secondary-subtle text-secondary"><%= group[:status]&.capitalize %></span>
              <% end %>
              <span class="text-muted small">
                <%= group[:total_count] %> product<%= group[:total_count] == 1 ? '' : 's' %>
              </span>
            </div>
            <div class="text-muted small mt-1">
              Requested by <strong><%= group[:requested_by]&.first_name %> <%= group[:requested_by]&.last_name %></strong>
              on <%= group[:created_at].strftime('%d %b %Y, %I:%M %p') %>
            </div>
            <% if group[:notes].present? %>
              <div class="text-muted small mt-1"><i class="bi bi-chat me-1"></i><%= group[:notes] %></div>
            <% end %>
          </div>

          <% if is_pending %>
            <div class="d-flex gap-2 align-items-start flex-shrink-0">
              <% if group[:total_count] > 1 %>
                <!-- Approve entire group -->
                <form action="<%= approve_group_admin_stock_transfers_path %>" method="post"
                      data-turbo="false" data-bulk-form data-verb="Approve"
                      data-bulk-progress-url="<%= bulk_progress_admin_stock_transfers_path %>">
                  <%= hidden_field_tag :_method, 'patch' %>
                  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                  <%= hidden_field_tag :group_id, group[:group_id] %>
                  <button type="submit" class="btn btn-success btn-sm" style="border-radius:6px; font-size:0.8rem;"
                          onclick="return confirm('Approve all <%= group[:total_count] %> products in this request?')">
                    <i class="bi bi-check2-all me-1"></i>Approve All
                  </button>
                </form>
                <button type="button" class="btn btn-outline-danger btn-sm" style="border-radius:6px; font-size:0.8rem;"
                        onclick="toggleGroupReject('<%= group[:group_id] %>')">
                  <i class="bi bi-x-circle me-1"></i>Reject All
                </button>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Reject All form (hidden) -->
        <% if is_pending && group[:total_count] > 1 %>
          <div id="group_reject_<%= group[:group_id] %>" style="display:none;" class="px-4 py-2 bg-danger-subtle">
            <form action="<%= reject_group_admin_stock_transfers_path %>" method="post" class="d-flex gap-2 align-items-center"
                  data-turbo="false" data-bulk-form data-verb="Reject"
                  data-bulk-progress-url="<%= bulk_progress_admin_stock_transfers_path %>">
              <%= hidden_field_tag :_method, 'patch' %>
              <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
              <%= hidden_field_tag :group_id, group[:group_id] %>
              <input type="text" name="rejection_reason" placeholder="Rejection reason (optional)" class="form-control form-control-sm" style="max-width:300px;">
              <button type="submit" class="btn btn-danger btn-sm" style="border-radius:6px;">Confirm Reject All</button>
              <button type="button" class="btn btn-outline-secondary btn-sm" style="border-radius:6px;"
                      onclick="toggleGroupReject('<%= group[:group_id] %>')">Cancel</button>
            </form>
          </div>
        <% end %>

        <!-- Products -->
        <div class="card-body p-0">
          <% if group[:total_count] > 1 %>
            <div class="d-flex align-items-center justify-content-between px-4 py-3">
              <div class="text-muted small">
                <i class="bi bi-box-seam me-1"></i>
                <%= group[:total_count] %> products in this request
              </div>
              <button type="button" class="btn btn-outline-primary btn-sm" style="border-radius:6px;"
                      onclick="openGroupItemsModal('<%= j group[:group_id] %>')">
                <i class="bi bi-eye me-1"></i>View all <%= group[:total_count] %> items
              </button>
            </div>
          <% else %>
            <%= render 'items_table', transfers: group[:transfers], stock_cache: group[:stock_cache] %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="d-flex justify-content-center mt-4">
    <%= paginate @page_data %>
  </div>
<% else %>
  <div class="card border-0 shadow-sm text-center py-5" style="border-radius:14px;">
    <i class="bi bi-arrow-left-right text-muted" style="font-size:2.5rem;"></i>
    <p class="text-muted mt-2 mb-0">No transfer requests found.</p>
  </div>
<% end %>

<script>
function rejectTransfer(id) {
  const form = document.getElementById('reject_form_' + id);
  form.style.display = form.style.display === 'none' ? 'block' : 'none';
}

function toggleGroupReject(groupId) {
  const el = document.getElementById('group_reject_' + groupId);
  el.style.display = el.style.display === 'none' ? 'block' : 'none';
}

// Select-all checkbox logic
const selectAll = document.getElementById('select_all_groups');
if (selectAll) {
  selectAll.addEventListener('change', function() {
    document.querySelectorAll('.group-checkbox').forEach(cb => cb.checked = this.checked);
  });
}

function confirmBulk(action) {
  const checked = document.querySelectorAll('.group-checkbox:checked').length;
  if (checked === 0) { alert('Please select at least one request.'); return false; }
  const verb = action === 'reject' ? 'Reject' : 'Approve';
  return confirm(verb + ' all selected ' + checked + ' request(s)?');
}

let groupItemsModalInstance = null;
function openGroupItemsModal(groupId) {
  if (!groupItemsModalInstance) {
    groupItemsModalInstance = new bootstrap.Modal(document.getElementById('groupItemsModal'));
  }
  const body = document.getElementById('groupItemsModalBody');
  body.innerHTML = '<div class="text-center py-5"><div class="spinner-border" style="color:#1C7C54;" role="status"></div><div class="text-muted small mt-2">Loading items&hellip;</div></div>';
  document.getElementById('groupItemsModalFullLink').href =
    '<%= show_group_admin_stock_transfers_path(group_id: "GROUP_ID_PLACEHOLDER") %>'.replace('GROUP_ID_PLACEHOLDER', encodeURIComponent(groupId));
  groupItemsModalInstance.show();

  fetch('<%= group_items_admin_stock_transfers_path %>?group_id=' + encodeURIComponent(groupId), { headers: { 'Accept': 'text/html' } })
    .then(function(r) { if (!r.ok) throw new Error('failed'); return r.text(); })
    .then(function(html) { body.innerHTML = html; })
    .catch(function() {
      body.innerHTML = '<div class="text-center py-5 text-danger"><i class="bi bi-exclamation-triangle fs-2 mb-2 d-block"></i>Failed to load items. Please try again.</div>';
    });
}
</script>

<!-- View Items Modal -->
<div class="modal fade" id="groupItemsModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable modal-lg">
    <div class="modal-content" style="border-radius:14px; border:none;">
      <div class="modal-header">
        <h6 class="modal-title fw-semibold mb-0"><i class="bi bi-box-seam me-2" style="color:#1C7C54;"></i>Request items</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-0" id="groupItemsModalBody"></div>
      <div class="modal-footer">
        <a href="#" id="groupItemsModalFullLink" class="btn btn-outline-secondary btn-sm me-auto" style="border-radius:6px;">
          <i class="bi bi-box-arrow-up-right me-1"></i>Open as full page
        </a>
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal" style="border-radius:6px;">Close</button>
      </div>
    </div>
  </div>
</div>

<%= render 'bulk_progress_modal' %>
<%= render 'simple_action_overlay' %>
