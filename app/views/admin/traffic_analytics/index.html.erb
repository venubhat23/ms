<% content_for :title, "Views & Traffic" %>
<%
  s = @stats
  views = s["views"].to_i
  visitors = s["visitors"].to_i
  clicks = s["clicks"].to_i
  prev_views = s["prev_views"].to_i
  prev_visitors = s["prev_visitors"].to_i
  change = ->(now, before) { before.zero? ? nil : ((now - before) * 100.0 / before).round(1) }
  views_change = change.(views, prev_views)
  visitors_change = change.(visitors, prev_visitors)
  returning = [visitors - s["new_visitors"].to_i, 0].max
  per_visitor = visitors.zero? ? 0 : (views.to_f / visitors).round(1)
  avg_time = views.zero? ? 0 : s["seconds"].to_f / views
  bounce = visitors.zero? ? 0 : (s["bounced"].to_i * 100.0 / visitors).round(1)
  device_icons = { "Mobile" => "bi-phone", "Desktop" => "bi-laptop", "Tablet" => "bi-tablet" }
  day_names = %w[Mon Tue Wed Thu Fri Sat Sun]
  heat = Array.new(7) { Array.new(24, 0) }
  s["heat"].each { |dow, hr, n| heat[dow - 1][hr] = n }
  heat_max = [heat.flatten.max.to_i, 1].max
  busiest_hour = s["hourly"].each_with_index.max_by(&:first)
  busiest_day = s["weekday"].each_with_index.max_by(&:first)
  hour_label = ->(h) { Time.zone.parse("#{h}:00").strftime("%-l %p") }
  single_day = @from_date == @to_date
  period_label = @range == "custom" ? "#{@from_date.strftime('%-d %b %Y')} – #{@to_date.strftime('%-d %b %Y')}" : Admin::TrafficAnalyticsController::RANGES[@range]
  sections = Admin::TrafficAnalyticsController::SECTIONS
  range_params = @filter_params.except(:section)
%>

<div class="ta-root">
  <!-- Header -->
  <div class="ta-header">
    <div>
      <h2 class="ta-title"><i class="bi bi-graph-up-arrow"></i> Views &amp; Traffic</h2>
      <div class="ta-url">
        <span class="ta-url-label">Public store</span>
        <a href="<%= @public_url %>" target="_blank" rel="noopener" class="ta-url-link"><%= @public_url %></a>
        <button type="button" class="ta-icon-btn" id="taCopyUrl" data-url="<%= @public_url %>" title="Copy link">
          <i class="bi bi-copy"></i>
        </button>
      </div>
    </div>
    <div class="ta-actions">
      <button type="button" class="ta-btn" id="taAutoRefresh" title="Reload the stats every 30 seconds">
        <i class="bi bi-arrow-repeat"></i> <span>Auto-refresh off</span>
      </button>
      <%= link_to admin_traffic_analytics_export_path(@filter_params), class: "ta-btn", data: { turbo: false } do %>
        <i class="bi bi-download"></i> Export CSV
      <% end %>
    </div>
  </div>

  <!-- Filters -->
  <div class="ta-filters">
    <div class="ta-sections" role="group" aria-label="Portal">
      <%= link_to "All portals", admin_traffic_analytics_path(range_params), class: "ta-section-pill #{'active' if @section == 'all'}" %>
      <% sections.each do |key, label| %>
        <%= link_to label, admin_traffic_analytics_path(range_params.merge(section: key)), class: "ta-section-pill #{'active' if @section == key}" %>
      <% end %>
    </div>
    <div class="ta-filter-row">
      <div class="ta-ranges" role="group" aria-label="Date range">
        <% Admin::TrafficAnalyticsController::RANGES.each do |key, label| %>
          <%= link_to label, admin_traffic_analytics_path(range: key, section: (@section unless @section == "all")), class: "ta-range #{'active' if key == @range}" %>
        <% end %>
      </div>
      <%= form_with url: admin_traffic_analytics_path, method: :get, class: "ta-custom", local: true do %>
        <% if @section != "all" %><%= hidden_field_tag :section, @section %><% end %>
        <label for="taFrom">From</label>
        <%= date_field_tag :from, @from_date, id: "taFrom", max: Time.zone.today %>
        <label for="taTo">to</label>
        <%= date_field_tag :to, @to_date, id: "taTo", max: Time.zone.today %>
        <button type="submit">Apply</button>
      <% end %>
    </div>
    <div class="ta-period">
      Showing <strong><%= period_label %></strong>
      <% if @section != "all" %> · <%= traffic_section_badge(@section) %><% end %>
    </div>
  </div>

  <!-- KPI tiles -->
  <div class="ta-kpis">
    <div class="ta-kpi">
      <div class="ta-kpi-label">Page views</div>
      <div class="ta-kpi-value"><%= number_with_delimiter(views) %></div>
      <% if views_change %>
        <div class="ta-delta <%= views_change >= 0 ? 'up' : 'down' %>">
          <i class="bi <%= views_change >= 0 ? 'bi-arrow-up-right' : 'bi-arrow-down-right' %>"></i>
          <%= views_change.abs %>% vs previous period
        </div>
      <% else %>
        <div class="ta-kpi-sub">No previous data to compare</div>
      <% end %>
    </div>
    <div class="ta-kpi">
      <div class="ta-kpi-label">Unique visitors</div>
      <div class="ta-kpi-value"><%= number_with_delimiter(visitors) %></div>
      <% if visitors_change %>
        <div class="ta-delta <%= visitors_change >= 0 ? 'up' : 'down' %>">
          <i class="bi <%= visitors_change >= 0 ? 'bi-arrow-up-right' : 'bi-arrow-down-right' %>"></i>
          <%= visitors_change.abs %>% vs previous period
        </div>
      <% else %>
        <div class="ta-kpi-sub"><%= number_with_delimiter(s["new_visitors"]) %> new · <%= number_with_delimiter(returning) %> returning</div>
      <% end %>
    </div>
    <div class="ta-kpi k2">
      <div class="ta-kpi-label">Clicks</div>
      <div class="ta-kpi-value"><%= number_with_delimiter(clicks) %></div>
      <div class="ta-kpi-sub"><%= visitors.zero? ? 0 : (clicks.to_f / visitors).round(1) %> clicks per visitor</div>
    </div>
    <div class="ta-kpi k3">
      <div class="ta-kpi-label">Avg. time on page</div>
      <div class="ta-kpi-value"><%= traffic_duration(avg_time) %></div>
      <div class="ta-kpi-sub"><%= per_visitor %> pages per visitor</div>
    </div>
    <div class="ta-kpi k4">
      <div class="ta-kpi-label">Logged-in users</div>
      <div class="ta-kpi-value"><%= number_with_delimiter(s["users"]) %></div>
      <div class="ta-kpi-sub">Bounce rate <%= bounce %>% (left after 1 page)</div>
    </div>
    <div class="ta-kpi">
      <div class="ta-kpi-label">Online now</div>
      <div class="ta-kpi-value"><span class="ta-live-dot"></span><%= number_with_delimiter(s["live"]) %></div>
      <div class="ta-kpi-sub">Active in the last 5 minutes</div>
    </div>
  </div>

  <% if views.zero? && clicks.zero? %>
    <div class="ta-card ta-empty">
      <i class="bi bi-binoculars"></i>
      <h5>No activity recorded for <%= period_label.downcase %> yet</h5>
      <p>Every page opened on the public store, customer, affiliate, franchise, store admin and admin portals is counted here,
        along with clicks and time on page. New activity appears within about 15 seconds.</p>
    </div>
  <% else %>

  <!-- Over time -->
  <div class="ta-card">
    <div class="ta-card-head">
      <h6><%= single_day ? "Views by hour" : "Views over time" %></h6>
      <div class="ta-legend">
        <span><i class="ta-swatch" style="background: var(--ta-s1)"></i>Page views</span>
        <% unless single_day %>
          <span><i class="ta-swatch" style="background: var(--ta-s2)"></i>Unique visitors</span>
          <span><i class="ta-swatch" style="background: var(--ta-s3)"></i>Clicks</span>
        <% end %>
      </div>
    </div>
    <div class="ta-chart-lg"><canvas id="taTimeline" aria-label="Views over time"></canvas></div>
  </div>

  <!-- Portals -->
  <% if @section == "all" && s["sections"].any? %>
    <div class="ta-card">
      <div class="ta-card-head"><h6><i class="bi bi-diagram-3"></i> By portal</h6><span class="ta-sub">Click a portal to filter the whole page</span></div>
      <div class="table-responsive">
        <table class="ta-table">
          <thead>
            <tr><th>Portal</th><th class="text-end">Views</th><th class="text-end">Visitors</th><th class="text-end">Clicks</th><th class="text-end">Avg. time</th><th class="ta-share-col">Share of views</th></tr>
          </thead>
          <tbody>
            <% s["sections"].each do |row| %>
              <% share = views.zero? ? 0 : (row["views"] * 100.0 / views).round(1) %>
              <tr>
                <td><%= link_to traffic_section_badge(row["name"]), admin_traffic_analytics_path(range_params.merge(section: row["name"])), class: "ta-link" %></td>
                <td class="text-end fw-semibold"><%= number_with_delimiter(row["views"]) %></td>
                <td class="text-end"><%= number_with_delimiter(row["visitors"]) %></td>
                <td class="text-end"><%= number_with_delimiter(row["clicks"]) %></td>
                <td class="text-end"><%= traffic_duration(row["views"].zero? ? 0 : row["seconds"].to_f / row["views"]) %></td>
                <td class="ta-share-col"><div class="ta-bar"><span style="width: <%= share %>%"></span></div><small><%= share %>%</small></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <!-- Live activity + people -->
  <div class="ta-grid-3">
    <div class="ta-card">
      <div class="ta-card-head">
        <h6><i class="bi bi-activity"></i> Live activity</h6>
        <span class="ta-sub">Latest <%= s["recent"].size %> events · click one to see that visitor's journey</span>
      </div>
      <% if s["recent"].empty? %>
        <p class="ta-muted mb-0">No activity yet.</p>
      <% else %>
        <ul class="ta-feed ta-scroll">
          <% s["recent"].each do |ev| %>
            <% who = ev["name"].presence || "Visitor #{ev['visitor_id'].to_s.first(6)}" %>
            <li>
              <%= traffic_kind_icon(ev["kind"]) %>
              <div class="ta-feed-main">
                <%= link_to who, traffic_journey_path(ev, @filter_params), class: "ta-link fw-semibold" %>
                <% case ev["kind"] %>
                <% when "click" %>
                  clicked <strong class="ta-ellipsis">“<%= ev["label"] %>”</strong> on <%= ev["page"] %>
                <% when "leave" %>
                  spent <strong><%= traffic_duration(ev["duration"]) %></strong> on <%= ev["page"] %>
                <% else %>
                  opened <strong><%= ev["page"] %></strong>
                <% end %>
                <span class="ta-sub">
                  <%= traffic_section_badge(ev["section"]) %>
                  <%= ev["kind"] == "click" && ev["target"].present? ? "→ #{ev['target']}" : ev["path"] %>
                  · <%= [ev["device"], ev["city"] || ev["country"]].compact.join(" · ") %>
                </span>
              </div>
              <span class="ta-feed-time" title="<%= traffic_time(ev['at'])&.strftime('%-d %b %Y, %-l:%M:%S %p') %>"><%= traffic_ago(ev["at"]) %></span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>

    <div class="ta-card">
      <div class="ta-card-head"><h6><i class="bi bi-people"></i> Who's using it</h6></div>
      <% if s["people"].empty? %>
        <p class="ta-muted mb-0">No logged-in users in this period. Anonymous visitors are listed in Live activity.</p>
      <% else %>
        <ul class="ta-feed ta-scroll">
          <% s["people"].each do |person| %>
            <li>
              <span class="ta-avatar"><%= traffic_initials(person["name"]) %></span>
              <div class="ta-feed-main">
                <%= link_to person["name"], traffic_journey_path(person, @filter_params), class: "ta-link fw-semibold" %>
                <span class="ta-sub"><%= person["role"] %><%= " · #{person['contact']}" if person["contact"].present? %></span>
                <span class="ta-sub">
                  <%= number_with_delimiter(person["views"]) %> views · <%= number_with_delimiter(person["clicks"]) %> clicks · <%= traffic_duration(person["seconds"]) %>
                </span>
              </div>
              <span class="ta-feed-time"><%= traffic_ago(person["last_seen"]) %></span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </div>

  <!-- When do people visit -->
  <div class="ta-grid-2">
    <div class="ta-card">
      <div class="ta-card-head">
        <h6>Busiest hours</h6>
        <span class="ta-chip"><i class="bi bi-clock"></i> Peak at <%= hour_label.(busiest_hour[1]) %></span>
      </div>
      <div class="ta-chart-md"><canvas id="taHours" aria-label="Views by hour of day"></canvas></div>
    </div>
    <div class="ta-card">
      <div class="ta-card-head">
        <h6>Day &amp; hour heatmap</h6>
        <span class="ta-chip"><i class="bi bi-calendar-week"></i> Busiest on <%= day_names[busiest_day[1]] %></span>
      </div>
      <div class="ta-heat" role="table" aria-label="Views by weekday and hour">
        <% heat.each_with_index do |row, d| %>
          <div class="ta-heat-row" role="row">
            <span class="ta-heat-day"><%= day_names[d] %></span>
            <% row.each_with_index do |n, h| %>
              <span class="ta-heat-cell" role="cell"
                    style="--ta-a: <%= n.zero? ? 0 : (0.12 + 0.88 * n / heat_max).round(3) %>"
                    data-tip="<%= day_names[d] %> <%= hour_label.(h) %> · <%= number_with_delimiter(n) %> views"></span>
            <% end %>
          </div>
        <% end %>
        <div class="ta-heat-row ta-heat-axis">
          <span class="ta-heat-day"></span>
          <% 24.times do |h| %><span><%= h % 6 == 0 ? hour_label.(h).sub(" ", "") : "" %></span><% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Top pages -->
  <div class="ta-card">
    <div class="ta-card-head"><h6>Most visited pages</h6></div>
    <div class="table-responsive">
      <table class="ta-table">
        <thead>
          <tr><th>Page</th><th class="text-end">Views</th><th class="text-end">Visitors</th><th class="text-end">Clicks</th><th class="text-end">Avg. time</th><th class="ta-share-col">Share</th></tr>
        </thead>
        <tbody>
          <% s["pages"].each do |p| %>
            <% share = views.zero? ? 0 : (p["views"] * 100.0 / views).round(1) %>
            <tr>
              <td>
                <div class="ta-page-name"><%= p["name"] %> <% if @section == "all" %><%= traffic_section_badge(p["section"]) %><% end %></div>
                <% if p["path"].include?(":") || p["section"] != "store" %>
                  <span class="ta-page-path"><%= p["path"] %></span>
                <% else %>
                  <a class="ta-page-path" href="<%= p["path"] %>" target="_blank" rel="noopener"><%= p["path"] %> <i class="bi bi-box-arrow-up-right"></i></a>
                <% end %>
              </td>
              <td class="text-end fw-semibold"><%= number_with_delimiter(p["views"]) %></td>
              <td class="text-end"><%= number_with_delimiter(p["visitors"]) %></td>
              <td class="text-end"><%= number_with_delimiter(p["clicks"]) %></td>
              <td class="text-end"><%= traffic_duration(p["seconds"].to_f / p["views"]) %></td>
              <td class="ta-share-col">
                <div class="ta-bar"><span style="width: <%= share %>%"></span></div>
                <small><%= share %>%</small>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Clicks -->
  <div class="ta-card">
    <div class="ta-card-head"><h6><i class="bi bi-hand-index"></i> Most clicked buttons &amp; links</h6></div>
    <% if s["clicked"].empty? %>
      <p class="ta-muted mb-0">No clicks recorded yet. Clicks are tracked on every page opened after this feature went live.</p>
    <% else %>
      <div class="table-responsive">
        <table class="ta-table">
          <thead>
            <tr><th>Clicked</th><th>Goes to</th><th>On page</th><th class="text-end">Clicks</th><th class="text-end">Visitors</th></tr>
          </thead>
          <tbody>
            <% s["clicked"].each do |c| %>
              <tr>
                <td class="fw-semibold"><span class="ta-ellipsis" title="<%= c['label'] %>"><%= c["label"].presence || "(no text)" %></span></td>
                <td><span class="ta-page-path ta-ellipsis" title="<%= c['target'] %>"><%= c["target"].presence || "—" %></span></td>
                <td><%= c["page"] %> <% if @section == "all" %><%= traffic_section_badge(c["section"]) %><% end %></td>
                <td class="text-end fw-semibold"><%= number_with_delimiter(c["clicks"]) %></td>
                <td class="text-end"><%= number_with_delimiter(c["visitors"]) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <!-- Devices -->
  <div class="ta-card">
    <div class="ta-card-head"><h6>Mobile or laptop?</h6></div>
    <div class="ta-devices">
      <% %w[Mobile Desktop Tablet].each do |name| %>
        <% row = s["devices"].find { |d| d["name"] == name } || { "views" => 0, "visitors" => 0 } %>
        <% pct = views.zero? ? 0 : (row["views"] * 100.0 / views).round(1) %>
        <div class="ta-device">
          <i class="bi <%= device_icons[name] %>"></i>
          <div class="ta-device-body">
            <div class="ta-device-top"><span><%= name == "Desktop" ? "Laptop / Desktop" : name %></span><strong><%= pct %>%</strong></div>
            <div class="ta-bar"><span style="width: <%= pct %>%"></span></div>
            <small><%= number_with_delimiter(row["views"]) %> views · <%= number_with_delimiter(row["visitors"]) %> visitors</small>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%
    lists = [
      ["Landing pages", "bi-box-arrow-in-right", s["entries"], "First page each visitor opened that day.", "visits"],
      ["Exit pages", "bi-box-arrow-right", s["exits"], "Last page each visitor opened that day.", "visits"],
      ["Top cities", "bi-geo-alt", s["cities"], "Location appears for visits after this feature went live.", nil],
      ["Countries", "bi-globe2", s["countries"], nil, nil],
      ["Where visitors came from", "bi-signpost-split", s["referrers"], "\"Direct\" = typed the URL, a bookmark, or a WhatsApp/app link.", nil],
      ["Campaigns (utm_source)", "bi-megaphone", s["campaigns"], "Add ?utm_source=instagram to links you share to see them here.", nil],
      ["Browsers", "bi-browser-chrome", s["browsers"], nil, nil],
      ["Operating systems", "bi-cpu", s["os"], nil, nil]
    ]
  %>
  <div class="ta-grid-2">
    <% lists.each do |title, icon, rows, note, unit| %>
      <div class="ta-card">
        <div class="ta-card-head"><h6><i class="bi <%= icon %>"></i> <%= title %></h6></div>
        <% if rows.empty? %>
          <p class="ta-muted mb-0">No data yet.</p>
        <% else %>
          <% top = rows.first["views"].to_f %>
          <ul class="ta-list">
            <% rows.each do |r| %>
              <li>
                <div class="ta-list-bar" style="width: <%= (r["views"] * 100 / top).round(1) %>%"></div>
                <span class="ta-list-name"><%= r["name"] %></span>
                <span class="ta-list-num">
                  <%= number_with_delimiter(r["views"]) %>
                  <small><%= unit ? unit : "#{number_with_delimiter(r['visitors'])} visitors" %></small>
                </span>
              </li>
            <% end %>
          </ul>
        <% end %>
        <% if note %><p class="ta-note"><%= note %></p><% end %>
      </div>
    <% end %>
  </div>
  <% end %>

  <p class="ta-foot">
    Counts real browser activity on every portal (search bots, link previews, embedded frames and admin theme previews are skipped).
    A "visitor" is one browser/device; "who" comes from whoever is logged in. Time on page counts only while the tab is visible.
    Clicked text is stored with phone numbers and emails masked. Stats refresh every 30 seconds; new activity takes up to about 15 seconds to show.
  </p>
  <div class="ta-tooltip" id="taTip" hidden></div>
</div>

<%= render "styles" %>

<script>
  (function () {
    const copyBtn = document.getElementById("taCopyUrl");
    if (copyBtn) {
      copyBtn.addEventListener("click", function () {
        navigator.clipboard.writeText(copyBtn.dataset.url).then(function () {
          copyBtn.innerHTML = '<i class="bi bi-check2"></i>';
          setTimeout(function () { copyBtn.innerHTML = '<i class="bi bi-copy"></i>'; }, 1500);
        });
      });
    }

    // Auto-refresh: remembered per browser; one timer, cleared on navigation.
    const autoBtn = document.getElementById("taAutoRefresh");
    const KEY = "taAutoRefresh";
    let on = false;
    try { on = localStorage.getItem(KEY) === "1"; } catch (_) {}
    const paint = function () {
      autoBtn.classList.toggle("on", on);
      autoBtn.querySelector("span").textContent = on ? "Auto-refresh on (30s)" : "Auto-refresh off";
    };
    if (window.__taTimer) clearTimeout(window.__taTimer);
    const schedule = function () {
      if (window.__taTimer) clearTimeout(window.__taTimer);
      if (!on) return;
      window.__taTimer = setTimeout(function () {
        if (!document.getElementById("taAutoRefresh")) return;
        if (window.Turbo) { Turbo.visit(location.href, { action: "replace" }); } else { location.reload(); }
      }, 30000);
    };
    autoBtn.addEventListener("click", function () {
      on = !on;
      try { localStorage.setItem(KEY, on ? "1" : "0"); } catch (_) {}
      paint(); schedule();
    });
    paint(); schedule();

    const tip = document.getElementById("taTip");
    document.querySelectorAll(".ta-heat-cell").forEach(function (cell) {
      cell.addEventListener("mouseenter", function () {
        const r = cell.getBoundingClientRect();
        tip.textContent = cell.dataset.tip;
        tip.style.left = (r.left + r.width / 2) + "px";
        tip.style.top = r.top + "px";
        tip.hidden = false;
      });
      cell.addEventListener("mouseleave", function () { tip.hidden = true; });
    });

    if (typeof Chart === "undefined" || !document.getElementById("taTimeline")) return;

    const css = getComputedStyle(document.querySelector(".ta-root"));
    const s1 = css.getPropertyValue("--ta-s1").trim();
    const s2 = css.getPropertyValue("--ta-s2").trim();
    const s3 = css.getPropertyValue("--ta-s3").trim();
    const grid = "#ecebe7";
    const ink2 = "#52514e";
    const fmt = new Intl.NumberFormat();
    const hourLabels = Array.from({ length: 24 }, function (_, h) {
      return ((h % 12) || 12) + (h < 12 ? " AM" : " PM");
    });

    Chart.defaults.font.family = "Poppins, system-ui, sans-serif";
    Chart.defaults.color = ink2;
    const tooltip = {
      backgroundColor: "#1a1a19", padding: 10, cornerRadius: 8, boxPadding: 4, usePointStyle: true,
      callbacks: { label: function (c) { return " " + c.dataset.label + ": " + fmt.format(c.parsed.y); } }
    };
    const axes = {
      x: { grid: { display: false }, border: { color: grid }, ticks: { maxRotation: 0, autoSkipPadding: 16 } },
      y: { beginAtZero: true, grid: { color: grid }, border: { display: false }, ticks: { precision: 0 } }
    };

    const singleDay = <%= raw(single_day.to_s) %>;
    const daily = <%= raw(s["daily"].to_json) %>;
    const hourly = <%= raw(s["hourly"].to_json) %>;
    const fade = function (ctx, color) {
      const g = ctx.chart.ctx.createLinearGradient(0, 0, 0, ctx.chart.height);
      g.addColorStop(0, color + "33");
      g.addColorStop(1, color + "00");
      return g;
    };
    const line = function (label, data, color, fill) {
      return {
        label: label, data: data, borderColor: color, borderWidth: 2, tension: 0.35, fill: fill,
        backgroundColor: fill ? function (ctx) { return fade(ctx, color); } : color,
        pointRadius: data.length > 45 ? 0 : 3, pointHoverRadius: 5, pointBackgroundColor: color, pointBorderColor: "#fff", pointBorderWidth: 2
      };
    };

    let labels, datasets;
    if (singleDay) {
      labels = hourLabels;
      datasets = [line("Page views", hourly, s1, true)];
    } else {
      labels = daily.map(function (d) {
        return new Date(d[0] + "T00:00:00").toLocaleDateString(undefined, { month: "short", day: "numeric" });
      });
      datasets = [
        line("Page views", daily.map(function (d) { return d[1]; }), s1, true),
        line("Unique visitors", daily.map(function (d) { return d[2]; }), s2, false),
        line("Clicks", daily.map(function (d) { return d[3]; }), s3, false)
      ];
    }

    new Chart(document.getElementById("taTimeline"), {
      type: "line",
      data: { labels: labels, datasets: datasets },
      options: {
        responsive: true, maintainAspectRatio: false,
        interaction: { mode: "index", intersect: false },
        plugins: { legend: { display: false }, tooltip: tooltip },
        scales: axes
      }
    });

    new Chart(document.getElementById("taHours"), {
      type: "bar",
      data: {
        labels: hourLabels,
        datasets: [{ label: "Page views", data: hourly, backgroundColor: s1, borderRadius: 4, borderSkipped: "bottom", maxBarThickness: 18 }]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false }, tooltip: tooltip },
        scales: axes
      }
    });
  })();
</script>
