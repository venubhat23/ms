<% content_for :page_title, "Booking ##{@booking.booking_number}" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="fw-bold mb-1"><i class="bi bi-receipt me-2 text-primary"></i>Booking #<%= @booking.booking_number %></h4>
    <small class="text-muted"><%= @booking.created_at&.strftime("%d %B %Y, %I:%M %p") %></small>
  </div>
  <%= link_to affiliate_bookings_path, class: "btn btn-outline-secondary btn-sm" do %>
    <i class="bi bi-arrow-left me-1"></i>My Bookings
  <% end %>
</div>

<%# Status row %>
<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body">
        <div class="text-muted small fw-semibold mb-1">Booking Status</div>
        <% case @booking.status&.to_s
           when 'pending' %>
          <span class="badge bg-warning text-dark fs-6 px-3 py-2">Pending</span>
        <% when 'completed' %>
          <span class="badge bg-success fs-6 px-3 py-2">Completed</span>
        <% when 'cancelled' %>
          <span class="badge bg-danger fs-6 px-3 py-2">Cancelled</span>
        <% else %>
          <span class="badge bg-secondary fs-6 px-3 py-2"><%= @booking.status&.humanize %></span>
        <% end %>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body">
        <div class="text-muted small fw-semibold mb-1">Payment Status</div>
        <% case @booking.payment_status&.to_s
           when 'paid' %>
          <span class="badge bg-success fs-6 px-3 py-2">Paid</span>
        <% when 'partially_paid' %>
          <span class="badge bg-warning text-dark fs-6 px-3 py-2">Partially Paid</span>
        <% else %>
          <span class="badge bg-danger fs-6 px-3 py-2">Unpaid</span>
        <% end %>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body">
        <div class="text-muted small fw-semibold mb-1">Total Amount</div>
        <div class="fw-bold fs-4 text-primary">₹<%= number_with_delimiter(@booking.total_amount&.to_f&.to_i || 0, delimiter: ',') %></div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-md-7">
    <%# Booking items %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white py-3 px-4">
        <h6 class="fw-semibold mb-0"><i class="bi bi-bag me-2 text-muted"></i>Items</h6>
      </div>
      <div class="card-body p-0">
        <% booking_items = @booking.booking_items.includes(:product) %>
        <% if booking_items.any? %>
          <div class="table-responsive">
            <table class="table mb-0">
              <thead class="table-light">
                <tr>
                  <th class="px-4">Product</th>
                  <th class="text-center">Qty</th>
                  <th class="text-end">Price</th>
                  <th class="text-end px-4">Total</th>
                </tr>
              </thead>
              <tbody>
                <% booking_items.each do |item| %>
                  <tr>
                    <td class="px-4 align-middle">
                      <div class="fw-semibold small"><%= item.product&.name || 'Product' %></div>
                      <% if item.product&.sku.present? %>
                        <small class="text-muted">SKU: <%= item.product.sku %></small>
                      <% end %>
                    </td>
                    <td class="text-center align-middle"><%= item.quantity %></td>
                    <td class="text-end align-middle">₹<%= item.price&.to_f&.to_i || 0 %></td>
                    <td class="text-end px-4 align-middle fw-semibold">₹<%= (item.quantity.to_f * item.price.to_f).to_i %></td>
                  </tr>
                <% end %>
              </tbody>
              <tfoot class="table-light">
                <% if (@booking.discount_amount&.to_f || 0) > 0 %>
                  <tr>
                    <td colspan="3" class="text-end px-4">Subtotal:</td>
                    <td class="text-end px-4">₹<%= @booking.subtotal&.to_f&.to_i || 0 %></td>
                  </tr>
                  <tr>
                    <td colspan="3" class="text-end px-4 text-danger">Discount:</td>
                    <td class="text-end px-4 text-danger">- ₹<%= @booking.discount_amount&.to_f&.to_i %></td>
                  </tr>
                <% end %>
                <tr>
                  <td colspan="3" class="text-end px-4 fw-bold">Total:</td>
                  <td class="text-end px-4 fw-bold text-primary">₹<%= @booking.total_amount&.to_f&.to_i || 0 %></td>
                </tr>
              </tfoot>
            </table>
          </div>
        <% else %>
          <div class="text-center py-4 text-muted small">No items recorded</div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-md-5">
    <%# Customer info %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white py-3 px-4">
        <h6 class="fw-semibold mb-0"><i class="bi bi-person me-2 text-muted"></i>Customer</h6>
      </div>
      <div class="card-body px-4">
        <div class="fw-semibold"><%= @booking.customer&.display_name || @booking.customer_name.presence || '—' %></div>
        <% if (@booking.customer&.mobile || @booking.customer_phone).present? %>
          <small class="text-muted d-block"><i class="bi bi-telephone me-1"></i><%= @booking.customer&.mobile || @booking.customer_phone %></small>
        <% end %>
        <% if (@booking.customer&.email || @booking.customer_email).present? %>
          <small class="text-muted d-block"><i class="bi bi-envelope me-1"></i><%= @booking.customer&.email || @booking.customer_email %></small>
        <% end %>
      </div>
    </div>

    <%# Order details %>
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white py-3 px-4">
        <h6 class="fw-semibold mb-0"><i class="bi bi-info-circle me-2 text-muted"></i>Order Details</h6>
      </div>
      <div class="card-body px-4">
        <div class="d-flex justify-content-between py-2 border-bottom">
          <span class="text-muted small">Payment Method</span>
          <span class="small fw-semibold"><%= @booking.payment_method&.humanize || '—' %></span>
        </div>
        <div class="d-flex justify-content-between py-2 border-bottom">
          <span class="text-muted small">Booked On</span>
          <span class="small fw-semibold"><%= @booking.created_at&.strftime("%d %b %Y") %></span>
        </div>
        <% if @booking.notes.present? %>
          <div class="pt-2">
            <div class="text-muted small mb-1">Notes</div>
            <div class="small bg-light rounded p-2"><%= simple_format(@booking.notes) %></div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
