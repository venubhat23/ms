<!DOCTYPE html>
<html lang="en">
<head>
  <title>Become an Affiliate - Marali Santhe</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <!-- Standalone page (loads Bootstrap from CDN, no access to application.css)
       — kept in sync with the affiliate login page's brand color variable. -->
  <style>
    :root {
      --color-primary: #667eea;
      --color-primary-dark: #764ba2;
    }
    body {
      font-family: 'Poppins', sans-serif !important;
      margin: 0 !important;
      background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%) !important;
      min-height: 100vh;
    }
    .enhanced-login-wrapper {
      min-height: 100vh !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      padding: 2rem 1rem;
    }
    .enhanced-login-card {
      background: rgba(255, 255, 255, 0.95) !important;
      backdrop-filter: blur(20px) !important;
      border-radius: 24px !important;
      padding: 3rem !important;
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.25) !important;
      width: 100% !important;
      max-width: 520px !important;
    }
    .enhanced-title { color: var(--color-primary) !important; font-weight: 700 !important; font-size: 1.6rem !important; }
    .form-label { font-weight: 600 !important; color: #374151 !important; }
    .form-control { border: 2px solid #e5e7eb !important; padding: 0.65rem 1rem !important; }
    .form-control:focus { border-color: var(--color-primary) !important; box-shadow: none !important; }
    .btn-primary {
      background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%) !important;
      border: none !important; border-radius: 16px !important; font-weight: 700 !important;
      text-transform: uppercase !important; letter-spacing: 1px !important;
    }
    .perk { font-size: 0.9rem; color: #6b7280; }
  </style>
</head>
<body>
<div class="enhanced-login-wrapper">
  <div class="enhanced-login-card">
    <div class="text-center mb-4">
      <h2 class="enhanced-title"><i class="fas fa-handshake me-2"></i>Become an Affiliate</h2>
      <p class="perk mb-0">Earn commission on every order from customers you refer.</p>
    </div>

    <% if @affiliate&.errors&.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% @affiliate.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @affiliate, url: affiliate_register_path, local: true do |f| %>
      <div class="row">
        <div class="col-md-6 mb-3">
          <%= f.label :first_name, class: "form-label" %>
          <%= f.text_field :first_name, class: "form-control", required: true, autofocus: true %>
        </div>
        <div class="col-md-6 mb-3">
          <%= f.label :last_name, class: "form-label" %>
          <%= f.text_field :last_name, class: "form-control", required: true %>
        </div>
      </div>

      <div class="mb-3">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, class: "form-control", required: true %>
      </div>

      <div class="mb-3">
        <%= f.label :mobile, "Mobile Number", class: "form-label" %>
        <%= f.text_field :mobile, class: "form-control", placeholder: "10-digit mobile number", pattern: "[0-9]{10}", required: true %>
        <small class="text-muted">This becomes your unique affiliate code and referral link.</small>
      </div>

      <div class="mb-3">
        <%= f.label :address, "Address (Optional)", class: "form-label" %>
        <%= f.text_area :address, class: "form-control", rows: 2 %>
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <%= f.label :city, "City (Optional)", class: "form-label" %>
          <%= f.text_field :city, class: "form-control" %>
        </div>
        <div class="col-md-6 mb-3">
          <%= f.label :state, "State (Optional)", class: "form-label" %>
          <%= f.text_field :state, class: "form-control" %>
        </div>
      </div>

      <div class="d-grid mt-4">
        <%= f.submit "Register as Affiliate", class: "btn btn-primary btn-lg py-3" %>
      </div>
    <% end %>

    <p class="text-center mt-3 mb-0">
      Already an affiliate? <%= link_to "Sign in", affiliate_login_path %>
    </p>
  </div>
</div>
</body>
</html>
