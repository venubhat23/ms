<% content_for :title, "Reset Password" %>

<style>
  .brand-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--green-dark);
    letter-spacing: 1px;
    margin-bottom: 4px;
  }

  .password-form-container {
    max-width: 100%;
  }

  .form-label {
    color: var(--green-dark);
    font-weight: 600;
    margin-bottom: 8px;
    font-size: 0.9rem;
  }

  .password-requirements {
    font-size: 0.78rem;
    color: var(--muted);
    margin-top: 5px;
  }

  /* Prevent iOS auto-zoom on focus — must be >= 16px */
  .form-control {
    font-size: 16px !important;
  }

  .btn-reset {
    background: linear-gradient(135deg, var(--green) 0%, var(--green-mid) 100%);
    border: none;
    border-radius: 12px;
    padding: 16px 24px;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    transition: all 0.4s ease;
    width: 100%;
    color: white;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .btn-reset:hover,
  .btn-reset:active {
    background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 100%);
    color: var(--dark);
    box-shadow: 0 8px 25px rgba(93, 130, 51, 0.3);
  }

  .icon-container {
    background: linear-gradient(135deg, var(--green) 0%, var(--green-mid) 100%);
    width: 70px;
    height: 70px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    animation: pulse 2s infinite;
    flex-shrink: 0;
  }

  .success-container {
    text-align: center;
    padding: 20px 0;
  }

  .success-icon {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, #28a745, #20c997);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    animation: successPop 0.5s ease-out;
    flex-shrink: 0;
  }

  .success-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.6rem;
    font-weight: 700;
    color: #1e7e34;
    margin-bottom: 12px;
  }

  .success-message {
    color: var(--muted);
    font-size: 0.95rem;
    margin-bottom: 24px;
    line-height: 1.6;
  }

  .btn-login-now {
    display: block;
    background: linear-gradient(135deg, var(--green) 0%, var(--green-mid) 100%);
    color: white;
    text-decoration: none;
    padding: 16px 32px;
    border-radius: 12px;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    transition: all 0.3s ease;
    text-align: center;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .btn-login-now:hover,
  .btn-login-now:active {
    background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 100%);
    color: var(--dark);
    box-shadow: 0 8px 25px rgba(93, 130, 51, 0.3);
    text-decoration: none;
  }

  /* Keep container top-aligned on mobile so keyboard doesn't push content off screen */
  @media (max-width: 600px) {
    .main-container {
      align-items: flex-start !important;
      padding-top: 24px !important;
      padding-bottom: 32px !important;
      min-height: 100dvh !important;
    }

    .login-card {
      padding: 24px 20px !important;
      margin: 0 !important;
      border-radius: 16px !important;
    }

    .login-logo img {
      width: 60px !important;
      height: 60px !important;
    }

    .brand-name {
      font-size: 1.25rem;
    }

    .icon-container {
      width: 56px;
      height: 56px;
    }

    .icon-container i {
      font-size: 1.4rem !important;
    }

    .welcome-title {
      font-size: 1.4rem !important;
    }

    .welcome-subtitle {
      font-size: 0.85rem;
    }

    .welcome-section {
      margin-bottom: 20px;
    }

    .form-group {
      margin-bottom: 16px;
    }

    .input-group-text {
      padding: 10px 14px !important;
    }

    .success-icon {
      width: 64px;
      height: 64px;
    }

    .success-icon i {
      font-size: 1.6rem !important;
    }

    .success-title {
      font-size: 1.35rem;
    }

    .success-message {
      font-size: 0.9rem;
    }

    .auth-links {
      margin-top: 16px;
    }
  }

  @keyframes pulse {
    0%   { transform: scale(1); }
    50%  { transform: scale(1.05); }
    100% { transform: scale(1); }
  }

  @keyframes successPop {
    0%   { transform: scale(0.5); opacity: 0; }
    80%  { transform: scale(1.1); }
    100% { transform: scale(1); opacity: 1; }
  }
</style>

<% if flash[:reset_success] %>
  <!-- Success State -->
  <div class="welcome-section">
    <div class="brand-name">Marali Santhe</div>
  </div>

  <div class="success-container">
    <div class="success-icon">
      <i class="bi bi-check-lg text-white" style="font-size: 2rem;"></i>
    </div>
    <h2 class="success-title">Password Reset Done!</h2>
    <p class="success-message">
      Your password has been updated successfully.<br>
      You can now log in with your new password.
    </p>
    <%= link_to "Go to Login", customer_login_path, class: "btn-login-now" %>
  </div>

<% else %>
  <!-- Reset Password Form -->
  <div class="welcome-section">
    <div class="brand-name">Marali Santhe</div>
    <div class="icon-container">
      <i class="bi bi-shield-lock-fill text-white" style="font-size: 1.8rem;"></i>
    </div>
    <h2 class="welcome-title">Reset Your Password</h2>
    <p class="welcome-subtitle">Create a new secure password for your account</p>
  </div>

  <div class="password-form-container">
    <%= form_with url: customer_reset_password_path, method: :patch, local: true, id: "resetForm", class: "needs-validation", novalidate: true do |form| %>
      <%= form.hidden_field :token, value: @token %>

      <div class="form-group">
        <%= form.label :password, "New Password", class: "form-label" %>
        <div class="input-group">
          <span class="input-group-text">
            <i class="bi bi-lock-fill"></i>
          </span>
          <%= form.password_field :password,
              class: "form-control",
              placeholder: "Enter new password",
              required: true,
              minlength: 6,
              id: "password" %>
        </div>
        <div class="password-requirements">
          <i class="bi bi-info-circle"></i> Minimum 6 characters
        </div>
      </div>

      <div class="form-group">
        <%= form.label :password_confirmation, "Confirm Password", class: "form-label" %>
        <div class="input-group">
          <span class="input-group-text">
            <i class="bi bi-lock-check-fill"></i>
          </span>
          <%= form.password_field :password_confirmation,
              class: "form-control",
              placeholder: "Re-enter new password",
              required: true,
              id: "password_confirmation" %>
        </div>
        <div id="matchError" class="password-requirements" style="color: #dc3545; display: none;">
          <i class="bi bi-exclamation-circle"></i> Passwords do not match
        </div>
      </div>

      <div class="form-group">
        <%= form.submit "Set New Password", class: "btn-reset", data: { disable_with: "Updating..." } %>
      </div>
    <% end %>
  </div>

  <div class="auth-links">
    <div class="auth-separator">
      <span>Remember your password?</span>
    </div>
    <%= link_to "Back to Sign In", customer_login_path, class: "register-link" %>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const form = document.getElementById('resetForm');
      const password = document.getElementById('password');
      const passwordConfirmation = document.getElementById('password_confirmation');
      const matchError = document.getElementById('matchError');

      function checkMatch() {
        if (passwordConfirmation.value.length > 0 && password.value !== passwordConfirmation.value) {
          matchError.style.display = 'block';
          passwordConfirmation.classList.add('is-invalid');
        } else {
          matchError.style.display = 'none';
          passwordConfirmation.classList.remove('is-invalid');
          if (passwordConfirmation.value.length > 0) passwordConfirmation.classList.add('is-valid');
        }
      }

      password.addEventListener('input', checkMatch);
      passwordConfirmation.addEventListener('input', checkMatch);

      form.addEventListener('submit', function(e) {
        if (password.value.length < 6) {
          e.preventDefault();
          password.focus();
          return false;
        }
        if (password.value !== passwordConfirmation.value) {
          e.preventDefault();
          matchError.style.display = 'block';
          passwordConfirmation.focus();
          return false;
        }
      });
    });
  </script>
<% end %>
