<%# Everything here depends only on @products / @categories (no customer
    data), so for the unfiltered shop the controller renders it once and
    serves the cached HTML — see Customer::ShopController#index. %>
  <!-- Compact Page Header -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h2 class="mb-1 text-dark fw-bold fs-4">
        <i class="bi bi-shop me-2 text-primary"></i>
        Shop Products
      </h2>
      <p class="text-muted mb-0 small">Browse and order your favorite fresh & organic products</p>
    </div>
    <div class="d-flex gap-2">
      <div class="badge bg-primary-subtle text-primary px-2 py-1">
        <i class="bi bi-box-seam me-1"></i>
        <%= @products&.size || 0 %> Products
      </div>
      <div class="badge bg-info-subtle text-info px-2 py-1">
        <i class="bi bi-tags me-1"></i>
        <%= @categories&.count || 0 %> Categories
      </div>
    </div>
  </div>

  <!-- Filter bar: instant client-side search + category + stock -->
  <% category_counts = @products.to_a.group_by(&:category_id).transform_values(&:size) %>
  <div class="card border-0 shadow-sm mb-3 shop-filter-bar" id="shopFilterBar">
    <div class="card-body p-2">
      <div class="row g-2 align-items-center">
        <div class="col-lg-5 col-md-12">
          <div class="shop-search">
            <i class="bi bi-search shop-search-icon"></i>
            <input type="search"
                   class="form-control"
                   placeholder="Search products by name, SKU, or category..."
                   id="productSearchInput"
                   autocomplete="off">
            <button type="button" class="shop-search-clear d-none" id="productSearchClear" title="Clear search" aria-label="Clear search">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
        </div>
        <div class="col-lg-3 col-md-5">
          <select class="form-select category-select2" id="categoryFilter">
            <option value="" data-count="<%= @products&.size || 0 %>">All Categories</option>
            <% @categories.each do |category| %>
              <% next unless category_counts[category.id] %>
              <option value="<%= category.id %>" data-count="<%= category_counts[category.id] %>"><%= category.name %></option>
            <% end %>
          </select>
        </div>
        <div class="col-lg-4 col-md-7">
          <div class="d-flex align-items-center gap-2">
            <div class="shop-stock-pills flex-grow-1" role="group" aria-label="Stock filter" id="stockFilter">
              <button type="button" class="active" data-stock-filter="all">All</button>
              <button type="button" data-stock-filter="instock"><span class="dot bg-success"></span>In Stock</button>
              <button type="button" data-stock-filter="lowstock"><span class="dot bg-warning"></span>Low</button>
              <button type="button" data-stock-filter="outofstock"><span class="dot bg-danger"></span>Out</button>
            </div>
            <button type="button" class="btn btn-sm btn-light border shop-reset d-none" id="shopResetFilters" onclick="clearAllFilters()" title="Clear all filters">
              <i class="bi bi-arrow-counterclockwise"></i>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Products Section -->
  <% if @products&.any? %>
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-transparent border-0">
        <div class="d-flex justify-content-between align-items-center">
          <h5 class="mb-0 fw-semibold">Product List</h5>
          <div class="d-flex gap-2">
            <span class="small text-muted align-self-center me-1" id="shopResultCount">
              <%= @products.size %> products
            </span>
            <button class="btn btn-outline-secondary btn-sm" onclick="toggleView('grid')" id="gridViewBtn">
              <i class="bi bi-grid-3x3-gap"></i>
            </button>
            <button class="btn btn-outline-secondary btn-sm" onclick="toggleView('list')" id="listViewBtn">
              <i class="bi bi-list"></i>
            </button>
          </div>
        </div>
      </div>
      <div class="card-body p-0">
        <div class="p-2">
            <div class="row g-2" id="productGrid">
              <% @products.each_with_index do |product, product_index| %>
                <% current_stock = product.cached_total_batch_stock %>
                <% in_stock = current_stock > 0 %>

                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 product-grid-item"
                     data-product-id="<%= product.id %>"
                     data-category="<%= product.category_id %>"
                     data-stock="<%= current_stock %>"
                     data-search="<%= [product.name, product.sku, product.category&.name].compact.join(' ').downcase %>">
                  <div class="card h-100 border-0 shadow-sm hover-lift product-card">
                <!-- Product Image -->
                <div class="position-relative">
                  <%# First row is above the fold: fetch it right away instead of lazily. %>
                  <%= render 'shared/product_image_slider', product: product, eager: product_index < 4 %>

                  <!-- Enhanced Stock Badge -->
                  <% if current_stock == 0 %>
                    <span class="position-absolute top-0 end-0 badge bg-danger m-2">
                      <i class="bi bi-x-circle me-1"></i>Out of Stock
                    </span>
                  <% elsif current_stock < 10 %>
                    <span class="position-absolute top-0 end-0 badge bg-warning text-dark m-2">
                      <i class="bi bi-exclamation-triangle me-1"></i>Low Stock (<%= current_stock.to_i %> left)
                    </span>
                  <% else %>
                    <span class="position-absolute top-0 end-0 badge bg-success m-2">
                      <i class="bi bi-check-circle me-1"></i><%= current_stock.to_i %> in stock
                    </span>
                  <% end %>

                  <!-- Discount Badge -->
                  <% if product.respond_to?(:discount_price) && product.discount_price.present? && product.discount_price != product.price %>
                    <% discount_percent = ((product.price - product.discount_price) * 100 / product.price).round %>
                    <span class="position-absolute top-0 start-0 badge bg-success m-2"><%= discount_percent %>% OFF</span>
                  <% end %>
                </div>

                <!-- Product Details -->
                <div class="card-body d-flex flex-column">
                  <small class="text-muted card-category mb-1"><%= product.category&.name || 'No Category' %></small>

                  <h6 class="card-title mb-2"><%= product.name %></h6>

                  <!-- Price -->
                  <div class="mb-3 price-block">
                    <%
                      if product.has_multiple_quantities? && product.product_variants.any?
                        sorted_variants = product.product_variants.sort_by { |v| [(v.display_order || 999), v.weight.to_f] }
                        shop_default_v = product.default_variant || sorted_variants.first
                        selling_price = shop_default_v.effective_price
                      else
                        shop_default_v = nil
                        selling_price = product.respond_to?(:discount_price) && product.discount_price.present? && product.discount_price != product.price ? product.discount_price : product.price
                      end

                      if product.gst_enabled && product.gst_percentage.present? && product.gst_percentage > 0
                        gst_rate = product.gst_percentage
                        base_price = selling_price / (1 + (gst_rate / 100.0))
                        final_price = selling_price
                      else
                        base_price = selling_price
                        gst_rate = 0
                        final_price = selling_price
                      end

                      rounded_final = final_price.round
                      rounded_base = (rounded_final / (1 + (gst_rate / 100.0))).round
                      rounded_gst = rounded_final - rounded_base

                      effective_stock = shop_default_v ? shop_default_v.available_stock : current_stock
                    %>

                    <% if product.has_multiple_quantities? && product.product_variants.any? %>
                      <!-- Variant pills -->
                      <div class="d-flex flex-wrap justify-content-center gap-1 mb-2" id="shop-variant-pills-<%= product.id %>">
                        <% sorted_variants.each do |v| %>
                          <button type="button"
                                  class="btn btn-xs px-2 py-1 shop-variant-pill <%= v.id == shop_default_v.id ? 'btn-primary' : 'btn-outline-secondary' %>"
                                  style="font-size:0.75rem; line-height:1.2; <%= v.id == shop_default_v.id ? '' : 'border-radius:999px;' %>"
                                  data-variant-id="<%= v.id %>"
                                  data-product-id="<%= product.id %>"
                                  data-price="<%= v.effective_price %>"
                                  data-stock="<%= v.available_stock %>"
                                  data-label="<%= j(v.label) %>"
                                  onclick="shopSelectVariant(this)">
                            <%= v.label %>
                          </button>
                        <% end %>
                      </div>
                      <span class="h6 text-primary mb-0" id="shop-vprice-<%= product.id %>">
                        ₹<%= number_with_delimiter(rounded_final) %>
                      </span>
                      <input type="hidden" id="shop-selected-variant-<%= product.id %>" value="<%= shop_default_v.id %>">
                    <% elsif product.respond_to?(:discount_price) && product.discount_price.present? && product.discount_price != product.price %>
                      <div class="d-flex align-items-center justify-content-center gap-2">
                        <span class="h6 text-success mb-0">₹<%= number_with_delimiter(final_price.round(2)) %></span>
                        <small class="text-muted text-decoration-line-through">₹<%= number_with_delimiter(product.price) %></small>
                      </div>
                    <% else %>
                      <span class="h6 text-primary mb-0">₹<%= number_with_delimiter(final_price.round(2)) %></span>
                    <% end %>

                    <% if product.gst_enabled && gst_rate > 0 %>
                      <small class="text-muted d-block">
                        Base: ₹<%= number_with_delimiter(rounded_base) %> + GST: ₹<%= number_with_delimiter(rounded_gst) %> (<%= gst_rate %>%) = ₹<%= number_with_delimiter(rounded_final) %>
                      </small>
                    <% end %>
                  </div>

                  <!-- Quantity and Add to Cart -->
                  <div class="mt-auto" id="shop-stock-section-<%= product.id %>">
                    <% if effective_stock > 0 %>
                      <!-- Quantity Selector -->
                      <div class="mb-3">
                        <label class="form-label fw-bold small">
                          Quantity
                          <span class="badge bg-info-subtle text-info ms-1" id="shop-max-stock-<%= product.id %>">
                            Max: <%= effective_stock.to_i %>
                          </span>
                        </label>
                        <div class="input-group">
                          <button class="btn btn-outline-primary quantity-btn" type="button" onclick="decreaseQty(<%= product.id %>)">
                            <i class="bi bi-dash fw-bold"></i>
                          </button>
                          <input type="number"
                                 id="qty-<%= product.id %>"
                                 value="1"
                                 min="1"
                                 step="1"
                                 max="<%= effective_stock %>"
                                 class="form-control text-center fw-bold quantity-input"
                                 onchange="validateQty(<%= product.id %>, <%= effective_stock %>)">
                          <button class="btn btn-outline-primary quantity-btn" type="button" onclick="increaseQty(<%= product.id %>)">
                            <i class="bi bi-plus fw-bold"></i>
                          </button>
                        </div>

                        <% if effective_stock < 10 %>
                          <small class="text-warning d-block mt-1">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <strong>Low Stock!</strong> Only <%= effective_stock.to_i %> left
                          </small>
                        <% end %>
                      </div>

                      <!-- Add to Cart Button -->
                      <button class="btn btn-primary w-100"
                              id="shop-add-btn-<%= product.id %>"
                              data-product-id="<%= product.id %>"
                              data-product-name="<%= j(product.name) %>"
                              data-final-price="<%= rounded_final %>"
                              data-stock="<%= effective_stock %>"
                              data-base-price="<%= rounded_base %>"
                              data-gst-rate="<%= gst_rate %>"
                              data-has-variants="<%= product.has_multiple_quantities? ? 'true' : 'false' %>"
                              onclick="shopAddToCart(<%= product.id %>)">
                        <i class="bi bi-cart-plus me-2"></i>Add to Cart
                      </button>
                    <% else %>
                      <!-- Out of Stock Button -->
                      <button class="btn btn-danger w-100" style="border-radius: 999px;" disabled id="shop-add-btn-<%= product.id %>">
                        <i class="bi bi-x-circle me-2"></i>Out of Stock
                      </button>
                    <% end %>
                  </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
            <div class="shop-no-match text-center py-5 d-none" id="shopNoMatch">
              <i class="bi bi-search fs-1 text-muted d-block mb-2"></i>
              <div class="fw-semibold">No products match your filters</div>
              <button type="button" class="btn btn-sm btn-outline-primary mt-3" onclick="clearAllFilters()">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Clear filters
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="row">
      <div class="col-12">
        <div class="card border-0 shadow-sm">
          <div class="card-body text-center py-5">
            <div class="empty-state-animation mb-4">
              <div class="empty-box">
                <i class="bi bi-box-seam fs-1 text-muted"></i>
                <div class="floating-dots">
                  <span class="dot"></span>
                  <span class="dot"></span>
                  <span class="dot"></span>
                </div>
              </div>
            </div>
            <h4 class="card-title fw-bold text-muted mb-3">No Products Found</h4>
            <p class="text-muted mb-4 lead">Check back later for new products or try adjusting your search.</p>
            <div class="d-flex justify-content-center gap-3">
              <%= link_to customer_dashboard_path, class: "btn btn-primary px-4" do %>
                <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
              <% end %>
              <button class="btn btn-outline-primary px-4" onclick="location.reload()">
                <i class="bi bi-arrow-clockwise me-2"></i>Refresh Page
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
