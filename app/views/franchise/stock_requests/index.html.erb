<!-- Franchise Stock Requests -->
<div class="dashboard-container">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="mb-1">Stock Requests</h2>
      <p class="text-muted mb-0">Request products from HQ — approved requests are credited to your inventory.</p>
    </div>
    <div>
      <%= link_to new_franchise_stock_request_path, class: "btn btn-primary" do %>
        <i class="bi bi-plus-lg me-1"></i>
        New Request
      <% end %>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-md-4">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <h6 class="text-muted mb-1">Pending</h6>
          <h4 class="mb-0 text-warning"><%= @pending_count %></h4>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <h6 class="text-muted mb-1">Approved</h6>
          <h4 class="mb-0 text-success"><%= @approved_count %></h4>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <h6 class="text-muted mb-1">Rejected</h6>
          <h4 class="mb-0 text-danger"><%= @rejected_count %></h4>
        </div>
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <% if @stock_requests.any? %>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="bg-light">
              <tr>
                <th class="border-0">Requested On</th>
                <th class="border-0">Items</th>
                <th class="border-0">Discount</th>
                <th class="border-0">Status</th>
                <th class="border-0">Reviewed</th>
                <th class="border-0"></th>
              </tr>
            </thead>
            <tbody>
              <% @stock_requests.each do |sr| %>
                <tr>
                  <td class="small"><%= sr.created_at.strftime('%b %d, %Y') %></td>
                  <td><%= pluralize(sr.items_count, 'item') %></td>
                  <td class="small text-muted"><%= sr.discount_amount.to_f > 0 ? "₹#{sr.discount_amount.to_f.round(2)}" : '—' %></td>
                  <td>
                    <% status_color = { 'pending' => 'warning', 'approved' => 'success', 'rejected' => 'danger' }[sr.status] %>
                    <span class="badge bg-<%= status_color %>"><%= sr.status.capitalize %></span>
                  </td>
                  <td class="small text-muted"><%= sr.reviewed_at&.strftime('%b %d, %Y') || '—' %></td>
                  <td>
                    <%= link_to "View", franchise_stock_request_path(sr), class: "btn btn-sm btn-outline-primary" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <% if @stock_requests.respond_to?(:total_pages) %>
          <div class="card-footer bg-transparent border-0">
            <%= paginate @stock_requests %>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-5">
          <i class="bi bi-box-seam fs-1 text-muted d-block mb-3"></i>
          <h5 class="text-muted">No stock requests yet</h5>
          <%= link_to "Request Stock", new_franchise_stock_request_path, class: "btn btn-primary mt-2" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
