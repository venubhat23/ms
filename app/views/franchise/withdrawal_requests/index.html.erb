<!-- Franchise Withdrawal Requests -->
<div class="dashboard-container">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="mb-1">Withdrawal Requests</h2>
      <p class="text-muted mb-0">Available balance: <strong><%= @wallet&.formatted_balance || '₹0.00' %></strong></p>
    </div>
    <div>
      <%= link_to new_franchise_withdrawal_request_path, class: "btn btn-primary" do %>
        <i class="bi bi-plus-lg me-1"></i>
        New Request
      <% end %>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <% if @withdrawal_requests.any? %>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="bg-light">
              <tr>
                <th class="border-0">Requested On</th>
                <th class="border-0">Amount</th>
                <th class="border-0">Status</th>
                <th class="border-0">Payment Reference</th>
                <th class="border-0">Tagged Bookings</th>
              </tr>
            </thead>
            <tbody>
              <% @withdrawal_requests.each do |wr| %>
                <tr>
                  <td class="small"><%= wr.requested_at&.strftime('%b %d, %Y') %></td>
                  <td class="fw-semibold"><%= wr.formatted_amount %></td>
                  <td>
                    <% status_color = { 'pending' => 'warning', 'approved' => 'info', 'paid' => 'success', 'rejected' => 'danger' }[wr.status] %>
                    <span class="badge bg-<%= status_color %>"><%= wr.status.capitalize %></span>
                  </td>
                  <td class="small text-muted"><%= wr.payment_reference || '—' %></td>
                  <td class="small text-muted">
                    <% tagged = ([wr.booking] + wr.tagged_bookings).compact.uniq %>
                    <%= tagged.any? ? tagged.map(&:booking_number).join(', ') : '—' %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <% if @withdrawal_requests.respond_to?(:total_pages) %>
          <div class="card-footer bg-transparent border-0">
            <%= paginate @withdrawal_requests %>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-5">
          <i class="bi bi-cash-coin fs-1 text-muted d-block mb-3"></i>
          <h5 class="text-muted">No withdrawal requests yet</h5>
        </div>
      <% end %>
    </div>
  </div>
</div>
