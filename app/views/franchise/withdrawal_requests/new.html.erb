<!-- Franchise Withdrawal Request -->
<div class="dashboard-container">
  <div class="mb-4">
    <h2 class="mb-1">Request Withdrawal</h2>
    <p class="text-muted mb-0">Available balance: <strong><%= @wallet&.formatted_balance || '₹0.00' %></strong></p>
  </div>

  <div class="card border-0 shadow-sm" style="max-width: 520px;">
    <div class="card-body">
      <% if @withdrawal_request&.errors&.any? %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% @withdrawal_request.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @withdrawal_request, url: franchise_withdrawal_requests_path, local: true do |f| %>
        <div class="mb-3">
          <%= f.label :amount, "Amount (₹)", class: "form-label" %>
          <%= f.number_field :amount, class: "form-control", step: "0.01", min: 0.01, required: true %>
          <small class="text-muted">Up to your available wallet balance.</small>
        </div>

        <div class="mb-3">
          <label class="form-label">Tag Bookings (Optional)</label>
          <% if @bookings.any? %>
            <div class="border rounded p-2" style="max-height: 220px; overflow-y: auto;">
              <div class="form-check mb-1 pb-1 border-bottom">
                <input type="checkbox" class="form-check-input" id="select_all_bookings" onclick="document.querySelectorAll('.booking-tag-checkbox').forEach(cb => cb.checked = this.checked)">
                <label class="form-check-label small text-muted" for="select_all_bookings">Select all</label>
              </div>
              <% @bookings.each do |booking| %>
                <div class="form-check">
                  <input type="checkbox" class="form-check-input booking-tag-checkbox" name="booking_ids[]" value="<%= booking.id %>" id="booking_tag_<%= booking.id %>">
                  <label class="form-check-label" for="booking_tag_<%= booking.id %>"><%= booking.booking_number %></label>
                </div>
              <% end %>
            </div>
            <small class="text-muted">Optionally link this withdrawal to one or more bookings you completed. Bookings already tagged to a request aren't shown.</small>
          <% else %>
            <p class="text-muted small mb-0">No untagged bookings available to tag right now.</p>
          <% end %>
        </div>

        <div class="mb-3">
          <%= f.label :notes, "Notes (Optional)", class: "form-label" %>
          <%= f.text_area :notes, class: "form-control", rows: 2, placeholder: "Any note for the admin reviewing this request" %>
        </div>

        <div class="d-grid">
          <%= f.submit "Submit Request", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
