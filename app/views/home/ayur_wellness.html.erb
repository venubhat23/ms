<script>
  function toggleMobileMenu(){
    document.getElementById('mobileNav').classList.toggle('mobile-open');
  }

  async function addToCart(productId, name, btn) {
    const orig = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Adding…';
    try {
      const res = await fetch('<%= add_item_storefront_cart_path %>', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ product_id: productId, quantity: 1 })
      });
      const data = await res.json();
      if (!data.success) {
        alert(data.error || 'Could not add item to cart.');
        btn.disabled = false;
        btn.textContent = orig;
        return;
      }
      const t = document.getElementById('toast');
      t.textContent = '✓ ' + (name || 'Item') + ' added to cart!';
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 2200);
      btn.textContent = '✓ Added!';
      setTimeout(() => { btn.disabled = false; btn.textContent = orig; }, 1600);

      const badge = document.querySelector('.cart-badge');
      if (badge) {
        badge.textContent = data.cart_count;
      } else if (data.cart_count > 0) {
        const cartLink = document.querySelector('.cart-link');
        const span = document.createElement('span');
        span.className = 'cart-badge';
        span.textContent = data.cart_count;
        cartLink.appendChild(span);
      }
    } catch (e) {
      alert('Could not add item to cart.');
      btn.disabled = false;
      btn.textContent = orig;
    }
  }
</script>
