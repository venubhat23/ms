<script>
  // Mobile menu toggle
  function toggleMobileMenu(){
    const mobileNav = document.getElementById('mobileNav');
    mobileNav.classList.toggle('mobile-open');
  }

  function scrollRow(id, dir){
    const row = document.getElementById(id);
    if (row) row.scrollBy({ left: dir * 320, behavior: 'smooth' });
  }

  // ── CATEGORY TABS ── clicking a pill shows only that category's product
  // panel (or all of them merged, for "All") instead of stacking every
  // category's carousel on the page at once.
  function applyActiveCategoryVisibility(){
    const activePill = document.querySelector('.pill-row .pill-btn.active');
    const cat = activePill ? activePill.dataset.cat : 'all';
    document.querySelectorAll('.cat-panel').forEach(panel => {
      panel.style.display = panel.dataset.cat === cat ? '' : 'none';
    });
  }

  function selectCategory(btn){
    document.querySelectorAll('.pill-row .pill-btn').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    applyActiveCategoryVisibility();
    window.dispatchEvent(new Event('resize'));
  }

  // ── PRODUCT ROW AUTO-SCROLL ── every carousel-row auto-advances
  // right-to-left by one "page" every 10s, looping back to the start.
  // Pauses on hover/touch and restarts its own timer if the user clicks
  // an arrow.
  (function initCarouselAutoScroll(){
    const AUTO_SCROLL_INTERVAL_MS = 10000;

    // A short category (e.g. only 2-3 products) doesn't fill the full-width
    // row, which strands the arrow buttons — anchored to the wrap's far
    // edges — way off in empty space. Hide the arrows (and skip
    // auto-scrolling) whenever a row has nothing to scroll to.
    function syncArrowVisibility(row) {
      const wrap = row.closest('.carousel-wrap');
      if (!wrap) return true;
      const hasOverflow = row.scrollWidth > row.clientWidth + 1;
      wrap.querySelectorAll('.carousel-arrow').forEach(btn => {
        btn.style.display = hasOverflow ? '' : 'none';
      });
      return hasOverflow;
    }

    const rows = Array.from(document.querySelectorAll('.carousel-row'));

    rows.forEach(row => {
      let timer = null;

      const advance = () => {
        if (!syncArrowVisibility(row)) return;
        const atEnd = row.scrollLeft + row.clientWidth >= row.scrollWidth - 1;
        if (atEnd) {
          row.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          row.scrollBy({ left: row.clientWidth, behavior: 'smooth' });
        }
      };

      const start = () => {
        if (timer) return;
        timer = setInterval(advance, AUTO_SCROLL_INTERVAL_MS);
      };

      const stop = () => {
        clearInterval(timer);
        timer = null;
      };

      row.addEventListener('mouseenter', stop);
      row.addEventListener('mouseleave', start);
      row.addEventListener('touchstart', stop, { passive: true });
      row.addEventListener('touchend', start);

      const wrap = row.closest('.carousel-wrap');
      if (wrap) {
        wrap.querySelectorAll('.carousel-arrow').forEach(btn => {
          btn.addEventListener('click', () => { stop(); start(); });
        });
      }

      syncArrowVisibility(row);
      start();
    });

    let resizeTimer = null;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => rows.forEach(syncArrowVisibility), 150);
    });
  })();

  async function addToCart(productId, name, btn) {
    const orig = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Adding…';
    try {
      const res = await fetch('<%= add_item_storefront_cart_path %>', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ product_id: productId, quantity: 1 })
      });
      const data = await res.json();
      if (!data.success) {
        alert(data.error || 'Could not add item to cart.');
        btn.disabled = false;
        btn.textContent = orig;
        return;
      }
      const t = document.getElementById('toast');
      t.textContent = '✓ ' + (name || 'Item') + ' added to cart!';
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 2200);
      btn.textContent = '✓ Added!';
      setTimeout(() => { btn.disabled = false; btn.textContent = orig; }, 1600);

      const badge = document.querySelector('.cart-badge');
      if (badge) {
        badge.textContent = data.cart_count;
      } else if (data.cart_count > 0) {
        const cartLink = document.querySelector('.cart-link');
        const span = document.createElement('span');
        span.className = 'cart-badge';
        span.textContent = data.cart_count;
        cartLink.appendChild(span);
      }
    } catch (e) {
      alert('Could not add item to cart.');
      btn.disabled = false;
      btn.textContent = orig;
    }
  }
</script>
</body>
