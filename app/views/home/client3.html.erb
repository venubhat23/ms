<script>
  function toggleMobileMenu(){
    document.getElementById('mobileNav').classList.toggle('mobile-open');
  }

  function scrollRow(id, dir){
    const row = document.getElementById(id);
    if (row) row.scrollBy({ left: dir * 320, behavior: 'smooth' });
  }

  // ── PRODUCT ROW AUTO-SCROLL ── every carousel-row (categories, best
  // sellers, all products, new arrivals) auto-advances right-to-left by
  // one "page" every 30s, looping back to the start at the end. Pauses
  // on hover/touch and restarts its own timer if the user clicks an arrow.
  (function initCarouselAutoScroll(){
    const AUTO_SCROLL_INTERVAL_MS = 30000;

    document.querySelectorAll('.carousel-row').forEach(row => {
      let timer = null;

      const advance = () => {
        const atEnd = row.scrollLeft + row.clientWidth >= row.scrollWidth - 1;
        if (atEnd) {
          row.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          row.scrollBy({ left: row.clientWidth, behavior: 'smooth' });
        }
      };

      const start = () => {
        if (timer) return;
        timer = setInterval(advance, AUTO_SCROLL_INTERVAL_MS);
      };

      const stop = () => {
        clearInterval(timer);
        timer = null;
      };

      row.addEventListener('mouseenter', stop);
      row.addEventListener('mouseleave', start);
      row.addEventListener('touchstart', stop, { passive: true });
      row.addEventListener('touchend', start);

      const wrap = row.closest('.carousel-wrap');
      if (wrap) {
        wrap.querySelectorAll('.carousel-arrow').forEach(btn => {
          btn.addEventListener('click', () => { stop(); start(); });
        });
      }

      start();
    });
  })();

  // ── HERO SLIDESHOW ── cycles the hero background right-to-left every 10s.
  // A clone of the first slide is appended after the last one so the loop
  // back to slide 1 slides seamlessly instead of jumping backwards.
  (function initHeroSlideshow(){
    const track = document.getElementById('heroTrack');
    if (!track) return;
    const slides = Array.from(track.children);
    if (slides.length < 2) return;

    track.appendChild(slides[0].cloneNode(true));
    track.style.transition = 'transform 1.2s ease-in-out';

    let index = 0;
    setInterval(() => {
      index++;
      track.style.transition = 'transform 1.2s ease-in-out';
      track.style.transform = `translateX(-${index * 100}%)`;

      if (index === slides.length) {
        track.addEventListener('transitionend', function resetToStart(e){
          if (e.propertyName !== 'transform') return;
          track.removeEventListener('transitionend', resetToStart);
          track.style.transition = 'none';
          index = 0;
          track.style.transform = 'translateX(0)';
        });
      }
    }, 10000);
  })();

  // ── PRODUCT SEARCH (client-side filter over every product already
  // rendered on the homepage — the theme has no dedicated search route) ──
  let searchDebounce;
  function filterProducts(rawQuery){
    const query = rawQuery.trim().toLowerCase();
    const banner = document.getElementById('searchBanner');
    const bannerText = document.getElementById('searchBannerText');
    const noResults = document.getElementById('searchNoResults');
    const cards = document.querySelectorAll('.pcard[data-name]');

    if (!query) {
      cards.forEach(c => { c.style.display = ''; });
      document.querySelectorAll('.carousel-wrap').forEach(w => { w.style.display = ''; });
      banner.style.display = 'none';
      noResults.style.display = 'none';
      return 0;
    }

    let matchCount = 0;
    cards.forEach(c => {
      const match = c.dataset.name.includes(query);
      c.style.display = match ? '' : 'none';
      if (match) matchCount++;
    });

    document.querySelectorAll('.carousel-wrap').forEach(w => {
      const anyVisible = Array.from(w.querySelectorAll('.pcard')).some(c => c.style.display !== 'none');
      w.style.display = anyVisible ? '' : 'none';
    });

    banner.style.display = 'block';
    bannerText.textContent = matchCount > 0
      ? `Showing ${matchCount} result${matchCount === 1 ? '' : 's'} for "${rawQuery.trim()}"`
      : `No results for "${rawQuery.trim()}"`;
    noResults.style.display = matchCount === 0 ? 'block' : 'none';
    return matchCount;
  }

  function submitSearch(event){
    event.preventDefault();
    const input = document.getElementById('searchInput');
    const matchCount = filterProducts(input.value);
    const target = matchCount > 0 ? document.querySelector('.pcard:not([style*="display: none"])') : document.getElementById('searchNoResults');
    if (target) target.scrollIntoView({ behavior: 'smooth', block: 'center' });
    return false;
  }

  function clearSearch(){
    const input = document.getElementById('searchInput');
    input.value = '';
    filterProducts('');
    input.focus();
  }

  document.addEventListener('DOMContentLoaded', function(){
    const input = document.getElementById('searchInput');
    if (!input) return;
    input.addEventListener('input', function(){
      clearTimeout(searchDebounce);
      const value = this.value;
      searchDebounce = setTimeout(() => filterProducts(value), 200);
    });
  });

  async function addToCart(productId, name, btn) {
    const orig = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Adding…';
    try {
      const res = await fetch('<%= add_item_storefront_cart_path %>', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ product_id: productId, quantity: 1 })
      });
      const data = await res.json();
      if (!data.success) {
        alert(data.error || 'Could not add item to cart.');
        btn.disabled = false;
        btn.textContent = orig;
        return;
      }
      const t = document.getElementById('toast');
      t.textContent = '✓ ' + (name || 'Item') + ' added to cart!';
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 2200);
      btn.textContent = '✓ Added!';
      setTimeout(() => { btn.disabled = false; btn.textContent = orig; }, 1600);

      const badge = document.querySelector('.cart-badge');
      if (badge) {
        badge.textContent = data.cart_count;
      } else if (data.cart_count > 0) {
        const cartLink = document.querySelector('.nicon[aria-label="Cart"]');
        const span = document.createElement('span');
        span.className = 'cart-badge';
        span.textContent = data.cart_count;
        cartLink.appendChild(span);
      }
    } catch (e) {
      alert('Could not add item to cart.');
      btn.disabled = false;
      btn.textContent = orig;
    }
  }
</script>
</body>
