<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Marali Santhe – Fresh Organic Produce & Groceries</title>
<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --sage:#8fae82;--sage-dark:#5f7a54;--peach:#f3ab7c;--peach-dark:#e08a53;
  --cream:#fdf9f2;--mint:#eaf4e6;--blush:#fdece2;--dark:#3d4536;--white:#fff;--muted:#7c8672;
}
html{scroll-behavior:smooth}
body{font-family:'Poppins',sans-serif;font-weight:400;color:var(--dark);overflow-x:hidden;background:var(--cream)}
h1,h2,h3,h4{font-family:'Quicksand',sans-serif;font-weight:700;color:var(--dark)}

/* ── TOP BAR ── */
.top-bar{background:var(--sage);color:#fff;text-align:center;padding:11px 20px;font-size:12.5px;font-weight:500;letter-spacing:.3px}

/* ── NAV ── */
nav{display:flex;align-items:center;justify-content:space-between;padding:0 44px;height:88px;background:rgba(253,249,242,.9);backdrop-filter:blur(8px);position:sticky;top:0;z-index:300;box-shadow:0 2px 16px rgba(95,122,84,.08)}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none}
.brand-mark{width:54px;height:54px;border-radius:50%;overflow:hidden;border:3px solid var(--white);box-shadow:0 4px 14px rgba(95,122,84,.25);flex-shrink:0}
.brand-mark img{width:100%;height:100%;object-fit:cover}
.brand-name{font-family:'Quicksand',sans-serif;font-size:21px;font-weight:700;color:var(--sage-dark)}
.nav-links{display:flex;gap:6px;list-style:none;align-items:center}
.nav-links a{text-decoration:none;color:var(--dark);font-size:13.5px;font-weight:600;padding:11px 18px;border-radius:30px;transition:background .2s,color .2s}
.nav-links a:hover{background:var(--mint);color:var(--sage-dark)}
.nav-right{display:flex;align-items:center;gap:14px}
.cart-link{position:relative;font-size:21px;text-decoration:none;color:var(--sage-dark);display:flex;align-items:center}
.cart-badge{position:absolute;top:-7px;right:-11px;background:var(--peach-dark);color:#fff;font-size:10px;font-weight:700;border-radius:50%;width:18px;height:18px;display:flex;align-items:center;justify-content:center}
.mobile-nav-links{display:none;position:absolute;top:100%;left:0;width:100%;background:var(--white);box-shadow:0 6px 20px rgba(0,0,0,.08);flex-direction:column;z-index:200;border-radius:0 0 24px 24px}
.mobile-nav-links a{display:block;padding:16px 24px;text-decoration:none;color:var(--dark);font-weight:600;font-size:14px;border-bottom:1px solid var(--mint)}
.mobile-menu-toggle{display:none;background:none;border:none;font-size:24px;color:var(--sage-dark);cursor:pointer}

/* ── BUTTONS ── */
.btn{display:inline-flex;align-items:center;gap:8px;background:var(--sage);color:#fff;padding:15px 34px;text-decoration:none;font-size:13.5px;font-weight:600;border:none;border-radius:40px;cursor:pointer;font-family:'Poppins',sans-serif;transition:transform .2s,box-shadow .2s;box-shadow:0 10px 26px rgba(95,122,84,.3)}
.btn:hover{transform:translateY(-3px);box-shadow:0 14px 32px rgba(95,122,84,.4)}
.btn-peach{display:inline-flex;align-items:center;gap:8px;background:var(--peach);color:#fff;padding:15px 34px;text-decoration:none;font-size:13.5px;font-weight:600;border-radius:40px;transition:transform .2s;box-shadow:0 10px 26px rgba(224,138,83,.35)}
.btn-peach:hover{transform:translateY(-3px)}
.btn-outline{padding:14px 32px;border:2px solid var(--sage);background:transparent;color:var(--sage-dark);font-weight:600;font-size:13.5px;border-radius:40px;cursor:pointer;font-family:'Poppins',sans-serif;transition:all .2s;text-decoration:none;display:inline-block}
.btn-outline:hover{background:var(--sage);color:#fff}
.btn-outline.onwhite{border-color:#fff;color:#fff}
.btn-outline.onwhite:hover{background:#fff;color:var(--sage-dark)}

/* ── HERO ── */
.hero{position:relative;min-height:88vh;display:flex;align-items:center;overflow:hidden;background:linear-gradient(160deg,var(--mint) 0%,var(--cream) 55%,var(--blush) 100%)}
.hero-body{position:relative;z-index:2;display:flex;align-items:center;width:100%;max-width:1320px;margin:0 auto;padding:0 56px;gap:60px}
.hero-left{flex:1}
.hero-eyebrow{display:inline-flex;align-items:center;gap:8px;background:#fff;color:var(--sage-dark);font-size:12.5px;font-weight:600;padding:9px 20px;border-radius:40px;margin-bottom:24px;box-shadow:0 6px 18px rgba(95,122,84,.12)}
.hero h1{font-size:clamp(38px,5.4vw,66px);line-height:1.12;margin-bottom:22px}
.hero h1 span{color:var(--peach-dark)}
.hero-sub{font-size:15px;color:var(--muted);line-height:1.85;max-width:440px;margin-bottom:36px}
.hero-ctas{display:flex;gap:16px;flex-wrap:wrap}
.hero-right{flex:1;position:relative;display:flex;justify-content:center;align-items:center}
.hero-right .circle-img{width:440px;height:440px;border-radius:50%;overflow:hidden;box-shadow:0 30px 70px rgba(95,122,84,.25);border:10px solid #fff}
.hero-right .circle-img img{width:100%;height:100%;object-fit:cover}
.hero-float{position:absolute;background:#fff;padding:16px 22px;border-radius:20px;box-shadow:0 12px 30px rgba(0,0,0,.1);font-size:12px;font-weight:600;display:flex;align-items:center;gap:10px}
.hero-float.f1{top:6%;left:0}
.hero-float.f2{bottom:8%;right:2%}

/* ── TRUST ── */
.trust{background:#fff;display:flex;justify-content:center;flex-wrap:wrap;padding:6px 0}
.trust-item{flex:1;min-width:180px;display:flex;align-items:center;justify-content:center;gap:10px;padding:20px}
.trust-item .ti{font-size:22px}
.trust-item p{font-size:12.5px;font-weight:600;color:var(--sage-dark)}

/* ── SECTION LABELS ── */
.sec-title{text-align:center;padding:76px 20px 10px;font-size:clamp(28px,3.2vw,42px)}
.sec-sub{text-align:center;font-size:14px;color:var(--muted);padding:0 20px 40px}

/* ── CATEGORY CARDS ── */
.cats{display:grid;grid-template-columns:1fr 1fr;gap:24px;max-width:1280px;margin:0 auto 20px;padding:0 40px}
.cat{position:relative;overflow:hidden;border-radius:36px;cursor:pointer;box-shadow:0 18px 44px rgba(95,122,84,.15)}
.cat img{width:100%;height:400px;object-fit:cover;display:block;transition:transform .6s}
.cat:hover img{transform:scale(1.06)}
.cat-shade{position:absolute;inset:0;background:linear-gradient(to top,rgba(61,69,54,.65) 0%,transparent 55%)}
.cat-info{position:absolute;bottom:0;left:0;right:0;padding:34px}
.cat-badge{display:inline-block;background:#fff;color:var(--sage-dark);font-size:11px;font-weight:700;padding:7px 16px;border-radius:40px;margin-bottom:12px}
.cat-info h3{font-size:28px;color:#fff;margin-bottom:16px}

/* ── PRODUCT GRID ── */
.pgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;max-width:1280px;margin:0 auto 72px;padding:0 40px}
.pcard{background:#fff;border-radius:28px;overflow:hidden;box-shadow:0 10px 28px rgba(95,122,84,.1);transition:transform .2s,box-shadow .2s;cursor:pointer}
.pcard:hover{transform:translateY(-8px);box-shadow:0 20px 44px rgba(95,122,84,.2)}
.pcard-img{position:relative;height:210px;overflow:hidden;background:var(--mint);border-radius:28px 28px 0 0}
.pcard-img img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.pcard:hover .pcard-img img{transform:scale(1.08)}
.ptag{position:absolute;top:14px;left:14px;font-size:10px;font-weight:700;padding:6px 14px;border-radius:40px;color:#fff}
.ptag.organic{background:var(--sage)}
.ptag.new{background:var(--peach)}
.ptag.super{background:#a879c9}
.ptag.oos{background:#bbb}
.ptag.best{background:var(--peach-dark)}
.pcard-body{padding:20px 20px 24px}
.pcard h4{font-size:15px;margin-bottom:5px}
.pcard .psub{font-size:11.5px;color:var(--muted);margin-bottom:12px}
.pcard .pprice{font-size:18px;font-weight:700;margin-bottom:14px;color:var(--sage-dark)}
.pcard .pprice s{font-weight:400;color:#ccc;font-size:12px;margin-right:5px}
.btn-add{width:100%;padding:12px;background:var(--mint);color:var(--sage-dark);border:none;cursor:pointer;font-family:'Poppins',sans-serif;font-size:12px;font-weight:600;border-radius:40px;transition:background .2s,color .2s}
.btn-add:hover{background:var(--sage);color:#fff}
.btn-add.out{background:#f1f1ee;color:#bbb;cursor:not-allowed}

/* ── BANNER ── */
.banner{position:relative;min-height:520px;overflow:hidden;display:flex;align-items:center;justify-content:center;margin:0 40px;border-radius:48px;max-width:1280px;margin-left:auto;margin-right:auto}
.banner-bg-img{position:absolute;inset:0;background:url('https://images.pexels.com/photos/1640774/pexels-photo-1640774.jpeg?auto=compress&cs=tinysrgb&w=1600') center/cover}
.banner::before{content:'';position:absolute;inset:0;background:rgba(95,122,84,.55)}
.banner-body{position:relative;z-index:2;text-align:center;color:#fff;max-width:680px;padding:60px 24px}
.banner-body span.leaf{font-size:44px;display:block;margin-bottom:16px}
.banner-body h2{font-size:clamp(28px,4.2vw,48px);margin-bottom:18px;color:#fff}
.banner-body p{font-size:14.5px;line-height:1.9;color:rgba(255,255,255,.9);margin-bottom:12px}

/* ── WHY STRIP ── */
.why-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;max-width:1280px;margin:0 auto;padding:80px 40px}
.why-item{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:38px 22px;text-align:center;background:#fff;border-radius:32px;box-shadow:0 10px 24px rgba(95,122,84,.08);transition:transform .2s}
.why-item:hover{transform:translateY(-6px)}
.why-icon{width:56px;height:56px;border-radius:50%;background:var(--mint);display:flex;align-items:center;justify-content:center;font-size:26px;margin-bottom:16px}
.why-item h4{font-size:17px;margin-bottom:6px}
.why-item p{font-size:12px;color:var(--muted)}

/* ── SPLIT ── */
.split{display:flex;min-height:520px;max-width:1280px;margin:0 auto 4px;border-radius:40px;overflow:hidden}
.split-img{flex:1;overflow:hidden;position:relative}
.split-img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .6s}
.split:hover .split-img img{transform:scale(1.04)}
.split-text{flex:1;background:var(--mint);display:flex;align-items:center;padding:60px 68px}
.split-quote{font-family:'Quicksand',sans-serif;font-weight:600;font-size:21px;color:var(--sage-dark);display:block;margin:14px 0 20px}
.split-text h2{font-size:clamp(24px,3vw,38px);margin-bottom:14px}
.split-text p{font-size:14px;line-height:1.9;color:var(--muted);margin-bottom:12px}
.split-rev{flex-direction:row-reverse}
.split-rev .split-text{background:var(--blush)}
.split-rev .split-quote{color:var(--peach-dark)}

/* ── VIDEO ── */
.vid-section{display:flex;min-height:480px;max-width:1280px;margin:0 auto 60px;border-radius:40px;overflow:hidden}
.vid-left iframe{width:100%;height:100%;min-height:480px;display:block;border:none}
.vid-right{flex:1;background:var(--sage);display:flex;align-items:center;padding:60px 56px;color:#fff}
.vid-right h2{font-size:32px;margin-bottom:16px;color:#fff}
.vid-right p{font-size:14px;line-height:1.9;color:rgba(255,255,255,.85);margin-bottom:12px}

/* ── REVIEWS ── */
.reviews{padding:80px 28px}
.reviews-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;max-width:1120px;margin:0 auto}
.rcard{background:#fff;padding:36px 30px;border-radius:32px;text-align:center;box-shadow:0 10px 26px rgba(95,122,84,.08);transition:transform .2s}
.rcard:hover{transform:translateY(-6px)}
.stars{color:var(--peach-dark);font-size:18px;letter-spacing:3px;margin-bottom:16px}
.rcard blockquote{font-size:14px;line-height:1.85;color:#5c6653;margin-bottom:16px}
.rcard cite{font-weight:700;font-style:normal;font-size:13px;color:var(--sage-dark)}

/* ── ARRIVALS ── */
.arrivals{display:grid;grid-template-columns:1fr 1fr;max-width:1280px;margin:0 auto 72px;gap:20px;padding:0 40px}
.acard{position:relative;overflow:hidden;border-radius:32px;cursor:pointer}
.acard img{width:100%;height:440px;object-fit:cover;display:block;transition:transform .6s}
.acard:hover img{transform:scale(1.06)}
.acard-overlay{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(transparent,rgba(61,69,54,.7));padding:52px 30px 30px;color:#fff}
.acard-overlay .atag{display:inline-block;background:#fff;color:var(--sage-dark);font-size:10.5px;font-weight:700;padding:6px 16px;border-radius:40px;margin-bottom:12px}
.acard-overlay h3{color:#fff;font-size:27px}

/* ── GALLERY ── */
.gallery-section{padding:20px 40px 0}
.gallery-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;max-width:1280px;margin:0 auto}
.gcard{overflow:hidden;border-radius:24px;cursor:pointer;position:relative}
.gcard img{width:100%;height:220px;object-fit:cover;display:block;transition:transform .5s}
.gcard:hover img{transform:scale(1.1)}

/* ── FEATURED ── */
.featured{padding:88px 40px}
.feat-wrap{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center;background:#fff;border-radius:44px;padding:56px;box-shadow:0 20px 50px rgba(95,122,84,.1)}
.feat-img-box{position:relative}
.feat-img-box img{width:100%;border-radius:28px;object-fit:cover;max-height:440px}
.feat-badge{position:absolute;top:-16px;right:-16px;background:var(--peach);color:#fff;width:84px;height:84px;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:10.5px;font-weight:700;text-align:center;line-height:1.3;box-shadow:0 10px 24px rgba(224,138,83,.35)}
.feat-info h2{font-size:34px;margin-bottom:10px}
.feat-price{font-size:28px;font-weight:700;color:var(--sage-dark);margin:14px 0}
.feat-info>p{font-size:14px;line-height:1.85;color:var(--muted);margin-bottom:8px}
.feat-pills{display:flex;gap:10px;flex-wrap:wrap;margin:18px 0}
.pill{background:var(--mint);color:var(--sage-dark);font-size:11.5px;font-weight:600;padding:8px 18px;border-radius:40px}

/* ── BLOG ── */
.blog-section{padding:20px 28px 88px}
.blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;max-width:1200px;margin:0 auto}
.bcard{border-radius:28px;overflow:hidden;box-shadow:0 8px 22px rgba(95,122,84,.08);cursor:pointer;transition:transform .2s;background:#fff}
.bcard:hover{transform:translateY(-6px)}
.bcard img{width:100%;height:200px;object-fit:cover;display:block}
.bcard-body{padding:22px}
.bcard-body .bdate{font-size:11px;color:var(--peach-dark);font-weight:600;margin-bottom:8px}
.bcard-body h4{font-size:17px;margin-bottom:8px}
.bcard-body p{font-size:12.5px;color:var(--muted);line-height:1.7}

/* ── MAILING ── */
.mailing{background:var(--sage);padding:56px 40px;display:flex;align-items:center;justify-content:space-between;gap:32px;flex-wrap:wrap;border-radius:44px;max-width:1280px;margin:0 auto 70px}
.mailing-left h3{font-size:25px;color:#fff;margin-bottom:6px}
.mailing-left p{font-size:13px;color:rgba(255,255,255,.8)}
.mailing-form{display:flex;flex:1;max-width:440px;min-width:260px;background:#fff;border-radius:40px;padding:6px}
.mailing-form input{flex:1;padding:12px 18px;border:none;background:transparent;font-family:'Poppins',sans-serif;font-size:13px;outline:none}
.mailing-form button{padding:12px 26px;background:var(--peach);color:#fff;border:none;cursor:pointer;font-weight:600;font-size:12.5px;border-radius:40px}

/* ── FOOTER ── */
footer{background:#fff;color:var(--muted);padding:64px 44px 30px}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:44px;margin-bottom:44px}
.fbrand-name{font-family:'Quicksand',sans-serif;font-size:25px;font-weight:700;color:var(--sage-dark);margin-bottom:12px}
.fbrand p{font-size:13px;line-height:1.9;max-width:280px}
.fcol h5{color:var(--dark);font-size:12.5px;font-weight:700;margin-bottom:18px}
.fcol ul{list-style:none}
.fcol ul li{margin-bottom:10px}
.fcol ul li a{text-decoration:none;color:var(--muted);font-size:13px}
.fcol ul li a:hover{color:var(--sage-dark)}
.footer-contact{font-size:13px;line-height:1.8;margin-top:14px}
.footer-contact b{color:var(--dark)}
.footer-bottom{border-top:1px solid var(--mint);padding-top:22px;display:flex;justify-content:space-between;align-items:center;font-size:12px;color:#b3b8ac;flex-wrap:wrap;gap:12px}
.footer-policy-links{display:flex;gap:20px}
.footer-policy-links a{color:var(--muted);text-decoration:none;font-size:12px}
.footer-policy-links a:hover{color:var(--sage-dark)}

.toast{position:fixed;bottom:28px;left:50%;transform:translateX(-50%) translateY(80px);background:var(--sage);color:#fff;padding:15px 30px;border-radius:40px;font-size:13px;font-weight:600;z-index:9999;opacity:0;transition:opacity .3s,transform .3s;pointer-events:none}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

@media(max-width:960px){
  nav{padding:0 18px}
  .mobile-menu-toggle{display:block}
  .nav-links{display:none}
  .mobile-nav-links.mobile-open{display:flex}
  .hero-body{flex-direction:column;padding:48px 24px;text-align:center}
  .hero-right{margin-top:24px}
  .hero-right .circle-img{width:320px;height:320px}
  .cats,.pgrid,.reviews-grid,.arrivals,.blog-grid,.footer-grid{grid-template-columns:1fr 1fr}
  .feat-wrap{grid-template-columns:1fr;padding:32px}
  .gallery-grid{grid-template-columns:1fr 1fr}
  .split,.split-rev,.vid-section{flex-direction:column;border-radius:32px}
  .split-img,.vid-left{min-height:260px}
  .why-strip{grid-template-columns:1fr 1fr}
  .banner{margin:0 20px;border-radius:32px}
  .mailing{margin:0 20px 50px;border-radius:32px}
}
@media(max-width:600px){
  .cats,.pgrid,.reviews-grid,.arrivals,.blog-grid,.footer-grid,.gallery-grid,.why-strip{grid-template-columns:1fr}
  .cats,.pgrid,.arrivals,.why-strip{padding-left:20px;padding-right:20px}
  .split-text{padding:36px 26px}
  .featured,.blog-section,.reviews{padding:48px 18px}
  footer{padding:44px 20px 24px}
}
</style>
</head>
<body>

<div class="toast" id="toast">🌿 Added to cart!</div>

<div class="top-bar">
  Free delivery within 5km of JP Nagar (₹499+) · Free across Bengaluru (₹3000+)
</div>

<nav>
  <a class="brand" href="/">
    <div class="brand-mark"><img src="/logo.jpeg" alt="Marali Santhe"></div>
    <span class="brand-name">Marali Santhe</span>
  </a>
  <ul class="nav-links">
    <li><a href="#">Home</a></li>
    <li><a href="#">Organic Foods</a></li>
    <li><a href="#">Wellness</a></li>
    <li><a href="#">Combos</a></li>
    <li><a href="#">Blogs</a></li>
  </ul>
  <div class="nav-right">
    <a href="<%= track_order_path %>" class="track-order-link" aria-label="Track Order" title="Track Order" style="display:inline-flex;align-items:center;gap:5px;padding:7px 14px;border:1.5px solid currentColor;border-radius:20px;font-size:12px;font-weight:700;text-decoration:none;color:inherit;white-space:nowrap;">📦 Track</a>
    <a href="<%= storefront_cart_path %>" class="cart-link" aria-label="Cart">
      🛍️<% if cart_count > 0 %><span class="cart-badge"><%= cart_count %></span><% end %>
    </a>
    <a href="/customer/login" class="btn-outline" style="padding:10px 22px;font-size:13px">Login</a>
    <button class="mobile-menu-toggle" onclick="toggleMobileMenu()">☰</button>
  </div>
  <div class="mobile-nav-links" id="mobileNav">
    <a href="#">Home</a><a href="#">Organic Foods</a><a href="#">Wellness</a><a href="#">Combos</a><a href="#">Blogs</a><a href="<%= track_order_path %>">📦 Track Order</a><a href="<%= storefront_cart_path %>">Cart (<%= cart_count %>)</a><a href="/customer/login">Login</a>
  </div>
</nav>

<section class="hero">
  <div class="hero-body">
    <div class="hero-left">
      <span class="hero-eyebrow">🌿 100% Certified Organic</span>
      <h1>Nourish your<br>body, <span>naturally</span></h1>
      <p class="hero-sub">Fresh, chemical-free organic produce and wellness essentials — sourced with care, delivered with love, straight to your door.</p>
      <div class="hero-ctas">
        <a href="#" class="btn">Shop the Range</a>
        <a href="#" class="btn-outline">Learn More</a>
      </div>
    </div>
