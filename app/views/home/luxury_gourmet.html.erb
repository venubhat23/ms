<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Marali Santhe – Fresh Organic Produce & Groceries</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --black:#0a0a0a;--charcoal:#161513;--gold:#c9a24b;--gold-light:#e9d19c;
  --champagne:#f3ecd9;--white:#fff;--muted:rgba(255,255,255,.55);--line:rgba(255,255,255,.12);
}
html{scroll-behavior:smooth}
body{font-family:'Jost',sans-serif;font-weight:300;color:var(--champagne);overflow-x:hidden;background:var(--black)}
h1,h2,h3,h4{font-family:'Playfair Display',serif;font-weight:600;color:var(--white)}
a{color:inherit}

/* ── TOP BAR ── */
.top-bar{background:var(--black);color:var(--gold-light);text-align:center;padding:11px 20px;font-size:11.5px;letter-spacing:1.6px;font-weight:400;text-transform:uppercase;border-bottom:1px solid var(--line)}

/* ── NAV ── */
nav{display:flex;align-items:center;justify-content:space-between;padding:0 52px;height:90px;background:rgba(10,10,10,.85);backdrop-filter:blur(12px);position:sticky;top:0;z-index:300;border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:14px;text-decoration:none}
.brand-mark{width:56px;height:56px;border-radius:50%;overflow:hidden;border:1.5px solid var(--gold);flex-shrink:0}
.brand-mark img{width:100%;height:100%;object-fit:cover}
.brand-name{font-family:'Playfair Display',serif;font-size:21px;font-weight:600;color:var(--gold-light);letter-spacing:.5px}
.nav-links{display:flex;gap:36px;list-style:none;align-items:center}
.nav-links a{text-decoration:none;color:var(--champagne);font-size:11px;font-weight:400;letter-spacing:2px;text-transform:uppercase;transition:color .2s}
.nav-links a:hover{color:var(--gold-light)}
.nav-right{display:flex;align-items:center;gap:20px}
.mobile-nav-links{display:none;position:absolute;top:100%;left:0;width:100%;background:var(--charcoal);border-bottom:1px solid var(--line);flex-direction:column;z-index:200}
.mobile-nav-links a{display:block;padding:18px 24px;text-decoration:none;color:var(--champagne);font-size:12px;letter-spacing:1.5px;text-transform:uppercase;border-bottom:1px solid var(--line)}
.mobile-menu-toggle{display:none;background:none;border:none;font-size:22px;color:var(--gold-light);cursor:pointer}

/* ── BUTTONS ── */
.btn{display:inline-block;background:var(--gold);color:var(--black);padding:15px 40px;text-decoration:none;font-size:11px;font-weight:600;letter-spacing:2.2px;text-transform:uppercase;border:1px solid var(--gold);cursor:pointer;font-family:'Jost',sans-serif;transition:all .25s}
.btn:hover{background:transparent;color:var(--gold-light)}
.btn-outline{padding:14px 38px;border:1px solid var(--gold-light);background:transparent;color:var(--gold-light);font-size:11px;font-weight:500;letter-spacing:2.2px;text-transform:uppercase;cursor:pointer;font-family:'Jost',sans-serif;transition:all .25s;text-decoration:none;display:inline-block}
.btn-outline:hover{background:var(--gold-light);color:var(--black)}

/* ── HERO ── */
.hero{position:relative;min-height:96vh;display:flex;align-items:center;overflow:hidden;background:#050505}
.hero-bg{position:absolute;inset:0;background:url('https://images.pexels.com/photos/1300972/pexels-photo-1300972.jpeg?auto=compress&cs=tinysrgb&w=1600') center/cover;opacity:.42;filter:contrast(1.1) brightness(.8)}
.hero-overlay{position:absolute;inset:0;background:linear-gradient(100deg,rgba(5,5,5,.97) 10%,rgba(10,10,10,.75) 45%,rgba(10,10,10,.2) 85%)}
.hero-body{position:relative;z-index:2;width:100%;max-width:1320px;margin:0 auto;padding:0 60px}
.hero-eyebrow{font-size:11.5px;letter-spacing:4px;font-weight:500;text-transform:uppercase;color:var(--gold-light);margin-bottom:26px}
.hero h1{font-size:clamp(42px,6vw,84px);line-height:1.05;letter-spacing:.5px;margin-bottom:26px;max-width:820px}
.hero h1 em{font-style:italic;color:var(--gold-light);font-weight:500}
.hero-sub{font-size:15px;color:var(--muted);line-height:1.9;max-width:480px;margin-bottom:40px}
.hero-ctas{display:flex;gap:16px;flex-wrap:wrap}
.hero-rule{width:64px;height:1px;background:var(--gold);margin:36px 0 26px}

/* ── TRUST STRIP ── */
.trust{background:var(--charcoal);border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:flex;justify-content:center;flex-wrap:wrap}
.trust-item{flex:1;min-width:180px;display:flex;align-items:center;justify-content:center;gap:12px;padding:24px 20px;border-right:1px solid var(--line)}
.trust-item:last-child{border:none}
.trust-item .ti{font-size:20px;color:var(--gold-light)}
.trust-item p{font-size:11.5px;letter-spacing:.6px;color:var(--muted);text-transform:uppercase}

/* ── SECTION LABELS ── */
.sec-title{text-align:center;padding:80px 20px 12px;font-size:clamp(28px,3.2vw,46px)}
.sec-sub{text-align:center;font-size:13.5px;color:var(--muted);padding:0 20px 40px;font-family:'Jost',sans-serif;letter-spacing:.3px}
.sec-line{display:block;width:56px;height:1px;background:var(--gold);margin:16px auto 0}

/* ── CATEGORY CARDS ── */
.cats{display:grid;grid-template-columns:1fr 1fr}
.cat{position:relative;overflow:hidden;cursor:pointer}
.cat img{width:100%;height:480px;object-fit:cover;display:block;transition:transform .8s ease;filter:brightness(.82) saturate(.9)}
.cat:hover img{transform:scale(1.06)}
.cat-shade{position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.8) 0%,transparent 55%)}
.cat-info{position:absolute;bottom:0;left:0;right:0;padding:44px}
.cat-badge{display:inline-block;border:1px solid var(--gold);color:var(--gold-light);font-size:10px;letter-spacing:1.5px;padding:6px 16px;text-transform:uppercase;margin-bottom:14px}
.cat-info h3{font-size:32px;margin-bottom:18px}

/* ── PRODUCT GRID ── */
.pgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;max-width:1280px;margin:0 auto 80px;padding:0 28px;background:var(--line)}
.pcard{background:var(--charcoal);overflow:hidden;transition:transform .25s;cursor:pointer;border:1px solid var(--line)}
.pcard:hover{transform:translateY(-6px);border-color:var(--gold)}
.pcard-img{position:relative;height:250px;overflow:hidden;background:#111;display:flex;align-items:center;justify-content:center}
.pcard-img img{width:100%;height:100%;object-fit:cover;transition:transform .5s;filter:brightness(.9)}
.pcard:hover .pcard-img img{transform:scale(1.08)}
.pcard-img .no-image{font-size:34px;color:var(--gold);opacity:.5}
.ptag{position:absolute;top:14px;left:14px;font-size:9.5px;font-weight:600;letter-spacing:1px;padding:5px 12px;text-transform:uppercase;background:rgba(10,10,10,.75);border:1px solid var(--gold);color:var(--gold-light)}
.ptag.best{background:var(--gold);color:var(--black)}
.ptag.arrival{background:var(--champagne);color:var(--black);border-color:var(--champagne)}
.ptag.oos{opacity:.6}
.pcard-body{padding:22px 20px 24px}
.pcard h4{font-size:15px;margin-bottom:6px;color:var(--champagne);font-family:'Playfair Display',serif}
.pcard .psub{font-size:11px;color:var(--muted);margin-bottom:14px;letter-spacing:.3px}
.pcard .pprice{font-size:17px;font-weight:600;margin-bottom:16px;color:var(--gold-light);font-family:'Playfair Display',serif}
.pcard .pprice s{font-weight:300;color:#666;font-size:12px;margin-right:5px}
.btn-add{width:100%;padding:11px;background:transparent;color:var(--gold-light);border:1px solid var(--gold);cursor:pointer;font-family:'Jost',sans-serif;font-size:10.5px;font-weight:500;letter-spacing:1.6px;text-transform:uppercase;transition:all .2s}
.btn-add:hover{background:var(--gold);color:var(--black)}

/* ── FULL CATALOG (real product data) ── */
.catalog-head{max-width:1280px;margin:0 auto 20px;padding:0 28px 16px;display:flex;align-items:baseline;justify-content:space-between;gap:20px;border-bottom:1px solid var(--line)}
.catalog-head h3{font-size:22px;color:var(--gold-light);font-weight:600}
.catalog-head span{font-size:11.5px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;white-space:nowrap}

/* ── BANNER ── */
.banner{position:relative;min-height:560px;overflow:hidden;display:flex;align-items:center;justify-content:center}
.banner-bg-img{position:absolute;inset:0;background:url('https://images.pexels.com/photos/1640774/pexels-photo-1640774.jpeg?auto=compress&cs=tinysrgb&w=1600') center/cover;filter:brightness(.55) saturate(.85)}
.banner-body{position:relative;z-index:2;text-align:center;color:#fff;max-width:720px;padding:60px 24px}
.banner-body span.tag{font-size:11px;letter-spacing:3px;text-transform:uppercase;color:var(--gold-light);display:block;margin-bottom:20px}
.banner-body h2{font-size:clamp(30px,4.5vw,58px);margin-bottom:20px;line-height:1.15}
.banner-body p{font-size:14.5px;line-height:1.95;color:rgba(255,255,255,.72);margin-bottom:12px}

/* ── WHY STRIP (glass cards) ── */
.why-strip{background:var(--black);display:grid;grid-template-columns:repeat(4,1fr);gap:20px;max-width:1280px;margin:0 auto;padding:60px 28px}
.why-item{background:rgba(255,255,255,.04);backdrop-filter:blur(10px);border:1px solid var(--line);border-radius:2px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:44px 22px;text-align:center;transition:border-color .2s,background .2s}
.why-item:hover{border-color:var(--gold);background:rgba(201,162,75,.06)}
.why-icon{font-size:34px;margin-bottom:16px;color:var(--gold-light)}
.why-item h4{font-size:18px;margin-bottom:8px}
.why-item p{font-size:11.5px;color:var(--muted);letter-spacing:.4px;text-transform:uppercase}

/* ── SPLIT ── */
.split{display:flex;min-height:580px}
.split-img{flex:1;overflow:hidden;position:relative}
.split-img img{width:100%;height:100%;object-fit:cover;display:block;filter:brightness(.85);transition:transform .6s}
.split:hover .split-img img{transform:scale(1.04)}
.split-text{flex:1;background:var(--charcoal);display:flex;align-items:center;padding:70px 76px}
.split-quote{font-family:'Playfair Display',serif;font-style:italic;font-size:22px;color:var(--gold-light);display:block;margin:16px 0 22px;border-left:2px solid var(--gold);padding-left:18px}
.split-text h2{font-size:clamp(26px,3vw,44px);margin-bottom:16px;line-height:1.2}
.split-text p{font-size:14px;line-height:1.95;color:var(--muted);margin-bottom:14px}
.split-rev{flex-direction:row-reverse}
.split-rev .split-text{background:#0d0d0c}

/* ── VIDEO ── */
.vid-section{display:flex;min-height:520px}
.vid-left{flex:1;overflow:hidden}
.vid-left iframe{width:100%;height:100%;min-height:520px;display:block;border:none;filter:brightness(.92)}
.vid-right{flex:1;background:var(--black);display:flex;align-items:center;padding:66px 58px;border-left:1px solid var(--line)}
.vid-right h2{font-size:36px;margin-bottom:18px}
.vid-right p{font-size:14px;line-height:1.95;color:var(--muted);margin-bottom:12px}

/* ── REVIEWS ── */
.reviews{background:var(--charcoal);padding:88px 28px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.reviews-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;max-width:1120px;margin:0 auto;background:var(--line)}
.rcard{background:var(--black);padding:38px 30px;text-align:center}
.stars{color:var(--gold);font-size:18px;letter-spacing:3px;margin-bottom:18px}
.rcard blockquote{font-size:14px;line-height:1.95;color:var(--champagne);font-style:italic;margin-bottom:18px}
.rcard cite{font-weight:500;font-style:normal;font-size:12px;letter-spacing:1px;text-transform:uppercase;color:var(--gold-light)}

/* ── ARRIVALS ── */
.arrivals{display:grid;grid-template-columns:1fr 1fr;max-width:1280px;margin:0 auto 80px;gap:1px;padding:0 28px}
.acard{position:relative;overflow:hidden;cursor:pointer}
.acard img{width:100%;height:520px;object-fit:cover;display:block;transition:transform .7s;filter:brightness(.82)}
.acard:hover img{transform:scale(1.05)}
.acard-overlay{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(transparent,rgba(0,0,0,.82));padding:60px 36px 36px}
.acard-overlay .atag{display:inline-block;border:1px solid var(--gold);color:var(--gold-light);font-size:10px;letter-spacing:1.5px;padding:5px 14px;text-transform:uppercase;margin-bottom:14px}
.acard-overlay h3{font-size:32px}

/* ── GALLERY ── */
.gallery-section{padding:60px 28px 0;background:var(--black)}
.gallery-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;max-width:1280px;margin:0 auto;background:var(--line)}
.gcard{overflow:hidden;cursor:pointer;position:relative;background:var(--charcoal)}
.gcard img{width:100%;height:260px;object-fit:cover;display:block;transition:transform .5s;filter:brightness(.8)}
.gcard:hover img{transform:scale(1.08);filter:brightness(1)}

/* ── FEATURED ── */
.featured{background:var(--charcoal);padding:88px 40px;border-top:1px solid var(--line)}
.feat-wrap{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}
.feat-img-box{position:relative}
.feat-img-box img{width:100%;object-fit:cover;max-height:520px;filter:brightness(.88)}
.feat-badge{position:absolute;top:-14px;right:-14px;background:var(--gold);color:var(--black);width:84px;height:84px;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;text-align:center;line-height:1.4}
.feat-info span.tag{font-size:11px;letter-spacing:2.5px;text-transform:uppercase;color:var(--gold-light)}
.feat-info h2{font-size:42px;margin:14px 0 8px}
.feat-price{font-size:30px;font-weight:600;color:var(--gold-light);margin:16px 0;font-family:'Playfair Display',serif}
.feat-info>p{font-size:14px;line-height:1.95;color:var(--muted);margin-bottom:8px}
.feat-pills{display:flex;gap:10px;flex-wrap:wrap;margin:20px 0}
.pill{background:rgba(255,255,255,.04);border:1px solid var(--line);color:var(--champagne);font-size:11px;padding:7px 16px}

/* ── BLOG ── */
.blog-section{padding:80px 28px;background:var(--black)}
.blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;max-width:1200px;margin:0 auto;background:var(--line)}
.bcard{background:var(--charcoal);overflow:hidden;cursor:pointer;transition:transform .2s}
.bcard:hover{transform:translateY(-4px)}
.bcard img{width:100%;height:220px;object-fit:cover;display:block;filter:brightness(.85);transition:transform .5s}
.bcard:hover img{transform:scale(1.05)}
.bcard-body{padding:22px}
.bcard-body .bdate{font-size:10.5px;color:var(--gold-light);letter-spacing:1px;text-transform:uppercase;margin-bottom:10px}
.bcard-body h4{font-size:19px;margin-bottom:8px}
.bcard-body p{font-size:13px;color:var(--muted);line-height:1.8}

/* ── FOOTER ── */
footer{background:var(--black);color:var(--muted);padding:70px 52px 32px;border-top:1px solid var(--line)}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:48px;margin-bottom:52px}
.fbrand-name{font-family:'Playfair Display',serif;font-size:28px;color:var(--gold-light);margin-bottom:12px}
.fbrand p{font-size:13px;line-height:1.95;max-width:280px}
.fcol h5{color:var(--champagne);font-size:11px;letter-spacing:2px;text-transform:uppercase;font-weight:500;margin-bottom:20px}
.fcol ul{list-style:none}
.fcol ul li{margin-bottom:11px}
.fcol ul li a{text-decoration:none;color:var(--muted);font-size:13px}
.fcol ul li a:hover{color:var(--gold-light)}
.footer-contact{font-size:13px;line-height:1.9;margin-top:16px}
.footer-contact b{color:var(--champagne)}
.footer-bottom{border-top:1px solid var(--line);padding-top:26px;display:flex;justify-content:space-between;align-items:center;font-size:12px;color:rgba(255,255,255,.28);flex-wrap:wrap;gap:12px}
.footer-policy-links{display:flex;gap:20px}
.footer-policy-links a{color:var(--muted);text-decoration:none;font-size:12px}
.footer-policy-links a:hover{color:var(--gold-light)}

.toast{position:fixed;bottom:28px;left:50%;transform:translateX(-50%) translateY(80px);background:var(--gold);color:var(--black);padding:14px 30px;font-size:13px;font-weight:600;z-index:9999;opacity:0;transition:opacity .3s,transform .3s;pointer-events:none}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
.cart-badge{position:absolute;top:-7px;right:-11px;background:var(--gold);color:var(--black);font-size:10px;font-weight:700;border-radius:50%;width:18px;height:18px;display:flex;align-items:center;justify-content:center}

@media(max-width:960px){
  nav{padding:0 18px}
  .mobile-menu-toggle{display:block}
  .nav-links{display:none}
  .mobile-nav-links.mobile-open{display:flex}
  .hero-body{padding:0 24px;text-align:left}
  .trust{flex-wrap:wrap}
  .cats,.pgrid,.reviews-grid,.arrivals,.blog-grid,.feat-wrap,.footer-grid{grid-template-columns:1fr 1fr}
  .gallery-grid{grid-template-columns:1fr 1fr}
  .split,.split-rev,.vid-section{flex-direction:column}
  .split-img,.vid-left{min-height:300px}
  .why-strip{grid-template-columns:1fr 1fr}
  .split-text{padding:44px 32px}
}
@media(max-width:600px){
  .cats,.pgrid,.reviews-grid,.arrivals,.blog-grid,.footer-grid,.gallery-grid,.why-strip{grid-template-columns:1fr}
  .split-text{padding:36px 24px}
  .featured,.blog-section,.reviews{padding:56px 18px}
  footer{padding:48px 20px 24px}
}
</style>
</head>
<body>

<div class="toast" id="toast">✓ Added to cart</div>

<div class="top-bar">
  Complimentary delivery within 5km of JP Nagar · Bengaluru-wide delivery on orders above ₹3000
</div>

<nav>
  <a class="brand" href="/">
    <div class="brand-mark"><img src="/logo.jpeg" alt="Marali Santhe"></div>
    <span class="brand-name">Marali Santhe</span>
  </a>
  <ul class="nav-links">
    <li><a href="#">Home</a></li>
    <li><a href="#catalog">Organic Foods</a></li>
    <li><a href="#catalog">Wellness</a></li>
    <li><a href="#">Combos</a></li>
    <li><a href="#">Journal</a></li>
  </ul>
  <div class="nav-right">
    <a href="<%= track_order_path %>" class="track-order-link" aria-label="Track Order" title="Track Order" style="display:inline-flex;align-items:center;gap:5px;padding:7px 14px;border:1.5px solid currentColor;border-radius:20px;font-size:12px;font-weight:700;text-decoration:none;color:var(--gold-light);white-space:nowrap;">📦 Track</a>
    <a href="<%= storefront_cart_path %>" class="cart-link" aria-label="Cart" style="position:relative;font-size:19px;color:var(--gold-light);">
      🛍️<% if cart_count > 0 %><span class="cart-badge"><%= cart_count %></span><% end %>
    </a>
    <a href="/customer/login" class="btn-outline" style="padding:11px 26px">Login</a>
    <button class="mobile-menu-toggle" onclick="toggleMobileMenu()">☰</button>
  </div>
  <div class="mobile-nav-links" id="mobileNav">
    <a href="#">Home</a><a href="#catalog">Organic Foods</a><a href="#catalog">Wellness</a><a href="#">Combos</a><a href="#">Journal</a><a href="<%= track_order_path %>">📦 Track Order</a><a href="<%= storefront_cart_path %>">Cart (<%= cart_count %>)</a><a href="/customer/login">Login</a>
  </div>
</nav>

<section class="hero">
  <div class="hero-bg"></div>
  <div class="hero-overlay"></div>
  <div class="hero-body">
    <p class="hero-eyebrow">Est. 2019 · Certified Organic</p>
    <h1>An <em>exceptional</em><br>standard of<br>organic living</h1>
    <div class="hero-rule"></div>
    <p class="hero-sub">Marali Santhe curates the finest organic produce and pantry essentials, sourced directly from India's most respected farms.</p>
    <div class="hero-ctas">
      <a href="#catalog" class="btn">Discover the Collection</a>
      <a href="#" class="btn-outline">Our Heritage</a>
    </div>
  </div>
</section>

<div class="trust">
  <div class="trust-item"><span class="ti">✦</span><p>Certified Organic</p></div>
  <div class="trust-item"><span class="ti">✦</span><p>Complimentary Delivery</p></div>
  <div class="trust-item"><span class="ti">✦</span><p>7-Day Returns</p></div>
  <div class="trust-item"><span class="ti">✦</span><p>Award Winning</p></div>
  <div class="trust-item"><span class="ti">✦</span><p>Made in India</p></div>
</div>

<div class="cats">
  <% if @top_category %>
    <div class="cat"><img src="<%= @top_category.display_image_url %>" alt="<%= @top_category.name %>"><div class="cat-shade"></div><div class="cat-info"><div class="cat-badge">★ Best Seller</div><h3><%= @top_category.name %></h3><a href="#catalog" class="btn-outline">Shop Now</a></div></div>
  <% end %>
  <% if @secondary_category %>
