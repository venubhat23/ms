</p>

<% @products_by_category.each do |category_name, products| %>
  <div class="catalog-head">
    <h3><%= category_name %></h3>
    <span><%= pluralize(products.size, 'item') %></span>
  </div>
  <div class="pgrid">
    <% products.each do |product| %>
      <div class="pcard">
        <div class="pcard-img">
          <% if product.main_image_url %>
            <%= image_tag product.main_image_url, alt: product.name %>
          <% else %>
            <span class="no-image">🍯</span>
          <% end %>
          <% if !product.in_stock? %>
            <span class="ptag oos">Out of Stock</span>
          <% elsif @best_seller_ids.include?(product.id) %>
            <span class="ptag best">★ Best Seller</span>
          <% elsif @new_arrival_ids.include?(product.id) %>
            <span class="ptag arrival">🆕 New Arrival</span>
          <% elsif product.discounted? %>
            <span class="ptag">Sale</span>
          <% end %>
        </div>
        <div class="pcard-body">
          <h4><%= product.name %></h4>
          <p class="psub"><%= [product.unit_type, product.sku].compact_blank.join(' · ') %></p>
          <div class="pprice">
            <% if product.discounted? %>
              <s>₹<%= product.price %></s> ₹<%= product.selling_price %>
            <% else %>
              ₹<%= product.selling_price %>
            <% end %>
          </div>
          <% if product.in_stock? %>
            <button class="btn-add" onclick="addToCart(<%= product.id %>,'<%= j product.name %>',this)">Add to Cart</button>
          <% else %>
            <button class="btn-add" disabled style="opacity:.4;cursor:not-allowed">Out of Stock</button>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

