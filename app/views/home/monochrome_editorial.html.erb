          <% else %>
            <span class="no-image">🌿</span>
          <% end %>
          <% if !product.in_stock? %>
            <span class="ptag oos">Out of Stock</span>
          <% elsif @best_seller_ids.include?(product.id) %>
            <span class="ptag best">★ Best Seller</span>
          <% elsif @new_arrival_ids.include?(product.id) %>
            <span class="ptag arrival">🆕 New Arrival</span>
          <% elsif product.discounted? %>
            <span class="ptag new">Sale</span>
          <% end %>
        </div>
        <div class="pcard-body">
          <h4><%= product.name %></h4>
          <p class="psub"><%= [product.unit_type, product.sku].compact_blank.join(' · ') %></p>
          <div class="pprice">
            <% if product.discounted? %>
              <s>₹<%= product.price %></s> ₹<%= product.selling_price %>
            <% else %>
              ₹<%= product.selling_price %>
