<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Marali Santhe – Fresh Organic Produce & Groceries</title>
<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,500;0,700;0,900;1,500&family=Archivo:wght@300;400;500;600;700;900&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --black:#0a0a0a;--white:#fff;--red:#e10600;--gray:#f1f1f1;--gray2:#e0e0e0;--muted:#666;
}
html{scroll-behavior:smooth}
body{font-family:'Archivo',sans-serif;color:var(--black);overflow-x:hidden;background:var(--white);font-weight:400}
h1,h2,h3,h4{font-family:'Bodoni Moda',serif;font-weight:700;letter-spacing:-.01em}
a{color:inherit}

/* ── TOP BAR ── */
.top-bar{background:var(--black);color:var(--white);text-align:center;padding:10px 20px;font-size:11px;letter-spacing:2px;font-weight:600;text-transform:uppercase}
.top-bar b{color:var(--red)}

/* ── NAV ── */
nav{display:flex;align-items:center;justify-content:space-between;padding:0 48px;height:96px;background:var(--white);position:sticky;top:0;z-index:300;border-bottom:2px solid var(--black)}
.brand{display:flex;align-items:center;gap:14px;text-decoration:none}
.brand-mark{width:48px;height:48px;border-radius:50%;overflow:hidden;border:2px solid var(--black);flex-shrink:0;filter:grayscale(1)}
.brand-mark img{width:100%;height:100%;object-fit:cover}
.brand-name{font-family:'Bodoni Moda',serif;font-size:24px;font-weight:900;letter-spacing:.5px;text-transform:uppercase}
.nav-links{display:flex;gap:40px;list-style:none;align-items:center}
.nav-links a{text-decoration:none;color:var(--black);font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;position:relative;padding-bottom:4px}
.nav-links a::after{content:'';position:absolute;left:0;bottom:0;width:0;height:2px;background:var(--red);transition:width .25s}
.nav-links a:hover::after{width:100%}
.nav-right{display:flex;align-items:center;gap:20px}
.cart-link{position:relative;font-size:20px;text-decoration:none;color:var(--black);display:flex;align-items:center}
.cart-badge{position:absolute;top:-7px;right:-11px;background:var(--red);color:#fff;font-size:10px;font-weight:700;border-radius:50%;width:18px;height:18px;display:flex;align-items:center;justify-content:center}
.mobile-nav-links{display:none;position:absolute;top:100%;left:0;width:100%;background:var(--white);border-bottom:2px solid var(--black);flex-direction:column;z-index:200}
.mobile-nav-links a{display:block;padding:18px 24px;text-decoration:none;color:var(--black);font-size:12px;letter-spacing:1.5px;text-transform:uppercase;border-bottom:1px solid var(--gray2);font-weight:700}
.mobile-menu-toggle{display:none;background:none;border:none;font-size:22px;color:var(--black);cursor:pointer}

/* ── BUTTONS ── */
.btn{display:inline-block;background:var(--black);color:var(--white);padding:16px 40px;text-decoration:none;font-size:11px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;border:2px solid var(--black);cursor:pointer;font-family:'Archivo',sans-serif;transition:all .25s}
.btn:hover{background:var(--white);color:var(--black)}
.btn-red{display:inline-block;background:var(--red);color:var(--white);padding:16px 40px;text-decoration:none;font-size:11px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;border:2px solid var(--red);cursor:pointer;transition:all .25s}
.btn-red:hover{background:var(--white);color:var(--red)}
.btn-outline{padding:15px 38px;border:2px solid var(--black);background:transparent;color:var(--black);font-size:11px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;cursor:pointer;font-family:'Archivo',sans-serif;transition:all .25s;text-decoration:none;display:inline-block}
.btn-outline:hover{background:var(--black);color:var(--white)}
.btn-outline.white{border-color:#fff;color:#fff}
.btn-outline.white:hover{background:#fff;color:var(--black)}

/* ── HERO ── */
.hero{position:relative;min-height:96vh;display:flex;flex-direction:column;justify-content:center;overflow:hidden;border-bottom:2px solid var(--black)}
.hero-top{display:flex;justify-content:space-between;align-items:flex-start;padding:48px;font-size:11px;letter-spacing:2px;text-transform:uppercase;font-weight:700}
.hero-main{flex:1;display:flex;align-items:center;padding:0 48px;gap:60px}
.hero-left{flex:1.2}
.hero h1{font-size:clamp(52px,8vw,140px);line-height:.92;text-transform:uppercase;margin-bottom:0}
.hero h1 .red{color:var(--red)}
.hero-sub{font-size:14px;color:var(--muted);line-height:1.8;max-width:400px;margin:30px 0}
.hero-ctas{display:flex;gap:16px;flex-wrap:wrap}
.hero-right{flex:1;position:relative;height:460px}
.hero-right img{width:100%;height:100%;object-fit:cover;display:block;filter:grayscale(1) contrast(1.05)}
.hero-num{position:absolute;top:-30px;left:-30px;font-family:'Bodoni Moda',serif;font-size:110px;font-weight:900;color:var(--gray2);z-index:0;line-height:1}

/* ── TRUST ── */
.trust{background:var(--black);display:flex;justify-content:center;flex-wrap:wrap}
.trust-item{flex:1;min-width:180px;display:flex;align-items:center;justify-content:center;gap:10px;padding:22px 20px;border-right:1px solid rgba(255,255,255,.15)}
.trust-item:last-child{border:none}
.trust-item p{font-size:11px;letter-spacing:1.5px;color:#fff;text-transform:uppercase;font-weight:700}

/* ── SECTION LABELS ── */
.sec-head{display:flex;justify-content:space-between;align-items:flex-end;padding:88px 48px 36px;border-bottom:2px solid var(--black);margin-bottom:0}
.sec-head .num{font-family:'Bodoni Moda',serif;font-size:15px;color:var(--red);letter-spacing:1px;margin-bottom:8px;display:block;font-weight:700}
.sec-head h2{font-size:clamp(32px,4vw,54px);text-transform:uppercase}
.sec-head p{font-size:13px;color:var(--muted);max-width:280px;text-align:right}

/* ── CATEGORY CARDS ── */
.cats{display:grid;grid-template-columns:1fr 1fr;border-bottom:2px solid var(--black)}
.cat{position:relative;overflow:hidden;cursor:pointer;border-right:2px solid var(--black)}
.cat:last-child{border-right:none}
.cat img{width:100%;height:460px;object-fit:cover;display:block;filter:grayscale(1);transition:transform .7s ease}
.cat:hover img{transform:scale(1.06)}
.cat-shade{position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.75) 0%,transparent 55%)}
.cat-info{position:absolute;bottom:0;left:0;right:0;padding:40px}
.cat-badge{display:inline-block;background:var(--red);color:#fff;font-size:10px;font-weight:700;letter-spacing:1.5px;padding:6px 16px;text-transform:uppercase;margin-bottom:14px}
.cat-info h3{font-size:34px;color:#fff;margin-bottom:18px;text-transform:uppercase}

/* ── PRODUCT GRID ── */
.pgrid{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:2px solid var(--black)}
.pcard{background:var(--white);cursor:pointer;border-right:1px solid var(--black);transition:background .2s}
.pcard:last-child{border-right:none}
.pcard:hover{background:var(--gray)}
.pcard-img{position:relative;height:260px;overflow:hidden;background:var(--gray);display:flex;align-items:center;justify-content:center}
.pcard-img img{width:100%;height:100%;object-fit:cover;transition:transform .5s;filter:grayscale(1)}
.pcard:hover .pcard-img img{transform:scale(1.06)}
.pcard-img .no-image{font-size:32px;opacity:.3}
.ptag{position:absolute;top:14px;left:14px;font-size:9.5px;font-weight:700;letter-spacing:1px;padding:5px 12px;text-transform:uppercase;background:var(--black);color:#fff}
.ptag.new{background:var(--red)}
.ptag.oos{background:#999}
.ptag.best{background:#fff;color:var(--black);border:1.5px solid var(--black)}
.ptag.arrival{background:var(--gray2);color:var(--black)}
.pcard-body{padding:22px 20px 26px}
.pcard h4{font-size:15px;font-weight:700;margin-bottom:6px;font-family:'Archivo',sans-serif;text-transform:uppercase;letter-spacing:.3px}
.pcard .psub{font-size:11px;color:var(--muted);margin-bottom:14px;letter-spacing:.3px}
.pcard .pprice{font-size:17px;font-weight:700;font-family:'Bodoni Moda',serif;color:var(--red)}
.pcard .pprice s{font-weight:400;color:#bbb;font-size:12px;margin-right:5px;font-family:'Archivo',sans-serif}
.btn-add{width:100%;padding:12px;background:var(--black);color:var(--white);border:none;cursor:pointer;font-family:'Archivo',sans-serif;font-size:10.5px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;transition:background .2s;margin-top:14px}
.btn-add:hover{background:var(--red)}
.btn-add.out{background:#ddd;color:#999;cursor:not-allowed}

/* ── BANNER ── */
.banner{position:relative;min-height:64vh;overflow:hidden;display:flex;align-items:center;justify-content:center;border-bottom:2px solid var(--black)}
.banner-bg{position:absolute;inset:0;background:url('https://images.pexels.com/photos/1640774/pexels-photo-1640774.jpeg?auto=compress&cs=tinysrgb&w=1600') center/cover;filter:grayscale(1) contrast(1.1)}
.banner::before{content:'';position:absolute;inset:0;background:rgba(0,0,0,.6)}
.banner-body{position:relative;z-index:2;text-align:center;color:#fff;max-width:700px;padding:60px 24px}
.banner-body span.tag{font-size:11px;letter-spacing:3px;text-transform:uppercase;color:var(--red);display:block;margin-bottom:20px;font-weight:700}
.banner-body h2{font-size:clamp(32px,4.8vw,60px);margin-bottom:20px;text-transform:uppercase}
.banner-body p{font-size:14px;line-height:1.9;color:rgba(255,255,255,.75);margin-bottom:12px}

/* ── WHY STRIP ── */
.why-strip{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:2px solid var(--black)}
.why-item{padding:56px 30px;border-right:1px solid var(--black);text-align:left}
.why-item:last-child{border:none}
.why-item .no{font-family:'Bodoni Moda',serif;font-size:34px;color:var(--gray2);margin-bottom:16px;display:block;font-weight:900}
.why-item h4{font-size:16px;margin-bottom:8px;text-transform:uppercase;letter-spacing:.5px}
.why-item p{font-size:12px;color:var(--muted)}

/* ── SPLIT ── */
.split{display:flex;min-height:560px;border-bottom:2px solid var(--black)}
.split-img{flex:1;overflow:hidden;position:relative}
.split-img img{width:100%;height:100%;object-fit:cover;display:block;filter:grayscale(1);transition:transform .6s}
.split:hover .split-img img{transform:scale(1.04)}
.split-text{flex:1;background:var(--white);display:flex;align-items:center;padding:64px 72px;border-left:2px solid var(--black)}
.split-text .tag{font-size:11px;letter-spacing:2.5px;text-transform:uppercase;color:var(--red);font-weight:700;margin-bottom:14px;display:block}
.split-text h2{font-size:clamp(28px,3.2vw,44px);margin-bottom:18px;text-transform:uppercase}
.split-text p{font-size:14px;line-height:1.9;color:var(--muted);margin-bottom:14px}
.split-rev{flex-direction:row-reverse}
.split-rev .split-text{background:var(--black);border-left:none;border-right:2px solid var(--black)}
.split-rev .split-text h2{color:#fff}
.split-rev .split-text p{color:rgba(255,255,255,.6)}

/* ── VIDEO ── */
.vid-section{display:flex;min-height:520px;border-bottom:2px solid var(--black)}
.vid-left iframe{width:100%;height:100%;min-height:520px;display:block;border:none;filter:grayscale(.6)}
.vid-right{flex:1;background:var(--white);display:flex;align-items:center;padding:64px 60px;border-left:2px solid var(--black)}
.vid-right h2{font-size:38px;margin-bottom:18px;text-transform:uppercase}
.vid-right p{font-size:14px;line-height:1.9;color:var(--muted);margin-bottom:12px}

/* ── REVIEWS ── */
.reviews{padding:88px 48px;border-bottom:2px solid var(--black)}
.reviews-grid{display:grid;grid-template-columns:repeat(3,1fr);max-width:1200px;margin:0 auto;border:1px solid var(--black)}
.rcard{background:var(--white);padding:40px 32px;border-right:1px solid var(--black)}
.rcard:last-child{border-right:none}
.rcard .quote{font-family:'Bodoni Moda',serif;font-size:48px;color:var(--red);line-height:1;margin-bottom:16px;display:block;font-weight:900}
.rcard blockquote{font-size:14px;line-height:1.85;color:#333;margin-bottom:18px}
.rcard cite{font-weight:700;font-style:normal;font-size:11px;letter-spacing:1.5px;text-transform:uppercase}

/* ── ARRIVALS ── */
.arrivals{display:grid;grid-template-columns:1fr 1fr;border-bottom:2px solid var(--black)}
.acard{position:relative;overflow:hidden;cursor:pointer;border-right:2px solid var(--black)}
.acard:last-child{border-right:none}
.acard img{width:100%;height:500px;object-fit:cover;display:block;filter:grayscale(1);transition:transform .6s}
.acard:hover img{transform:scale(1.05)}
.acard-overlay{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(transparent,rgba(0,0,0,.72));padding:60px 36px 36px;color:#fff}
.acard-overlay .atag{display:inline-block;background:var(--red);color:#fff;font-size:10px;font-weight:700;letter-spacing:1px;padding:5px 14px;text-transform:uppercase;margin-bottom:12px}
.acard-overlay h3{font-size:32px;text-transform:uppercase}

/* ── GALLERY ── */
.gallery-grid{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:2px solid var(--black)}
.gcard{overflow:hidden;cursor:pointer;position:relative;border-right:1px solid var(--black)}
.gcard:last-child{border-right:none}
.gcard img{width:100%;height:260px;object-fit:cover;display:block;transition:transform .5s;filter:grayscale(1)}
.gcard:hover img{transform:scale(1.08);filter:grayscale(0)}

/* ── FEATURED ── */
.featured{padding:96px 48px;border-bottom:2px solid var(--black)}
.feat-wrap{max-width:1160px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}
.feat-img-box img{width:100%;object-fit:cover;max-height:500px;filter:grayscale(1)}
.feat-info span.tag{font-size:11px;letter-spacing:2.5px;text-transform:uppercase;color:var(--red);font-weight:700}
.feat-info h2{font-size:40px;margin:14px 0 12px;text-transform:uppercase}
.feat-price{font-size:30px;font-weight:700;font-family:'Bodoni Moda',serif;margin:16px 0}
.feat-info>p{font-size:14px;line-height:1.9;color:var(--muted);margin-bottom:14px}
.feat-pills{display:flex;gap:10px;flex-wrap:wrap;margin:20px 0 28px}
.pill{border:1px solid var(--black);color:var(--black);font-size:10.5px;font-weight:700;padding:7px 16px;letter-spacing:.5px;text-transform:uppercase}

/* ── BLOG ── */
.blog-section{padding:88px 48px;border-bottom:2px solid var(--black)}
.blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;max-width:1200px;margin:0 auto;border:1px solid var(--black)}
.bcard{cursor:pointer;border-right:1px solid var(--black);padding-bottom:24px}
.bcard:last-child{border-right:none}
.bcard img{width:100%;height:220px;object-fit:cover;display:block;filter:grayscale(1);margin-bottom:18px;transition:transform .5s}
.bcard:hover img{transform:scale(1.03)}
.bcard .bdate{font-size:10.5px;color:var(--red);letter-spacing:1px;text-transform:uppercase;margin:0 24px 8px;font-weight:700}
.bcard h4{font-size:18px;margin:0 24px 8px;text-transform:uppercase}
.bcard p{font-size:13px;color:var(--muted);line-height:1.7;margin:0 24px}

/* ── MAILING ── */
.mailing{background:var(--black);padding:64px 48px;display:flex;align-items:center;justify-content:space-between;gap:40px;flex-wrap:wrap}
.mailing-left h3{color:#fff;font-size:26px;margin-bottom:6px;text-transform:uppercase}
.mailing-left p{color:rgba(255,255,255,.5);font-size:12px;letter-spacing:.5px}
.mailing-form{display:flex;flex:1;max-width:460px;min-width:260px;border-bottom:2px solid #fff}
.mailing-form input{flex:1;padding:14px 4px;border:none;background:transparent;color:#fff;font-family:'Archivo',sans-serif;font-size:13px;outline:none}
.mailing-form input::placeholder{color:rgba(255,255,255,.4)}
.mailing-form button{padding:14px 0;background:none;color:var(--red);border:none;cursor:pointer;font-weight:700;font-size:11px;letter-spacing:1.5px;text-transform:uppercase}

/* ── FOOTER ── */
footer{background:var(--white);color:var(--muted);padding:72px 48px 32px}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:48px;margin-bottom:56px}
.fbrand-name{font-family:'Bodoni Moda',serif;font-size:28px;font-weight:900;color:var(--black);margin-bottom:14px;text-transform:uppercase}
.fbrand p{font-size:13px;line-height:1.9;max-width:280px}
.fcol h5{color:var(--black);font-size:11px;letter-spacing:2px;text-transform:uppercase;font-weight:700;margin-bottom:22px}
.fcol ul{list-style:none}
.fcol ul li{margin-bottom:12px}
.fcol ul li a{text-decoration:none;color:var(--muted);font-size:13.5px}
.fcol ul li a:hover{color:var(--red)}
.footer-contact{font-size:13px;line-height:1.8;margin-top:18px}
.footer-contact b{color:var(--black)}
.footer-bottom{border-top:2px solid var(--black);padding-top:26px;display:flex;justify-content:space-between;align-items:center;font-size:11px;color:#aaa;flex-wrap:wrap;gap:12px;text-transform:uppercase;letter-spacing:.5px}
.footer-policy-links{display:flex;gap:20px}
.footer-policy-links a{color:var(--muted);text-decoration:none;font-size:11px;text-transform:uppercase}
.footer-policy-links a:hover{color:var(--red)}

.toast{position:fixed;bottom:28px;left:50%;transform:translateX(-50%) translateY(80px);background:var(--black);color:#fff;padding:15px 30px;font-size:12px;font-weight:700;letter-spacing:1px;text-transform:uppercase;z-index:9999;opacity:0;transition:opacity .3s,transform .3s;pointer-events:none}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

@media(max-width:960px){
  nav{padding:0 20px}
  .mobile-menu-toggle{display:block}
  .nav-links{display:none}
  .mobile-nav-links.mobile-open{display:flex}
  .hero-main{flex-direction:column;padding:30px 24px}
  .hero-right{width:100%;height:280px;margin-top:24px}
  .cats,.pgrid,.reviews-grid,.arrivals,.blog-grid,.footer-grid,.feat-wrap{grid-template-columns:1fr 1fr}
  .gallery-grid{grid-template-columns:1fr 1fr}
  .split,.split-rev,.vid-section{flex-direction:column}
  .split-img,.vid-left{min-height:280px}
  .split-text{border-left:none;border-top:2px solid var(--black)}
  .why-strip{grid-template-columns:1fr 1fr}
  .sec-head{flex-direction:column;align-items:flex-start;gap:10px;padding:56px 24px 28px}
  .cats,.pgrid,.arrivals,.gallery-grid,.reviews-grid,.blog-grid{padding-left:0}
}
@media(max-width:600px){
  .cats,.pgrid,.reviews-grid,.arrivals,.blog-grid,.footer-grid,.gallery-grid,.why-strip{grid-template-columns:1fr}
  .hero-main{padding:20px}
  .split-text,.vid-right{padding:40px 24px}
  .featured,.blog-section,.reviews{padding:56px 20px}
  .feat-wrap{gap:32px}
  footer{padding:48px 20px 24px}
  .pcard,.rcard,.bcard,.gcard{border-right:none !important}
}
</style>
</head>
<body>

<div class="toast" id="toast">Added to cart</div>

<div class="top-bar">
  Free delivery within 5km of JP Nagar — orders above <b>₹499</b> · Free across Bengaluru above <b>₹3000</b>
</div>

<nav>
  <a class="brand" href="/">
    <div class="brand-mark"><img src="/logo.jpeg" alt="Marali Santhe"></div>
    <span class="brand-name">Marali Santhe</span>
  </a>
  <ul class="nav-links">
    <li><a href="#">Home</a></li>
    <li><a href="#catalog">Organic Foods</a></li>
    <li><a href="#catalog">Wellness</a></li>
    <li><a href="#">Combos</a></li>
    <li><a href="#">Journal</a></li>
  </ul>
  <div class="nav-right">
    <a href="<%= storefront_cart_path %>" class="cart-link" aria-label="Cart">
      🛍️<% if cart_count > 0 %><span class="cart-badge"><%= cart_count %></span><% end %>
    </a>
    <a href="/customer/login" class="btn-outline" style="padding:11px 26px">Login</a>
    <button class="mobile-menu-toggle" onclick="toggleMobileMenu()">☰</button>
  </div>
  <div class="mobile-nav-links" id="mobileNav">
    <a href="#">Home</a><a href="#catalog">Organic Foods</a><a href="#catalog">Wellness</a><a href="#">Combos</a><a href="#">Journal</a><a href="<%= storefront_cart_path %>">Cart (<%= cart_count %>)</a><a href="/customer/login">Login</a>
  </div>
</nav>

<section class="hero">
  <div class="hero-top">
    <span>Est. 2019 — Bengaluru</span>
    <span>No. 01 / Organic Journal</span>
  </div>
  <div class="hero-main">
    <div class="hero-left">
      <h1>Pure<br>Organic<br><span class="red">Living.</span></h1>
      <p class="hero-sub">Marali Santhe curates uncompromising organic produce and pantry staples — sourced directly, delivered fresh, nothing in between.</p>
      <div class="hero-ctas">
        <a href="#catalog" class="btn">Shop the Edit</a>
        <a href="#" class="btn-outline">Our Farms</a>
      </div>
    </div>
    <div class="hero-right">
      <img src="https://images.pexels.com/photos/1300972/pexels-photo-1300972.jpeg?auto=compress&cs=tinysrgb&w=1200" alt="Marali Santhe organic produce">
    </div>
  </div>
