  <svg viewBox="0 0 32 32"><path d="M16 3C8.8 3 3 8.8 3 16c0 2.3.6 4.5 1.7 6.5L3 29l6.7-1.7c1.9 1 4 1.6 6.3 1.6 7.2 0 13-5.8 13-13S23.2 3 16 3zm0 23.7c-2 0-4-.5-5.7-1.6l-.4-.2-4 1 1.1-3.9-.3-.4c-1.2-1.8-1.8-3.9-1.8-6 0-6 4.9-10.9 11-10.9S26.9 9.9 26.9 16 22 26.7 16 26.7zm6-8.1c-.3-.2-1.9-1-2.2-1.1-.3-.1-.5-.2-.7.2-.2.3-.8 1.1-1 1.3-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.3-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.3.3-.6.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.5c.2.2 2.4 3.7 5.8 5.1 2.9 1.1 3.4.9 4 .8.6-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.3-.6-.4z"/></svg>
</a>
<button class="to-top" id="toTop" onclick="window.scrollTo({top:0,behavior:'smooth'})" aria-label="Back to top">↑</button>

<!-- QUICK VIEW -->
<div class="qv" id="qv" onclick="if(event.target===this)closeQuickView()">
  <div class="qv-box">
    <button class="qv-close" onclick="closeQuickView()" aria-label="Close">×</button>
    <div class="qv-img" id="qvImg"></div>
    <div class="qv-body">
      <div class="pcat" id="qvCat"></div>
      <h3 id="qvTitle"></h3>
      <div class="pprice" id="qvPrice"></div>
      <p id="qvDesc"></p>
      <div id="qvAction"></div>
    </div>
  </div>
</div>

<script>
  // ── HEADER / MENU ──
  function toggleMenu(open){ document.getElementById('offcanvas').classList.toggle('open', open); }
  (function(){
    const header = document.getElementById('siteHeader');
    const toTop = document.getElementById('toTop');
    window.addEventListener('scroll', () => {
      header.classList.toggle('scrolled', window.scrollY > 60);
      toTop.classList.toggle('show', window.scrollY > 600);
    }, { passive: true });
  })();

  // ── HERO SLIDER ── fade + slow zoom, autoplays every 6s
  let heroIndex = 0, heroTimer = null;
  function heroTo(i){
    const slides = document.querySelectorAll('.hero-slide');
    const dots = document.querySelectorAll('.hero-dots button');
    if (slides.length < 2) return;
    heroIndex = (i + slides.length) % slides.length;
    slides.forEach((s, n) => s.classList.toggle('active', n === heroIndex));
    dots.forEach((d, n) => d.classList.toggle('active', n === heroIndex));
    clearInterval(heroTimer);
    heroTimer = setInterval(() => heroTo(heroIndex + 1), 6000);
  }
  function heroGo(dir){ heroTo(heroIndex + dir); }
  heroTo(0);

  // ── WORD-BY-WORD HEADINGS + SCROLL REVEAL ──
  document.querySelectorAll('.split').forEach(h => {
    const words = h.textContent.trim().split(/\s+/);
    h.innerHTML = words.map((w, i) => `<span class="word" style="transition-delay:${i * 90}ms">${w.replace(/&/g,'&amp;').replace(/</g,'&lt;')}</span>`).join(' ');
  });
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in-view'); io.unobserve(e.target); } });
  }, { threshold: 0.15 });
  document.querySelectorAll('.split, .reveal').forEach(el => io.observe(el));

  // ── CATEGORY CAROUSEL ──
  function scrollCats(dir){
    const row = document.getElementById('catRow');
    if (row) row.scrollBy({ left: dir * (row.clientWidth * 0.8), behavior: 'smooth' });
  }

  // ── PRODUCT GRID: tabs, search, load more ──
  const PAGE_SIZE = 12;
  let activeCat = 'all', searchQuery = '', visibleLimit = PAGE_SIZE;

  function renderGrid(){
    const cards = Array.from(document.querySelectorAll('#productGrid .pcard'));
    if (!cards.length) return;
    const matches = cards.filter(c =>
      (activeCat === 'all' || c.dataset.cat === activeCat) &&
      (!searchQuery || c.dataset.name.includes(searchQuery))
    );
    const limit = searchQuery ? Infinity : visibleLimit;
    cards.forEach(c => { c.style.display = 'none'; });
    matches.forEach((c, i) => { if (i < limit) c.style.display = ''; });

    document.getElementById('moreWrap').style.display = matches.length > limit ? '' : 'none';
    document.getElementById('noResults').style.display = matches.length ? 'none' : 'block';

    const banner = document.getElementById('searchBanner');
    if (searchQuery) {
      banner.style.display = 'block';
      document.getElementById('searchBannerText').textContent =
        `${matches.length} result${matches.length === 1 ? '' : 's'} for "${document.getElementById('searchInput').value.trim()}"`;
    } else {
      banner.style.display = 'none';
    }
  }

  function selectTab(cat){
    activeCat = cat;
    visibleLimit = PAGE_SIZE;
    document.querySelectorAll('#tabs .tab').forEach(t => t.classList.toggle('active', t.dataset.cat === cat));
    renderGrid();
    const section = document.getElementById('products');
    const rect = section.getBoundingClientRect();
    if (rect.top > 200 || rect.bottom < 0) section.scrollIntoView({ behavior: 'smooth' });
  }

  function showMore(){ visibleLimit += PAGE_SIZE; renderGrid(); }

  let searchDebounce;
  function submitSearch(event){
    event.preventDefault();
    searchQuery = document.getElementById('searchInput').value.trim().toLowerCase();
    renderGrid();
    document.getElementById('products').scrollIntoView({ behavior: 'smooth' });
    return false;
  }
  function clearSearch(){
    const input = document.getElementById('searchInput');
    input.value = ''; searchQuery = ''; renderGrid(); input.focus();
  }
  document.getElementById('searchInput').addEventListener('input', function(){
    clearTimeout(searchDebounce);
    const value = this.value;
    searchDebounce = setTimeout(() => { searchQuery = value.trim().toLowerCase(); renderGrid(); }, 200);
  });
  renderGrid();

  // ── WISHLIST (per-browser, localStorage) ──
  const WISH_KEY = 'np_wishlist';
  function readWish(){ try { return JSON.parse(localStorage.getItem(WISH_KEY)) || []; } catch (e) { return []; } }
  function writeWish(ids){ try { localStorage.setItem(WISH_KEY, JSON.stringify(ids)); } catch (e) {} }
  function syncWish(){
    const ids = readWish();
    document.querySelectorAll('#productGrid .pcard').forEach(c => {
      const btn = c.querySelector('.wish-btn');
      if (btn) btn.classList.toggle('wished', ids.includes(c.dataset.id));
    });
    const badge = document.getElementById('wishBadge');
    badge.textContent = ids.length;
    badge.style.display = ids.length ? '' : 'none';
  }
  function toggleWish(btn){
    const id = btn.closest('.pcard').dataset.id;
    let ids = readWish();
    const adding = !ids.includes(id);
    ids = adding ? ids.concat(id) : ids.filter(x => x !== id);
    writeWish(ids);
    syncWish();
    showToast(adding ? '♥ Added to wishlist' : 'Removed from wishlist');
  }
  function showWishlist(){
    const ids = readWish();
    if (!ids.length) { showToast('Your wishlist is empty'); return; }
    activeCat = 'all'; searchQuery = '';
    document.querySelectorAll('#tabs .tab').forEach(t => t.classList.toggle('active', t.dataset.cat === 'all'));
    document.querySelectorAll('#productGrid .pcard').forEach(c => { c.style.display = ids.includes(c.dataset.id) ? '' : 'none'; });
    document.getElementById('moreWrap').style.display = 'none';
    document.getElementById('noResults').style.display = 'none';
    const banner = document.getElementById('searchBanner');
    banner.style.display = 'block';
    document.getElementById('searchBannerText').textContent = `Your wishlist (${ids.length})`;
    document.getElementById('products').scrollIntoView({ behavior: 'smooth' });
  }
  syncWish();

  // ── QUICK VIEW ── reuses the card's own add-to-cart control (moved into
  // the modal while open, then put back) so variant chips keep working.
  let qvSource = null, qvControl = null;
  function quickView(btn){
    const card = btn.closest('.pcard');
    qvSource = card.querySelector('.pbody');
    qvControl = qvSource.querySelector('.sv-picker, .btn-add');
    document.getElementById('qvImg').innerHTML = card.dataset.img
      ? `<img src="${card.dataset.img}" alt="">` : '<div class="noimg">🌾</div>';
    document.querySelector('#qvImg img')?.setAttribute('alt', card.dataset.title);
    document.getElementById('qvCat').textContent = card.querySelector('.pcat').textContent;
    document.getElementById('qvTitle').textContent = card.dataset.title;
    document.getElementById('qvPrice').innerHTML = card.querySelector('.pprice').innerHTML;
    document.getElementById('qvDesc').textContent = card.dataset.desc || 'Authentic, natural and traditionally crafted.';
    if (qvControl) document.getElementById('qvAction').appendChild(qvControl);
    document.getElementById('qv').classList.add('open');
  }
  function closeQuickView(){
    if (qvControl && qvSource) qvSource.appendChild(qvControl);
    qvControl = qvSource = null;
    document.getElementById('qv').classList.remove('open');
  }
  document.addEventListener('keydown', e => { if (e.key === 'Escape') { closeQuickView(); toggleMenu(false); } });

  // ── CART ──
  function showToast(msg){
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 2200);
  }

  async function addToCart(productId, name, btn) {
    const orig = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Adding…';
    try {
      const res = await fetch('<%= add_item_storefront_cart_path %>', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ product_id: productId, quantity: 1 })
      });
      const data = await res.json();
      if (!data.success) {
        alert(data.error || 'Could not add item to cart.');
        btn.disabled = false;
        btn.textContent = orig;
        return;
      }
      showToast('✓ ' + (name || 'Item') + ' added to cart!');
      btn.textContent = '✓ Added!';
      setTimeout(() => { btn.disabled = false; btn.textContent = orig; }, 1600);

      const badge = document.querySelector('.cart-badge');
      if (badge) {
        badge.textContent = data.cart_count;
      } else if (data.cart_count > 0) {
        const span = document.createElement('span');
        span.className = 'cart-badge';
        span.textContent = data.cart_count;
        document.querySelector('.cart-link').appendChild(span);
      }
    } catch (e) {
      alert('Could not add item to cart.');
      btn.disabled = false;
      btn.textContent = orig;
    }
  }
</script>
</body>
</html>
