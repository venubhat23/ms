<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Marali Santhe – Fresh Organic Produce & Groceries</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --navy:#070b14;--navy2:#0d1526;--navy3:#111c33;--blue:#3b82f6;--cyan:#22d3ee;
  --neon:#39ff88;--white:#e8ecf5;--muted:#8b96ab;--line:rgba(255,255,255,.1);
}
html{scroll-behavior:smooth}
body{font-family:'Sora',sans-serif;color:var(--white);overflow-x:hidden;background:var(--navy);font-weight:400;
  background-image:linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.03) 1px,transparent 1px);
  background-size:48px 48px;}
h1,h2,h3,h4{font-family:'Space Grotesk',sans-serif;font-weight:700;color:#fff}
a{color:inherit}

/* ── TOP BAR ── */
.top-bar{background:var(--navy2);color:var(--cyan);text-align:center;padding:10px 20px;font-size:11.5px;letter-spacing:1.2px;font-weight:600;text-transform:uppercase;border-bottom:1px solid var(--line)}

/* ── NAV ── */
nav{display:flex;align-items:center;justify-content:space-between;padding:0 48px;height:88px;background:rgba(7,11,20,.85);backdrop-filter:blur(14px);position:sticky;top:0;z-index:300;border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:14px;text-decoration:none}
.brand-mark{width:50px;height:50px;border-radius:12px;overflow:hidden;border:1px solid var(--cyan);flex-shrink:0;box-shadow:0 0 20px rgba(34,211,238,.35)}
.brand-mark img{width:100%;height:100%;object-fit:cover}
.brand-name{font-family:'Space Grotesk',sans-serif;font-size:20px;font-weight:700;background:linear-gradient(90deg,var(--cyan),var(--neon));-webkit-background-clip:text;background-clip:text;color:transparent}
.nav-links{display:flex;gap:34px;list-style:none;align-items:center}
.nav-links a{text-decoration:none;color:var(--white);font-size:12.5px;font-weight:500;letter-spacing:.3px;transition:color .2s}
.nav-links a:hover{color:var(--cyan)}
.nav-right{display:flex;align-items:center;gap:18px}
.cart-link{position:relative;font-size:20px;text-decoration:none;color:var(--cyan);display:flex;align-items:center}
.cart-badge{position:absolute;top:-7px;right:-11px;background:var(--neon);color:#04140a;font-size:10px;font-weight:700;border-radius:50%;width:18px;height:18px;display:flex;align-items:center;justify-content:center}
.mobile-nav-links{display:none;position:absolute;top:100%;left:0;width:100%;background:var(--navy2);border-bottom:1px solid var(--line);flex-direction:column;z-index:200}
.mobile-nav-links a{display:block;padding:16px 24px;text-decoration:none;color:var(--white);font-size:13px;border-bottom:1px solid var(--line)}
.mobile-menu-toggle{display:none;background:none;border:none;font-size:22px;color:var(--cyan);cursor:pointer}

/* ── BUTTONS ── */
.btn{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(90deg,var(--blue),var(--cyan));color:#04121a;padding:15px 34px;text-decoration:none;font-size:13px;font-weight:700;border:none;border-radius:10px;cursor:pointer;font-family:'Sora',sans-serif;transition:transform .18s,box-shadow .18s;box-shadow:0 0 30px rgba(59,130,246,.4)}
.btn:hover{transform:translateY(-3px);box-shadow:0 0 44px rgba(34,211,238,.55)}
.btn-neon{display:inline-flex;align-items:center;gap:8px;background:var(--neon);color:#04140a;padding:15px 34px;text-decoration:none;font-size:13px;font-weight:700;border-radius:10px;transition:transform .18s;box-shadow:0 0 30px rgba(57,255,136,.35)}
.btn-neon:hover{transform:translateY(-3px)}
.btn-outline{padding:14px 32px;border:1px solid var(--cyan);background:transparent;color:var(--cyan);font-weight:600;font-size:13px;border-radius:10px;cursor:pointer;font-family:'Sora',sans-serif;transition:all .2s;text-decoration:none;display:inline-block}
.btn-outline:hover{background:rgba(34,211,238,.1);box-shadow:0 0 20px rgba(34,211,238,.25)}

/* ── HERO ── */
.hero{position:relative;min-height:90vh;display:flex;align-items:center;overflow:hidden}
.hero-glow{position:absolute;width:600px;height:600px;background:radial-gradient(circle,rgba(59,130,246,.25),transparent 70%);top:-200px;right:-100px}
.hero-glow2{position:absolute;width:500px;height:500px;background:radial-gradient(circle,rgba(57,255,136,.15),transparent 70%);bottom:-150px;left:-100px}
.hero-body{position:relative;z-index:2;display:flex;align-items:center;width:100%;max-width:1320px;margin:0 auto;padding:0 56px;gap:60px}
.hero-left{flex:1}
.hero-eyebrow{display:inline-flex;align-items:center;gap:8px;background:var(--navy2);border:1px solid var(--line);color:var(--cyan);font-size:11.5px;font-weight:600;padding:9px 18px;border-radius:50px;margin-bottom:24px;letter-spacing:.5px}
.hero-eyebrow::before{content:'●';color:var(--neon);font-size:9px}
.hero h1{font-size:clamp(36px,5.2vw,62px);line-height:1.1;margin-bottom:22px}
.hero h1 .grad{background:linear-gradient(90deg,var(--cyan),var(--neon));-webkit-background-clip:text;background-clip:text;color:transparent}
.hero-sub{font-size:15px;color:var(--muted);line-height:1.85;max-width:460px;margin-bottom:36px}
.hero-ctas{display:flex;gap:16px;flex-wrap:wrap;margin-bottom:44px}
.hero-stats{display:flex;gap:40px;border-top:1px solid var(--line);padding-top:26px}
.hero-stats div b{display:block;font-family:'Space Grotesk',sans-serif;font-size:24px;color:var(--cyan)}
.hero-stats div span{font-size:11px;color:var(--muted);letter-spacing:.5px;text-transform:uppercase}
.hero-right{flex:1;position:relative;display:flex;justify-content:center}
.hero-right .panel{position:relative;border-radius:20px;overflow:hidden;border:1px solid var(--line);box-shadow:0 0 60px rgba(59,130,246,.25)}
.hero-right .panel img{width:100%;max-width:440px;height:440px;object-fit:cover;display:block;filter:saturate(1.1) brightness(.95)}
.hero-right .panel::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 60%,rgba(7,11,20,.85));pointer-events:none}
.hero-tag{position:absolute;bottom:20px;left:20px;background:rgba(7,11,20,.85);border:1px solid var(--neon);color:var(--neon);padding:10px 18px;border-radius:8px;font-size:11.5px;font-weight:600;z-index:2}

/* ── TRUST ── */
.trust{background:var(--navy2);border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:flex;justify-content:center;flex-wrap:wrap}
.trust-item{flex:1;min-width:180px;display:flex;align-items:center;justify-content:center;gap:10px;padding:22px 20px;border-right:1px solid var(--line)}
.trust-item:last-child{border:none}
.trust-item .ti{color:var(--cyan);font-size:18px}
.trust-item p{font-size:11.5px;letter-spacing:.4px;color:var(--muted);text-transform:uppercase}

/* ── SECTION LABELS ── */
.sec-title{text-align:center;padding:76px 20px 10px;font-size:clamp(28px,3.2vw,44px)}
.sec-title .grad{background:linear-gradient(90deg,var(--cyan),var(--neon));-webkit-background-clip:text;background-clip:text;color:transparent}
.sec-sub{text-align:center;font-size:14px;color:var(--muted);padding:0 20px 40px}

/* ── CATEGORY CARDS ── */
.cats{display:grid;grid-template-columns:1fr 1fr;gap:24px;max-width:1280px;margin:0 auto 20px;padding:0 40px}
.cat{position:relative;overflow:hidden;border-radius:20px;cursor:pointer;border:1px solid var(--line)}
.cat img{width:100%;height:400px;object-fit:cover;display:block;transition:transform .6s;filter:brightness(.85) saturate(1.05)}
.cat:hover img{transform:scale(1.06)}
.cat-shade{position:absolute;inset:0;background:linear-gradient(to top,rgba(7,11,20,.85) 0%,transparent 55%)}
.cat-info{position:absolute;bottom:0;left:0;right:0;padding:32px}
.cat-badge{display:inline-block;background:rgba(34,211,238,.15);border:1px solid var(--cyan);color:var(--cyan);font-size:10.5px;font-weight:600;padding:6px 16px;border-radius:50px;margin-bottom:12px}
.cat-info h3{font-size:27px;color:#fff;margin-bottom:16px}

/* ── PRODUCT GRID ── */
.pgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;max-width:1280px;margin:0 auto 72px;padding:0 40px}
.pcard{background:var(--navy2);border-radius:18px;overflow:hidden;border:1px solid var(--line);transition:transform .2s,border-color .2s,box-shadow .2s;cursor:pointer}
.pcard:hover{transform:translateY(-6px);border-color:var(--cyan);box-shadow:0 0 30px rgba(34,211,238,.2)}
.pcard-img{position:relative;height:200px;overflow:hidden;background:var(--navy3);display:flex;align-items:center;justify-content:center}
.pcard-img img{width:100%;height:100%;object-fit:cover;transition:transform .5s;filter:brightness(.92)}
.pcard:hover .pcard-img img{transform:scale(1.08)}
.pcard-img .no-image{font-size:32px;opacity:.3}
.ptag{position:absolute;top:12px;left:12px;font-size:9.5px;font-weight:600;padding:5px 12px;border-radius:50px;background:rgba(7,11,20,.8);border:1px solid var(--neon);color:var(--neon)}
.ptag.oos{border-color:#555;color:#888}
.ptag.best{background:var(--neon);color:var(--navy);border-color:var(--neon)}
.ptag.arrival{background:rgba(59,130,246,.15);border-color:var(--blue);color:var(--blue)}
.pcard-body{padding:18px 18px 22px}
.pcard h4{font-size:14.5px;margin-bottom:5px;color:#fff}
.pcard .psub{font-size:11px;color:var(--muted);margin-bottom:12px}
.pcard .pprice{font-size:17px;font-weight:700;margin-bottom:14px;color:var(--cyan);font-family:'Space Grotesk',sans-serif}
.pcard .pprice s{font-weight:400;color:#555;font-size:12px;margin-right:5px}
.btn-add{width:100%;padding:11px;background:transparent;color:var(--cyan);border:1px solid var(--line);cursor:pointer;font-family:'Sora',sans-serif;font-size:11px;font-weight:600;border-radius:8px;transition:all .2s}
.btn-add:hover{background:rgba(34,211,238,.1);border-color:var(--cyan)}
.btn-add.out{color:#555;border-color:var(--line);cursor:not-allowed}

/* ── BANNER ── */
.banner{position:relative;min-height:520px;overflow:hidden;display:flex;align-items:center;justify-content:center}
.banner-bg-img{position:absolute;inset:0;background:url('https://images.pexels.com/photos/1640774/pexels-photo-1640774.jpeg?auto=compress&cs=tinysrgb&w=1600') center/cover;filter:brightness(.4) saturate(1.1)}
.banner::before{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(7,11,20,.7),rgba(7,11,20,.9))}
.banner-body{position:relative;z-index:2;text-align:center;color:#fff;max-width:720px;padding:60px 24px}
.banner-body span.tag{font-size:11px;letter-spacing:2.5px;text-transform:uppercase;color:var(--neon);display:block;margin-bottom:20px;font-weight:600}
.banner-body h2{font-size:clamp(28px,4.2vw,50px);margin-bottom:20px}
.banner-body p{font-size:14.5px;line-height:1.9;color:rgba(255,255,255,.75);margin-bottom:12px}

/* ── WHY STRIP ── */
.why-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;max-width:1280px;margin:0 auto;padding:0 40px;background:var(--line)}
.why-item{background:var(--navy2);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:44px 22px;text-align:center;transition:background .2s}
.why-item:hover{background:var(--navy3)}
.why-icon{font-size:32px;margin-bottom:14px}
.why-item h4{font-size:17px;margin-bottom:6px}
.why-item p{font-size:11.5px;color:var(--muted);letter-spacing:.4px;text-transform:uppercase}

/* ── SPLIT ── */
.split{display:flex;min-height:520px}
.split-img{flex:1;overflow:hidden;position:relative}
.split-img img{width:100%;height:100%;object-fit:cover;display:block;filter:brightness(.85);transition:transform .6s}
.split:hover .split-img img{transform:scale(1.04)}
.split-text{flex:1;background:var(--navy2);display:flex;align-items:center;padding:60px 68px}
.split-quote{font-family:'Space Grotesk',sans-serif;font-size:20px;color:var(--cyan);display:block;margin:14px 0 20px}
.split-text h2{font-size:clamp(24px,3vw,38px);margin-bottom:14px}
.split-text p{font-size:14px;line-height:1.9;color:var(--muted);margin-bottom:12px}
.split-rev{flex-direction:row-reverse}
.split-rev .split-text{background:var(--navy)}
.split-rev .split-quote{color:var(--neon)}

/* ── VIDEO ── */
.vid-section{display:flex;min-height:500px}
.vid-left{flex:1;overflow:hidden}
.vid-left iframe{width:100%;height:100%;min-height:500px;display:block;border:none;filter:brightness(.9)}
.vid-right{flex:1;background:var(--navy2);display:flex;align-items:center;padding:60px 56px;border-left:1px solid var(--line)}
.vid-right h2{font-size:32px;margin-bottom:16px}
.vid-right p{font-size:14px;line-height:1.9;color:var(--muted);margin-bottom:12px}

/* ── REVIEWS ── */
.reviews{background:var(--navy2);padding:80px 28px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.reviews-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;max-width:1120px;margin:0 auto;background:var(--line)}
.rcard{background:var(--navy2);padding:36px 28px;text-align:center}
.stars{color:var(--neon);font-size:18px;letter-spacing:3px;margin-bottom:16px}
.rcard blockquote{font-size:14px;line-height:1.9;color:var(--white);margin-bottom:16px}
.rcard cite{font-family:'Space Grotesk',sans-serif;font-weight:600;font-size:12.5px;color:var(--cyan)}

/* ── ARRIVALS ── */
.arrivals{display:grid;grid-template-columns:1fr 1fr;max-width:1280px;margin:0 auto 72px;gap:20px;padding:0 40px}
.acard{position:relative;overflow:hidden;border-radius:20px;cursor:pointer;border:1px solid var(--line)}
.acard img{width:100%;height:440px;object-fit:cover;display:block;transition:transform .6s;filter:brightness(.82)}
.acard:hover img{transform:scale(1.06)}
.acard-overlay{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(transparent,rgba(7,11,20,.85));padding:52px 30px 30px;color:#fff}
.acard-overlay .atag{display:inline-block;background:rgba(57,255,136,.15);border:1px solid var(--neon);color:var(--neon);font-size:10.5px;font-weight:600;padding:6px 16px;border-radius:50px;margin-bottom:12px}
.acard-overlay h3{color:#fff;font-size:27px}

/* ── GALLERY ── */
.gallery-section{padding:20px 40px 0}
.gallery-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;max-width:1280px;margin:0 auto;background:var(--line)}
.gcard{overflow:hidden;cursor:pointer;position:relative;background:var(--navy2)}
.gcard img{width:100%;height:220px;object-fit:cover;display:block;transition:transform .5s;filter:brightness(.85)}
.gcard:hover img{transform:scale(1.1);filter:brightness(1)}

/* ── FEATURED ── */
.featured{background:var(--navy2);padding:88px 40px;border-top:1px solid var(--line)}
.feat-wrap{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}
.feat-img-box{position:relative}
.feat-img-box img{width:100%;border-radius:20px;object-fit:cover;max-height:460px;border:1px solid var(--line)}
.feat-badge{position:absolute;top:-14px;right:-14px;background:var(--navy);border:1px solid var(--neon);color:var(--neon);width:80px;height:80px;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:10px;font-weight:700;text-align:center;line-height:1.3;box-shadow:0 0 20px rgba(57,255,136,.35)}
.feat-info span.tag{font-size:11px;letter-spacing:2.5px;text-transform:uppercase;color:var(--cyan);font-weight:600}
.feat-info h2{font-size:34px;margin:14px 0 8px}
.feat-price{font-size:28px;font-weight:700;color:var(--cyan);margin:14px 0;font-family:'Space Grotesk',sans-serif}
.feat-info>p{font-size:14px;line-height:1.9;color:var(--muted);margin-bottom:8px}
.feat-pills{display:flex;gap:10px;flex-wrap:wrap;margin:18px 0}
.pill{background:var(--navy3);border:1px solid var(--line);color:var(--white);font-size:11px;padding:7px 16px;border-radius:50px}

/* ── BLOG ── */
.blog-section{padding:80px 28px;background:var(--navy)}
.blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;max-width:1200px;margin:0 auto;background:var(--line)}
.bcard{background:var(--navy2);overflow:hidden;cursor:pointer;transition:transform .2s}
.bcard:hover{transform:translateY(-4px)}
.bcard img{width:100%;height:200px;object-fit:cover;display:block;filter:brightness(.88)}
.bcard-body{padding:20px}
.bcard-body .bdate{font-size:10.5px;color:var(--cyan);letter-spacing:1px;text-transform:uppercase;margin-bottom:10px}
.bcard-body h4{font-size:18px;margin-bottom:8px}
.bcard-body p{font-size:12.5px;color:var(--muted);line-height:1.75}

/* ── FOOTER ── */
footer{background:var(--navy);color:var(--muted);padding:64px 48px 30px;border-top:1px solid var(--line)}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:44px;margin-bottom:48px}
.fbrand-name{font-family:'Space Grotesk',sans-serif;font-size:24px;font-weight:700;background:linear-gradient(90deg,var(--cyan),var(--neon));-webkit-background-clip:text;background-clip:text;color:transparent;margin-bottom:12px}
.fbrand p{font-size:13px;line-height:1.9;max-width:280px}
.fcol h5{color:var(--white);font-size:11px;letter-spacing:1.5px;text-transform:uppercase;font-weight:600;margin-bottom:18px}
.fcol ul{list-style:none}
.fcol ul li{margin-bottom:10px}
.fcol ul li a{text-decoration:none;color:var(--muted);font-size:13px}
.fcol ul li a:hover{color:var(--cyan)}
.footer-contact{font-size:13px;line-height:1.85;margin-top:14px}
.footer-contact b{color:var(--white)}
.footer-bottom{border-top:1px solid var(--line);padding-top:24px;display:flex;justify-content:space-between;align-items:center;font-size:12px;color:#555f70;flex-wrap:wrap;gap:12px}
.footer-policy-links{display:flex;gap:20px}
.footer-policy-links a{color:var(--muted);text-decoration:none;font-size:12px}
.footer-policy-links a:hover{color:var(--cyan)}

.toast{position:fixed;bottom:28px;left:50%;transform:translateX(-50%) translateY(80px);background:var(--navy2);border:1px solid var(--neon);color:var(--neon);padding:14px 30px;border-radius:10px;font-size:13px;font-weight:600;z-index:9999;opacity:0;transition:opacity .3s,transform .3s;pointer-events:none;box-shadow:0 0 24px rgba(57,255,136,.3)}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

@media(max-width:960px){
  nav{padding:0 18px}
  .mobile-menu-toggle{display:block}
  .nav-links{display:none}
  .mobile-nav-links.mobile-open{display:flex}
  .hero-body{flex-direction:column;padding:44px 24px;text-align:center}
  .hero-right{margin-top:32px}
  .hero-stats{justify-content:center}
  .cats,.pgrid,.reviews-grid,.arrivals,.blog-grid,.feat-wrap,.footer-grid{grid-template-columns:1fr 1fr}
  .gallery-grid{grid-template-columns:1fr 1fr}
  .split,.split-rev,.vid-section{flex-direction:column}
  .split-img,.vid-left{min-height:280px}
  .why-strip{grid-template-columns:1fr 1fr}
}
@media(max-width:600px){
  .cats,.pgrid,.reviews-grid,.arrivals,.blog-grid,.footer-grid,.gallery-grid,.why-strip{grid-template-columns:1fr}
  .split-text{padding:40px 26px}
  .featured,.blog-section,.reviews{padding:56px 18px}
  footer{padding:44px 20px 24px}
}
</style>
</head>
<body>

<div class="toast" id="toast">✓ Added to cart</div>

<div class="top-bar">
  Free delivery within 5km of JP Nagar (₹499+) · Free across Bengaluru (₹3000+)
</div>

<nav>
  <a class="brand" href="/">
    <div class="brand-mark"><img src="/logo.jpeg" alt="Marali Santhe"></div>
    <span class="brand-name">Marali Santhe</span>
  </a>
  <ul class="nav-links">
    <li><a href="#">Home</a></li>
    <li><a href="#">Organic Foods</a></li>
    <li><a href="#">Wellness</a></li>
    <li><a href="#">Combos</a></li>
    <li><a href="#">Journal</a></li>
  </ul>
  <div class="nav-right">
    <a href="<%= storefront_cart_path %>" class="cart-link" aria-label="Cart">
      🛒<% if cart_count > 0 %><span class="cart-badge"><%= cart_count %></span><% end %>
    </a>
    <a href="/customer/login" class="btn-outline" style="padding:10px 22px;font-size:13px">Login</a>
    <button class="mobile-menu-toggle" onclick="toggleMobileMenu()">☰</button>
  </div>
  <div class="mobile-nav-links" id="mobileNav">
    <a href="#">Home</a><a href="#">Organic Foods</a><a href="#">Wellness</a><a href="#">Combos</a><a href="#">Journal</a><a href="<%= storefront_cart_path %>">Cart (<%= cart_count %>)</a><a href="/customer/login">Login</a>
  </div>
</nav>

<section class="hero">
  <div class="hero-glow"></div>
  <div class="hero-glow2"></div>
