<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Marali Santhe – Fresh Organic Produce & Groceries</title>
<link href="https://fonts.googleapis.com/css2?family=Righteous&family=Karla:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --mustard:#d99a2b;--mustard-dark:#b57e1e;--rust:#b8502f;--rust-dark:#963f22;
  --cream:#f7ecd8;--dark:#3a2c1a;--olive:#6b7a3d;--brown:#5c3d2a;--muted:#7a6a52;--white:#fffaf0;
}
html{scroll-behavior:smooth}
body{font-family:'Karla',sans-serif;color:var(--dark);overflow-x:hidden;background:var(--cream)}
h1,h2,h3,h4{font-family:'Righteous',cursive;font-weight:400}

/* ── TOP BAR ── */
.top-bar{background:var(--rust);color:var(--cream);text-align:center;padding:11px 20px;font-size:12.5px;font-weight:700;letter-spacing:.3px}

/* ── NAV ── */
nav{display:flex;align-items:center;justify-content:space-between;padding:0 44px;height:88px;background:var(--cream);position:sticky;top:0;z-index:300;border-bottom:4px solid var(--dark)}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none}
.brand-mark{width:58px;height:58px;border-radius:50%;overflow:hidden;border:4px solid var(--mustard);flex-shrink:0}
.brand-mark img{width:100%;height:100%;object-fit:cover}
.brand-name{font-family:'Righteous',cursive;font-size:21px;color:var(--rust-dark)}
.nav-links{display:flex;gap:6px;list-style:none;align-items:center}
.nav-links a{text-decoration:none;color:var(--dark);font-size:13.5px;font-weight:700;padding:10px 18px;border-radius:50px;transition:background .2s,color .2s}
.nav-links a:hover{background:var(--mustard);color:#fff}
.nav-right{display:flex;align-items:center;gap:14px}
.cart-link{position:relative;font-size:20px;text-decoration:none;color:var(--rust-dark);display:flex;align-items:center}
.cart-badge{position:absolute;top:-7px;right:-11px;background:var(--rust);color:#fff;font-size:10px;font-weight:700;border-radius:50%;width:18px;height:18px;display:flex;align-items:center;justify-content:center;border:2px solid var(--dark)}
.mobile-nav-links{display:none;position:absolute;top:100%;left:0;width:100%;background:var(--cream);border-bottom:4px solid var(--dark);flex-direction:column;z-index:200}
.mobile-nav-links a{display:block;padding:16px 22px;text-decoration:none;color:var(--dark);font-weight:700;font-size:14px;border-bottom:1px dashed var(--muted)}
.mobile-menu-toggle{display:none;background:none;border:none;font-size:24px;color:var(--rust-dark);cursor:pointer}

/* ── BUTTONS ── */
.btn{display:inline-flex;align-items:center;gap:8px;background:var(--rust);color:#fff;padding:15px 34px;text-decoration:none;font-size:13.5px;font-weight:700;border:3px solid var(--dark);border-radius:50px;cursor:pointer;font-family:'Karla',sans-serif;transition:transform .18s;box-shadow:4px 4px 0 var(--dark)}
.btn:hover{transform:translate(-3px,-3px);box-shadow:7px 7px 0 var(--dark)}
.btn-mustard{display:inline-flex;align-items:center;gap:8px;background:var(--mustard);color:var(--dark);padding:15px 34px;text-decoration:none;font-size:13.5px;font-weight:700;border:3px solid var(--dark);border-radius:50px;box-shadow:4px 4px 0 var(--dark);transition:transform .18s}
.btn-mustard:hover{transform:translate(-3px,-3px);box-shadow:7px 7px 0 var(--dark)}
.btn-outline{padding:13px 32px;border:3px solid var(--dark);background:transparent;color:var(--dark);font-weight:700;font-size:13.5px;border-radius:50px;cursor:pointer;font-family:'Karla',sans-serif;transition:all .2s;text-decoration:none;display:inline-block}
.btn-outline:hover{background:var(--dark);color:var(--cream)}
.btn-outline.white{border-color:#fff;color:#fff}
.btn-outline.white:hover{background:#fff;color:var(--dark)}

/* ── HERO ── */
.hero{position:relative;min-height:88vh;display:flex;align-items:center;background:var(--cream);overflow:hidden}
.hero-body{position:relative;z-index:2;display:flex;align-items:center;width:100%;max-width:1320px;margin:0 auto;padding:0 56px;gap:60px}
.hero-left{flex:1}
.hero-eyebrow{display:inline-block;background:var(--dark);color:var(--mustard);font-size:11.5px;font-weight:700;padding:8px 20px;border-radius:50px;margin-bottom:24px;letter-spacing:1px;text-transform:uppercase}
.hero h1{font-size:clamp(34px,4.8vw,58px);line-height:1.25;color:var(--rust-dark);margin-bottom:22px}
.hero h1 span{color:var(--olive)}
.hero-sub{font-size:15px;color:var(--muted);line-height:1.85;max-width:440px;margin-bottom:34px;font-weight:500}
.hero-ctas{display:flex;gap:16px;flex-wrap:wrap}
.hero-right{flex:1;position:relative;display:flex;justify-content:center}
.hero-right .stamp{background:#fff;padding:14px;border-radius:8px;box-shadow:0 20px 50px rgba(58,44,26,.25);transform:rotate(3deg)}
.hero-right .stamp img{width:100%;max-width:420px;height:420px;object-fit:cover;border:3px dashed var(--rust);border-radius:4px;display:block}
.hero-badge{position:absolute;top:-10px;left:-16px;background:var(--mustard);color:var(--dark);width:100px;height:100px;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:11px;font-weight:700;text-align:center;line-height:1.3;border:3px solid var(--dark);transform:rotate(-8deg)}

/* ── TRUST ── */
.trust{background:var(--dark);display:flex;justify-content:center;flex-wrap:wrap}
.trust-item{flex:1;min-width:180px;display:flex;align-items:center;justify-content:center;gap:10px;padding:22px 20px;color:var(--cream)}
.trust-item .ti{font-size:22px}
.trust-item p{font-size:12px;font-weight:700}

/* ── SECTION LABELS ── */
.sec-title{text-align:center;padding:70px 20px 10px;font-size:clamp(26px,3.2vw,40px);color:var(--rust-dark)}
.sec-title span{color:var(--olive)}
.sec-sub{text-align:center;font-size:14px;color:var(--muted);padding:0 20px 40px;font-weight:500}

/* ── CATEGORY CARDS ── */
.cats{display:grid;grid-template-columns:1fr 1fr;gap:24px;max-width:1280px;margin:0 auto 20px;padding:0 40px}
.cat{position:relative;overflow:hidden;border-radius:16px;cursor:pointer;border:4px solid var(--dark);box-shadow:6px 6px 0 var(--mustard)}
.cat img{width:100%;height:400px;object-fit:cover;display:block;transition:transform .6s;filter:sepia(.15) saturate(1.1)}
.cat:hover img{transform:scale(1.06)}
.cat-shade{position:absolute;inset:0;background:linear-gradient(to top,rgba(58,44,26,.75) 0%,transparent 55%)}
.cat-info{position:absolute;bottom:0;left:0;right:0;padding:32px}
.cat-badge{display:inline-block;background:var(--mustard);color:var(--dark);font-size:11px;font-weight:700;padding:6px 16px;border-radius:50px;margin-bottom:12px}
.cat-info h3{font-size:27px;color:#fff;margin-bottom:16px}

/* ── PRODUCT GRID ── */
.pgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;max-width:1280px;margin:0 auto 72px;padding:0 40px}
.pcard{background:var(--white);border-radius:16px;overflow:hidden;border:3px solid var(--dark);box-shadow:5px 5px 0 var(--dark);transition:transform .2s,box-shadow .2s;cursor:pointer}
.pcard:hover{transform:translate(-3px,-3px);box-shadow:8px 8px 0 var(--dark)}
.pcard-img{position:relative;height:200px;overflow:hidden;background:var(--cream);border-bottom:3px solid var(--dark);display:flex;align-items:center;justify-content:center}
.pcard-img img{width:100%;height:100%;object-fit:cover;transition:transform .5s;filter:sepia(.1)}
.pcard:hover .pcard-img img{transform:scale(1.08)}
.pcard-img .no-image{font-size:32px;opacity:.3}
.ptag{position:absolute;top:10px;left:10px;font-size:10px;font-weight:700;padding:5px 12px;border-radius:50px;color:#fff;border:2px solid var(--dark)}
.ptag.organic{background:var(--olive)}
.ptag.new{background:var(--rust)}
.ptag.super{background:#8a5a9e}
.ptag.oos{background:#999}
.ptag.best{background:var(--mustard-dark)}
.pcard-body{padding:18px 16px 20px}
.pcard h4{font-family:'Righteous',cursive;font-size:15px;margin-bottom:6px;color:var(--rust-dark)}
.pcard .psub{font-size:11.5px;color:var(--muted);margin-bottom:12px;font-weight:500}
.pcard .pprice{font-size:18px;font-weight:800;margin-bottom:14px;color:var(--olive)}
.pcard .pprice s{font-weight:400;color:#ccc;font-size:12px;margin-right:5px}
.btn-add{width:100%;padding:11px;background:var(--dark);color:var(--cream);border:none;cursor:pointer;font-family:'Karla',sans-serif;font-size:11.5px;font-weight:700;border-radius:50px;transition:background .2s}
.btn-add:hover{background:var(--rust)}
.btn-add.out{background:#ddd;color:#999;cursor:not-allowed}

/* ── BANNER ── */
.banner{position:relative;min-height:520px;overflow:hidden;display:flex;align-items:center;justify-content:center}
.banner-bg-img{position:absolute;inset:0;background:url('https://images.pexels.com/photos/1640774/pexels-photo-1640774.jpeg?auto=compress&cs=tinysrgb&w=1600') center/cover;filter:sepia(.25) saturate(1.1)}
.banner::before{content:'';position:absolute;inset:0;background:rgba(58,44,26,.68)}
.banner-body{position:relative;z-index:2;text-align:center;color:#fff;max-width:720px;padding:60px 24px}
.banner-body .leaf{font-size:44px;display:block;margin-bottom:14px}
.banner-body h2{font-size:clamp(26px,4vw,46px);margin-bottom:18px;color:var(--mustard)}
.banner-body p{font-size:14.5px;line-height:1.9;color:rgba(255,255,255,.88);margin-bottom:12px}

/* ── WHY STRIP ── */
.why-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;max-width:1280px;margin:0 auto;padding:80px 40px}
.why-item{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:36px 22px;text-align:center;background:var(--white);border-radius:16px;border:3px solid var(--dark);box-shadow:4px 4px 0 var(--mustard);transition:transform .2s}
.why-item:hover{transform:translate(-2px,-2px)}
.why-icon{font-size:34px;margin-bottom:14px}
.why-item h4{font-size:17px;color:var(--rust-dark);margin-bottom:6px}
.why-item p{font-size:12px;color:var(--muted);font-weight:600}

/* ── SPLIT ── */
.split{display:flex;min-height:520px}
.split-img{flex:1;overflow:hidden;position:relative}
.split-img img{width:100%;height:100%;object-fit:cover;display:block;filter:sepia(.12);transition:transform .6s}
.split:hover .split-img img{transform:scale(1.04)}
.split-text{flex:1;background:var(--white);display:flex;align-items:center;padding:60px 68px}
.split-quote{font-family:'Righteous',cursive;font-size:21px;color:var(--rust-dark);display:block;margin:14px 0 20px}
.split-text h2{font-size:clamp(24px,2.8vw,36px);margin-bottom:14px;color:var(--dark)}
.split-text p{font-size:14px;line-height:1.9;color:var(--muted);margin-bottom:12px;font-weight:500}
.split-rev{flex-direction:row-reverse}
.split-rev .split-text{background:var(--dark)}
.split-rev .split-text h2{color:var(--cream)}
.split-rev .split-text p{color:rgba(247,236,216,.65)}
.split-rev .split-quote{color:var(--mustard)}

/* ── VIDEO ── */
.vid-section{display:flex;min-height:500px}
.vid-left{flex:1;overflow:hidden}
.vid-left iframe{width:100%;height:100%;min-height:500px;display:block;border:none}
.vid-right{flex:1;background:var(--olive);display:flex;align-items:center;padding:60px 56px;color:#fff}
.vid-right h2{font-size:30px;margin-bottom:16px;color:#fff}
.vid-right p{font-size:14px;line-height:1.9;color:rgba(255,255,255,.85);margin-bottom:12px}

/* ── REVIEWS ── */
.reviews{padding:80px 28px}
.reviews-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;max-width:1120px;margin:0 auto}
.rcard{background:var(--white);padding:34px 28px;border-radius:16px;text-align:center;border:3px solid var(--dark);box-shadow:5px 5px 0 var(--mustard);transition:transform .2s}
.rcard:hover{transform:translate(-3px,-3px)}
.stars{color:var(--rust);font-size:19px;letter-spacing:3px;margin-bottom:14px}
.rcard blockquote{font-size:14px;line-height:1.85;color:#4a3a26;margin-bottom:16px;font-style:italic}
.rcard cite{font-family:'Righteous',cursive;font-size:13px;color:var(--olive)}

/* ── ARRIVALS ── */
.arrivals{display:grid;grid-template-columns:1fr 1fr;max-width:1280px;margin:0 auto 72px;gap:20px;padding:0 40px}
.acard{position:relative;overflow:hidden;border-radius:16px;cursor:pointer;border:4px solid var(--dark);box-shadow:6px 6px 0 var(--rust)}
.acard img{width:100%;height:440px;object-fit:cover;display:block;transition:transform .6s;filter:sepia(.1)}
.acard:hover img{transform:scale(1.06)}
.acard-overlay{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(transparent,rgba(58,44,26,.8));padding:52px 30px 30px;color:#fff}
.acard-overlay .atag{display:inline-block;background:var(--mustard);color:var(--dark);font-size:10.5px;font-weight:700;padding:6px 16px;border-radius:50px;margin-bottom:12px}
.acard-overlay h3{color:#fff;font-size:27px}

/* ── GALLERY ── */
.gallery-section{padding:20px 40px 0}
.gallery-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;max-width:1280px;margin:0 auto}
.gcard{overflow:hidden;border-radius:14px;cursor:pointer;position:relative;border:3px solid var(--dark)}
.gcard img{width:100%;height:220px;object-fit:cover;display:block;transition:transform .5s;filter:sepia(.1)}
.gcard:hover img{transform:scale(1.1)}

/* ── FEATURED ── */
.featured{background:var(--white);padding:88px 40px;border-top:4px solid var(--dark);border-bottom:4px solid var(--dark)}
.feat-wrap{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}
.feat-img-box{position:relative}
.feat-img-box img{width:100%;border-radius:16px;object-fit:cover;max-height:440px;border:4px solid var(--dark)}
.feat-badge{position:absolute;top:-18px;right:-18px;background:var(--rust);color:#fff;width:86px;height:86px;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:10.5px;font-weight:700;text-align:center;line-height:1.3;transform:rotate(10deg);border:3px solid var(--dark)}
.feat-info h2{font-size:32px;margin-bottom:10px;color:var(--rust-dark)}
.feat-price{font-size:28px;font-weight:800;color:var(--olive);margin:14px 0;font-family:'Righteous',cursive}
.feat-info>p{font-size:14px;line-height:1.85;color:var(--muted);margin-bottom:8px}
.feat-pills{display:flex;gap:10px;flex-wrap:wrap;margin:18px 0}
.pill{background:var(--cream);color:var(--dark);font-size:11.5px;font-weight:700;padding:7px 16px;border-radius:50px;border:2px solid var(--dark)}

/* ── BLOG ── */
.blog-section{padding:80px 28px}
.blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;max-width:1200px;margin:0 auto}
.bcard{border-radius:16px;overflow:hidden;border:3px solid var(--dark);box-shadow:5px 5px 0 var(--olive);cursor:pointer;transition:transform .2s;background:var(--white)}
.bcard:hover{transform:translate(-3px,-3px)}
.bcard img{width:100%;height:190px;object-fit:cover;display:block;filter:sepia(.1)}
.bcard-body{padding:20px}
.bcard-body .bdate{font-size:11px;color:var(--rust-dark);font-weight:700;margin-bottom:8px}
.bcard-body h4{font-family:'Righteous',cursive;font-size:16px;margin-bottom:8px;color:var(--dark)}
.bcard-body p{font-size:12.5px;color:var(--muted);line-height:1.7}

/* ── FOOTER ── */
footer{background:var(--dark);color:rgba(247,236,216,.7);padding:64px 44px 30px}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:44px;margin-bottom:48px}
.fbrand-name{font-family:'Righteous',cursive;font-size:24px;color:var(--mustard);margin-bottom:12px}
.fbrand p{font-size:13px;line-height:1.9;max-width:280px}
.fcol h5{color:var(--cream);font-size:12px;font-weight:700;margin-bottom:18px;text-transform:uppercase;letter-spacing:1px}
.fcol ul{list-style:none}
.fcol ul li{margin-bottom:10px}
.fcol ul li a{text-decoration:none;color:rgba(247,236,216,.65);font-size:13px}
.fcol ul li a:hover{color:var(--mustard)}
.footer-contact{font-size:13px;line-height:1.85;margin-top:14px}
.footer-contact b{color:var(--cream)}
.footer-bottom{border-top:1px dashed rgba(247,236,216,.25);padding-top:24px;display:flex;justify-content:space-between;align-items:center;font-size:12px;color:rgba(247,236,216,.4);flex-wrap:wrap;gap:12px}
.footer-policy-links{display:flex;gap:20px}
.footer-policy-links a{color:rgba(247,236,216,.55);text-decoration:none;font-size:12px}
.footer-policy-links a:hover{color:var(--mustard)}

.toast{position:fixed;bottom:28px;left:50%;transform:translateX(-50%) translateY(80px);background:var(--dark);color:var(--cream);padding:15px 30px;border-radius:50px;font-size:13px;font-weight:700;z-index:9999;opacity:0;transition:opacity .3s,transform .3s;pointer-events:none}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

@media(max-width:960px){
  nav{padding:0 18px}
  .mobile-menu-toggle{display:block}
  .nav-links{display:none}
  .mobile-nav-links.mobile-open{display:flex}
  .hero-body{flex-direction:column;padding:44px 24px;text-align:center}
  .hero-right{margin-top:40px}
  .cats,.pgrid,.reviews-grid,.arrivals,.blog-grid,.feat-wrap,.footer-grid{grid-template-columns:1fr 1fr}
  .gallery-grid{grid-template-columns:1fr 1fr}
  .split,.split-rev,.vid-section{flex-direction:column}
  .split-img,.vid-left{min-height:280px}
  .why-strip{grid-template-columns:1fr 1fr}
}
@media(max-width:600px){
  .cats,.pgrid,.reviews-grid,.arrivals,.blog-grid,.footer-grid,.gallery-grid,.why-strip{grid-template-columns:1fr}
  .split-text{padding:40px 26px}
  .featured,.blog-section,.reviews{padding:56px 18px}
  footer{padding:44px 20px 24px}
}
</style>
</head>
<body>

<div class="toast" id="toast">✌️ Added to cart, groovy!</div>

<div class="top-bar">
  Free delivery within 5km of JP Nagar (₹499+) · Free across Bengaluru (₹3000+)
</div>

<nav>
  <a class="brand" href="/">
    <div class="brand-mark"><img src="/logo.jpeg" alt="Marali Santhe"></div>
    <span class="brand-name">Marali Santhe</span>
  </a>
  <ul class="nav-links">
    <li><a href="#">Home</a></li>
    <li><a href="#catalog">Organic Foods</a></li>
    <li><a href="#catalog">Wellness</a></li>
    <li><a href="#">Combos</a></li>
    <li><a href="#">Blogs</a></li>
  </ul>
  <div class="nav-right">
    <a href="<%= track_order_path %>" class="track-order-link" aria-label="Track Order" title="Track Order" style="display:inline-flex;align-items:center;gap:5px;padding:7px 14px;border:1.5px solid currentColor;border-radius:20px;font-size:12px;font-weight:700;text-decoration:none;color:inherit;white-space:nowrap;">📦 Track</a>
    <a href="<%= storefront_cart_path %>" class="cart-link" aria-label="Cart">
      🛍️<% if cart_count > 0 %><span class="cart-badge"><%= cart_count %></span><% end %>
    </a>
    <a href="/customer/login" class="btn-outline" style="padding:10px 22px;font-size:13px">Login</a>
    <button class="mobile-menu-toggle" onclick="toggleMobileMenu()">☰</button>
  </div>
  <div class="mobile-nav-links" id="mobileNav">
    <a href="#">Home</a><a href="#catalog">Organic Foods</a><a href="#catalog">Wellness</a><a href="#">Combos</a><a href="#">Blogs</a><a href="<%= track_order_path %>">📦 Track Order</a><a href="<%= storefront_cart_path %>">Cart (<%= cart_count %>)</a><a href="/customer/login">Login</a>
  </div>
</nav>

<section class="hero">
  <div class="hero-body">
    <div class="hero-left">
      <span class="hero-eyebrow">☮ Groovy Since Day One</span>
      <h1>Far out, fresh &amp;<br><span>totally organic</span></h1>
      <p class="hero-sub">Marali Santhe brings back honest, wholesome eating — real produce, real farmers, real good vibes, delivered to your door.</p>
      <div class="hero-ctas">
        <a href="#catalog" class="btn">Shop the Vibe</a>
        <a href="#" class="btn-outline">Our Farmers</a>
      </div>
    </div>
    <div class="hero-right">
      <div class="hero-badge">Est.<br>Fresh<br>Daily</div>
      <div class="stamp"><img src="https://images.pexels.com/photos/1300972/pexels-photo-1300972.jpeg?auto=compress&cs=tinysrgb&w=1200" alt="Marali Santhe organic produce"></div>
    </div>
  </div>
</section>

<div class="trust">
  <div class="trust-item"><span class="ti">🌱</span><p>100% Organic</p></div>
  <div class="trust-item"><span class="ti">🚚</span><p>Free Delivery ₹499+</p></div>
  <div class="trust-item"><span class="ti">🔄</span><p>7-Day Returns</p></div>
  <div class="trust-item"><span class="ti">🏆</span><p>Award Winning</p></div>
  <div class="trust-item"><span class="ti">🇮🇳</span><p>Made in India</p></div>
</div>

<div class="cats">
  <% if @top_category %>
    <div class="cat"><img src="<%= @top_category.display_image_url %>" alt="<%= @top_category.name %>"><div class="cat-shade"></div><div class="cat-info"><div class="cat-badge">★ Best Seller</div><h3><%= @top_category.name %></h3><a href="#catalog" class="btn-mustard">Shop Now</a></div></div>
  <% end %>
  <% if @secondary_category %>
    <div class="cat"><img src="<%= @secondary_category.display_image_url %>" alt="<%= @secondary_category.name %>"><div class="cat-shade"></div><div class="cat-info"><div class="cat-badge">Also Popular</div><h3><%= @secondary_category.name %></h3><a href="#catalog" class="btn-mustard">Shop Now</a></div></div>
  <% end %>
</div>

<a id="catalog"></a>
<h2 class="sec-title">Shop Our <span>Collection</span></h2>
<p class="sec-sub">
  <% if @products_by_category.present? %>
    <%= pluralize(@total_products, 'item') %> across <%= pluralize(@products_by_category.size, 'category') %>
  <% else %>
    Our catalog is being restocked — please check back shortly
  <% end %>
</p>

<% @products_by_category.each do |category_name, products| %>
  <h3 style="text-align:center;font-size:22px;color:var(--rust-dark);margin:0 0 4px"><%= category_name %></h3>
  <p class="sec-sub" style="padding-top:0"><%= pluralize(products.size, 'item') %></p>
  <div class="pgrid">
    <% products.each do |product| %>
      <div class="pcard">
        <div class="pcard-img">
          <% if product.main_image_url %>
            <%= image_tag product.main_image_url, alt: product.name %>
          <% else %>
            <span class="no-image">🌿</span>
          <% end %>
          <% if !product.in_stock? %>
            <span class="ptag oos">Out of Stock</span>
          <% elsif @best_seller_ids.include?(product.id) %>
            <span class="ptag best">★ Best Seller</span>
          <% elsif @new_arrival_ids.include?(product.id) %>
            <span class="ptag super">🆕 New Arrival</span>
          <% elsif product.discounted? %>
            <span class="ptag new">Sale</span>
          <% end %>
        </div>
        <div class="pcard-body">
          <h4><%= product.name %></h4>
          <p class="psub"><%= [product.unit_type, product.sku].compact_blank.join(' · ') %></p>
          <div class="pprice">
            <% if product.discounted? %>
              <s>₹<%= product.price %></s> ₹<%= product.selling_price %>
            <% else %>
              ₹<%= product.selling_price %>
            <% end %>
          </div>
          <% if product.in_stock? %>
            <button class="btn-add" onclick="addToCart(<%= product.id %>, '<%= j product.name %>', this)">Add to Cart</button>
          <% else %>
            <button class="btn-add out" disabled>Out of Stock</button>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

