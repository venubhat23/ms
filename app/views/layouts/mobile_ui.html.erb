<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>Marali Santhe</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <%= csrf_meta_tags %>
  <style>
    * { -webkit-tap-highlight-color: transparent; }
    body {
      background: #f0f2f5;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      overscroll-behavior: none;
      min-height: 100vh;
    }
    .mobile-header {
      background: linear-gradient(135deg, #2e7d32 0%, #1b5e20 100%);
      color: white;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 2px 12px rgba(0,0,0,0.2);
    }
    .mobile-header .brand { font-size: 1.05rem; font-weight: 700; letter-spacing: 0.3px; }
    .mobile-header .sub-brand { font-size: 0.7rem; opacity: 0.8; }
    .mobile-content { padding-bottom: 70px; }
    /* Bottom navigation bar */
    .mobile-bottom-nav {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      height: 62px;
      background: white;
      border-top: 1px solid #e9ecef;
      display: flex;
      align-items: stretch;
      z-index: 200;
      box-shadow: 0 -2px 12px rgba(0,0,0,0.08);
    }
    .bn-item {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      color: #aaa;
      font-size: 0.58rem;
      font-weight: 600;
      letter-spacing: 0.2px;
      gap: 2px;
      transition: color 0.15s;
      -webkit-tap-highlight-color: transparent;
    }
    .bn-item i { font-size: 1.3rem; line-height: 1; }
    .bn-item.active, .bn-item:active { color: #2e7d32; }
    .bn-item.bn-new {
      color: white;
      background: linear-gradient(135deg, #2e7d32, #1b5e20);
      border-radius: 14px 14px 0 0;
      margin: 0 6px;
      padding: 0 10px;
    }
    .bn-item.bn-new i { font-size: 1.4rem; }
    /* Global loader overlay */
    #globalLoader {
      display: none;
      position: fixed; inset: 0;
      background: rgba(0,0,0,0.45);
      z-index: 9999;
      align-items: center;
      justify-content: center;
    }
    #globalLoader.active { display: flex; }
    .gl-box {
      background: white;
      border-radius: 18px;
      padding: 28px 36px;
      text-align: center;
      box-shadow: 0 8px 32px rgba(0,0,0,0.2);
      min-width: 160px;
    }
    .gl-ring {
      width: 44px; height: 44px;
      border: 4px solid #e8f5e9;
      border-top-color: #2e7d32;
      border-radius: 50%;
      animation: glSpin 0.7s linear infinite;
      margin: 0 auto 14px;
    }
    @keyframes glSpin { to { transform: rotate(360deg); } }
    .gl-text { font-weight: 700; font-size: 0.95rem; color: #1a1a1a; }
    .gl-sub  { font-size: 0.78rem; color: #888; margin-top: 4px; }
    .flash-msg {
      position: fixed;
      top: 65px;
      left: 10px;
      right: 10px;
      z-index: 999;
      border-radius: 10px;
      font-size: 0.9rem;
      animation: fadeInDown 0.3s ease;
    }
    @keyframes fadeInDown {
      from { opacity: 0; transform: translateY(-10px); }
      to   { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body>
  <% if session[:mobile_ui_auth] %>
    <div class="mobile-header px-3 py-2">
      <div class="d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
          <div class="bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center"
               style="width:36px;height:36px;">
            <i class="bi bi-shop text-white fs-5"></i>
          </div>
          <div>
            <div class="brand">Marali Santhe</div>
            <div class="sub-brand">Admin Mobile</div>
          </div>
        </div>
        <div class="d-flex align-items-center gap-2">
          <%= link_to admin_mobile_ui_logout_path,
              class: "btn btn-sm btn-outline-light border-white border-opacity-50 text-white py-1 px-2",
              data: { no_loader: '' } do %>
            <i class="bi bi-box-arrow-right"></i>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <% if flash[:error].present? %>
    <div class="flash-msg alert alert-danger alert-dismissible mb-0" role="alert">
      <i class="bi bi-exclamation-circle me-2"></i><%= flash[:error] %>
      <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
    </div>
  <% end %>
  <% if flash[:notice].present? %>
    <div class="flash-msg alert alert-success alert-dismissible mb-0" role="alert">
      <i class="bi bi-check-circle me-2"></i><%= flash[:notice] %>
      <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
    </div>
  <% end %>

  <div class="mobile-content">
    <%= yield %>
  </div>

  <% if session[:mobile_ui_auth] %>
    <%
      _tab    = params[:tab].to_s
      _action = action_name.to_s
      _on_dashboard  = _action == 'dashboard'
      _on_today      = _action == 'index' && _tab == 'today'
      _on_bookings   = _action == 'index' && _tab != 'today'
      _on_price_list = _action == 'price_list'
    %>
    <nav class="mobile-bottom-nav">
      <%= link_to admin_mobile_ui_dashboard_path,
            class: "bn-item #{_on_dashboard ? 'active' : ''}" do %>
        <i class="bi bi-speedometer2"></i>
        <span>Dashboard</span>
      <% end %>
      <%= link_to admin_mobile_ui_bookings_path,
            class: "bn-item #{_on_bookings ? 'active' : ''}" do %>
        <i class="bi bi-list-ul"></i>
        <span>Bookings</span>
      <% end %>
      <%= link_to admin_mobile_ui_bookings_path(tab: 'today'),
            class: "bn-item #{_on_today ? 'active' : ''}" do %>
        <i class="bi bi-calendar-day"></i>
        <span>Today</span>
      <% end %>
      <%= link_to admin_mobile_ui_price_list_path,
            class: "bn-item #{_on_price_list ? 'active' : ''}" do %>
        <i class="bi bi-tags"></i>
        <span>Prices</span>
      <% end %>
      <%= link_to admin_mobile_ui_new_booking_path, class: "bn-item bn-new" do %>
        <i class="bi bi-plus-circle-fill"></i>
        <span>New</span>
      <% end %>
    </nav>
  <% end %>

  <!-- Global loader overlay -->
  <div id="globalLoader">
    <div class="gl-box">
      <div class="gl-ring"></div>
      <div class="gl-text" id="glText">Please wait…</div>
      <div class="gl-sub"  id="glSub"></div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    setTimeout(() => {
      document.querySelectorAll('.flash-msg').forEach(el => {
        el.style.opacity = '0';
        el.style.transition = 'opacity 0.4s';
        setTimeout(() => el.remove(), 400);
      });
    }, 3000);

    function showLoader(text, sub) {
      document.getElementById('glText').textContent = text || 'Please wait…';
      document.getElementById('glSub').textContent  = sub  || '';
      document.getElementById('globalLoader').classList.add('active');
    }
    function hideLoader() {
      document.getElementById('globalLoader').classList.remove('active');
    }

    window.addEventListener('pageshow', function(e) {
      if (e.persisted) hideLoader();
    });

    document.addEventListener('submit', function(e) {
      const form = e.target;
      if (form.dataset.noLoader !== undefined) return;
      if (form.method === 'get' && form.dataset.loaderOnGet === undefined) return;
      showLoader();
    }, true);

    document.addEventListener('click', function(e) {
      const a = e.target.closest('a[href]');
      if (!a) return;
      if (a.dataset.noLoader !== undefined) return;
      if (a.target === '_blank') return;
      const href = a.getAttribute('href') || '';
      if (href === '#' || href.startsWith('#')) return;
      if (href.includes('wa.me') || href.includes('whatsapp')) return;
      if (a.hasAttribute('data-bs-dismiss') || a.hasAttribute('data-bs-toggle')) return;
      showLoader();
    }, true);
  </script>
</body>
</html>
