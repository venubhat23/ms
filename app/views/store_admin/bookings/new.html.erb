<%- content_for :title, "New Booking - #{@current_store.name}" %>

<style>
.sa-hover-lift { transition: transform 0.15s, box-shadow 0.15s; }
.sa-hover-lift:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,0.12) !important; }
.sa-cart-item { background:#f9fafb; border-radius:10px; padding:0.75rem 1rem; margin-bottom:0.5rem; position:relative; }
.sa-cart-remove { position:absolute; top:0.5rem; right:0.5rem; background:none; border:none; color:#9ca3af; cursor:pointer; font-size:1.1rem; }
.sa-cart-remove:hover { color:#dc3545; }
</style>

<script>const SA_PRODUCTS = <%= raw json_escape(@products_json) %>;</script>

<%# Header %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h5 class="mb-1 fw-bold">New Booking</h5>
    <small class="text-muted">Create a booking for <%= @current_store.name %></small>
  </div>
  <%= link_to store_admin_bookings_path, class: "btn btn-outline-secondary btn-sm" do %>
    <i class="bi bi-arrow-left me-1"></i>Back
  <% end %>
</div>

<%# Toggle Buttons %>
<div class="mb-3 d-flex gap-3 align-items-center">
  <button type="button" class="btn btn-outline-primary px-4 py-2 rounded-3 fw-medium" id="saProductsBtn" onclick="saShowProducts()" style="display:none!important;">
    <i class="bi bi-grid me-2"></i>Products
  </button>
  <button type="button" class="btn btn-outline-primary px-4 py-2 rounded-3 fw-medium position-relative" id="saCheckoutBtn" onclick="saShowCheckout()">
    <i class="bi bi-cart-check me-2"></i>Checkout
    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" id="saCartBadge">0</span>
  </button>
</div>

<%# Search & Filters %>
<div class="card border-0 shadow-sm mb-3" id="saSearchSection">
  <div class="card-body py-2">
    <div class="row g-2 align-items-center">
      <div class="col-md-5">
        <input type="text" class="form-control form-control-sm" id="saProductSearch"
               placeholder="Search products by name, SKU..." oninput="saFilterProducts()">
      </div>
      <div class="col-md-3">
        <select class="form-select form-select-sm" id="saCategoryFilter" onchange="saFilterProducts()">
          <option value="">All Categories</option>
        </select>
      </div>
      <div class="col-md-4">
        <div class="d-flex gap-2 align-items-center">
          <small class="text-muted">Filter:</small>
          <div class="btn-group btn-group-sm">
            <button type="button" class="btn btn-outline-primary btn-sm active" id="saAllBtn" onclick="saStockFilter('all')">All</button>
            <button type="button" class="btn btn-outline-primary btn-sm" id="saInStockBtn" onclick="saStockFilter('instock')">In Stock</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%# Products Grid %>
<div id="saProductsView">
  <div class="card border-0 shadow-sm">
    <div class="card-body pt-3">
      <div class="row g-3" id="saProductGrid"></div>
      <div id="saNoResults" class="text-center py-5 d-none">
        <i class="bi bi-search fs-1 text-muted mb-2"></i>
        <p class="text-muted">No products match your search.</p>
      </div>
    </div>
  </div>
</div>

<%# Checkout View %>
<div id="saCheckoutView" style="display:none;">
  <%= form_with model: [:store_admin, @booking], local: true, id: "saBookingForm" do |f| %>
    <% if @booking.errors.any? %>
      <div class="alert alert-danger mb-3">
        <ul class="mb-0"><% @booking.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
      </div>
    <% end %>

    <div class="row g-4">
      <div class="col-lg-7">
        <div class="card border-0 shadow-sm mb-3" style="border-radius:14px;">
          <div class="card-header bg-white py-3 px-4">
            <h6 class="mb-0 fw-semibold"><i class="bi bi-cart3 me-2 text-muted"></i>Cart Items</h6>
          </div>
          <div class="card-body px-4 py-3">
            <div id="saCartItems"></div>
            <div id="saCartEmpty" class="text-center py-4 text-muted small">
              <i class="bi bi-cart" style="font-size:2rem; opacity:0.3;"></i>
              <p class="mt-2 mb-0">No items yet — go back to add products</p>
            </div>
            <div id="saBookingItemsFields"></div>
          </div>
        </div>

        <div class="card border-0 shadow-sm" style="border-radius:14px;">
          <div class="card-body px-4 py-3">
            <div class="d-flex justify-content-between mb-2">
              <span class="text-muted">Subtotal</span>
              <span class="fw-semibold" id="saSubtotal">₹0</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span class="text-muted">Discount</span>
              <span class="text-danger" id="saDiscountDisplay">- ₹0</span>
            </div>
            <hr class="my-2">
            <div class="d-flex justify-content-between">
              <span class="fw-bold">Total</span>
              <span class="fw-bold fs-5" style="color:#1C7C54;" id="saTotal">₹0</span>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-5">
        <div class="card border-0 shadow-sm" style="border-radius:14px;">
          <div class="card-header bg-white py-3 px-4">
            <h6 class="mb-0 fw-semibold"><i class="bi bi-person me-2 text-muted"></i>Order Details</h6>
          </div>
          <div class="card-body px-4 py-3">
            <div class="mb-3">
              <label class="form-label fw-semibold small">Customer</label>
              <%= f.collection_select :customer_id, (@customers || []), :id, :full_name,
                  { include_blank: "Walk-in Customer" }, { class: "form-select form-select-sm" } %>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold small">Payment Method</label>
              <%= f.select :payment_method,
                  options_for_select([['Cash', 'cash'], ['UPI', 'upi'], ['Card', 'card']], 'cash'),
                  {}, { class: "form-select form-select-sm" } %>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold small">Payment Status</label>
              <%= f.select :payment_status,
                  options_for_select([['Paid', 'paid'], ['Unpaid', 'unpaid']], 'paid'),
                  {}, { class: "form-select form-select-sm" } %>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold small">Discount (₹)</label>
              <div class="input-group input-group-sm">
                <span class="input-group-text">₹</span>
                <%= f.number_field :discount_amount, value: 0, class: "form-control", step: 0.01, min: 0,
                    id: "saDiscountInput", oninput: "saUpdateTotal()" %>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold small">Notes</label>
              <%= f.text_area :notes, class: "form-control form-control-sm", rows: 2, placeholder: "Optional notes..." %>
            </div>
            <div class="d-grid gap-2 mt-4">
              <button type="submit" class="btn fw-semibold" id="saSubmitBtn"
                  style="background:linear-gradient(135deg,#1C7C54,#10b981);color:white;border-radius:10px;">
                <i class="bi bi-check-lg me-1"></i>Create Booking
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<script>
const SA_MAP = Object.fromEntries(SA_PRODUCTS.map(p => [p.id, p]));
let saCart = [];
let saItemIdx = 0;
let saStockMode = 'all';

function esc(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

function saRenderCard(p) {
  const stock = p.stock, si = Math.floor(stock), LOW = 5;
  const img = p.image_url
    ? `<img src="${esc(p.image_url)}" class="card-img-top" loading="lazy" style="height:180px;object-fit:cover;" alt="${esc(p.name)}">`
    : `<div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height:180px;"><i class="bi bi-box-seam fs-1 text-muted"></i></div>`;
  const badge = stock <= 0
    ? `<span class="position-absolute top-0 end-0 badge bg-danger m-2"><i class="bi bi-x-circle me-1"></i>Out of Stock</span>`
    : stock <= LOW
    ? `<span class="position-absolute top-0 end-0 badge bg-warning text-dark m-2"><i class="bi bi-exclamation-triangle me-1"></i>Low Stock (${si} left)</span>`
    : `<span class="position-absolute top-0 end-0 badge bg-success m-2"><i class="bi bi-check-circle me-1"></i>${si} in stock</span>`;

  let priceHtml;
  if (p.has_variants && p.variants.length) {
    const opts = p.variants.map(v => `<option value="${v.id}" data-price="${v.price}" data-stock="${v.stock}">${esc(v.label)} — ₹${v.price}</option>`).join('');
    priceHtml = `<select class="form-select form-select-sm mb-1" id="sa-variant-${p.id}" onchange="saVariantChange(this,${p.id})">${opts}</select>
                 <span class="fw-bold text-primary" id="sa-price-${p.id}">₹${p.price}</span>`;
  } else {
    const gstNote = p.gst_rate > 0
      ? `<small class="text-muted d-block" style="font-size:0.72rem;">Base: ₹${p.base_price} + GST: ₹${Math.round(p.price-p.base_price)} (${Math.round(p.gst_rate)}%) = ₹${p.price}</small>`
      : '';
    priceHtml = `<span class="fw-bold text-primary">₹${p.price}</span>${gstNote}`;
  }

  let actionHtml;
  if (stock > 0) {
    const lowNote = stock <= LOW ? `<small class="text-warning d-block mt-1"><i class="bi bi-exclamation-triangle-fill"></i> Low Stock! Only ${si} left</small>` : '';
    actionHtml = `<div class="mb-2">
      <label class="form-label fw-bold small mb-1">Quantity <span class="badge bg-info-subtle text-info ms-1" id="sa-maxstock-${p.id}">Max: ${si}</span></label>
      <div class="input-group input-group-sm">
        <button class="btn btn-outline-primary" type="button" onclick="saDecQty(${p.id})" style="width:40px;border-radius:6px 0 0 6px;"><i class="bi bi-dash fw-bold"></i></button>
        <input type="number" id="sa-qty-${p.id}" value="1" min="0.01" step="0.01" max="${stock}" class="form-control text-center fw-bold" onchange="saValidateQty(${p.id},${stock})">
        <button class="btn btn-outline-primary" type="button" onclick="saIncQty(${p.id},${stock})" style="width:40px;border-radius:0 6px 6px 0;"><i class="bi bi-plus fw-bold"></i></button>
      </div>${lowNote}
    </div>
    <button class="btn btn-primary w-100" id="sa-addbtn-${p.id}" onclick="saAddToCart(${p.id})">
      <i class="bi bi-cart-plus me-2"></i>Add to Cart
    </button>`;
  } else {
    actionHtml = `<button class="btn btn-danger w-100" disabled><i class="bi bi-x-circle me-2"></i>SOLD OUT</button>
                  <small class="text-muted d-block text-center mt-1">Not in store stock</small>`;
  }

  return `<div class="col-md-4 col-lg-3 sa-product-item"
               data-product-id="${p.id}" data-category="${esc(p.category_id)}"
               data-stock="${stock}" data-name="${esc(p.name.toLowerCase())}" data-sku="${esc(p.sku.toLowerCase())}">
    <div class="card h-100 border-0 shadow-sm sa-hover-lift">
      <div class="position-relative">${img}${badge}</div>
      <div class="card-body d-flex flex-column p-3">
        <div class="d-flex justify-content-between align-items-start mb-1">
          <small class="text-muted">${esc(p.category_name)}</small>
          <small class="text-muted">SKU: ${esc(p.sku)}</small>
        </div>
        <h6 class="card-title fw-bold mb-2" style="min-height:40px;font-size:0.9rem;">${esc(p.name)}</h6>
        <div class="mb-3">${priceHtml}</div>
        <div class="mt-auto" id="sa-action-${p.id}">${actionHtml}</div>
      </div>
    </div>
  </div>`;
}

// Init: populate categories + render grid
(function(){
  const cats = {};
  SA_PRODUCTS.forEach(p => { if (p.category_id) cats[p.category_id] = p.category_name; });
  const sel = document.getElementById('saCategoryFilter');
  Object.entries(cats).sort((a,b) => a[1].localeCompare(b[1])).forEach(([id,name]) => {
    const o = document.createElement('option'); o.value = id; o.textContent = name; sel.appendChild(o);
  });
  const grid = document.getElementById('saProductGrid');
  if (SA_PRODUCTS.length === 0) {
    grid.innerHTML = '<div class="col-12 text-center py-5"><i class="bi bi-box-seam fs-1 text-muted mb-3"></i><h5 class="text-muted">No Products in This Store</h5></div>';
  } else {
    grid.innerHTML = SA_PRODUCTS.map(saRenderCard).join('');
  }
})();

function saShowProducts() {
  document.getElementById('saProductsView').style.display = '';
  document.getElementById('saCheckoutView').style.display = 'none';
  document.getElementById('saSearchSection').style.display = '';
  document.getElementById('saProductsBtn').classList.add('d-none');
  document.getElementById('saCheckoutBtn').classList.replace('btn-primary','btn-outline-primary');
}
function saShowCheckout() {
  document.getElementById('saProductsView').style.display = 'none';
  document.getElementById('saCheckoutView').style.display = '';
  document.getElementById('saSearchSection').style.display = 'none';
  document.getElementById('saProductsBtn').classList.remove('d-none');
  document.getElementById('saCheckoutBtn').classList.replace('btn-outline-primary','btn-primary');
  saRenderCart();
}

function saVariantChange(select, productId) {
  const opt = select.options[select.selectedIndex];
  const price = parseFloat(opt.dataset.price) || 0;
  const priceEl = document.getElementById('sa-price-' + productId);
  if (priceEl) priceEl.textContent = '₹' + Math.round(price);
}

function saIncQty(id, max) { const inp=document.getElementById('sa-qty-'+id); inp.value=Math.min(parseFloat(inp.value)||0,max-1)+1; }
function saDecQty(id) { const inp=document.getElementById('sa-qty-'+id); const v=parseFloat(inp.value)||1; if(v>0.01)inp.value=Math.max(0.01,v-1); }
function saValidateQty(id, max) { const inp=document.getElementById('sa-qty-'+id); const v=parseFloat(inp.value)||1; if(v>max)inp.value=max; if(v<0.01)inp.value=0.01; }

function saAddToCart(productId) {
  const p = SA_MAP[productId];
  if (!p) return;
  let name=p.name, price=p.price, variantId=null;
  if (p.has_variants) {
    const sel=document.getElementById('sa-variant-'+productId);
    if (sel) {
      const opt=sel.options[sel.selectedIndex];
      name=p.name+' ('+opt.text.split('—')[0].trim()+')';
      price=parseFloat(opt.dataset.price)||p.price;
      variantId=sel.value;
    }
  }
  const qty=parseFloat(document.getElementById('sa-qty-'+productId).value)||1;
  const existing=saCart.find(i=>i.productId===productId&&i.variantId===variantId);
  if (existing) { existing.quantity=Math.min(existing.quantity+qty,p.stock); }
  else { saCart.push({index:saItemIdx++,productId,name,price:Math.round(price),basePrice:p.base_price,gstRate:p.gst_rate,variantId,quantity:qty,stock:p.stock}); }
  document.getElementById('sa-qty-'+productId).value=1;
  saUpdateBadge(); saRenderHiddenFields(); saUpdateTotal();
  const btn=document.getElementById('sa-addbtn-'+productId);
  if (btn) {
    const orig=btn.innerHTML;
    btn.innerHTML='<i class="bi bi-check-circle-fill me-2"></i>Added!';
    btn.classList.replace('btn-primary','btn-success');
    setTimeout(()=>{btn.innerHTML=orig;btn.classList.replace('btn-success','btn-primary');},1200);
  }
}

function saRemoveItem(idx) { saCart=saCart.filter(i=>i.index!==idx); saRenderCart(); saUpdateBadge(); saUpdateTotal(); saRenderHiddenFields(); }
function saUpdateItemQty(idx, val) { const item=saCart.find(i=>i.index===idx); if(item)item.quantity=parseFloat(val)||1; saUpdateTotal(); saRenderHiddenFields(); }

function saRenderCart() {
  const container=document.getElementById('saCartItems');
  const empty=document.getElementById('saCartEmpty');
  if (!saCart.length) { container.innerHTML=''; empty.style.display='block'; saUpdateTotal(); return; }
  empty.style.display='none';
  container.innerHTML=saCart.map(item=>`
    <div class="sa-cart-item">
      <button class="sa-cart-remove" type="button" onclick="saRemoveItem(${item.index})"><i class="bi bi-x"></i></button>
      <div class="d-flex align-items-center gap-3">
        <div class="flex-grow-1">
          <div class="fw-semibold small">${esc(item.name)}</div>
          <div class="text-muted" style="font-size:0.75rem;">₹${item.price} each</div>
        </div>
        <div style="width:90px;">
          <input type="number" value="${item.quantity}" min="0.01" step="0.01" max="${item.stock}"
                 class="form-control form-control-sm text-center" onchange="saUpdateItemQty(${item.index},this.value)">
        </div>
        <div style="width:75px;text-align:right;" class="fw-semibold">₹${Math.round(item.price*item.quantity)}</div>
      </div>
    </div>`).join('');
}

function saRenderHiddenFields() {
  document.getElementById('saBookingItemsFields').innerHTML=saCart.map((item,i)=>
    `<input type="hidden" name="booking[booking_items_attributes][${i}][product_id]" value="${item.productId}">` +
    `<input type="hidden" name="booking[booking_items_attributes][${i}][quantity]" value="${item.quantity}">` +
    `<input type="hidden" name="booking[booking_items_attributes][${i}][price]" value="${item.price}">` +
    (item.variantId?`<input type="hidden" name="booking[booking_items_attributes][${i}][product_variant_id]" value="${item.variantId}">`:'')
  ).join('');
}

function saUpdateTotal() {
  const sub=saCart.reduce((s,i)=>s+i.price*i.quantity,0);
  const disc=parseFloat(document.getElementById('saDiscountInput')?.value||0);
  document.getElementById('saSubtotal').textContent='₹'+Math.round(sub);
  document.getElementById('saDiscountDisplay').textContent='- ₹'+Math.round(disc);
  document.getElementById('saTotal').textContent='₹'+Math.round(Math.max(0,sub-disc));
}

function saUpdateBadge() {
  const badge=document.getElementById('saCartBadge');
  const count=saCart.reduce((s,i)=>s+i.quantity,0);
  badge.textContent=Math.round(count);
  badge.classList.toggle('d-none',count===0);
}

function saFilterProducts() {
  const q=document.getElementById('saProductSearch').value.toLowerCase();
  const cat=document.getElementById('saCategoryFilter').value;
  let vis=0;
  document.querySelectorAll('.sa-product-item').forEach(item=>{
    const stock=parseFloat(item.dataset.stock)||0;
    const show=(!q||item.dataset.name.includes(q)||item.dataset.sku.includes(q))
            &&(!cat||item.dataset.category===cat)
            &&(saStockMode==='all'||(saStockMode==='instock'&&stock>0));
    item.style.display=show?'':'none';
    if(show)vis++;
  });
  document.getElementById('saNoResults').classList.toggle('d-none',vis>0);
}

function saStockFilter(mode) {
  saStockMode=mode;
  document.getElementById('saAllBtn').classList.toggle('active',mode==='all');
  document.getElementById('saInStockBtn').classList.toggle('active',mode==='instock');
  saFilterProducts();
}

document.getElementById('saBookingForm')?.addEventListener('submit',function(e){
  if(!saCart.length){e.preventDefault();alert('Please add at least one product to the booking.');}
});
</script>
