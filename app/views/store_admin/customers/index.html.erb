<%- content_for :title, "Customers — #{@current_store.name}" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h5 class="fw-bold mb-1"><i class="bi bi-people me-2" style="color:#1C7C54;"></i>Customers</h5>
    <small class="text-muted"><%= @total_count %> customer<%= @total_count == 1 ? '' : 's' %> total</small>
  </div>
  <%= link_to new_store_admin_customer_path, class: "btn btn-sm fw-semibold", style: "background:linear-gradient(135deg,#1C7C54,#10b981);color:white;border-radius:8px;" do %>
    <i class="bi bi-person-plus me-1"></i>New Customer
  <% end %>
</div>

<%# Search %>
<div class="card border-0 shadow-sm mb-3">
  <div class="card-body py-2">
    <%= form_with url: store_admin_customers_path, method: :get, local: true do |f| %>
      <div class="input-group input-group-sm" style="max-width:420px;">
        <%= f.text_field :search, value: params[:search], class: "form-control", placeholder: "Search by name, mobile or email…" %>
        <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-search"></i></button>
        <% if params[:search].present? %>
          <%= link_to store_admin_customers_path, class: "btn btn-outline-danger" do %>
            <i class="bi bi-x"></i>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<%# Table %>
<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <% if @customers.any? %>
      <div class="table-responsive">
        <table class="table table-hover mb-0" style="font-size:0.88rem;">
          <thead style="background:#f8fafc;">
            <tr>
              <th class="px-4 py-3 fw-semibold text-muted border-0">#</th>
              <th class="px-3 py-3 fw-semibold text-muted border-0">Name</th>
              <th class="px-3 py-3 fw-semibold text-muted border-0">Mobile</th>
              <th class="px-3 py-3 fw-semibold text-muted border-0">Email</th>
              <th class="px-3 py-3 fw-semibold text-muted border-0">Joined</th>
              <th class="px-3 py-3 fw-semibold text-muted border-0"></th>
            </tr>
          </thead>
          <tbody>
            <% @customers.each_with_index do |c, i| %>
              <tr>
                <td class="px-4 py-3 text-muted"><%= i + 1 %></td>
                <td class="px-3 py-3">
                  <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white"
                         style="width:34px;height:34px;font-size:0.8rem;background:linear-gradient(135deg,#1C7C54,#10b981);flex-shrink:0;">
                      <%= c.first_name[0].upcase %><%= c.last_name&.first&.upcase %>
                    </div>
                    <div>
                      <div class="fw-semibold"><%= c.full_name %></div>
                      <% if c.company_name.present? %>
                        <small class="text-muted"><%= c.company_name %></small>
                      <% end %>
                    </div>
                  </div>
                </td>
                <td class="px-3 py-3">
                  <a href="tel:<%= c.mobile %>" class="text-decoration-none text-dark"><%= c.mobile %></a>
                </td>
                <td class="px-3 py-3 text-muted"><%= c.email.presence || '—' %></td>
                <td class="px-3 py-3 text-muted"><%= c.created_at.strftime('%d %b %Y') %></td>
                <td class="px-3 py-3 text-end">
                  <%= link_to store_admin_customer_path(c), class: "btn btn-sm btn-outline-secondary" do %>
                    <i class="bi bi-eye me-1"></i>View
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @customers.respond_to?(:total_pages) && @customers.total_pages > 1 %>
        <div class="px-4 py-3 border-top">
          <%== paginate @customers %>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-5">
        <i class="bi bi-people fs-1 text-muted mb-3 d-block"></i>
        <% if params[:search].present? %>
          <p class="text-muted">No customers found for "<strong><%= params[:search] %></strong>"</p>
          <%= link_to 'Clear search', store_admin_customers_path, class: 'btn btn-sm btn-outline-secondary' %>
        <% else %>
          <h6 class="text-muted">No customers yet</h6>
          <%= link_to new_store_admin_customer_path, class: "btn btn-sm fw-semibold mt-2", style: "background:linear-gradient(135deg,#1C7C54,#10b981);color:white;border-radius:8px;" do %>
            <i class="bi bi-person-plus me-1"></i>Add First Customer
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
