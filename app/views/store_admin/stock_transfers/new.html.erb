<style>
.st-card { cursor:pointer; border:2px solid transparent; transition:all 0.18s; border-radius:10px; }
.st-card:hover { border-color:#1C7C54; box-shadow:0 4px 16px rgba(28,124,84,0.12); transform:translateY(-2px); }
.st-card.selected { border-color:#1C7C54; background:#f0fdf4; }
.st-cart-row { background:#f8fafc; border-radius:8px; padding:0.6rem 0.8rem; margin-bottom:0.4rem; }
.st-spinner { display:inline-block; width:1rem; height:1rem; border:2px solid rgba(255,255,255,0.5); border-top-color:#fff; border-radius:50%; animation:st-spin 0.7s linear infinite; vertical-align:-2px; margin-right:0.5rem; }
@keyframes st-spin { to { transform:rotate(360deg); } }
#stSubmitBtn:disabled { opacity:0.85; cursor:not-allowed; }
</style>

<script>const ST_PRODUCTS = <%= raw json_escape(@products_json) %>;</script>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h5 class="fw-bold mb-1"><i class="bi bi-arrow-left-right me-2" style="color:#1C7C54;"></i>Request Stock Transfer</h5>
    <small class="text-muted">Select products and submit a transfer request for <%= @current_store.name %></small>
  </div>
  <%= link_to store_admin_stock_transfers_path, class: "btn btn-outline-secondary btn-sm" do %>
    <i class="bi bi-arrow-left me-1"></i>Back
  <% end %>
</div>

<%# Search & Filters %>
<div class="card border-0 shadow-sm mb-3">
  <div class="card-body py-2">
    <div class="row g-2 align-items-center">
      <div class="col-md-5">
        <input type="text" class="form-control form-control-sm" placeholder="Search products by name or SKU..." id="stSearch" oninput="stFilter()">
      </div>
      <div class="col-md-3">
        <select class="form-select form-select-sm" id="stCatFilter" onchange="stFilter()">
          <option value="">All Categories</option>
        </select>
      </div>
      <div class="col-auto d-flex gap-2 align-items-center">
        <small class="text-muted">Filter:</small>
        <div class="btn-group btn-group-sm">
          <button type="button" class="btn btn-outline-primary active" id="stAllBtn" onclick="stStockFilter('all')">All</button>
          <button type="button" class="btn btn-outline-primary" id="stInStockBtn" onclick="stStockFilter('instock')">In Stock</button>
        </div>
      </div>
    </div>
    <div class="d-flex justify-content-end gap-2 mt-2 pt-2 border-top">
      <button type="button" class="btn btn-sm fw-semibold" style="background:linear-gradient(135deg,#1C7C54,#10b981);color:#fff;border:none;border-radius:6px;" onclick="stSelectAllVisible()">
        <i class="bi bi-check2-square me-1"></i>Select All (incl. variants)
      </button>
      <button type="button" class="btn btn-sm fw-semibold" style="background:#fff;color:#dc3545;border:1px solid #dc3545;border-radius:6px;" onclick="stDeselectAllVisible()">
        <i class="bi bi-square me-1"></i>Deselect All
      </button>
    </div>
  </div>
</div>

<%# Product Grid %>
<div class="card border-0 shadow-sm" style="margin-bottom:220px;">
  <div class="card-body pt-3">
    <div class="row g-3" id="stGrid"></div>
    <div id="stNoResults" class="text-center py-5 d-none">
      <i class="bi bi-search fs-1 text-muted mb-2"></i>
      <p class="text-muted">No products match your search.</p>
    </div>
  </div>
</div>

<%# Sticky Cart Panel %>
<div id="stPanel" class="d-none position-fixed bottom-0 start-0 w-100" style="z-index:1040;box-shadow:0 -4px 20px rgba(0,0,0,0.15);max-height:50vh;overflow-y:auto;">
  <div class="bg-white border-top">
    <div class="container-fluid px-4 py-3">
      <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div class="fw-bold">
          <i class="bi bi-cart3 me-2" style="color:#1C7C54;"></i>
          Transfer Request — <span id="stItemCount">0</span> product(s) selected
        </div>
        <div class="d-flex align-items-center gap-2">
          <div class="input-group input-group-sm" style="width:190px;">
            <span class="input-group-text">Set qty</span>
            <input type="number" class="form-control" id="stBulkQty" min="1" step="1" placeholder="e.g. 10">
            <button type="button" class="btn btn-outline-primary" onclick="stApplyBulkQty()">Apply to All</button>
          </div>
          <button type="button" class="btn btn-sm btn-outline-secondary" onclick="stClearAll()">
            <i class="bi bi-x me-1"></i>Clear All
          </button>
        </div>
      </div>

      <%= form_tag store_admin_stock_transfers_path, method: :post, id: "stForm" do %>
        <div id="stCartRows" class="mb-3"></div>
        <div id="stHiddenFields"></div>

        <div class="row g-3 align-items-end pt-2 border-top">
          <div class="col-md-3">
            <label class="form-label fw-semibold small mb-1">Transfer From</label>
            <select name="from_store_id" class="form-select form-select-sm">
              <option value="">Central Inventory (Main Stock)</option>
              <% @stores.each do |s| %>
                <option value="<%= s.id %>"><%= s.name %></option>
              <% end %>
            </select>
          </div>
          <div class="col-md-5">
            <label class="form-label fw-semibold small mb-1">Notes (optional)</label>
            <input type="text" name="notes" class="form-control form-control-sm" placeholder="Reason for this transfer request...">
          </div>
          <div class="col-md-4">
            <button type="submit" id="stSubmitBtn" class="btn w-100 fw-semibold" style="background:linear-gradient(135deg,#1C7C54,#10b981);color:white;border-radius:8px;transition:opacity 0.15s;">
              <span id="stSubmitBtnContent"><i class="bi bi-send me-1"></i>Submit Transfer Request (<span id="stSubmitCount">0</span>)</span>
            </button>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
const ST_MAP = Object.fromEntries(ST_PRODUCTS.map(p => [p.id, p]));
let stCart = [];
let stStockMode = 'all';

function esc(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

function stRenderCard(p) {
  const stock = p.stock;
  const si = Math.floor(stock);
  const img = p.image_url
    ? `<img src="${esc(p.image_url)}" class="card-img-top" loading="lazy" style="height:160px;object-fit:cover;border-radius:8px 8px 0 0;" alt="${esc(p.name)}">`
    : `<div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height:160px;border-radius:8px 8px 0 0;"><i class="bi bi-box-seam fs-1 text-muted"></i></div>`;
  const badge = stock <= 0
    ? `<span class="position-absolute top-0 end-0 badge bg-danger m-2"><i class="bi bi-x-circle me-1"></i>Out of Stock</span>`
    : stock <= 5
    ? `<span class="position-absolute top-0 end-0 badge bg-warning text-dark m-2"><i class="bi bi-exclamation-triangle me-1"></i>Low (${si})</span>`
    : `<span class="position-absolute top-0 end-0 badge bg-success m-2"><i class="bi bi-check-circle me-1"></i>${si} in stock</span>`;
  const varSel = p.has_variants && p.variants.length
    ? `<select class="form-select form-select-sm mb-2" id="st-variant-${p.id}" onclick="event.stopPropagation()"><option value="">— Select variant —</option>${p.variants.map(v=>`<option value="${v.id}" data-label="${esc(v.label)}" data-stock="${v.stock}">${esc(v.label)} (stock: ${Math.floor(v.stock)})</option>`).join('')}</select>`
    : '';
  return `<div class="col-md-4 col-lg-3 st-item" data-id="${p.id}" data-name="${esc(p.name.toLowerCase())}" data-sku="${esc(p.sku.toLowerCase())}" data-category="${esc(p.category_id)}" data-stock="${stock}">
    <div class="card h-100 st-card" id="st-card-${p.id}" onclick="stToggle(${p.id})">
      <div class="position-relative">${img}${badge}
        <div class="position-absolute top-0 start-0 m-2 d-none" id="st-check-${p.id}"><span class="badge rounded-circle p-2" style="background:#1C7C54;"><i class="bi bi-check-lg text-white"></i></span></div>
      </div>
      <div class="card-body d-flex flex-column p-3">
        <small class="text-muted mb-1">${esc(p.category_name)}</small>
        <h6 class="fw-semibold mb-1" style="font-size:0.88rem;min-height:36px;">${esc(p.name)}</h6>
        <small class="text-muted mb-2">SKU: ${esc(p.sku)}</small>
        ${varSel}
        <div class="mt-auto">
          <button type="button" class="btn btn-sm w-100 fw-semibold st-btn" id="st-btn-${p.id}"
                  style="background:linear-gradient(135deg,#1C7C54,#10b981);color:white;border:none;border-radius:6px;"
                  onclick="event.stopPropagation();stAddFromBtn(${p.id})"${stock<=0?' disabled':''}>
            <i class="bi bi-plus-circle me-1"></i>Add to Request
          </button>
        </div>
      </div>
    </div>
  </div>`;
}

// Init: populate categories + render grid
(function(){
  const cats = {};
  ST_PRODUCTS.forEach(p => { if (p.category_id) cats[p.category_id] = p.category_name; });
  const sel = document.getElementById('stCatFilter');
  Object.entries(cats).sort((a,b) => a[1].localeCompare(b[1])).forEach(([id,name]) => {
    const o = document.createElement('option'); o.value = id; o.textContent = name; sel.appendChild(o);
  });
  const grid = document.getElementById('stGrid');
  if (ST_PRODUCTS.length === 0) {
    grid.innerHTML = '<div class="col-12 text-center py-5"><i class="bi bi-box-seam fs-1 text-muted mb-3"></i><h5 class="text-muted">No Products Available</h5></div>';
  } else {
    grid.innerHTML = ST_PRODUCTS.map(stRenderCard).join('');
  }
})();

function stCartKey(productId, variantId) { return variantId ? `${productId}-v${variantId}` : `${productId}`; }

function stToggle(id) {
  const p = ST_MAP[id];
  if (!p || p.has_variants || p.stock <= 0) return;
  const key = stCartKey(id, null);
  const idx = stCart.findIndex(i => i.key === key);
  if (idx >= 0) { stCart.splice(idx, 1); stSetCardState(id, false); }
  else { stCart.push({ key, productId: id, variantId: null, variantLabel: null, name: p.name, sku: p.sku, stock: p.stock, qty: 1 }); stSetCardState(id, true); }
  stRender();
}

function stAddFromBtn(id) {
  const p = ST_MAP[id];
  if (!p) return;
  if (p.has_variants) {
    const sel = document.getElementById('st-variant-' + id);
    if (!sel || !sel.value) { alert('Please select a variant first.'); return; }
    const opt = sel.options[sel.selectedIndex];
    const variantId = parseInt(sel.value);
    const key = stCartKey(id, variantId);
    if (stCart.find(i => i.key === key)) { alert('This variant is already in the request.'); return; }
    stCart.push({ key, productId: id, variantId, variantLabel: opt.dataset.label, name: p.name, sku: p.sku, stock: parseFloat(opt.dataset.stock) || 0, qty: 1 });
  } else {
    if (p.stock <= 0) return;
    const key = stCartKey(id, null);
    if (stCart.find(i => i.key === key)) { stRemoveByKey(key); return; }
    stCart.push({ key, productId: id, variantId: null, variantLabel: null, name: p.name, sku: p.sku, stock: p.stock, qty: 1 });
  }
  stSetCardState(id, true);
  stRender();
}

function stSetCardState(id, selected) {
  const card = document.getElementById('st-card-' + id);
  const check = document.getElementById('st-check-' + id);
  const btn = document.getElementById('st-btn-' + id);
  const inCart = stCart.some(i => i.productId === id);
  if (selected || inCart) {
    card.classList.add('selected'); check.classList.remove('d-none');
    if (btn) { btn.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>Added'; btn.style.background = 'linear-gradient(135deg,#0f5e3e,#059669)'; }
  } else {
    card.classList.remove('selected'); check.classList.add('d-none');
    if (btn) { btn.innerHTML = '<i class="bi bi-plus-circle me-1"></i>Add to Request'; btn.style.background = 'linear-gradient(135deg,#1C7C54,#10b981)'; }
  }
}

function stRender() {
  const panel = document.getElementById('stPanel');
  const rows = document.getElementById('stCartRows');
  const hidden = document.getElementById('stHiddenFields');
  const count = stCart.length;
  document.getElementById('stItemCount').textContent = count;
  document.getElementById('stSubmitCount').textContent = count;
  if (count === 0) { panel.classList.add('d-none'); return; }
  panel.classList.remove('d-none');
  rows.innerHTML = stCart.map(item => `
    <div class="st-cart-row d-flex align-items-center gap-3">
      <div class="flex-grow-1">
        <div class="fw-semibold small">${esc(item.name)}${item.variantLabel ? ` <span class="badge bg-primary-subtle text-primary ms-1" style="font-size:0.7rem;">${esc(item.variantLabel)}</span>` : ''}</div>
        <small class="text-muted">SKU: ${esc(item.sku)} &bull; Available: ${Math.floor(item.stock)}</small>
      </div>
      <div style="width:130px;">
        <div class="input-group input-group-sm">
          <button class="btn btn-outline-secondary" type="button" onclick="stDec('${item.key}')" style="border-radius:6px 0 0 6px;"><i class="bi bi-dash"></i></button>
          <input type="number" class="form-control text-center fw-bold" id="st-qty-${item.key}" value="${item.qty}" min="1" step="1" max="${Math.floor(item.stock)}" onchange="stQtyChange('${item.key}',this.value)" style="max-width:54px;">
          <button class="btn btn-outline-secondary" type="button" onclick="stInc('${item.key}')" style="border-radius:0 6px 6px 0;"><i class="bi bi-plus"></i></button>
        </div>
      </div>
      <button type="button" class="btn btn-sm btn-outline-danger" onclick="stRemoveByKey('${item.key}')" style="border-radius:6px;"><i class="bi bi-trash"></i></button>
    </div>`).join('');
  hidden.innerHTML = stCart.map((item, i) =>
    `<input type="hidden" name="transfers[${i}][product_id]" value="${item.productId}">` +
    `<input type="hidden" name="transfers[${i}][quantity]" value="${item.qty}">` +
    (item.variantId ? `<input type="hidden" name="transfers[${i}][variant_id]" value="${item.variantId}">` : '')
  ).join('');
}

function stQtyChange(key, val) {
  const item = stCart.find(i => i.key === key);
  if (!item) return;
  item.qty = Math.min(Math.max(1, parseInt(val) || 1), Math.floor(item.stock));
  const inp = document.getElementById('st-qty-' + key);
  if (inp) inp.value = item.qty;
  stRender();
}
function stInc(key) { const i = stCart.find(i=>i.key===key); if(i&&i.qty<Math.floor(i.stock)){i.qty++;stRender();} }
function stDec(key) { const i = stCart.find(i=>i.key===key); if(i&&i.qty>1){i.qty--;stRender();} }
function stRemoveByKey(key) { const i=stCart.find(i=>i.key===key); if(i)stSetCardState(i.productId,false); stCart=stCart.filter(i=>i.key!==key); stRender(); }
function stClearAll() { stCart.forEach(i=>stSetCardState(i.productId,false)); stCart=[]; stRender(); }

// Adds every currently-visible (filtered), in-stock product to the cart.
// Products with variants get EVERY in-stock variant added as its own line.
function stSelectAllVisible() {
  document.querySelectorAll('.st-item').forEach(el => {
    if (el.style.display === 'none') return;
    const id = parseInt(el.dataset.id);
    const p = ST_MAP[id];
    if (!p) return;

    if (p.has_variants) {
      let any = false;
      (p.variants || []).forEach(v => {
        if (v.stock <= 0) return;
        const key = stCartKey(id, v.id);
        if (stCart.find(i => i.key === key)) return;
        stCart.push({ key, productId: id, variantId: v.id, variantLabel: v.label, name: p.name, sku: p.sku, stock: v.stock, qty: 1 });
        any = true;
      });
      if (any) stSetCardState(id, true);
    } else {
      if (p.stock <= 0) return;
      const key = stCartKey(id, null);
      if (stCart.find(i => i.key === key)) return;
      stCart.push({ key, productId: id, variantId: null, variantLabel: null, name: p.name, sku: p.sku, stock: p.stock, qty: 1 });
      stSetCardState(id, true);
    }
  });
  stRender();
}

function stDeselectAllVisible() {
  document.querySelectorAll('.st-item').forEach(el => {
    if (el.style.display === 'none') return;
    const id = parseInt(el.dataset.id);
    stCart = stCart.filter(i => i.productId !== id);
    stSetCardState(id, false);
  });
  stRender();
}

function stApplyBulkQty() {
  const val = parseInt(document.getElementById('stBulkQty').value, 10);
  if (!val || val < 1) { alert('Enter a valid quantity first.'); return; }
  stCart.forEach(item => { item.qty = Math.max(1, Math.min(val, Math.floor(item.stock))); });
  stRender();
}

function stFilter() {
  const q = document.getElementById('stSearch').value.toLowerCase();
  const cat = document.getElementById('stCatFilter').value;
  let vis = 0;
  document.querySelectorAll('.st-item').forEach(item => {
    const show = (!q || item.dataset.name.includes(q) || item.dataset.sku.includes(q))
              && (!cat || item.dataset.category === cat)
              && (stStockMode === 'all' || parseFloat(item.dataset.stock) > 0);
    item.style.display = show ? '' : 'none';
    if (show) vis++;
  });
  document.getElementById('stNoResults').classList.toggle('d-none', vis > 0);
}

function stStockFilter(mode) {
  stStockMode = mode;
  document.getElementById('stAllBtn').classList.toggle('active', mode === 'all');
  document.getElementById('stInStockBtn').classList.toggle('active', mode === 'instock');
  stFilter();
}

document.getElementById('stForm')?.addEventListener('submit', function(e) {
  if (stCart.length === 0) { e.preventDefault(); alert('Please select at least one product.'); return; }
  const btn = document.getElementById('stSubmitBtn');
  btn.disabled = true;
  document.getElementById('stSubmitBtnContent').innerHTML = '<span class="st-spinner"></span>Submitting request&hellip;';
});
</script>
