<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Order Confirmed</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#f6f5f2;color:#232323;line-height:1.5}
a{color:inherit;text-decoration:none}
.topbar{background:#1c1c1a;color:#f4ece0;padding:16px 24px}
.topbar .brand{font-weight:700;font-size:16px}
.wrap{max-width:760px;margin:0 auto;padding:48px 20px 80px}
.success{text-align:center;margin-bottom:32px}
.success .tick{font-size:52px;color:#2e7d32;margin-bottom:12px}
.success h1{font-size:24px;font-weight:700;color:#2e7d32;margin-bottom:8px}
.success p{color:#6b6459}
.card{background:#fff;border-radius:12px;padding:24px;margin-bottom:20px;box-shadow:0 1px 3px rgba(0,0,0,.06)}
.card h2{font-size:15px;font-weight:700;margin-bottom:14px}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}
.row2 label{display:block;font-size:11.5px;color:#8a8378;text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px}
.row2 .val{font-size:15px;font-weight:600}
.badge{display:inline-block;background:#eef7ee;color:#2e7d32;border:1px solid #cfe8cf;border-radius:6px;padding:4px 10px;font-size:12.5px;font-weight:600}
.badge.amber{background:#fdf3e2;color:#a15c00;border-color:#f0deb4}
.badge.grey{background:#f1f0ec;color:#6b6459;border-color:#e2dfd6}
.steps{display:flex;flex-wrap:wrap;gap:8px;margin-top:4px}
.steps .badge{opacity:.5}
.steps .badge.done{opacity:1}
.steps .badge.current{opacity:1;box-shadow:0 0 0 2px #2e7d3233}
.addr-box{background:#f6f5f2;border-radius:8px;padding:12px 14px;font-size:14px;white-space:pre-line}
.item-row{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #f0ece2;font-size:14px}
.tot-row{display:flex;justify-content:space-between;padding:8px 0;font-size:14px}
.tot-row.grand{font-size:17px;font-weight:700;border-top:1px solid #eee5d5;margin-top:6px;padding-top:12px}
.btn{display:inline-block;text-align:center;width:100%;background:#1c1c1a;color:#fff;border:none;border-radius:9px;padding:14px;font-size:14.5px;font-weight:700;cursor:pointer}
</style>
</head>
<body>

<div class="topbar"><span class="brand">Order Confirmation</span></div>

<div class="wrap">
  <div class="success">
    <div class="tick">✓</div>
    <h1>Order Placed Successfully!</h1>
    <p>Thank you, <%= @booking.customer_name %>. We'll process your order shortly.</p>
  </div>

  <div class="card">
    <h2>Order Details</h2>
    <div class="row2">
      <div><label>Booking Number</label><div class="val"><%= @booking.booking_number %></div></div>
      <div><label>Order Date</label><div class="val"><%= @booking.booking_date.strftime('%d %b %Y, %I:%M %p') %></div></div>
      <div><label>Payment Method</label><div class="val"><%= @booking.payment_method_display %></div></div>
      <div>
        <label>Status</label>
        <div>
          <span class="badge <%= @booking.pending_pre_booking_approval? ? 'amber' : (%w[cancelled returned].include?(@booking.status) ? 'grey' : '') %>">
            <%= @booking.pending_pre_booking_approval? ? 'Awaiting Admin Approval' : @booking.status.humanize %>
          </span>
        </div>
      </div>
    </div>
    <label style="display:block;font-size:11.5px;color:#8a8378;text-transform:uppercase;letter-spacing:.4px;margin-bottom:6px;">Delivery Address</label>
    <div class="addr-box"><%= @booking.delivery_address %></div>
  </div>

  <% if @steps.present? %>
    <div class="card">
      <h2>Order Progress</h2>
      <div class="steps">
        <% @steps.each_with_index do |step, i| %>
          <span class="badge <%= i < @current_step_index ? 'done' : (i == @current_step_index ? 'current' : 'grey') %>">
            <%= step[:icon] %> <%= step[:label] %>
          </span>
        <% end %>
      </div>
      <p style="margin-top:12px;font-size:13px;color:#8a8378;">
        Track live updates any time at
        <a href="/track-order/<%= @booking.booking_number %>" style="color:#2e7d32;font-weight:600;">/track-order/<%= @booking.booking_number %></a>
      </p>
    </div>
  <% end %>

  <div class="card">
    <h2>Items Ordered</h2>
    <% @booking_items.each do |item| %>
      <div class="item-row">
        <span><%= item.product&.name || 'Product' %> × <%= item.quantity.to_i %></span>
        <span>₹<%= (item.price * item.quantity).round(2) %></span>
      </div>
    <% end %>
    <div class="tot-row"><span>Subtotal</span><span>₹<%= @booking.subtotal %></span></div>
    <div class="tot-row grand"><span>Total</span><span>₹<%= @booking.total_amount %></span></div>
  </div>

  <a href="/" class="btn">Continue Shopping</a>
</div>

</body>
</html>
