<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Checkout</title>
<script src="https://sdk.cashfree.com/js/v3/cashfree.js"></script>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#f6f5f2;color:#232323;line-height:1.5}
a{color:inherit;text-decoration:none}
.topbar{background:#1c1c1a;color:#f4ece0;padding:16px 24px;display:flex;align-items:center;justify-content:space-between}
.topbar a{font-size:14px;letter-spacing:.3px;display:flex;align-items:center;gap:6px}
.topbar .brand{font-weight:700;font-size:16px}
.wrap{max-width:1080px;margin:0 auto;padding:32px 20px 80px}
h1.page-title{font-size:26px;font-weight:700;margin-bottom:24px}
.grid{display:grid;grid-template-columns:1.6fr 1fr;gap:24px;align-items:start}
.card{background:#fff;border-radius:12px;padding:24px;margin-bottom:20px;box-shadow:0 1px 3px rgba(0,0,0,.06)}
.card h2{font-size:16px;font-weight:700;margin-bottom:16px;display:flex;align-items:center;gap:8px}
.field-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px}
.field{margin-bottom:14px}
.field label{display:block;font-size:12.5px;font-weight:600;color:#555;margin-bottom:6px}
.field input{width:100%;padding:11px 13px;border:1.5px solid #e2ddd3;border-radius:8px;font-size:14.5px;font-family:inherit}
.field input:focus{outline:none;border-color:#b08d3f}
.required-note{font-size:12px;color:#8a8378;margin-top:-6px;margin-bottom:16px}
.opt{border:1.5px solid #e2ddd3;border-radius:10px;padding:14px 16px;margin-bottom:10px;cursor:pointer;display:flex;align-items:flex-start;gap:12px;transition:border-color .15s}
.opt.selected{border-color:#b08d3f;background:#fbf7ee}
.opt.disabled-opt{opacity:.45;cursor:not-allowed;pointer-events:none}
.opt input{margin-top:3px}
.opt .opt-title{font-weight:600;font-size:14.5px}
.opt .opt-sub{font-size:12.5px;color:#8a8378;margin-top:2px}
#address-fields,#store-fields{margin-top:6px;padding-top:14px;border-top:1px solid #eee5d5}
.pincode-check-box{margin-top:-4px;margin-bottom:14px}
.check-btn{background:#fff;border:1.5px solid #b08d3f;color:#b08d3f;border-radius:8px;padding:9px 16px;font-size:13.5px;font-weight:600;cursor:pointer;transition:background .15s}
.check-btn:hover:not(:disabled){background:#fbf7ee}
.check-btn:disabled{opacity:.6;cursor:not-allowed}
#pincode-result{margin-top:10px;padding:10px 12px;border-radius:8px;font-size:13.5px}
#pincode-result.ok{background:#eaf6ec;color:#1e7a34;border:1px solid #bfe6c6}
#pincode-result.bad{background:#fdeceb;color:#a13b32;border:1px solid #f3c7c2}
.delivery-charge-note{font-size:12px;color:#8a8378;margin-top:4px}
.free-delivery-banner{margin-top:10px;padding:14px 16px;border-radius:10px;background:linear-gradient(135deg,#fff3d6,#ffe6b3);border:1.5px solid #f0c775}
.free-delivery-banner .fdb-title{font-weight:700;font-size:14px;color:#7a5300;display:flex;align-items:center;gap:6px}
.free-delivery-banner .fdb-sub{font-size:12.5px;color:#8a6a1f;margin-top:4px;line-height:1.5}
.free-delivery-banner .fdb-bar{height:7px;border-radius:99px;background:#fff;border:1px solid #f0c775;margin-top:10px;overflow:hidden}
.free-delivery-banner .fdb-bar-fill{height:100%;background:linear-gradient(90deg,#e8a33d,#c47f1e);border-radius:99px;transition:width .3s ease}
.free-delivery-banner .fdb-actions{display:flex;gap:8px;margin-top:12px}
.free-delivery-banner .fdb-btn{flex:1;text-align:center;padding:9px 10px;border-radius:8px;font-size:12.5px;font-weight:700;cursor:pointer;border:none;transition:opacity .15s}
.free-delivery-banner .fdb-btn:hover{opacity:.88}
.free-delivery-banner .fdb-btn.primary{background:#c47f1e;color:#fff}
.free-delivery-banner .fdb-btn.secondary{background:#fff;color:#7a5300;border:1.5px solid #e8a33d}
.free-delivery-banner.earned{background:linear-gradient(135deg,#e4f7e8,#c9f0d3);border-color:#8fd9a3}
.free-delivery-banner.earned .fdb-title{color:#1e7a34}
.store-pick{border:1px solid #e2ddd3;border-radius:8px;padding:10px 12px;margin-bottom:8px;cursor:pointer;font-size:13.5px}
.store-pick.selected{border-color:#b08d3f;background:#fbf7ee}
.summary{position:sticky;top:20px}
.item-row{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #f0ece2;font-size:14px;gap:10px}
.item-row .name{font-weight:600}
.item-row .qty{color:#8a8378;font-size:12.5px}
.tot-row{display:flex;justify-content:space-between;padding:8px 0;font-size:14px}
.tot-row.grand{font-size:17px;font-weight:700;border-top:1px solid #eee5d5;margin-top:6px;padding-top:12px}
.place-btn{width:100%;background:#1c1c1a;color:#fff;border:none;border-radius:9px;padding:15px;font-size:15px;font-weight:700;cursor:pointer;margin-top:16px;transition:opacity .15s}
.place-btn:disabled{opacity:.6;cursor:not-allowed}
.place-btn:hover:not(:disabled){opacity:.88}
.error-box{background:#fdeceb;color:#a13b32;border:1px solid #f3c7c2;border-radius:8px;padding:12px 14px;font-size:13.5px;margin-bottom:18px;display:none}
.secure-note{text-align:center;font-size:12px;color:#8a8378;margin-top:10px}
.place-btn-note{text-align:center;font-size:12.5px;color:#8a8378;margin-top:10px}
.place-btn-note.bad{color:#a13b32}
.place-btn-note.ok{color:#1e7a34}
@media(max-width:820px){.grid{grid-template-columns:1fr}.field-row{grid-template-columns:1fr}}
</style>
</head>
<body>

<div class="topbar">
  <a href="/"><span class="brand">← Continue Shopping</span></a>
  <span class="brand">Checkout</span>
</div>

<div class="wrap">
  <h1 class="page-title">Checkout</h1>
  <div id="error-box" class="error-box"></div>

  <div class="grid">
    <div>
      <div class="card">
        <h2>Your Details</h2>
        <div class="field-row">
          <div class="field">
            <label for="guest_name">Full Name *</label>
            <input type="text" id="guest_name" name="guest_name" required>
          </div>
          <div class="field">
            <label for="guest_phone">Phone Number *</label>
            <input type="tel" id="guest_phone" name="guest_phone" maxlength="10" required>
          </div>
        </div>
        <div class="field">
          <label for="guest_email">Email Address *</label>
          <input type="email" id="guest_email" name="guest_email" required>
        </div>
        <p class="required-note">We'll use these to confirm and update you about your order — no account needed.</p>
      </div>

      <div class="card">
        <h2>Delivery Option</h2>
        <label class="opt <%= @allow_pre_booking_enabled ? 'disabled-opt' : 'selected' %>" id="opt-home" onclick="selectDelivery('home')">
          <input type="radio" name="delivery_option" value="home_delivery" <%= 'checked' unless @allow_pre_booking_enabled %> <%= 'disabled' if @allow_pre_booking_enabled %>>
          <div>
            <div class="opt-title">Home Delivery</div>
            <div class="opt-sub">Delivered to your address</div>
            <% if @allow_pre_booking_enabled %>
              <div class="opt-sub" style="color:#b08d3f">Unavailable while Pre Booking is on</div>
            <% end %>
          </div>
        </label>
        <% if @collect_from_store_enabled && @available_stores&.any? %>
          <label class="opt <%= 'disabled-opt' if @allow_pre_booking_enabled %>" id="opt-store" onclick="selectDelivery('store')">
            <input type="radio" name="delivery_option" value="store_pickup" <%= 'disabled' if @allow_pre_booking_enabled %>>
            <div>
              <div class="opt-title">Collect from Store</div>
              <div class="opt-sub">Pick up your order yourself</div>
              <% if @allow_pre_booking_enabled %>
                <div class="opt-sub" style="color:#b08d3f">Unavailable while Pre Booking is on</div>
              <% end %>
            </div>
          </label>
        <% end %>
        <% if @allow_pre_booking_enabled %>
          <label class="opt selected" id="opt-prebooking" onclick="selectDelivery('prebooking')">
            <input type="radio" name="delivery_option" value="pre_booking" checked>
            <div>
              <div class="opt-title">Pre Booking</div>
              <div class="opt-sub">Order now, even if not currently in stock — delivered to your address once admin approves</div>
            </div>
          </label>
        <% end %>

        <div id="address-fields">
          <div class="field-row">
            <div class="field">
              <label for="address">Address *</label>
              <input type="text" id="address" name="address">
            </div>
            <div class="field">
              <label for="landmark">Landmark</label>
              <input type="text" id="landmark" name="landmark">
            </div>
          </div>
          <div class="field-row" style="grid-template-columns:1fr 1fr 1fr;">
            <div class="field">
              <label for="city">City *</label>
              <input type="text" id="city" name="city">
            </div>
            <div class="field">
              <label for="state">State</label>
              <input type="text" id="state" name="state">
            </div>
            <div class="field">
              <label for="pincode">Pincode *</label>
              <input type="text" id="pincode" name="pincode" maxlength="6" inputmode="numeric" pattern="\d{6}" oninput="pincodeValidated=false;pincodeDeliverable=null;validatedDeliveryCharge=0;document.getElementById('pincode-result').style.display='none';hideFreeDeliveryBanner();updateSummary();updatePlaceButtonState();">
            </div>
          </div>
          <div class="pincode-check-box">
            <button type="button" class="check-btn" id="check-pincode-btn" onclick="checkPincode()">Check Availability</button>
            <div id="pincode-result" style="display:none;"></div>
            <div id="free-delivery-banner" class="free-delivery-banner" style="display:none;"></div>
          </div>
        </div>

        <% if @collect_from_store_enabled && @available_stores&.any? %>
          <div id="store-fields" style="display:none">
            <% @available_stores.each do |store| %>
              <div class="store-pick" data-store-id="<%= store.id %>" onclick="selectStore(<%= store.id %>, this)">
                <strong><%= store.name %></strong><br>
                <span style="color:#8a8378"><%= store.full_address %></span>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="card">
        <h2>Payment Method</h2>
        <% if @allow_pre_booking_enabled %>
          <div class="opt-sub" style="margin-bottom:10px">No payment is collected now — you'll be contacted once your Pre Booking is approved.</div>
        <% end %>
        <div id="payment-options" style="display:<%= @allow_pre_booking_enabled ? 'none' : 'block' %>">
          <label class="opt selected" id="pay-cod" onclick="selectPayment('cod')">
            <input type="radio" name="payment_method" value="cod" checked>
            <div>
              <div class="opt-title">Cash on Delivery</div>
              <div class="opt-sub">Pay when you receive your order</div>
            </div>
          </label>
          <label class="opt" id="pay-online" onclick="selectPayment('online')">
            <input type="radio" name="payment_method" value="online">
            <div>
              <div class="opt-title">Online Payment</div>
              <div class="opt-sub">UPI, Cards, Net Banking, Wallets — pay securely now</div>
            </div>
          </label>
        </div>
      </div>
    </div>

    <div class="summary">
      <div class="card">
        <h2>Order Summary</h2>
        <% @cart_items.each do |item| %>
          <div class="item-row">
            <div>
              <div class="name"><%= item['product_name'] %></div>
              <div class="qty">Qty: <%= item['quantity'] %></div>
            </div>
            <div>₹<%= (item['price'].to_f * item['quantity'].to_f).round(2) %></div>
          </div>
        <% end %>
        <div class="tot-row"><span>Subtotal</span><span>₹<%= @cart_total.round(2) %></span></div>
        <div class="tot-row"><span>Delivery</span><span id="delivery-charge-display">₹0.00</span></div>
        <div class="tot-row grand"><span>Total</span><span id="grand-total-display">₹<%= @cart_total.round(2) %></span></div>
        <button class="place-btn" id="place-order-btn" onclick="placeOrder()" disabled>Place Order</button>
        <p class="place-btn-note" id="place-btn-note">Please check delivery availability first to place your order.</p>
        <p class="secure-note">🔒 Your order is secure and protected</p>
      </div>
    </div>
  </div>
</div>

<script>
let selectedDeliveryStoreId = null;
let selectedDeliveryOption = 'home_delivery';
const cartTotal = <%= @cart_total.round(2) %>;
let pincodeValidated = false;
let pincodeDeliverable = null; // null = not checked yet, true/false = last check result
let validatedDeliveryCharge = 0;

function updateSummary() {
  const charge = (selectedDeliveryOption !== 'store_pickup' && pincodeValidated) ? validatedDeliveryCharge : 0;
  document.getElementById('delivery-charge-display').textContent = '₹' + charge.toFixed(2);
  document.getElementById('grand-total-display').textContent = '₹' + (cartTotal + charge).toFixed(2);
}

function updatePlaceButtonState() {
  const btn = document.getElementById('place-order-btn');
  const note = document.getElementById('place-btn-note');

  if (selectedDeliveryOption === 'store_pickup') {
    btn.disabled = false;
    note.style.display = 'none';
    return;
  }

  if (pincodeDeliverable === true) {
    btn.disabled = false;
    note.style.display = 'none';
  } else if (pincodeDeliverable === false) {
    btn.disabled = true;
    note.className = 'place-btn-note bad';
    note.style.display = 'block';
    note.textContent = 'Delivery is not serviceable at this pincode. Please try a different address.';
  } else {
    btn.disabled = true;
    note.className = 'place-btn-note';
    note.style.display = 'block';
    note.textContent = 'Please check delivery availability first to place your order.';
  }
}

function hideFreeDeliveryBanner() {
  const banner = document.getElementById('free-delivery-banner');
  banner.style.display = 'none';
  banner.className = 'free-delivery-banner';
  banner.innerHTML = '';
}

function showFreeDeliveryBanner(data) {
  const banner = document.getElementById('free-delivery-banner');

  if (!data.free_delivery_allowed) {
    hideFreeDeliveryBanner();
    return;
  }

  const minOrder = data.min_order_for_free_delivery || 0;
  const orderAmount = data.order_amount != null ? data.order_amount : cartTotal;
  const amountLeft = data.amount_left_for_free_delivery || 0;

  banner.style.display = 'block';

  if (amountLeft <= 0) {
    banner.className = 'free-delivery-banner earned';
    banner.innerHTML = `
      <div class="fdb-title">🎉 You've unlocked FREE delivery!</div>
      <div class="fdb-sub">Your order qualifies for free delivery to this pincode. No delivery charge will be added.</div>
    `;
    return;
  }

  const progressPct = minOrder > 0 ? Math.min(100, Math.round((orderAmount / minOrder) * 100)) : 0;

  banner.className = 'free-delivery-banner';
  banner.innerHTML = `
    <div class="fdb-title">🎁 So close! Just ₹${amountLeft.toFixed(2)} away from FREE delivery</div>
    <div class="fdb-sub">Add ₹${amountLeft.toFixed(2)} more to your cart and save ₹${validatedDeliveryCharge.toFixed(2)} on delivery — or continue with your current order and pay the delivery charge.</div>
    <div class="fdb-bar"><div class="fdb-bar-fill" style="width:${progressPct}%"></div></div>
    <div class="fdb-actions">
      <a href="/" class="fdb-btn secondary" style="text-decoration:none;display:flex;align-items:center;justify-content:center;">Continue Shopping</a>
      <button type="button" class="fdb-btn primary" onclick="hideFreeDeliveryBanner()">Continue with ₹${validatedDeliveryCharge.toFixed(2)} delivery</button>
    </div>
  `;
}

function selectDelivery(type) {
  selectedDeliveryOption = type === 'home' ? 'home_delivery' : type === 'prebooking' ? 'pre_booking' : 'store_pickup';
  document.getElementById('opt-home').classList.toggle('selected', type === 'home');
  const storeOpt = document.getElementById('opt-store');
  if (storeOpt) storeOpt.classList.toggle('selected', type === 'store');
  const prebookingOpt = document.getElementById('opt-prebooking');
  if (prebookingOpt) prebookingOpt.classList.toggle('selected', type === 'prebooking');

  // Pre Booking behaves just like Home Delivery (address + pincode
  // validation), but represents a distinct order type (stock isn't
  // available yet) — while it's selected, disable the other two delivery
  // options so they can't be picked at the same time.
  const preBookingActive = type === 'prebooking';
  const homeOpt = document.getElementById('opt-home');
  const homeInput = homeOpt.querySelector('input');
  homeOpt.classList.toggle('disabled-opt', preBookingActive);
  homeInput.disabled = preBookingActive;
  if (storeOpt) {
    storeOpt.classList.toggle('disabled-opt', preBookingActive);
    storeOpt.querySelector('input').disabled = preBookingActive;
  }

  document.getElementById('address-fields').style.display = (type === 'home' || type === 'prebooking') ? 'block' : 'none';
  const storeFields = document.getElementById('store-fields');
  if (storeFields) storeFields.style.display = type === 'store' ? 'block' : 'none';

  // No payment is collected for a Pre Booking — hide the Cash on
  // Delivery / Online Payment options entirely rather than just
  // disabling them (server still forces payment_method to 'cod'
  // regardless, see Storefront::CheckoutController#payment_method_key).
  const paymentOptions = document.getElementById('payment-options');
  if (paymentOptions) paymentOptions.style.display = preBookingActive ? 'none' : 'block';

  updateSummary();
  updatePlaceButtonState();
}

async function checkPincode() {
  const input = document.getElementById('pincode');
  const resultBox = document.getElementById('pincode-result');
  const btn = document.getElementById('check-pincode-btn');
  const pincode = input.value.trim();

  if (!/^\d{6}$/.test(pincode)) {
    resultBox.className = 'bad';
    resultBox.style.display = 'block';
    resultBox.textContent = 'Please enter a valid 6-digit pincode.';
    return;
  }

  btn.disabled = true;
  btn.textContent = 'Checking…';
  resultBox.style.display = 'none';

  try {
    const response = await fetch('<%= check_pincode_storefront_checkout_path %>?pincode=' + encodeURIComponent(pincode));
    const data = await response.json();

    resultBox.style.display = 'block';

    if (!data.success || !data.deliverable) {
      resultBox.className = 'bad';
      resultBox.textContent = (data.message || 'Delivery is not serviceable at this pincode.');
      pincodeValidated = false;
      pincodeDeliverable = false;
      validatedDeliveryCharge = 0;
      hideFreeDeliveryBanner();
    } else {
      pincodeValidated = true;
      pincodeDeliverable = true;
      validatedDeliveryCharge = data.delivery_charge || 0;
      resultBox.className = 'ok';
      resultBox.textContent = validatedDeliveryCharge > 0
        ? `Delivery available${data.area ? ' to ' + data.area : ''}. Charge: ₹${validatedDeliveryCharge.toFixed(2)}`
        : `Free delivery available${data.area ? ' to ' + data.area : ''}!`;
      showFreeDeliveryBanner(data);
    }
    updateSummary();
    updatePlaceButtonState();
  } catch (e) {
    resultBox.className = 'bad';
    resultBox.style.display = 'block';
    resultBox.textContent = 'Could not check pincode. Please try again.';
    pincodeValidated = false;
    pincodeDeliverable = false;
    validatedDeliveryCharge = 0;
    hideFreeDeliveryBanner();
    updatePlaceButtonState();
  } finally {
    btn.disabled = false;
    btn.textContent = 'Check Availability';
  }
}

function selectStore(id, el) {
  selectedDeliveryStoreId = id;
  document.querySelectorAll('.store-pick').forEach(e => e.classList.remove('selected'));
  el.classList.add('selected');
}

function selectPayment(method) {
  document.getElementById('pay-cod').classList.toggle('selected', method === 'cod');
  document.getElementById('pay-online').classList.toggle('selected', method === 'online');
}

let cashfree;
async function initCashfree() {
  try {
    cashfree = await Cashfree({ mode: '<%= Rails.env.production? ? "production" : "sandbox" %>' });
  } catch (e) {
    console.error('Cashfree init failed', e);
  }
}
initCashfree();

function showError(message) {
  const box = document.getElementById('error-box');
  box.textContent = message;
  box.style.display = 'block';
  box.scrollIntoView({ behavior: 'smooth', block: 'center' });
}

async function placeOrder() {
  const btn = document.getElementById('place-order-btn');
  const errorBox = document.getElementById('error-box');
  errorBox.style.display = 'none';

  const deliveryOption = document.querySelector('input[name="delivery_option"]:checked').value;
  const paymentMethod = document.querySelector('input[name="payment_method"]:checked').value;

  const payload = {
    guest_name: document.getElementById('guest_name').value.trim(),
    guest_email: document.getElementById('guest_email').value.trim(),
    guest_phone: document.getElementById('guest_phone').value.trim(),
    delivery_option: deliveryOption,
    address: document.getElementById('address').value.trim(),
    landmark: document.getElementById('landmark').value.trim(),
    city: document.getElementById('city').value.trim(),
    state: document.getElementById('state').value.trim(),
    pincode: document.getElementById('pincode').value.trim(),
    delivery_store_id: selectedDeliveryStoreId,
    payment_method: paymentMethod
  };

  if (!payload.guest_name || !payload.guest_email || !payload.guest_phone) {
    showError('Please fill in your name, email and phone number.');
    return;
  }
  if (deliveryOption === 'home_delivery' && (!payload.address || !payload.city || !payload.pincode)) {
    showError('Please fill in your delivery address, city and pincode.');
    return;
  }
  if (deliveryOption === 'home_delivery' && !pincodeValidated) {
    showError('Please check delivery availability for your pincode before placing the order.');
    return;
  }

  btn.disabled = true;
  btn.textContent = 'Placing order…';

  try {
    const response = await fetch('<%= storefront_checkout_path %>', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await response.json();

    if (!data.success) {
      throw new Error(data.error || 'Failed to place order.');
    }

    if (data.redirect_to_payment && data.payment_session_id) {
      if (!cashfree) await initCashfree();
      await cashfree.checkout({ paymentSessionId: data.payment_session_id, redirectTarget: '_self' });
      return;
    }

    window.location.href = data.redirect_url;
  } catch (e) {
    showError(e.message || 'Something went wrong. Please try again.');
    btn.disabled = false;
    btn.textContent = 'Place Order';
  }
}
</script>
</body>
</html>
